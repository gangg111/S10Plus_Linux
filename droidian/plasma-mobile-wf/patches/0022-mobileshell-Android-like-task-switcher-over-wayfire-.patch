diff --git a/components/mobileshell/qml/taskswitcher/TaskSwitcherWindow.qml b/components/mobileshell/qml/taskswitcher/TaskSwitcherWindow.qml
new file mode 100644
index 00000000..c763f5b9
--- /dev/null
+++ b/components/mobileshell/qml/taskswitcher/TaskSwitcherWindow.qml
@@ -0,0 +1,296 @@
+// SPDX-FileCopyrightText: 2026 Artur <ganggg111@gmail.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Window
+
+import org.kde.kirigami as Kirigami
+import org.kde.layershell 1.0 as LayerShell
+
+import org.kde.plasma.private.mobileshell as MobileShell
+import org.kde.plasma.private.mobileshell.wayfireipcplugin as WayfireIpcPlugin
+
+/**
+ * Recent apps like on Android: one card per app window, newest first,
+ * scrolled sideways.  Tap a card to go back to the app, swipe it up to close
+ * it, "Zamknij wszystko" closes them all.  Windows come from wayfire over IPC
+ * (no scale plugin, whose GLES renderer crashes when a window closes under it).
+ *
+ * Opened by D-Bus pl.s10plus.ScreenGrab.toggleTaskSwitcher on
+ * org.kde.plasmashell, bound to an edge swipe in wayfire.ini.
+ */
+Window {
+    id: window
+
+    LayerShell.Window.scope: "taskswitcher"
+    LayerShell.Window.anchors: LayerShell.Window.AnchorTop | LayerShell.Window.AnchorLeft | LayerShell.Window.AnchorRight | LayerShell.Window.AnchorBottom
+    LayerShell.Window.layer: LayerShell.Window.LayerOverlay
+    LayerShell.Window.exclusionZone: -1
+    LayerShell.Window.keyboardInteractivity: LayerShell.Window.KeyboardInteractivityNone
+
+    // mapped only while open: a transparent full screen surface on top of
+    // every app would be blended in each frame
+    visible: false
+    color: "transparent"
+
+    // views asked to close: id -> pid, for the kill fallback
+    property var pendingClose: ({})
+    property bool checkingPending: false
+
+    function open() {
+        views.clear();
+        WayfireIpcPlugin.WayfireIPC.requestViews();
+        visible = true;
+        raise();
+        list.positionViewAtBeginning();
+    }
+
+    function hide() {
+        visible = false;
+    }
+
+    function closeCard(index) {
+        const view = views.get(index);
+        pendingClose[view.viewId] = view.pid;
+        WayfireIpcPlugin.WayfireIPC.closeView(view.viewId);
+        views.remove(index);
+        killCheck.restart();
+        if (views.count === 0) {
+            hide();
+        }
+    }
+
+    function closeAll() {
+        while (views.count > 0) {
+            closeCard(0);
+        }
+    }
+
+    // an app that keeps its window after the close request (asks to save,
+    // hangs) is terminated, as swiping it away does on Android
+    Timer {
+        id: killCheck
+        interval: 1500
+        onTriggered: {
+            window.checkingPending = true;
+            WayfireIpcPlugin.WayfireIPC.requestViews();
+        }
+    }
+
+    Connections {
+        target: MobileShell.ShellUtil
+        function onTaskSwitcherToggleRequested() {
+            if (window.visible) {
+                window.hide();
+            } else {
+                window.open();
+            }
+        }
+    }
+
+    Connections {
+        target: WayfireIpcPlugin.WayfireIPC
+
+        function onViewsListed(list) {
+            if (window.checkingPending) {
+                window.checkingPending = false;
+                for (const view of list) {
+                    if (window.pendingClose[view.id] !== undefined) {
+                        WayfireIpcPlugin.WayfireIPC.terminatePid(view.pid);
+                    }
+                }
+                window.pendingClose = {};
+            }
+            if (!window.visible) {
+                return;
+            }
+            views.clear();
+            for (const view of list) {
+                if (window.pendingClose[view.id] !== undefined) {
+                    continue;
+                }
+                const info = MobileShell.ShellUtil.appInfo(view.appId);
+                views.append({
+                    viewId: view.id,
+                    pid: view.pid,
+                    name: info.name,
+                    iconName: info.icon,
+                    title: view.title
+                });
+            }
+        }
+
+        function onViewsChanged() {
+            if (window.visible) {
+                WayfireIpcPlugin.WayfireIPC.requestViews();
+            }
+        }
+    }
+
+    ListModel {
+        id: views
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        color: Qt.rgba(0, 0, 0, 0.82)
+
+        // tap outside the cards goes back
+        TapHandler {
+            onTapped: window.hide()
+        }
+    }
+
+    QQC2.Label {
+        anchors.centerIn: parent
+        visible: views.count === 0
+        text: "Brak ostatnich aplikacji"
+        color: "white"
+        font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.3
+    }
+
+    ListView {
+        id: list
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.verticalCenter: parent.verticalCenter
+        anchors.verticalCenterOffset: -window.height * 0.03
+        height: window.height * 0.62
+
+        orientation: ListView.Horizontal
+        model: views
+        spacing: window.width * 0.05
+        snapMode: ListView.SnapToItem
+        highlightRangeMode: ListView.StrictlyEnforceRange
+        preferredHighlightBegin: (width - cardWidth) / 2
+        preferredHighlightEnd: (width + cardWidth) / 2
+        boundsBehavior: Flickable.StopAtBounds
+
+        readonly property real cardWidth: window.width * 0.66
+
+        remove: Transition {
+            NumberAnimation { property: "opacity"; to: 0; duration: 150 }
+        }
+        displaced: Transition {
+            NumberAnimation { property: "x"; duration: 220; easing.type: Easing.OutCubic }
+        }
+
+        delegate: Item {
+            id: delegate
+            width: list.cardWidth
+            height: list.height
+
+            required property int index
+            required property string name
+            required property string iconName
+            required property string title
+
+            Rectangle {
+                id: card
+                width: parent.width
+                height: parent.height
+                radius: width * 0.08
+                color: Qt.rgba(0.16, 0.17, 0.19, 1)
+                opacity: 1 - Math.min(1, Math.max(0, -y / (parent.height * 0.6)))
+
+                Kirigami.Icon {
+                    id: icon
+                    anchors.horizontalCenter: parent.horizontalCenter
+                    anchors.top: parent.top
+                    anchors.topMargin: parent.height * 0.24
+                    width: parent.width * 0.42
+                    height: width
+                    source: delegate.iconName
+                }
+
+                QQC2.Label {
+                    id: nameLabel
+                    anchors.top: icon.bottom
+                    anchors.topMargin: parent.height * 0.05
+                    anchors.left: parent.left
+                    anchors.right: parent.right
+                    anchors.margins: parent.width * 0.08
+                    horizontalAlignment: Text.AlignHCenter
+                    elide: Text.ElideRight
+                    text: delegate.name
+                    color: "white"
+                    font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.4
+                    font.weight: Font.DemiBold
+                }
+
+                QQC2.Label {
+                    anchors.top: nameLabel.bottom
+                    anchors.topMargin: parent.height * 0.015
+                    anchors.left: parent.left
+                    anchors.right: parent.right
+                    anchors.margins: parent.width * 0.08
+                    horizontalAlignment: Text.AlignHCenter
+                    elide: Text.ElideRight
+                    visible: delegate.title !== delegate.name
+                    text: delegate.title
+                    color: Qt.rgba(1, 1, 1, 0.6)
+                }
+
+                TapHandler {
+                    onTapped: {
+                        WayfireIpcPlugin.WayfireIPC.focusView(views.get(delegate.index).viewId);
+                        window.hide();
+                    }
+                }
+
+                DragHandler {
+                    id: swipe
+                    target: null
+                    yAxis.enabled: true
+                    xAxis.enabled: false
+                    // sideways moves stay with the list
+                    acceptedDevices: PointerDevice.TouchScreen | PointerDevice.Mouse
+                    onTranslationChanged: card.y = Math.min(0, translation.y)
+                    onActiveChanged: {
+                        if (active) {
+                            return;
+                        }
+                        if (-card.y > delegate.height * 0.25 || centroid.velocity.y < -1500) {
+                            flyAway.start();
+                        } else {
+                            settle.start();
+                        }
+                    }
+                }
+
+                NumberAnimation {
+                    id: settle
+                    target: card
+                    property: "y"
+                    to: 0
+                    duration: 180
+                    easing.type: Easing.OutCubic
+                }
+
+                SequentialAnimation {
+                    id: flyAway
+                    NumberAnimation {
+                        target: card
+                        property: "y"
+                        to: -delegate.height * 1.2
+                        duration: 160
+                        easing.type: Easing.InCubic
+                    }
+                    ScriptAction {
+                        script: window.closeCard(delegate.index)
+                    }
+                }
+            }
+        }
+    }
+
+    QQC2.Button {
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.top: list.bottom
+        anchors.topMargin: window.height * 0.04
+        visible: views.count > 0
+        text: "Zamknij wszystko"
+        onClicked: window.closeAll()
+    }
+}
