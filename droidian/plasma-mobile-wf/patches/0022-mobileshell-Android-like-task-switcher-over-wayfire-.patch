+QList<QPointer<ShellUtil>> shellUtils;
 }
 
 
 ShellUtil::ShellUtil(QObject *parent) : QObject{parent}, m_localeConfig {
     KSharedConfig::openConfig(QStringLiteral("kdeglobals"), KConfig::SimpleConfig) } {
+    shellUtils.append(this);
     // only the first ShellUtil of a process gets the object path
     auto *grabber = new ScreenGrab(this);
     if (!QDBusConnection::sessionBus().registerObject(QStringLiteral("/ScreenGrab"), grabber, QDBusConnection::ExportAllSlots)) {
@@ -291,6 +297,42 @@ QString ShellUtil::symbolicIcon(const QString &name)
     return found;
 }
 
+QVariantMap ShellUtil::appInfo(const QString &appId)
+{
+    KService::Ptr service = KService::serviceByDesktopName(appId);
+    if (!service) {
+        service = KService::serviceByStorageId(appId + QStringLiteral(".desktop"));
+    }
+    if (!service) {
+        // apps whose app-id differs from the .desktop name set StartupWMClass
+        const auto all = KService::allServices();
+        for (const KService::Ptr &candidate : all) {
+            if (candidate->property<QString>(QStringLiteral("StartupWMClass")).compare(appId, Qt::CaseInsensitive) == 0) {
+                service = candidate;
+                break;
+            }
+        }
+    }
+    QVariantMap info;
+    info[QStringLiteral("name")] = service ? service->name() : appId;
+    info[QStringLiteral("icon")] = service && !service->icon().isEmpty() ? service->icon() : appId;
+    return info;
+}
+
+void ShellUtil::requestTaskSwitcherToggle()
+{
+    Q_EMIT taskSwitcherToggleRequested();
+}
+
+void ScreenGrab::toggleTaskSwitcher()
+{
+    for (const auto &util : std::as_const(shellUtils)) {
+        if (util) {
+            util->requestTaskSwitcherToggle();
+        }
+    }
+}
+
 bool ShellUtil::autolockEnabled()
 {
     const KConfigGroup daemon(KSharedConfig::openConfig(QStringLiteral("kscreenlockerrc")), QStringLiteral("Daemon"));
