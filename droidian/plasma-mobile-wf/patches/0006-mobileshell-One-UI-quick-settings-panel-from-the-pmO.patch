+class ScreenGrab : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "pl.s10plus.ScreenGrab")
+
+public:
+    using QObject::QObject;
+
+public Q_SLOTS:
+    /**
+     * Writes <prefix>.png (whole screen) and <prefix>-<n>.png (each window).
+     * Returns the files written, one per line.
