+QString ScreenGrab::grab(const QString &prefix)
+{
+    QScreen *screen = QGuiApplication::primaryScreen();
+    if (!screen) {
+        return {};
+    }
+    const qreal dpr = screen->devicePixelRatio();
+    QImage out(screen->size() * dpr, QImage::Format_ARGB32_Premultiplied);
+    out.fill(Qt::black);
+
+    struct Shot {
+        int layer;
+        QPoint pos;
+        QImage image;
+    };
+    QList<Shot> shots;
+    QStringList written;
+
+    for (QWindow *window : QGuiApplication::topLevelWindows()) {
+        auto *quickWindow = qobject_cast<QQuickWindow *>(window);
+        if (!quickWindow || !quickWindow->isVisible()) {
+            continue;
+        }
+        const QImage image = quickWindow->grabWindow();
+        if (image.isNull()) {
+            continue;
+        }
+        const QString file = prefix + QStringLiteral("-%1.png").arg(written.size());
+        image.save(file);
+        written << file;
+
+        // do not create a layer-shell object for windows that have none
+        int layer = LayerShellQt::Window::LayerTop;
+        QPoint pos;
+        if (auto *layerWindow = window->findChild<LayerShellQt::Window *>()) {
+            layer = layerWindow->layer();
+            const auto anchors = layerWindow->anchors();
+            if ((anchors & LayerShellQt::Window::AnchorBottom) && !(anchors & LayerShellQt::Window::AnchorTop)) {
+                pos.setY(out.height() - image.height());
+            }
+            if ((anchors & LayerShellQt::Window::AnchorRight) && !(anchors & LayerShellQt::Window::AnchorLeft)) {
+                pos.setX(out.width() - image.width());
+            }
+        }
+        shots.append({layer, pos, image});
+    }
+
+    std::stable_sort(shots.begin(), shots.end(), [](const Shot &a, const Shot &b) {
+        return a.layer < b.layer;
+    });
+    QPainter painter(&out);
+    for (const Shot &shot : std::as_const(shots)) {
+        painter.drawImage(shot.pos, shot.image);
+    }
+    painter.end();
+
+    const QString file = prefix + QStringLiteral(".png");
+    out.save(file);
+    written.prepend(file);
+    return written.join(QLatin1Char('\n'));
 }
 
