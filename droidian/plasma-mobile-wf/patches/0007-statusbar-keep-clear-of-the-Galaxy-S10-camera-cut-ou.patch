From 3fd4e36bc2c8ad5c4c28f396ac3c9b3d18f02689 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Tue, 29 Sep 2026 22:38:55 +0200
Subject: [PATCH 07/29] statusbar: keep clear of the Galaxy S10+ camera cut-out

In portrait the indicators stay 370 px off the right edge and the clock
110 px off the curved left edge; the panel is at least 200 px high so its
content lines up with the front camera (physical pixels).

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 components/mobileshell/qml/components/Constants.qml |  6 +++++-
 components/mobileshell/qml/statusbar/StatusBar.qml  | 12 ++++++++++--
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/components/mobileshell/qml/components/Constants.qml b/components/mobileshell/qml/components/Constants.qml
index 8a76a038..00557fa9 100644
--- a/components/mobileshell/qml/components/Constants.qml
+++ b/components/mobileshell/qml/components/Constants.qml
@@ -12,7 +12,11 @@ import org.kde.plasma.private.mobileshell.shellsettingsplugin as ShellSettings
 pragma Singleton
 
 QtObject {
-    readonly property real topPanelHeight: Math.round(Kirigami.Units.gridUnit * ShellSettings.Settings.statusBarScaleFactor / 2) * 2 + Kirigami.Units.smallSpacing
+    // Galaxy S10+: at least 200 physical px, so the clock and the icons line up
+    // with the middle of the front camera cut-out (bottom edge at 142 px)
+    readonly property real devicePixelRatio: Qt.application.screens.length > 0 ? Qt.application.screens[0].devicePixelRatio : 1
+    readonly property real topPanelHeight: Math.max(Math.round(Kirigami.Units.gridUnit * ShellSettings.Settings.statusBarScaleFactor / 2) * 2 + Kirigami.Units.smallSpacing,
+                                                    Math.round(200 / devicePixelRatio))
     readonly property real navigationPanelThickness: ShellSettings.Settings.navigationPanelEnabled ? Kirigami.Units.gridUnit * 2 : 0
 
     function navigationPanelOnSide(screenWidth: real, screenHeight: real): bool {
diff --git a/components/mobileshell/qml/statusbar/StatusBar.qml b/components/mobileshell/qml/statusbar/StatusBar.qml
index fec1ed0d..9db29436 100644
--- a/components/mobileshell/qml/statusbar/StatusBar.qml
+++ b/components/mobileshell/qml/statusbar/StatusBar.qml
@@ -54,6 +54,14 @@ Item {
     readonly property real smallerTextPixelSize: Math.round(9 * ShellSettings.Settings.statusBarScaleFactor)
     readonly property real elementSpacing: Math.round(Kirigami.Units.smallSpacing * 1.5)
 
+    // Galaxy S10+: in portrait the dual front camera cuts 326 x 142 px out of the
+    // top right corner and the left edge curves away.  Keep the indicators 370 px
+    // off the right edge and the clock 110 px off the left one (physical pixels,
+    // same values as the pmOS device preset).
+    readonly property bool portrait: Screen.width < Screen.height
+    readonly property real cutoutPadding: portrait ? Math.round(370 / Screen.devicePixelRatio) : 0
+    readonly property real curvePadding: portrait ? Math.round(110 / Screen.devicePixelRatio) : 0
+
     P5Support.DataSource {
         id: timeSource
         engine: "time"
@@ -87,8 +95,8 @@ Item {
         z: 1
         topPadding: Kirigami.Units.smallSpacing
         bottomPadding: Kirigami.Units.smallSpacing
-        rightPadding: Kirigami.Units.smallSpacing * 3
-        leftPadding: Kirigami.Units.smallSpacing * 3
+        rightPadding: Math.max(Kirigami.Units.smallSpacing * 3, root.cutoutPadding)
+        leftPadding: Math.max(Kirigami.Units.smallSpacing * 3, root.curvePadding)
 
         anchors.fill: parent
         background: Rectangle {
-- 
