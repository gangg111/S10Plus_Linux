From 0202bca8c0e750729f26ac31d8af7c2636fc4008 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Tue, 29 Sep 2026 22:38:55 +0200
Subject: [PATCH 09/29] debian: version for the Galaxy S10+ port

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 debian/changelog | 17 +++++++++++++++++
 debian/control   |  1 +
 2 files changed, 18 insertions(+)

diff --git a/debian/changelog b/debian/changelog
index 2259d923..d7381ca5 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,20 @@
+plasma-mobile-wf (6.5.2-1~git20251121171019.91ba13c.next.plasma.6.5+s10plus4) rolling; urgency=medium
+
+  * Session lock only with Autolock on; the preloaded lock surface no
+    longer turns the display off while unlocked.
+  * pl.s10plus.ScreenGrab: screenshots of the shell over D-Bus.
+
+ -- Artur Szafraniec <ganggg111@gmail.com>  Tue, 29 Sep 2026 19:58:15 +0000
+
+plasma-mobile-wf (6.5.2-1~git20251121171019.91ba13c.next.plasma.6.5+s10plus3) rolling; urgency=medium
+
+  * One UI quick settings panel and brightness/volume cards from the
+    pmOS (mainline) port of the Galaxy S10+.
+  * Status bar clear of the front camera cut-out and the curved edge.
+  * Autolock=false in kscreenlockerrc turns off locking the session.
+
+ -- Artur Szafraniec <ganggg111@gmail.com>  Tue, 29 Sep 2026 19:13:24 +0000
+
 plasma-mobile-wf (6.5.2-1~git20251121171019.91ba13c.next.plasma.6.5+s10plus2) rolling; urgency=medium
 
   * Use Milou.ResultsView from Plasma 6.7 (Folio home screen).
diff --git a/debian/control b/debian/control
index 97547901..d72c945a 100644
--- a/debian/control
+++ b/debian/control
@@ -35,6 +35,7 @@ Build-Depends: debhelper-compat (= 13),
                libkf6notifications-dev (>= 6.18.0~),
                libkf6package-dev (>= 6.18.0~),
                libkf6service-dev (>= 6.18.0~),
+               libkf6windowsystem-dev (>= 6.18.0~),
                libkpipewire-dev (>= 6.5.2~),
                libkscreen-dev,
                liblayershellqtinterface-dev,
-- 
2.47.3

