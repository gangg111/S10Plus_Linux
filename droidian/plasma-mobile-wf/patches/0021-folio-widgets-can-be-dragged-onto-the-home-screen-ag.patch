From ea527e2a9341745db7433a345550c832dd4c6405 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Wed, 30 Sep 2026 16:30:32 +0200
Subject: [PATCH 21/29] folio: widgets can be dragged onto the home screen
 again

Closing the widget list destroys the list delegate, and the press-and-hold
handler then called the QML-defined buttonVibrate() in that dead context:
"not a function" aborted the handler before the drag started, so no widget
was ever added.  Vibrate and read everything from the delegate (position,
touch point, plugin name) before closing; start the drag after it, as
before, so the home screen takes over the touch.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../folio/qml/settings/AppletListViewer.qml   | 29 ++++++++++++-------
 1 file changed, 19 insertions(+), 10 deletions(-)

diff --git a/containments/homescreens/folio/qml/settings/AppletListViewer.qml b/containments/homescreens/folio/qml/settings/AppletListViewer.qml
index 058225bb..deea39a7 100644
--- a/containments/homescreens/folio/qml/settings/AppletListViewer.qml
+++ b/containments/homescreens/folio/qml/settings/AppletListViewer.qml
@@ -151,21 +151,30 @@ MouseArea {
                     return
                 }
 
-                root.requestClose();
-                folio.HomeScreenState.closeSettingsView();
+                // Vibrate before closing: closing the viewer destroys this
+                // delegate's context, and calling the QML-defined buttonVibrate()
+                // afterwards threw "not a function", which aborted this handler
+                // before the drag started, so no widget was ever added.  The
+                // drag itself has to start after closing, so that the home
+                // screen takes over the touch.
+                // Everything read from this delegate (its position, the touch
+                // point, the plugin name) is read before closing too: read
+                // afterwards, pluginName came back empty and the widget being
+                // dragged showed "this widget was not found".
                 haptics.buttonVibrate();
 
-                let mappedCoords = root.homeScreen.prepareStartDelegateDrag(null, delegate, true);
+                const mappedCoords = root.homeScreen.prepareStartDelegateDrag(null, delegate, true);
                 const widthOffset = folio.HomeScreenState.pageCellWidth / 2;
                 const heightOffset = folio.HomeScreenState.pageCellHeight / 2;
+                const startX = mappedCoords.x + mouseX - widthOffset;
+                const startY = mappedCoords.y + mouseY - heightOffset;
+                const plugin = delegate.pluginName;
+                const state = folio.HomeScreenState;
+
+                root.requestClose();
+                state.closeSettingsView();
 
-                folio.HomeScreenState.startDelegateWidgetListDrag(
-                    mappedCoords.x + mouseX - widthOffset,
-                    mappedCoords.y + mouseY - heightOffset,
-                    widthOffset,
-                    heightOffset,
-                    pluginName
-                );
+                state.startDelegateWidgetListDrag(startX, startY, widthOffset, heightOffset, plugin);
             }
 
             Rectangle {
-- 
