diff --git a/src/qml/oneui.js b/src/qml/oneui.js
index 229f0b12..71d27702 100755
--- a/src/qml/oneui.js
+++ b/src/qml/oneui.js
@@ -89,3 +89,99 @@ function glyph(pluginId, iconName) {
     var e = entry(pluginId, iconName);
     return e ? e[1] : iconName;
 }
+
+// One UI main page: top level entries in the One UI order, grouped into cards.
+// A module is a plugin id; "@<icon>" means all the modules of the KDE category with
+// that icon (categories have no plugin id). Entries without any installed module are
+// hidden; modules not listed anywhere end up in "Inne ustawienia".
+var groups = [
+    { card: 1, title: "Połączenia", colour: blue, glyph: "network-wireless-symbolic",
+      modules: ["kcm_mobile_wifi", "kcm_bluetooth", "kcm_cellular_network", "kcm_mobile_hotspot", "kcm_mobile_wired"] },
+    { card: 1, title: "Podłączone urządzenia", colour: blue, glyph: "smartphone-symbolic",
+      modules: ["kcm_kdeconnect"] },
+    { card: 2, title: "Dźwięki i wibracja", colour: violet, glyph: "audio-volume-high",
+      modules: ["kcm_pulseaudio"] },
+    { card: 2, title: "Powiadomienia", colour: orange, glyph: "notifications",
+      modules: ["kcm_notifications"] },
+    { card: 3, title: "Wyświetlacz", colour: lime, glyph: "monitor-symbolic",
+      modules: ["@preferences-desktop-display", "kcm_nighttime", "kcm_animations", "@preferences-desktop-font"] },
+    { card: 3, title: "Bateria", colour: green, glyph: "battery-100",
+      modules: ["kcm_mobile_power"] },
+    { card: 4, title: "Tapeta i styl", colour: pink, glyph: "preferences-desktop-theme-global-symbolic",
+      modules: ["@preferences-desktop-theme-global"] },
+    { card: 4, title: "Ekran startowy", colour: blue, glyph: "go-home",
+      modules: ["kcm_mobileshell", "kcm_navigation"] },
+    { card: 5, title: "Bezpieczeństwo i prywatność", colour: violet, glyph: "security-high-symbolic",
+      modules: ["kcm_feedback"] },
+    { card: 6, title: "Konta", colour: blue, glyph: "user-symbolic",
+      modules: ["kcm_users"] },
+    { card: 7, title: "Aplikacje", colour: blue, glyph: "view-grid-symbolic",
+      modules: ["@preferences-desktop-default-applications", "kcm_autostart", "kcm_waydroidintegration"] },
+    { card: 8, title: "Zarządzanie ogólne", colour: slate, glyph: "adjustlevels",
+      modules: ["kcm_regionandlang", "kcm_mobile_time", "@preferences-desktop-keyboard", "kcm_mobile_onscreenkeyboard"] },
+    { card: 9, title: "Informacje o telefonie", colour: slate, glyph: "info-symbolic",
+      modules: ["kcm_mobile_info"] }
+]
+var otherGroup = { card: 9, title: "Inne ustawienia", colour: slate, glyph: "preferences-other", modules: [] }
+
+// Walks the settings model (top level rows, categories one level deep) and returns
+// { "<plugin id>": {id, name, icon}, "@<category icon>": {name, children: [...]} }.
+function collectModules(model) {
+    var found = {};
+    for (var r = 0; r < model.rowCount(); r++) {
+        var idx = model.index(r, 0);
+        var id = model.data(idx, Qt.UserRole + 2);
+        var name = model.data(idx, Qt.DisplayRole);
+        var icon = model.data(idx, Qt.DecorationRole);
+        if (model.data(idx, Qt.UserRole + 3)) {
+            var children = [];
+            for (var c = 0; c < model.rowCount(idx); c++) {
+                var cidx = model.index(c, 0, idx);
+                children.push({ id: model.data(cidx, Qt.UserRole + 2), name: model.data(cidx, Qt.DisplayRole),
+                                icon: model.data(cidx, Qt.DecorationRole) });
+            }
+            found["@" + icon] = { name: name, children: children };
+        } else if (id) {
+            found[id] = { id: id, name: name, icon: icon };
+        }
+    }
+    return found;
+}
+
+// The One UI entries with the modules installed here: [{card, title, colour, glyph,
+// modules: [{id, name, icon, section}]}]; section is the KDE category name for
+// modules taken from a category, so a group page can split them into cards.
+function buildGroups(model) {
+    var found = collectModules(model);
+    var used = {};
+    var result = [];
+    var all = groups.concat([otherGroup]);
+    for (var g = 0; g < all.length; g++) {
+        var mods = [];
+        if (all[g] === otherGroup) {
+            for (var key in found) {
+                if (used[key]) continue;
+                if (key[0] === "@") {
+                    found[key].children.forEach(function (m) { mods.push({ id: m.id, name: m.name, icon: m.icon, section: found[key].name }); });
+                } else {
+                    mods.push({ id: found[key].id, name: found[key].name, icon: found[key].icon, section: "" });
+                }
+            }
+        } else {
+            all[g].modules.forEach(function (key) {
+                var f = found[key];
+                if (!f) return;
+                used[key] = true;
+                if (key[0] === "@") {
+                    f.children.forEach(function (m) { mods.push({ id: m.id, name: m.name, icon: m.icon, section: f.name }); });
+                } else {
+                    mods.push({ id: f.id, name: f.name, icon: f.icon, section: "" });
+                }
+            });
+        }
+        if (mods.length > 0) {
+            result.push({ card: all[g].card, title: all[g].title, colour: all[g].colour, glyph: all[g].glyph, modules: mods });
+        }
+    }
+    return result;
+}
