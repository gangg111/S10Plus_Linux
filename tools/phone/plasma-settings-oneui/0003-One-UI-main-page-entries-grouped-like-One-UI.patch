index 00000000..6b58992a
--- /dev/null
+++ b/src/qml/OneUiGroupPage.qml
@@ -0,0 +1,122 @@
+// SPDX-FileCopyrightText: 2026 Artur <ganggg111@gmail.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Page of a One UI entry (e.g. Połączenia): compact header with a back arrow and
+// the title, the modules of the entry as text rows in rounded cards; modules taken
+// from one KDE category share a card.
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import org.kde.kirigami as Kirigami
+
+import org.kde.plasma.settings
+import "oneui.js" as OneUi
+
+Kirigami.Page {
+    id: root
+
+    // {title, modules: [{id, name, icon, section}]} from OneUi.buildGroups
+    property var group
+    title: group ? group.title : ""
+    titleDelegate: null
+
+    leftPadding: 0
+    rightPadding: 0
+    topPadding: 0
+    bottomPadding: 0
+    clip: true
+
+    background: Rectangle {
+        color: OneUi.bg
+    }
+
+    ListModel {
+        id: modulesModel
+    }
+
+    Component.onCompleted: {
+        for (const m of group.modules) {
+            modulesModel.append({ kcmId: m.id, kcmName: m.name, kcmIcon: m.icon, section: m.section.length > 0 ? m.section : "-" });
+        }
+    }
+
+    ListView {
+        id: listView
+        anchors.fill: parent
+        model: modulesModel
+        reuseItems: false
+        currentIndex: -1
+        highlightFollowsCurrentItem: false
+        boundsBehavior: Flickable.StopAtBounds
+
+        header: Item {
+            width: listView.width
+            height: topBar.height + 12
+        }
+
+        section {
+            property: "section"
+            delegate: Item {
+                required property string section
+                width: ListView.view.width
+                height: OneUi.sectionGap
+            }
+        }
+
+        delegate: OneUiDelegate {
+            required property int index
+            // role names differ from the delegate's own properties (icon, moduleId)
+            required property string kcmId
+            required property string kcmName
+            required property string kcmIcon
+
+            width: ListView.view.width
+            text: kcmName
+            moduleId: kcmId
+            moduleIcon: kcmIcon
+            showIcon: false
+            first: ListView.previousSection !== ListView.section
+            last: ListView.nextSection !== ListView.section
+
+            onClicked: applicationWindow().openModuleById(kcmId)
+        }
+
+        footer: Item {
+            width: listView.width
+            height: 2 * OneUi.sectionGap
+        }
+    }
+
+    Rectangle {
+        id: topBar
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.top: parent.top
+        height: 56
+        color: OneUi.bg
+
+        QQC2.ToolButton {
+            id: backButton
+            anchors.left: parent.left
+            anchors.leftMargin: 6
+            anchors.verticalCenter: parent.verticalCenter
+            icon.name: "go-previous-symbolic"
+            icon.color: OneUi.text
+            Accessible.name: i18n("Navigate Back")
+            onClicked: applicationWindow().pageStack.pop()
+        }
+
+        QQC2.Label {
+            anchors.left: backButton.right
+            anchors.leftMargin: 4
+            anchors.right: parent.right
+            anchors.rightMargin: OneUi.cardMargin
+            anchors.verticalCenter: parent.verticalCenter
+            text: root.title
+            color: OneUi.text
+            font.pixelSize: 22
+            font.weight: Font.Bold
+            elide: Text.ElideRight
+        }
+    }
+}
