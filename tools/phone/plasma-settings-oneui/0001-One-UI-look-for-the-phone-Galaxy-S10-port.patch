diff --git a/src/qml/OneUiDelegate.qml b/src/qml/OneUiDelegate.qml
new file mode 100755
index 00000000..ca40a62a
--- /dev/null
+++ b/src/qml/OneUiDelegate.qml
@@ -0,0 +1,104 @@
+// SPDX-FileCopyrightText: 2026 Artur <ganggg111@gmail.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// One row of a One UI style card: coloured circle with a white glyph, label,
+// separator inset to the label. The card is drawn by its rows: the first row
+// of a section rounds the top corners, the last one the bottom corners.
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import org.kde.kirigami as Kirigami
+
+import "oneui.js" as OneUi
+
+QQC2.ItemDelegate {
+    id: root
+
+    property string moduleId
+    property string moduleIcon
+    property string subtitle
+    property bool first: true
+    property bool showIcon: true
+    // label start from the screen edge: after the circle, or where the circle would be
+    readonly property real textX: showIcon ? OneUi.textX : OneUi.iconX
+    property bool last: true
+
+    readonly property real cardWidth: Math.min(width - 2 * OneUi.cardMargin, OneUi.maxCardWidth)
+    readonly property real cardX: (width - cardWidth) / 2
+
+    implicitWidth: 300
+    implicitHeight: OneUi.rowHeight
+    padding: 0
+    leftInset: cardX
+    rightInset: cardX
+    topInset: 0
+    bottomInset: 0
+    hoverEnabled: false
+
+    Accessible.name: text
+
+    background: Rectangle {
+        color: root.down ? OneUi.cardPressed : OneUi.card
+        topLeftRadius: root.first ? OneUi.radius : 0
+        topRightRadius: root.first ? OneUi.radius : 0
+        bottomLeftRadius: root.last ? OneUi.radius : 0
+        bottomRightRadius: root.last ? OneUi.radius : 0
+
+        Rectangle {
+            visible: !root.last
+            height: 1
+            color: OneUi.separator
+            anchors.bottom: parent.bottom
+            anchors.left: parent.left
+            anchors.leftMargin: root.textX - OneUi.cardMargin
+            anchors.right: parent.right
+            anchors.rightMargin: OneUi.separatorEnd
+        }
+    }
+
+    contentItem: Item {
+        Rectangle {
+            id: circle
+            visible: root.showIcon
+            x: root.cardX + OneUi.iconX - OneUi.cardMargin
+            anchors.verticalCenter: parent.verticalCenter
+            width: OneUi.iconSize
+            height: OneUi.iconSize
+            radius: width / 2
+            color: OneUi.colour(root.moduleId, root.moduleIcon)
+
+            Kirigami.Icon {
+                anchors.centerIn: parent
+                width: OneUi.glyphSize
+                height: OneUi.glyphSize
+                source: OneUi.glyph(root.moduleId, root.moduleIcon)
+                isMask: true
+                color: "white"
+            }
+        }
+
+        Column {
+            x: root.cardX + root.textX - OneUi.cardMargin
+            width: root.cardWidth - x + root.cardX - OneUi.separatorEnd
+            anchors.verticalCenter: parent.verticalCenter
+            spacing: 2
+
+            QQC2.Label {
+                width: parent.width
+                text: root.text
+                color: OneUi.text
+                font.pixelSize: OneUi.fontSize
+                elide: Text.ElideRight
+            }
+
+            QQC2.Label {
+                width: parent.width
+                visible: text.length > 0
+                text: root.subtitle
+                color: OneUi.subtitle
+                font.pixelSize: OneUi.fontSize - 3
+                elide: Text.ElideRight
+            }
+        }
+    }
+}
