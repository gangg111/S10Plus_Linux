diff --git a/src/qml/oneui.js b/src/qml/oneui.js
new file mode 100755
index 00000000..229f0b12
--- /dev/null
+++ b/src/qml/oneui.js
@@ -0,0 +1,91 @@
+// SPDX-FileCopyrightText: 2026 Artur <ganggg111@gmail.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// One UI look for the settings list: colours and sizes measured on a Galaxy
+// One UI 7 settings screenshot (1080 px wide, scaled to 480 logical px).
+.pragma library
+
+var bg = "#010101"
+var card = "#171719"
+var cardPressed = "#2a2a2e"
+var separator = "#3a3a3c"
+var text = "#fafafa"
+var subtitle = "#a3a2a7"
+var pill = "#232325"
+var pillText = "#a1a0a5"
+
+var cardMargin = 13      // card edge from the screen edge
+var radius = 28
+var rowHeight = 65
+var iconX = 32           // icon circle left edge, from the screen edge
+var iconSize = 32
+var glyphSize = 22       // the 22 px Breeze glyphs (16 px ones are other drawings)
+var textX = 88           // label left edge, from the screen edge
+var separatorEnd = 19    // separator end, from the card edge
+var sectionGap = 24
+var fontSize = 17
+var maxCardWidth = 640
+
+var blue = "#377aff"
+var indigo = "#5164fe"
+var violet = "#715aff"
+var orange = "#e65b18"
+var lime = "#a4d925"
+var green = "#65c33b"
+var darkGreen = "#5aae35"
+var pink = "#ed5882"
+var red = "#d83e36"
+var yellow = "#fdbe4d"
+var slate = "#6869a2"
+
+// pluginId (or the icon name for categories, which have no plugin id) ->
+// [circle colour, monochrome Breeze glyph]; colours follow the One UI groups
+var icons = {
+    // connections
+    "kcm_mobile_wifi": [blue, "network-wireless-symbolic"],
+    "kcm_mobile_wired": [blue, "network-wired-symbolic"],
+    "kcm_cellular_network": [blue, "network-mobile-100"],
+    "kcm_mobile_hotspot": [blue, "network-wireless-hotspot"],
+    "kcm_bluetooth": [blue, "network-bluetooth"],
+    // sounds, notifications
+    "kcm_pulseaudio": [violet, "audio-volume-high"],
+    "kcm_notifications": [orange, "notifications"],
+    // display, battery
+    "preferences-desktop-display": [lime, "monitor-symbolic"],
+    "kcm_nighttime": [lime, "redshift-status-on"],
+    "kcm_mobile_power": [green, "battery-100"],
+    // wallpaper and style
+    "preferences-desktop-theme-global": [pink, "preferences-desktop-theme-global-symbolic"],
+    "preferences-desktop-font": [pink, "font"],
+    "kcm_animations": [pink, "animation-stage"],
+    // home screen
+    "kcm_mobileshell": [blue, "go-home"],
+    "kcm_navigation": [blue, "input-touchscreen-symbolic"],
+    // privacy
+    "kcm_feedback": [violet, "dialog-messages"],
+    // accounts, apps
+    "kcm_users": [blue, "user-symbolic"],
+    "kcm_autostart": [blue, "system-run"],
+    "preferences-desktop-default-applications": [blue, "starred-symbolic"],
+    "kcm_waydroidintegration": [darkGreen, "folder-android-symbolic"],
+    // general management, about
+    "preferences-desktop-keyboard": [slate, "input-keyboard"],
+    "kcm_mobile_onscreenkeyboard": [slate, "input-keyboard-virtual"],
+    "kcm_regionandlang": [slate, "globe"],
+    "kcm_mobile_time": [slate, "clock"],
+    "kcm_mobile_info": [slate, "help-about"]
+}
+
+function entry(pluginId, iconName) {
+    return icons[pluginId] || icons[iconName];
+}
+
+function colour(pluginId, iconName) {
+    var e = entry(pluginId, iconName);
+    return e ? e[0] : slate;
+}
+
+function glyph(pluginId, iconName) {
+    var e = entry(pluginId, iconName);
+    return e ? e[1] : iconName;
+}
