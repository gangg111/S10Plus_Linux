-} // namespace
+// The EXIF APP1 segment (from its 0xff marker) and the value field of the
+// orientation entry in it; segment.size() 0: no EXIF, orientation null: no entry
+struct Exif {
+	QByteArray segment;
+	int pos = 0; // segment offset in the file
+	uchar *orientation = nullptr;
+	bool le = false;
+};
 
-// The EXIF orientation of the horizontally mirrored picture (checked for all
-// eight values against Pillow's exif_transpose): the pixels stay, viewers show
-// the selfie the way the preview did.
-bool HybrisCamera::mirrorJpeg(QByteArray &jpeg)
+Exif findExif(QByteArray &jpeg)
 {
-	static const quint16 mirrored[9] = { 0, 2, 1, 4, 3, 6, 5, 8, 7 };
+	Exif x;
 	uchar *d = reinterpret_cast<uchar *>(jpeg.data());
 	const int n = jpeg.size();
 	if (n < 4 || d[0] != 0xff || d[1] != 0xd8)
-		return false;
+		return x;
 	int pos = 2;
 	while (pos + 4 <= n && d[pos] == 0xff) {
 		const int marker = d[pos + 1];
 		const int len = d[pos + 2] << 8 | d[pos + 3];
 		if (marker == 0xda) // image data: no EXIF before it
-			return false;
+			return x;
 		if (marker == 0xe1 && pos + 10 + 8 <= n && memcmp(d + pos + 4, "Exif\0\0", 6) == 0) {
+			x.pos = pos;
+			x.segment = jpeg.mid(pos, qMin(2 + len, n - pos));
 			uchar *t = d + pos + 10;
 			const int tlen = qMin(len - 8, n - pos - 10);
-			const bool le = t[0] == 'I';
-			const quint32 ifd = read32(t + 4, le);
+			x.le = t[0] == 'I';
+			const quint32 ifd = read32(t + 4, x.le);
 			if (ifd + 2 > quint32(tlen))
-				return false;
-			const int count = read16(t + ifd, le);
+				return x;
+			const int count = read16(t + ifd, x.le);
 			for (int i = 0; i < count; i++) {
 				uchar *e = t + ifd + 2 + 12 * i;
 				if (e + 12 > t + tlen)
-					return false;
-				if (read16(e, le) == 0x0112) {
-					const quint16 o = read16(e + 8, le);
-					if (o < 1 || o > 8)
-						return false;
-					const quint16 m = mirrored[o];
-					e[8] = le ? m & 0xff : m >> 8;
-					e[9] = le ? m >> 8 : m & 0xff;
-					return true;
+					return x;
+				if (read16(e, x.le) == 0x0112) {
+					x.orientation = e + 8;
+					return x;
 				}
 			}
-			return false;
+			return x;
 		}
 		pos += 2 + len;
 	}
-	return false;
+	return x;
+}
+
+void write16(uchar *p, quint16 v, bool le)
+{
+	p[0] = le ? v & 0xff : v >> 8;
+	p[1] = le ? v >> 8 : v & 0xff;
+}
+
+} // namespace
+
+// The EXIF orientation of the horizontally mirrored picture (checked for all
+// eight values against Pillow's exif_transpose): the pixels stay, viewers show
+// the selfie the way the preview did.
+bool HybrisCamera::mirrorJpeg(QByteArray &jpeg)
+{
+	static const quint16 mirrored[9] = { 0, 2, 1, 4, 3, 6, 5, 8, 7 };
+	const Exif x = findExif(jpeg);
+	if (!x.orientation)
+		return false;
+	const quint16 o = read16(x.orientation, x.le);
+	if (o < 1 || o > 8)
+		return false;
+	write16(x.orientation, mirrored[o], x.le);
+	return true;
+}
+
+// Like One UI: the model name and the time in the lower left corner of the
+// picture as it is viewed. The picture is turned upright for that, so the EXIF
+// block is carried over with orientation 1.
+bool HybrisCamera::watermarkJpeg(QByteArray &jpeg, int quality)
+{
+	QBuffer in(&jpeg);
+	QImageReader reader(&in, "jpeg");
+	reader.setAutoTransform(true);
+	QImage img = reader.read();
+	if (img.isNull())
+		return false;
+	img = img.convertToFormat(QImage::Format_RGB32);
+	{
+		QPainter p(&img);
+		p.setRenderHint(QPainter::Antialiasing);
+		p.setRenderHint(QPainter::TextAntialiasing);
+		const int side = qMin(img.width(), img.height());
+		const int margin = side * 4 / 100;
+		QFont model;
+		model.setPixelSize(qMax(12, side * 33 / 1000));
+		model.setWeight(QFont::DemiBold);
+		QFont time = model;
+		time.setPixelSize(qMax(10, side * 21 / 1000));
+		time.setWeight(QFont::Normal);
+		const QString stamp = QDateTime::currentDateTime().toString("yyyy.MM.dd  HH:mm");
+		const QFontMetrics fm(model), ft(time);
+		const int timeBase = img.height() - margin;
+		const int modelBase = timeBase - ft.height() - fm.descent();
+		const int shadow = qMax(1, side / 600);
+		auto draw = [&](const QFont &f, int base, const QString &text) {
+			p.setFont(f);
+			p.setPen(QColor(0, 0, 0, 110));
+			p.drawText(margin + shadow, base + shadow, text);
+			p.setPen(QColor(255, 255, 255, 235));
+			p.drawText(margin, base, text);
+		};
+		draw(model, modelBase, QStringLiteral("Galaxy S10+"));
+		draw(time, timeBase, stamp);
+	}
+	QByteArray out;
+	QBuffer buf(&out);
+	buf.open(QIODevice::WriteOnly);
+	QImageWriter writer(&buf, "jpeg");
+	writer.setQuality(quality);
+	if (!writer.write(img) || out.size() < 4)
+		return false;
+	Exif x = findExif(jpeg);
+	if (x.segment.size()) {
+		if (x.orientation) // the pixels are upright now
+			write16(reinterpret_cast<uchar *>(x.segment.data()) + (x.orientation - reinterpret_cast<uchar *>(jpeg.data()) - x.pos), 1, x.le);
+		// EXIF right after SOI, in place of Qt's JFIF header
+		int at = 2;
+		const uchar *o = reinterpret_cast<const uchar *>(out.constData());
+		if (o[2] == 0xff && o[3] == 0xe0)
+			at = 4 + (o[4] << 8 | o[5]);
+		out = out.left(2) + x.segment + out.mid(at);
+	}
+	jpeg = out;
+	return true;
 }
 
