@@ -0,0 +1,229 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Preferences of the One UI style settings page: QR codes in photo mode,
+ * histogram, metering mode, selfies saved as previewed (mirrored), haptic
+ * shutter, reset. Grid, swipe and volume keys are handled in QML.
+ */
+
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <QGuiApplication>
+#include <QSettings>
+#include <QSocketNotifier>
+
+#include <cstring>
+#include <fcntl.h>
+#include <linux/input.h>
+#include <unistd.h>
+
+#include <hybris-camera.h>
+
+namespace {
+
+struct Pref {
+	const char *key;
+	QVariant value;
+};
+
+// defaults like One UI
+const Pref PREFS[] = {
+	{ "qr", true }, { "grid", false }, { "mirror", true }, { "swipe", true },
+	{ "volumeKeys", true }, { "vibration", false }, { "metering", 0 }, { "histogram", true },
+};
+
+const int CENTRE_HALF = 500; // centre-weighted: the middle half of the frame
+const int SPOT_HALF = 80; // spot: about 8% of the width
+
+quint16 read16(const uchar *p, bool le)
+{
+	return le ? quint16(p[0] | p[1] << 8) : quint16(p[0] << 8 | p[1]);
+}
+
+quint32 read32(const uchar *p, bool le)
+{
+	return le ? quint32(p[0] | p[1] << 8 | p[2] << 16 | quint32(p[3]) << 24)
+		  : quint32(quint32(p[0]) << 24 | p[1] << 16 | p[2] << 8 | p[3]);
+}
+
+} // namespace
+
+// The EXIF orientation of the horizontally mirrored picture (checked for all
+// eight values against Pillow's exif_transpose): the pixels stay, viewers show
+// the selfie the way the preview did.
+bool HybrisCamera::mirrorJpeg(QByteArray &jpeg)
+{
+	static const quint16 mirrored[9] = { 0, 2, 1, 4, 3, 6, 5, 8, 7 };
+	uchar *d = reinterpret_cast<uchar *>(jpeg.data());
+	const int n = jpeg.size();
+	if (n < 4 || d[0] != 0xff || d[1] != 0xd8)
+		return false;
+	int pos = 2;
+	while (pos + 4 <= n && d[pos] == 0xff) {
+		const int marker = d[pos + 1];
+		const int len = d[pos + 2] << 8 | d[pos + 3];
+		if (marker == 0xda) // image data: no EXIF before it
+			return false;
+		if (marker == 0xe1 && pos + 10 + 8 <= n && memcmp(d + pos + 4, "Exif\0\0", 6) == 0) {
+			uchar *t = d + pos + 10;
+			const int tlen = qMin(len - 8, n - pos - 10);
+			const bool le = t[0] == 'I';
+			const quint32 ifd = read32(t + 4, le);
+			if (ifd + 2 > quint32(tlen))
+				return false;
+			const int count = read16(t + ifd, le);
+			for (int i = 0; i < count; i++) {
+				uchar *e = t + ifd + 2 + 12 * i;
+				if (e + 12 > t + tlen)
+					return false;
+				if (read16(e, le) == 0x0112) {
+					const quint16 o = read16(e + 8, le);
+					if (o < 1 || o > 8)
+						return false;
+					const quint16 m = mirrored[o];
+					e[8] = le ? m & 0xff : m >> 8;
+					e[9] = le ? m >> 8 : m & 0xff;
+					return true;
+				}
+			}
+			return false;
+		}
+		pos += 2 + len;
+	}
+	return false;
+}
+
+void HybrisCamera::initPrefs()
+{
+	m_prefs = new QQmlPropertyMap(this);
+	QSettings s;
+	for (const Pref &p : PREFS)
+		m_prefs->insert(p.key, s.value(QString("Prefs/") + p.key, p.value));
+	connect(m_prefs, &QQmlPropertyMap::valueChanged, this, [this](const QString &key, const QVariant &value) {
+		QSettings().setValue("Prefs/" + key, value);
+		prefChanged(key);
+	});
+	connect(this, &HybrisCamera::proChanged, this, &HybrisCamera::applyQrScan);
+	connect(this, &HybrisCamera::camModeChanged, this, &HybrisCamera::applyQrScan);
+	connect(m_cameraManager, &CameraManager::cameraChanged, this, &HybrisCamera::applyMetering);
+	connect(qGuiApp, &QGuiApplication::applicationStateChanged, this, &HybrisCamera::applyVolumeKeys);
+	applyVolumeKeys();
+}
+
+void HybrisCamera::prefChanged(const QString &key)
+{
+	if (key == "qr" || key == "histogram")
+		applyQrScan();
+	else if (key == "metering")
+		applyMetering();
+	else if (key == "volumeKeys")
+		applyVolumeKeys();
+}
+
+// Volume keys as the shutter. The compositor keeps them from the window, so
+// they are read from the key device (group android_input). No exclusive grab:
+// the same device carries the power key.
+void HybrisCamera::applyVolumeKeys()
+{
+	const bool on = m_prefs->value("volumeKeys").toBool() &&
+			qGuiApp->applicationState() == Qt::ApplicationActive;
+	if (on && !m_keyNotifier) {
+		const QDir dir("/sys/class/input");
+		for (const QString &ev : dir.entryList({ "event*" }, QDir::Dirs | QDir::System)) {
+			QFile name(dir.filePath(ev + "/device/name"));
+			if (!name.open(QIODevice::ReadOnly) || name.readAll().trimmed() != "gpio_keys")
+				continue;
+			m_keyFd = ::open(("/dev/input/" + ev).toUtf8().constData(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+			break;
+		}
+		if (m_keyFd < 0) {
+			qWarning() << "volume keys: no readable gpio_keys device";
+			return;
+		}
+		m_keyNotifier = new QSocketNotifier(m_keyFd, QSocketNotifier::Read, this);
+		connect(m_keyNotifier, &QSocketNotifier::activated, this, [this]() {
+			input_event ev;
+			while (::read(m_keyFd, &ev, sizeof(ev)) == sizeof(ev))
+				if (ev.type == EV_KEY && ev.value == 1 && (ev.code == KEY_VOLUMEUP || ev.code == KEY_VOLUMEDOWN))
+					Q_EMIT volumeKeyPressed();
+		});
+	} else if (!on && m_keyNotifier) {
+		delete m_keyNotifier;
+		m_keyNotifier = nullptr;
+		::close(m_keyFd);
+		m_keyFd = -1;
+	}
+}
+
+// QR codes in QR mode and, with prefs.qr, in photo mode; the histogram in PRO
+void HybrisCamera::applyQrScan()
+{
+	if (!m_renderer)
+		return;
+	const CameraManager::CamMode mode = m_cameraManager->camMode();
+	const bool pro = m_proActive || m_proVideoActive;
+	m_renderer->setQrScan(mode == CameraManager::QrMode ||
+			      (mode == CameraManager::PictureMode && !pro && m_prefs->value("qr").toBool()));
+	const bool histogram = pro && m_prefs->value("histogram").toBool();
+	m_renderer->setHistogram(histogram);
+	if (!histogram && !m_histogram.isEmpty()) {
+		m_histogram.clear();
+		Q_EMIT histogramChanged();
+	}
+}
+
+// metering mode as a metering area; a tapped area takes over until reset
+void HybrisCamera::applyMetering()
+{
+	const int m = m_prefs->value("metering").toInt();
+	const int half = m == 1 ? CENTRE_HALF : m == 2 ? SPOT_HALF : 0;
+	if (m_c2s) {
+		pushCam2(); // cam2Settings() fills the meter area
+		return;
+	}
+	CameraControl *cc = m_cameraManager->cameraControl();
+	if (!cc)
+		return;
+	if (!half) {
+		android_camera_reset_metering_region(cc);
+		return;
+	}
+	FocusRegion region{ -half, -half, half, half, 1000 };
+	android_camera_set_metering_region(cc, &region);
+}
+
+void HybrisCamera::vibrate(int ms)
+{
+	if (!m_prefs->value("vibration").toBool())
+		return;
+	QFile f("/sys/class/timed_output/vibrator/enable");
+	if (f.open(QIODevice::WriteOnly))
+		f.write(QByteArray::number(qBound(5, ms, 200)));
+}
+
+void HybrisCamera::resetSettings()
+{
+	if (m_isRecording || m_busy)
+		return;
+	exitCam2();
+	QSettings s;
+	const QVariant lastCamera = s.value("AppSettings/last-camera");
+	s.clear();
+	s.setValue("AppSettings/last-camera", lastCamera);
+	for (const Pref &p : PREFS)
+		m_prefs->insert(p.key, p.value);
+	loadProSettings();
+	m_cameraManager->setJpegQuality(95);
+	m_cameraManager->setWithMic(true);
+	setVideoFps(30);
+	setHevc(false);
+	setFaceDetection(false);
+	setGeotag(false);
+	setBurstCount(10);
+	Q_EMIT proChanged();
+	m_cameraManager->reconnectCamera(); // HAL parameters back to the defaults
+	applyQrScan();
+	applyMetering();
+	scheduleCam2();
+	qDebug() << "settings reset";
+}
