+void CameraRenderer::readHistogram()
+{
+	std::vector<uint8_t> px(size_t(m_qrWidth) * m_qrHeight * 4);
+	glBindFramebuffer(GL_FRAMEBUFFER, m_qrFbo);
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	glReadPixels(0, 0, m_qrWidth, m_qrHeight, GL_RGBA, GL_UNSIGNED_BYTE, px.data());
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	QVector<int> bins(32, 0);
+	for (size_t i = 0; i < px.size(); i += 4)
+		bins[px[i] >> 3]++;
+	Q_EMIT histogramReady(bins);
+}
