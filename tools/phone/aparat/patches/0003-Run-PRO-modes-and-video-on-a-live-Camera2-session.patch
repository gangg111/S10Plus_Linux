+void gpsEntries(ACaptureRequest *shot, const Cam2Settings *s)
+{
+	if (!s->gps)
+		return;
+	const double c[3] = { s->latitude, s->longitude, s->altitude };
+	const int64_t ts = s->gpsTime;
+	static const uint8_t method[] = "GPS";
+	ACaptureRequest_setEntry_double(shot, ACAMERA_JPEG_GPS_COORDINATES, 3, c);
+	ACaptureRequest_setEntry_i64(shot, ACAMERA_JPEG_GPS_TIMESTAMP, 1, &ts);
+	ACaptureRequest_setEntry_u8(shot, ACAMERA_JPEG_GPS_PROCESSING_METHOD, sizeof(method), method);
+}
+
+// the RAW frame with the colour data a DNG needs (static metadata + its result)
+void deliverRaw(AImage *img, const ACameraMetadata *ch, const ACameraMetadata *res, cam2_raw_cb onRaw, void *ctx)
+{
+	Cam2Dng m = {};
+	ACameraMetadata_const_entry e;
+	uint8_t *d = nullptr;
+	int n = 0;
+	AImage_getPlaneData(img, 0, &d, &n);
+	AImage_getWidth(img, &m.width);
+	AImage_getHeight(img, &m.height);
+	AImage_getPlaneRowStride(img, 0, &m.rowStride);
+	if (entry(ch, ACAMERA_SENSOR_INFO_COLOR_FILTER_ARRANGEMENT, &e))
+		m.cfa = e.data.u8[0];
+	if (entry(ch, ACAMERA_SENSOR_BLACK_LEVEL_PATTERN, &e))
+		for (int i = 0; i < 4 && i < (int)e.count; i++)
+			m.black[i] = e.data.i32[i];
+	if (entry(ch, ACAMERA_SENSOR_INFO_WHITE_LEVEL, &e))
+		m.white = e.data.i32[0];
+	if (entry(ch, ACAMERA_SENSOR_REFERENCE_ILLUMINANT1, &e))
+		m.illuminant1 = e.data.u8[0];
+	if (entry(ch, ACAMERA_SENSOR_REFERENCE_ILLUMINANT2, &e))
+		m.illuminant2 = e.data.u8[0];
+	matrix(ch, ACAMERA_SENSOR_COLOR_TRANSFORM1, m.colorMatrix1, 9);
+	matrix(ch, ACAMERA_SENSOR_COLOR_TRANSFORM2, m.colorMatrix2, 9);
+	matrix(ch, ACAMERA_SENSOR_FORWARD_MATRIX1, m.forwardMatrix1, 9);
+	matrix(ch, ACAMERA_SENSOR_FORWARD_MATRIX2, m.forwardMatrix2, 9);
+	matrix(ch, ACAMERA_SENSOR_CALIBRATION_TRANSFORM1, m.calibration1, 9);
+	matrix(ch, ACAMERA_SENSOR_CALIBRATION_TRANSFORM2, m.calibration2, 9);
+	matrix(res, ACAMERA_SENSOR_NEUTRAL_COLOR_POINT, m.neutral, 3);
+	if (entry(res, ACAMERA_SENSOR_SENSITIVITY, &e))
+		m.iso = e.data.i32[0];
+	if (entry(res, ACAMERA_SENSOR_EXPOSURE_TIME, &e))
+		m.expNs = e.data.i64[0];
+	if (entry(res, ACAMERA_LENS_APERTURE, &e))
+		m.fNumber = e.data.f[0];
+	if (entry(res, ACAMERA_LENS_FOCAL_LENGTH, &e))
+		m.focalLength = e.data.f[0];
+	if (d && n >= m.rowStride * m.height)
+		onRaw(ctx, reinterpret_cast<const unsigned short *>(d), &m);
+}
+
+// JPEG frames (and the RAW of the first shot) of a capture sequence; drain: a
+// preview reader nobody else empties, or null. Returns the JPEG count.
+int collectShots(AImageReader *drain, AImageReader *jpeg, AImageReader *raw, Shared &shared,
+		 const ACameraMetadata *ch, int count, long long limitMs, cam2_jpeg_cb onJpeg, cam2_raw_cb onRaw,
+		 void *ctx)
+{
+	int delivered = 0;
+	bool rawDone = !raw;
+	AImage *rawImage = nullptr;
+	for (long long t = 0; t < limitMs && (delivered < count || !rawDone); t += 5) {
+		usleep(5000);
+		AImage *img = nullptr;
+		if (drain && AImageReader_acquireLatestImage(drain, &img) == AMEDIA_OK && img)
+			AImage_delete(img);
+		img = nullptr;
+		if (AImageReader_acquireNextImage(jpeg, &img) == AMEDIA_OK && img) {
+			uint8_t *d = nullptr;
+			int n = 0;
+			AImage_getPlaneData(img, 0, &d, &n);
+			if (d && n > 0)
+				onJpeg(ctx, d, jpegSize(d, n), delivered);
+			delivered++;
+			AImage_delete(img);
+		}
+		if (!rawDone && !rawImage && AImageReader_acquireNextImage(raw, &rawImage) != AMEDIA_OK)
+			rawImage = nullptr;
+		// the RAW frame waits for its capture result (white balance, gain)
+		ACameraMetadata *res = __atomic_load_n(&shared.stillResult, __ATOMIC_ACQUIRE);
+		if (!rawDone && rawImage && res) {
+			deliverRaw(rawImage, ch, res, onRaw, ctx);
+			AImage_delete(rawImage);
+			rawImage = nullptr;
+			rawDone = true;
+		}
+	}
+	if (rawImage)
+		AImage_delete(rawImage);
+	return delivered;
+}
