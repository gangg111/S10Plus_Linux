+void HybrisCamera::stillCam2(int count, bool raw)
+{
+	if (m_busy || !m_c2s || m_c2Video)
+		return;
+	Cam2Settings s = cam2Settings(true);
+	s.raw = raw && m_cam2.value("raw").toBool();
+	s.count = count;
+	Job *job = new Job;
+	job->base = m_picturePath + "/IMG" + QDateTime::currentDateTime().toString("yyyyMMdd_hhmmsszzz");
+	job->count = count;
+	job->orientation = s.orientation;
+	m_busy = true;
+	Q_EMIT busyChanged();
+	const Cam2Api *api = m_c2;
+	void *session = m_c2s;
+	QThread *worker = QThread::create([this, api, session, s, job]() {
+		const int n = api->still(session, &s, onJpeg, onRaw, job);
+		qDebug() << "cam2 live still:" << n << "frames, ISO" << s.iso << "exposure us" << s.expNs / 1000
+			 << "files" << job->saved;
+		QMetaObject::invokeMethod(this, [this, job]() {
+			m_busy = false;
+			Q_EMIT busyChanged();
+			for (const QString &path : job->saved)
+				if (path.endsWith(".jpg"))
+					Q_EMIT newMediaSaved(path);
+			delete job;
+		}, Qt::QueuedConnection);
+	});
+	connect(worker, &QThread::finished, worker, &QObject::deleteLater);
+	worker->start();
+}
