+// the screen must not blank while the camera is open: a blanked screen also
+// makes mobile-power-saver throttle real-time threads, and the camera then
+// loses frames (about 270 ms every second)
+void HybrisCamera::setScreenInhibit(bool on)
+{
+	QDBusInterface ss("org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver", "org.freedesktop.ScreenSaver",
+			  QDBusConnection::sessionBus());
+	if (!ss.isValid())
+		return;
+	if (on && !m_inhibitCookie) {
+		QDBusReply<uint> r = ss.call("Inhibit", "droidian-camera", tr("Camera in use"));
+		if (r.isValid())
+			m_inhibitCookie = r.value();
+	} else if (!on && m_inhibitCookie) {
+		ss.call("UnInhibit", m_inhibitCookie);
+		m_inhibitCookie = 0;
+	}
+}
