+// ------------------------------------------------------------------ live session
+
+namespace {
+
+struct Pending {
+	uint8_t *data;
+	AMediaCodecBufferInfo info;
+	bool audio;
+};
+
+struct Session {
+	ACameraManager *mgr = nullptr;
+	ACameraMetadata *ch = nullptr;
+	ACameraDevice *dev = nullptr;
+	ACaptureSessionOutputContainer *container = nullptr;
+	ACameraCaptureSession *session = nullptr;
+	Output preview, jpeg, raw;
+	ANativeWindow *encSurface = nullptr;
+	ACaptureSessionOutput *encOutput = nullptr;
+	ACameraOutputTarget *encTarget = nullptr;
+	Cam2SessionConfig cfg = {};
+	Cam2Settings ctl = {};
+	int32_t active[4] = {};
+	int32_t crop[4] = {};
+	bool hasCrop = false;
+	bool manualOk = false;
+	bool flashAvail = false;
+	long long expMin = 0, expMax = 0;
+	int isoMin = 0, isoMax = 0;
+	Shared shared;
+	ACameraCaptureSession_captureCallbacks cb = {};
+	// values in the repeating request; a half-manual setting keeps the
+	// exposure (ISO x time) metered once by the automatic exposure
+	int liveIso = 0;
+	long long liveExp = 0;
+	double meteredExposure = 0;
+	bool metering = false;
+	long long meterUntil = 0;
+	// recording
+	AMediaCodec *venc = nullptr, *aenc = nullptr;
+	AMediaMuxer *mux = nullptr;
+	long vtrack = -1, atrack = -1;
+	bool recording = false, encoding = false, stopping = false;
+	bool muxStarted = false, veos = false, aeos = false;
+	long long stopAt = 0;
+	int sampleRate = 48000, channels = 2;
+	Pending pending[32];
+	int npending = 0;
+};
+
+// a closed session may still get callbacks: its memory is reused only after
+// three more sessions
+Session *graveyard[3];
+
+long long nowUs()
+{
+	long long ts[2];
+	clock_gettime(1, ts); // CLOCK_MONOTONIC
+	return ts[0] * 1000000LL + ts[1] / 1000;
+}
+
+AMediaCodec *newVideoEncoder(const Cam2SessionConfig &c, ANativeWindow *surface)
+{
+	const char *mime = c.hevc ? "video/hevc" : "video/avc";
+	AMediaCodec *enc = AMediaCodec_createEncoderByType(mime);
+	if (!enc)
+		return nullptr;
+	AMediaFormat *f = AMediaFormat_new();
+	AMediaFormat_setString(f, "mime", mime);
+	AMediaFormat_setInt32(f, "width", c.videoWidth);
+	AMediaFormat_setInt32(f, "height", c.videoHeight);
+	AMediaFormat_setInt32(f, "bitrate", c.bitrate > 0 ? c.bitrate : 17000000);
+	AMediaFormat_setInt32(f, "frame-rate", c.fps > 0 ? c.fps : 30);
+	AMediaFormat_setInt32(f, "i-frame-interval", 1);
+	AMediaFormat_setInt32(f, "color-format", COLOR_FORMAT_SURFACE);
+	const bool ok = AMediaCodec_configure(enc, f, nullptr, nullptr, AMEDIACODEC_CONFIGURE_FLAG_ENCODE) == AMEDIA_OK &&
+			AMediaCodec_setInputSurface(enc, surface) == AMEDIA_OK;
+	AMediaFormat_delete(f);
+	if (!ok) {
+		AMediaCodec_delete(enc);
+		return nullptr;
+	}
+	return enc;
+}
+
+void applyCrop(Session *S)
+{
+	const float z = S->ctl.zoom;
+	S->hasCrop = z > 1.01f;
+	if (!S->hasCrop)
+		return;
+	const int aw = S->active[2] - S->active[0], ah = S->active[3] - S->active[1];
+	S->crop[2] = (int32_t)(aw / z);
+	S->crop[3] = (int32_t)(ah / z);
+	S->crop[0] = S->active[0] + (aw - S->crop[2]) / 2;
+	S->crop[1] = S->active[1] + (ah - S->crop[3]) / 2;
+}
+
+// ISO and time for the stream from the manual settings
+void liveExposure(Session *S)
+{
+	const int iso = S->manualOk ? S->ctl.iso : 0;
+	const long long exp = S->manualOk ? S->ctl.expNs : 0;
+	// video: no exposure longer than a frame, the frame rate stays
+	const long long expMax = S->cfg.video ? 1000000000LL / (S->cfg.fps > 0 ? S->cfg.fps : 30) : S->expMax;
+	S->metering = false;
+	if (iso > 0 && exp > 0) {
+		S->liveIso = iso;
+		S->liveExp = exp;
+	} else if (iso > 0 || exp > 0) {
+		if (S->meteredExposure <= 0) {
+			// meter first with the automatic exposure, see cam2s_state()
+			S->liveIso = 0;
+			S->liveExp = 0;
+			S->metering = true;
+			S->meterUntil = __atomic_load_n(&S->shared.frames, __ATOMIC_RELAXED) + 10;
+		} else if (iso > 0) {
+			S->liveIso = iso;
+			S->liveExp = clampLL((long long)(S->meteredExposure / iso), S->expMin, expMax);
+		} else {
+			S->liveExp = exp;
+			S->liveIso = (int)clampLL((long long)(S->meteredExposure / exp), S->isoMin, S->isoMax);
+		}
+	} else {
+		S->liveIso = 0;
+		S->liveExp = 0;
+		S->meteredExposure = 0; // automatic again: meter anew next time
+	}
+}
+
+ACaptureRequest *streamRequest(Session *S, bool trigger)
+{
+	ACaptureRequest *r = nullptr;
+	ACameraDevice_createCaptureRequest(S->dev, S->cfg.video ? TEMPLATE_RECORD : TEMPLATE_PREVIEW, &r);
+	ACaptureRequest_addTarget(r, S->preview.target);
+	if (S->encoding)
+		ACaptureRequest_addTarget(r, S->encTarget);
+	const int flash = S->cfg.video || !S->flashAvail ? 0 : S->ctl.flash;
+	controls(r, &S->ctl, S->liveIso, S->liveExp, S->hasCrop ? S->crop : nullptr, flash, false, S->active);
+	const int fps = S->cfg.fps > 0 ? S->cfg.fps : 30;
+	if (S->liveIso > 0 && S->liveExp > 0) {
+		const int64_t frame = S->liveExp > 1000000000LL / fps ? S->liveExp : 1000000000LL / fps;
+		ACaptureRequest_setEntry_i64(r, ACAMERA_SENSOR_FRAME_DURATION, 1, &frame);
+	} else if (S->cfg.video) {
+		const int32_t range[2] = { fps, fps };
+		ACaptureRequest_setEntry_i32(r, ACAMERA_CONTROL_AE_TARGET_FPS_RANGE, 2, range);
+	}
+	if (trigger) {
+		const uint8_t start = 1;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AF_TRIGGER, 1, &start);
+	}
+	return r;
+}
+
+int restartStream(Session *S)
+{
+	ACaptureRequest *r = streamRequest(S, false);
+	const int ret = ACameraCaptureSession_setRepeatingRequest(S->session, &S->cb, 1, &r, nullptr);
+	ACaptureRequest_free(r);
+	return ret;
+}
+
+void freePending(Session *S)
+{
+	for (int i = 0; i < S->npending; i++)
+		free(S->pending[i].data);
+	S->npending = 0;
+}
+
+void writeSample(Session *S, bool audio, const uint8_t *data, const AMediaCodecBufferInfo &info)
+{
+	if (!S->muxStarted) {
+		// wait for the format of both tracks; keep the first frames (the key frame)
+		if (S->npending < 32) {
+			Pending &p = S->pending[S->npending++];
+			p.data = (uint8_t *)malloc(info.size);
+			memcpy(p.data, data + info.offset, info.size);
+			p.info = info;
+			p.info.offset = 0;
+			p.audio = audio;
+		}
+		return;
+	}
+	AMediaMuxer_writeSampleData(S->mux, audio ? S->atrack : S->vtrack, data, &info);
+}
+
+void tryStartMuxer(Session *S)
+{
+	if (S->muxStarted || S->vtrack < 0 || (S->aenc && S->atrack < 0))
+		return;
+	AMediaMuxer_start(S->mux);
+	S->muxStarted = true;
+	for (int i = 0; i < S->npending; i++)
+		AMediaMuxer_writeSampleData(S->mux, S->pending[i].audio ? S->atrack : S->vtrack, S->pending[i].data,
+					    &S->pending[i].info);
+	freePending(S);
+}
+
+// moves everything an encoder has ready into the muxer
+void drain(Session *S, AMediaCodec *enc, bool audio)
+{
+	for (int guard = 0; guard < 64; guard++) {
+		AMediaCodecBufferInfo info;
+		const long i = AMediaCodec_dequeueOutputBuffer(enc, &info, 0);
+		if (i == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED) {
+			AMediaFormat *f = AMediaCodec_getOutputFormat(enc);
+			(audio ? S->atrack : S->vtrack) = AMediaMuxer_addTrack(S->mux, f);
+			AMediaFormat_delete(f);
+			tryStartMuxer(S);
+			continue;
+		}
+		if (i < 0)
+			return;
+		size_t n = 0;
+		uint8_t *b = AMediaCodec_getOutputBuffer(enc, i, &n);
+		if (b && info.size > 0 && !(info.flags & AMEDIACODEC_BUFFER_FLAG_CODEC_CONFIG))
+			writeSample(S, audio, b, info);
+		AMediaCodec_releaseOutputBuffer(enc, i, false);
+		if (info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM)
+			(audio ? S->aeos : S->veos) = true;
+	}
+}
+
+void finishRecording(Session *S)
+{
+	if (S->muxStarted) {
+		AMediaMuxer_stop(S->mux);
+	}
+	AMediaMuxer_delete(S->mux);
+	S->mux = nullptr;
+	freePending(S);
+	if (S->venc) {
+		AMediaCodec_stop(S->venc);
+		AMediaCodec_delete(S->venc);
+	}
+	if (S->aenc) {
+		AMediaCodec_stop(S->aenc);
+		AMediaCodec_delete(S->aenc);
+	}
+	S->aenc = nullptr;
+	S->recording = S->stopping = S->muxStarted = false;
+	S->vtrack = S->atrack = -1;
+	// the persistent surface gets a fresh encoder for the next recording
+	S->venc = newVideoEncoder(S->cfg, S->encSurface);
+}
+
+void destroySession(Session *S)
+{
+	if (S->session) {
+		ACameraCaptureSession_stopRepeating(S->session);
+		ACameraCaptureSession_close(S->session);
+	}
+	if (S->dev)
+		ACameraDevice_close(S->dev);
+	S->preview.destroy();
+	S->jpeg.destroy();
+	S->raw.destroy();
+	if (S->encTarget)
+		ACameraOutputTarget_free(S->encTarget);
+	if (S->encOutput)
+		ACaptureSessionOutput_free(S->encOutput);
+	if (S->container)
+		ACaptureSessionOutputContainer_free(S->container);
+	if (S->venc)
+		AMediaCodec_delete(S->venc);
+	if (S->encSurface)
+		ANativeWindow_release(S->encSurface);
+	if (ACameraMetadata *res = __atomic_exchange_n(&S->shared.stillResult, nullptr, __ATOMIC_ACQ_REL))
+		ACameraMetadata_free(res);
+	if (S->ch)
+		ACameraMetadata_free(S->ch);
+	if (S->mgr)
+		ACameraManager_delete(S->mgr);
+	delete graveyard[2];
+	graveyard[2] = graveyard[1];
+	graveyard[1] = graveyard[0];
+	graveyard[0] = S;
+}
+
+} // namespace
+
+extern "C" void *cam2s_open(const char *id, const Cam2SessionConfig *cfg, int *error)
+{
+	startPool();
+	Session *S = new Session;
+	S->cfg = *cfg;
+	S->cb.context = &S->shared;
+	S->cb.onCaptureCompleted = onCompleted;
+	S->ctl.focus = -1;
+	S->ctl.ois = -1;
+	S->ctl.awb = -1;
+	S->ctl.effect = -1;
+	S->ctl.antibanding = -1;
+	S->ctl.zoom = 1;
+	*error = -1;
+	S->mgr = ACameraManager_create();
+	if (ACameraManager_getCameraCharacteristics(S->mgr, id, &S->ch) != ACAMERA_OK) {
+		destroySession(S);
+		return nullptr;
+	}
+	ACameraMetadata_const_entry e;
+	if (entry(S->ch, ACAMERA_SENSOR_INFO_ACTIVE_ARRAY_SIZE, &e))
+		for (int i = 0; i < 4; i++)
+			S->active[i] = e.data.i32[i];
+	// the active array entry is (x, y, w, h); keep (l, t, r, b)
+	S->active[2] += S->active[0];
+	S->active[3] += S->active[1];
+	if (entry(S->ch, ACAMERA_SENSOR_INFO_EXPOSURE_TIME_RANGE, &e)) {
+		S->expMin = e.data.i64[0];
+		S->expMax = e.data.i64[1];
+	}
+	if (entry(S->ch, ACAMERA_SENSOR_INFO_SENSITIVITY_RANGE, &e)) {
+		S->isoMin = e.data.i32[0];
+		S->isoMax = e.data.i32[1];
+	}
+	S->manualOk = hasCap(S->ch, CAP_MANUAL_SENSOR);
+	S->flashAvail = entry(S->ch, ACAMERA_FLASH_INFO_AVAILABLE, &e) && e.data.u8[0];
+
+	ACameraDevice_StateCallbacks devCb = { nullptr, noDevice, devError };
+	*error = -2;
+	if (ACameraManager_openCamera(S->mgr, id, &devCb, &S->dev) != ACAMERA_OK) {
+		S->dev = nullptr;
+		destroySession(S);
+		return nullptr;
+	}
+	ACaptureSessionOutputContainer_create(&S->container);
+	*error = -3;
+	if (!S->preview.create(cfg->previewWidth, cfg->previewHeight, AIMAGE_FORMAT_PRIVATE, 4, S->container,
+			       AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE)) {
+		destroySession(S);
+		return nullptr;
+	}
+	if (cfg->video) {
+		*error = -4;
+		if (AMediaCodec_createPersistentInputSurface(&S->encSurface) != AMEDIA_OK) {
+			S->encSurface = nullptr;
+			destroySession(S);
+			return nullptr;
+		}
+		// an encoder configured on the surface gives it size and format before
+		// the session sees it
+		*error = -5;
+		S->venc = newVideoEncoder(S->cfg, S->encSurface);
+		if (!S->venc) {
+			destroySession(S);
+			return nullptr;
+		}
+		ACaptureSessionOutput_create(S->encSurface, &S->encOutput);
+		ACaptureSessionOutputContainer_add(S->container, S->encOutput);
+		ACameraOutputTarget_create(S->encSurface, &S->encTarget);
+	} else {
+		*error = -6;
+		int rw = 0, rh = 0;
+		if (cfg->raw && hasCap(S->ch, CAP_RAW))
+			largest(S->ch, AIMAGE_FORMAT_RAW16, &rw, &rh);
+		int jw = cfg->stillWidth, jh = cfg->stillHeight;
+		if (!hasSize(S->ch, AIMAGE_FORMAT_JPEG, jw, jh))
+			largest(S->ch, AIMAGE_FORMAT_JPEG, &jw, &jh);
+		if (!S->jpeg.create(jw, jh, AIMAGE_FORMAT_JPEG, 2, S->container) ||
+		    (rw && !S->raw.create(rw, rh, AIMAGE_FORMAT_RAW16, 1, S->container))) {
+			destroySession(S);
+			return nullptr;
+		}
+	}
+	ACameraCaptureSession_stateCallbacks sesCb = { nullptr, noSession, noSession, noSession };
+	*error = -7;
+	if (ACameraDevice_createCaptureSession(S->dev, S->container, &sesCb, &S->session) != ACAMERA_OK) {
+		S->session = nullptr;
+		destroySession(S);
+		return nullptr;
+	}
+	*error = -8;
+	if (restartStream(S) != ACAMERA_OK) {
+		destroySession(S);
+		return nullptr;
+	}
+	*error = 0;
+	return S;
+}
+
+extern "C" void cam2s_close(void *session)
+{
+	Session *S = static_cast<Session *>(session);
+	if (!S)
+		return;
+	if (S->recording) {
+		cam2s_record_stop(S);
+		for (int i = 0; i < 300 && S->recording; i++) {
+			if (cam2s_record_pump(S) == 1)
+				break;
+			usleep(10000);
+		}
+		if (S->recording)
+			finishRecording(S);
+	}
+	destroySession(S);
+}
+
+extern "C" int cam2s_controls(void *session, const Cam2Settings *s)
+{
+	Session *S = static_cast<Session *>(session);
+	S->ctl = *s;
+	applyCrop(S);
+	liveExposure(S);
+	int ret = restartStream(S);
+	if (s->afTrigger) {
+		ACaptureRequest *r = streamRequest(S, true);
+		ACameraCaptureSession_capture(S->session, &S->cb, 1, &r, nullptr);
+		ACaptureRequest_free(r);
+	}
+	return ret;
+}
+
+extern "C" int cam2s_state(void *session, Cam2State *out)
+{
+	Session *S = static_cast<Session *>(session);
+	out->iso = __atomic_load_n(&S->shared.iso, __ATOMIC_RELAXED);
+	out->expNs = __atomic_load_n(&S->shared.exp, __ATOMIC_RELAXED);
+	__atomic_load(&S->shared.focus, &out->focusDiopters, __ATOMIC_RELAXED);
+	out->aeState = __atomic_load_n(&S->shared.aeState, __ATOMIC_RELAXED);
+	out->afState = __atomic_load_n(&S->shared.afState, __ATOMIC_RELAXED);
+	out->frames = __atomic_load_n(&S->shared.frames, __ATOMIC_RELAXED);
+	// half-manual: the automatic exposure has metered, fix the other value
+	if (S->metering && out->frames >= S->meterUntil && out->iso > 0 && out->expNs > 0) {
+		S->meteredExposure = (double)out->iso * (double)out->expNs;
+		liveExposure(S);
+		restartStream(S);
+	}
+	return 0;
+}
+
+extern "C" void *cam2s_acquire(void *session, void **hardwareBuffer)
+{
+	Session *S = static_cast<Session *>(session);
+	AImage *img = nullptr;
+	if (AImageReader_acquireLatestImage(S->preview.reader, &img) != AMEDIA_OK || !img)
+		return nullptr;
+	AHardwareBuffer *b = nullptr;
+	if (AImage_getHardwareBuffer(img, &b) != AMEDIA_OK || !b) {
+		AImage_delete(img);
+		return nullptr;
+	}
+	*hardwareBuffer = b;
+	return img;
+}
+
+extern "C" void cam2s_release(void *, void *frame)
+{
+	if (frame)
+		AImage_delete(static_cast<AImage *>(frame));
+}
+
+extern "C" int cam2s_still(void *session, const Cam2Settings *s, cam2_jpeg_cb onJpeg, cam2_raw_cb onRaw, void *ctx)
+{
+	Session *S = static_cast<Session *>(session);
+	if (S->cfg.video || !S->jpeg.reader)
+		return -1;
+	const int flash = S->flashAvail && !(S->liveIso > 0 && S->liveExp > 0) ? s->flash : (s->flash == 2 ? 2 : 0);
+	// automatic exposure with flash: precapture metering (pre-flash) first
+	if (flash && !(S->liveIso > 0 && S->liveExp > 0)) {
+		ACaptureRequest *r = streamRequest(S, false);
+		const uint8_t start = 1;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AE_PRECAPTURE_TRIGGER, 1, &start);
+		ACameraCaptureSession_capture(S->session, &S->cb, 1, &r, nullptr);
+		ACaptureRequest_free(r);
+		bool seen = false;
+		for (int t = 0; t < 150; t++) {
+			usleep(10000);
+			const int ae = __atomic_load_n(&S->shared.aeState, __ATOMIC_RELAXED);
+			if (ae == 5)
+				seen = true;
+			else if ((seen || t > 50) && (ae == 2 || ae == 3 || ae == 4))
+				break;
+		}
+	}
+	if (ACameraMetadata *old = __atomic_exchange_n(&S->shared.stillResult, nullptr, __ATOMIC_ACQ_REL))
+		ACameraMetadata_free(old);
+	ACaptureRequest *shot = nullptr;
+	ACameraDevice_createCaptureRequest(S->dev, TEMPLATE_STILL_CAPTURE, &shot);
+	ACaptureRequest_addTarget(shot, S->preview.target);
+	ACaptureRequest_addTarget(shot, S->jpeg.target);
+	const bool raw = s->raw && S->raw.reader;
+	if (raw)
+		ACaptureRequest_addTarget(shot, S->raw.target);
+	Cam2Settings c = S->ctl;
+	c.flash = s->flash;
+	controls(shot, &c, S->liveIso, S->liveExp, S->hasCrop ? S->crop : nullptr, flash, true, S->active);
+	const uint8_t q = (uint8_t)(s->quality > 0 && s->quality <= 100 ? s->quality : 95);
+	const int32_t o = s->orientation;
+	ACaptureRequest_setEntry_u8(shot, ACAMERA_JPEG_QUALITY, 1, &q);
+	ACaptureRequest_setEntry_i32(shot, ACAMERA_JPEG_ORIENTATION, 1, &o);
+	gpsEntries(shot, s);
+	ACaptureRequest_setUserContext(shot, &S->shared.stillResults);
+	const int count = s->count > 1 ? (s->count > 30 ? 30 : s->count) : 1;
+	ACaptureRequest *shots[30];
+	for (int i = 0; i < count; i++)
+		shots[i] = shot;
+	int ret = -2;
+	if (ACameraCaptureSession_capture(S->session, &S->cb, count, shots, nullptr) == ACAMERA_OK) {
+		const long long perShot = (S->liveExp > 0 ? S->liveExp : 100000000LL) / 1000000 + 400;
+		ret = collectShots(nullptr, S->jpeg.reader, raw ? S->raw.reader : nullptr, S->shared, S->ch, count,
+				   3000 + perShot * count, onJpeg, onRaw, ctx);
+	}
+	ACaptureRequest_free(shot);
+	return ret;
+}
+
+extern "C" int cam2s_record_start(void *session, int fd, int orientation, int sampleRate, int channels)
+{
+	Session *S = static_cast<Session *>(session);
+	if (!S->cfg.video || S->recording)
+		return -1;
+	if (!S->venc)
+		S->venc = newVideoEncoder(S->cfg, S->encSurface);
+	if (!S->venc || AMediaCodec_start(S->venc) != AMEDIA_OK)
+		return -2;
+	if (sampleRate > 0 && channels > 0) {
+		S->sampleRate = sampleRate;
+		S->channels = channels;
+		S->aenc = AMediaCodec_createEncoderByType("audio/mp4a-latm");
+		AMediaFormat *f = AMediaFormat_new();
+		AMediaFormat_setString(f, "mime", "audio/mp4a-latm");
+		AMediaFormat_setInt32(f, "sample-rate", sampleRate);
+		AMediaFormat_setInt32(f, "channel-count", channels);
+		AMediaFormat_setInt32(f, "bitrate", 128000);
+		AMediaFormat_setInt32(f, "aac-profile", 2);
+		AMediaFormat_setInt32(f, "max-input-size", 16384);
+		if (!S->aenc || AMediaCodec_configure(S->aenc, f, nullptr, nullptr, AMEDIACODEC_CONFIGURE_FLAG_ENCODE) ||
+		    AMediaCodec_start(S->aenc)) {
+			if (S->aenc)
+				AMediaCodec_delete(S->aenc);
+			S->aenc = nullptr; // video without sound rather than no video
+		}
+		AMediaFormat_delete(f);
+	}
+	S->mux = AMediaMuxer_new(fd, 0); // MPEG-4
+	AMediaMuxer_setOrientationHint(S->mux, orientation);
+	S->vtrack = S->atrack = -1;
+	S->muxStarted = S->veos = false;
+	S->aeos = !S->aenc;
+	S->recording = S->encoding = true;
+	S->stopping = false;
+	return restartStream(S) == ACAMERA_OK ? 0 : -3;
+}
+
+extern "C" int cam2s_record_audio(void *session, const void *pcm, int bytes, long long ptsUs)
+{
+	Session *S = static_cast<Session *>(session);
+	if (!S->aenc || S->stopping)
+		return -1;
+	const uint8_t *p = static_cast<const uint8_t *>(pcm);
+	const int frameBytes = 2 * S->channels; // 16-bit samples
+	while (bytes > 0) {
+		const long i = AMediaCodec_dequeueInputBuffer(S->aenc, 5000);
+		if (i < 0)
+			return -2; // encoder busy: this chunk is dropped
+		size_t cap = 0;
+		uint8_t *b = AMediaCodec_getInputBuffer(S->aenc, i, &cap);
+		const int n = bytes < (int)cap ? bytes : (int)(cap - cap % frameBytes);
+		memcpy(b, p, n);
+		AMediaCodec_queueInputBuffer(S->aenc, i, 0, n, ptsUs, 0);
+		ptsUs += (long long)(n / frameBytes) * 1000000LL / S->sampleRate;
+		p += n;
+		bytes -= n;
+	}
+	return 0;
+}
+
+extern "C" int cam2s_record_pump(void *session)
+{
+	Session *S = static_cast<Session *>(session);
+	if (!S->recording)
+		return 1;
+	drain(S, S->venc, false);
+	if (S->aenc)
+		drain(S, S->aenc, true);
+	if (S->stopping && ((S->veos && S->aeos) || nowUs() > S->stopAt)) {
+		finishRecording(S);
+		return 1;
+	}
+	return 0;
+}
+
+extern "C" int cam2s_record_stop(void *session)
+{
+	Session *S = static_cast<Session *>(session);
+	if (!S->recording || S->stopping)
+		return -1;
+	S->stopping = true;
+	S->stopAt = nowUs() + 3000000;
+	S->encoding = false;
+	restartStream(S); // the preview goes on without the encoder
+	AMediaCodec_signalEndOfInputStream(S->venc);
+	if (S->aenc) {
+		const long i = AMediaCodec_dequeueInputBuffer(S->aenc, 20000);
+		if (i >= 0)
+			AMediaCodec_queueInputBuffer(S->aenc, i, 0, 0, nowUs(), AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM);
+		else
+			S->aeos = true;
+	}
+	return 0;
+}
