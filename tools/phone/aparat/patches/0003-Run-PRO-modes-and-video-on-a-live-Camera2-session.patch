+void HybrisCamera::updateCam2()
+{
+	const CameraManager::CamMode mode = m_cameraManager->camMode();
+	const bool available = m_cam2.value("available").toBool();
+	const bool manual = available && m_cam2.value("manualSensor").toBool();
+	// every video but hyperlapse and the software encoder goes through Camera2:
+	// MediaRecorder of Camera1 cannot take the microphone here (no audio socket)
+	const bool hyperlapse = m_cameraRecorder->timeLapseFps() > 0;
+	const bool video = mode == CameraManager::VideoMode && !hyperlapse && !m_swEncode &&
+			   (m_proVideoActive ? manual : available);
+	const bool photo = m_proActive && mode == CameraManager::PictureMode && manual;
+	const bool want = (photo || video) && !m_busy && !(m_isRecording && !m_c2s);
+	const QSize size = video ? m_cameraManager->currentVideoSize() : m_cameraManager->currentPictureSize();
+	if (m_c2s && (!want || m_c2Video != video || m_c2Size != size)) {
+		if (m_isRecording || m_busy)
+			return;
+		exitCam2();
+	}
+	if (want && !m_c2s && m_c2Failures < 2 && !enterCam2(video))
+		m_c2Failures++;
+}
+
+bool HybrisCamera::enterCam2(bool video)
+{
+	m_c2 = m_cameraManager->extras().cam2Session();
+	if (!m_c2 || !m_cameraManager->cameraControl())
+		return false;
+	const QSize size = video ? m_cameraManager->currentVideoSize() : m_cameraManager->currentPictureSize();
+	if (size.isEmpty())
+		return false;
+	// the largest preview size of the same shape, at most 1920x1080
+	const double aspect = double(size.width()) / size.height();
+	QSize preview;
+	for (const QSize &p : m_cameraManager->currentCamera().previewSizes)
+		if (p.width() <= 1920 && p.height() <= 1080 && qAbs(double(p.width()) / p.height() - aspect) < 0.02 &&
+		    p.width() * p.height() > preview.width() * preview.height())
+			preview = p;
+	if (preview.isEmpty())
+		preview = QSize(1280, 720);
+
+	Cam2SessionConfig cfg = {};
+	cfg.previewWidth = preview.width();
+	cfg.previewHeight = preview.height();
+	if (video) {
+		cfg.video = 1;
+		cfg.videoWidth = size.width();
+		cfg.videoHeight = size.height();
+		cfg.fps = m_videoFps;
+		cfg.bitrate = m_cameraManager->videoBitRate() * 1000000;
+		cfg.hevc = m_hevc;
+	} else {
+		cfg.stillWidth = size.width();
+		cfg.stillHeight = size.height();
+		cfg.raw = m_cam2.value("raw").toBool();
+	}
+
+	if (m_renderer)
+		m_renderer->detachCamera(); // waits for a frame being drawn
+	m_cameraManager->releaseCamera();
+	m_cameraManager->setCam2Mode(true);
+	int error = 0;
+	m_c2s = m_c2->open(QByteArray::number(m_cameraManager->camId()).constData(), &cfg, &error);
+	if (!m_c2s) {
+		qWarning() << "cam2: live session not opened, error" << error;
+		m_cameraManager->setCam2Mode(false);
+		m_cameraManager->reconnectCamera();
+		return false;
+	}
+	qDebug() << "cam2: live session" << (video ? "video" : "photo") << size << "preview" << preview;
+	m_c2Video = video;
+	m_c2Size = size;
+	m_previewSize = preview;
+	pushCam2();
+	if (m_renderer) {
+		m_renderer->setTextureSize(preview);
+		m_renderer->setCam2Session(m_c2, m_c2s);
+	}
+	m_c2Timer->start();
+	Q_EMIT cam2LiveChanged();
+	return true;
+}
+
+void HybrisCamera::exitCam2()
+{
+	if (!m_c2s)
+		return;
+	if (m_renderer)
+		m_renderer->setCam2Session(nullptr, nullptr); // frees the frame it holds
+	m_c2Timer->stop();
+	m_c2->close(m_c2s);
+	m_c2s = nullptr;
+	for (int &r : m_c2Region)
+		r = 0;
+	m_cameraManager->setCam2Mode(false);
+	m_cameraManager->reconnectCamera();
+	qDebug() << "cam2: back to Camera1";
+	Q_EMIT cam2LiveChanged();
+}
+
+void HybrisCamera::pushCam2()
+{
+	if (!m_c2s)
+		return;
+	// manual values only in the PRO modes; plain video is automatic
+	Cam2Settings s = cam2Settings(m_proActive || m_proVideoActive);
+	s.afTrigger = m_c2Trigger;
+	m_c2Trigger = false;
+	m_c2->controls(m_c2s, &s);
+}
