+// redraws the viewfinder and reads what the sensor uses (automatic values)
+void HybrisCamera::pollCam2()
+{
+	if (!m_c2s)
+		return;
+	if (window())
+		window()->update();
+	static int tick = 0;
+	if (++tick % 6)
+		return;
+	Cam2State st = {};
+	m_c2->state(m_c2s, &st);
+	const int us = int(st.expNs / 1000);
+	if (st.iso != m_liveIso || us != m_liveExposureUs) {
+		m_liveIso = st.iso;
+		m_liveExposureUs = us;
+		Q_EMIT liveStateChanged();
+	}
+}
