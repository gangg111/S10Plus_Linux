+void HybrisCamera::startCam2Recording()
+{
+	if (m_c2Recorder || !m_c2s || !m_c2Video)
+		return;
+	m_recordingFile = m_videoPath + "/VID" + QDateTime::currentDateTime().toString("yyyyMMdd_hhmmsszzz") + ".mp4";
+	m_c2Recorder = new Cam2Recorder;
+	m_c2Recorder->api = m_c2;
+	m_c2Recorder->session = m_c2s;
+	m_c2Recorder->path = m_recordingFile;
+	m_c2RecorderThread = new QThread(this);
+	m_c2Recorder->moveToThread(m_c2RecorderThread);
+	connect(m_c2RecorderThread, &QThread::finished, m_c2Recorder, &QObject::deleteLater);
+	m_c2RecorderThread->start();
+	const int orientation = m_cameraManager->effectiveRotation();
+	const bool mic = m_cameraManager->withMic();
+	Cam2Recorder *rec = m_c2Recorder;
+	QMetaObject::invokeMethod(rec, [this, rec, orientation, mic]() {
+		const bool ok = rec->start(orientation, mic);
+		QMetaObject::invokeMethod(this, [this, ok]() {
+			if (ok) {
+				setRecordingState(true);
+			} else {
+				stopCam2Recording();
+			}
+		}, Qt::QueuedConnection);
+	}, Qt::QueuedConnection);
+}
+
+void HybrisCamera::stopCam2Recording()
+{
+	if (!m_c2Recorder)
+		return;
+	Cam2Recorder *rec = m_c2Recorder;
+	QThread *thread = m_c2RecorderThread;
+	m_c2Recorder = nullptr;
+	m_c2RecorderThread = nullptr;
+	QMetaObject::invokeMethod(rec, [this, rec, thread]() {
+		const bool ok = rec->fd < 0 || rec->stop();
+		qDebug() << "cam2: recording" << rec->path << (ok ? "complete" : "NOT finished cleanly");
+		thread->quit(); // the recorder is deleted when the thread finishes
+		QMetaObject::invokeMethod(this, [this, thread]() {
+			thread->wait();
+			delete thread;
+			setRecordingState(false);
+			scheduleCam2();
+		}, Qt::QueuedConnection);
+	}, Qt::QueuedConnection);
+}
