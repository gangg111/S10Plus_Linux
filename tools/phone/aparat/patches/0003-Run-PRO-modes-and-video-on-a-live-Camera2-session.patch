--- a/src/camera-renderer.cpp
+++ b/src/camera-renderer.cpp
@@ -9,11 +9,61 @@
 #include <camera-renderer.h>
 #include <QThreadPool>
 
+#include <EGL/egl.h>
+
+namespace {
+const unsigned EGL_NATIVE_BUFFER_ANDROID_ = 0x3140;
+const int EGL_IMAGE_PRESERVED_KHR_ = 0x30D2;
+}
+
 CameraRenderer::~CameraRenderer()
 {
 	delete m_prgViewFinder;
 }
 
+void CameraRenderer::setCam2Session(const Cam2Api *api, void *session)
+{
+	QMutexLocker lock(&m_cam2Mutex);
+	dropCam2Frame();
+	m_cam2Api = api;
+	m_cam2Session = session;
+}
+
+// with m_cam2Mutex held
+void CameraRenderer::dropCam2Frame()
+{
+	if (m_cam2Image && m_eglDestroyImage)
+		m_eglDestroyImage(m_eglDisplay, m_cam2Image);
+	m_cam2Image = nullptr;
+	if (m_cam2Frame && m_cam2Api)
+		m_cam2Api->release(m_cam2Session, m_cam2Frame);
+	m_cam2Frame = nullptr;
+}
+
+// newest Camera2 frame into m_textureId (render thread, m_cam2Mutex held);
+// the previous frame stays bound when none is new
+void CameraRenderer::updateCam2Texture()
+{
+	glBindTexture(GL_TEXTURE_EXTERNAL_OES, m_textureId);
+	if (!m_eglCreateImage || !m_glEGLImageTargetTexture)
+		return;
+	void *buffer = nullptr;
+	void *frame = m_cam2Api->acquire(m_cam2Session, &buffer);
+	if (!frame)
+		return;
+	const int attrs[] = { EGL_IMAGE_PRESERVED_KHR_, EGL_TRUE, EGL_NONE };
+	void *image = m_eglCreateImage(m_eglDisplay, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID_,
+				       m_eglGetNativeClientBuffer(buffer), attrs);
+	if (!image) {
+		m_cam2Api->release(m_cam2Session, frame);
+		return;
+	}
+	m_glEGLImageTargetTexture(GL_TEXTURE_EXTERNAL_OES, image);
+	dropCam2Frame();
+	m_cam2Frame = frame;
+	m_cam2Image = image;
+}
