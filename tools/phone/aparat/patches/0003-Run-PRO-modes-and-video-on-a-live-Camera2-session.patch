+// PRO video recording on its own thread: microphone PCM into the session's AAC
+// encoder (stamped with CLOCK_MONOTONIC like the camera frames), encoded data
+// into the MP4. Every recording call of the session comes from this thread.
+class Cam2Recorder : public QObject {
+    public:
+	const Cam2Api *api = nullptr;
+	void *session = nullptr;
+	QString path;
+	int fd = -1;
+	QAudioSource *audio = nullptr;
+	QIODevice *io = nullptr;
+	QTimer *timer = nullptr;
+	long long audioStart = -1, audioFrames = 0;
+	static const int rate = 48000, channels = 2;
+
+	bool start(int orientation, bool mic)
+	{
+		fd = ::open(path.toUtf8().constData(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+		if (fd < 0)
+			return false;
+		const int r = api->recordStart(session, fd, orientation, mic ? rate : 0, channels);
+		if (r != 0) {
+			qWarning() << "cam2: recording did not start, error" << r;
+			::close(fd);
+			fd = -1;
+			return false;
+		}
+		if (mic) {
+			QAudioFormat f;
+			f.setSampleRate(rate);
+			f.setChannelCount(channels);
+			f.setSampleFormat(QAudioFormat::Int16);
+			audio = new QAudioSource(QMediaDevices::defaultAudioInput(), f, this);
+			io = audio->start();
+		}
+		timer = new QTimer(this);
+		timer->setInterval(10);
+		connect(timer, &QTimer::timeout, this, [this]() { tick(); });
+		timer->start();
+		return true;
+	}
+
+	void tick()
+	{
+		if (io) {
+			const QByteArray pcm = io->readAll();
+			const int frames = pcm.size() / (2 * channels);
+			if (frames > 0) {
+				// the first chunk was recorded during the time it spans
+				if (audioStart < 0)
+					audioStart = monotonicUs() - frames * 1000000LL / rate;
+				api->recordAudio(session, pcm.constData(), frames * 2 * channels,
+						 audioStart + audioFrames * 1000000LL / rate);
+				audioFrames += frames;
+			}
+		}
+		api->recordPump(session);
+	}
+
+	// end of stream, the rest of the encoded data, then the MP4 index
+	bool stop()
+	{
+		if (timer)
+			timer->stop();
+		if (audio)
+			audio->stop();
+		tick();
+		api->recordStop(session);
+		bool done = false;
+		for (int i = 0; i < 400 && !done; i++) {
+			done = api->recordPump(session) == 1;
+			if (!done)
+				QThread::msleep(10);
+		}
+		::close(fd);
+		fd = -1;
+		return done;
+	}
+};
