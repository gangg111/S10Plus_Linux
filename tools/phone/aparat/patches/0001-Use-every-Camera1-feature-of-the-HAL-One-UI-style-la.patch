index 0000000..88f49b2
--- /dev/null
+++ b/src/camera-extras.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Camera1 parameters that the libhybris camera compatibility layer does not
+ * expose (exposure compensation, AE/AWB lock, antibanding, face detection and
+ * the full capability list). They go through libcamx.so, a small bionic-side
+ * library loaded with android_dlopen, which works on the compatibility layer's
+ * own CameraControl object after verifying its layout at runtime.
+ */
+
+#pragma once
+
+#include <QMap>
+#include <QRect>
+#include <QSize>
+#include <QString>
+#include <QStringList>
+#include <QList>
+
+struct CameraControl;
+struct CameraControlListener;
+
+struct CameraFace {
+	QRect rect; // sensor coordinates, -1000..1000
+	int score;
+	int id;
+};
+
+class CameraExtras {
+    public:
+	CameraExtras();
+
+	// false when libcamx is missing or the CameraControl layout does not match;
+	// every other call is then a no-op returning an error
+	bool attach(CameraControl *cc, CameraControlListener *listener);
+	void detach();
+	bool available() const
+	{
+		return m_cc != nullptr;
+	}
+
+	// full HAL parameter set of the attached camera, re-read from the camera
+	QMap<QString, QString> parameters();
+
+	// 0 when the HAL accepted the value
+	int set(const QString &key, const QString &value);
+	QString get(const QString &key);
+	int command(int cmd, int arg1, int arg2);
+
+	bool startFaceDetection();
+	void stopFaceDetection();
+	QList<CameraFace> faces(unsigned *generation = nullptr);
+
+	static QStringList splitValues(const QString &values);
+	static QList<QSize> splitSizes(const QString &values);
+
+    private:
+	typedef int (*check_t)(void *, void *);
+	typedef int (*set_t)(void *, const char *, const char *);
+	typedef int (*get_t)(void *, const char *, char *, int);
+	typedef int (*dump_t)(void *, char *, int);
+	typedef int (*command_t)(void *, int, int, int);
+	typedef int (*listen_t)(void *);
+	typedef int (*faces_t)(int *, int, unsigned *);
+
+	bool load();
+
+	void *m_lib = nullptr;
+	bool m_loadTried = false;
+	check_t m_check = nullptr;
+	set_t m_set = nullptr;
+	get_t m_get = nullptr;
+	dump_t m_dump = nullptr;
+	command_t m_command = nullptr;
+	listen_t m_listen = nullptr;
+	faces_t m_faces = nullptr;
+
+	CameraControl *m_cc = nullptr;
+	bool m_listening = false;
+};
