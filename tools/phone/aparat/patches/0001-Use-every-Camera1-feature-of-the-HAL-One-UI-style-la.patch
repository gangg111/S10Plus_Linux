index 0000000..d3484a0
--- /dev/null
+++ b/src/camx/camx.cpp
@@ -0,0 +1,355 @@
+// camx: parametry aparatu, ktorych nie ma w warstwie zgodnosci libhybris
+// (android_camera_*): korekta ekspozycji, blokady AE/AWB, przeciwmigotanie,
+// wykrywanie twarzy i dowolny klucz Camera1.
+//
+// Biblioteka po stronie ANDROIDA (bionic), ladowana z aplikacji przez hybris
+// (android_dlopen). Dziala na obiekcie CameraControl warstwy zgodnosci
+// (libhybris hybris/include/hybris/internal/camera_control.h):
+//   struct CameraControl : CameraListener, GLConsumer::FrameAvailableListener {
+//       android::Mutex guard;                    // +16 (po dwoch vptr), bionic 40 B
+//       CameraControlListener* listener;         // +56
+//       android::sp<android::Camera> camera;     // +64
+//       android::CameraParameters camera_parameters; // +72
+//   ...
+// Przesuniecia sa sprawdzane w dzialajacym procesie (camx_check): pole listener
+// musi byc wskaznikiem przekazanym przez aplikacje, a parametry musza zwracac
+// picture-size. Bez zgodnosci zadna inna funkcja nic nie robi.
+//
+// Twarze: Camera1 oddaje je w postData(CAMERA_MSG_PREVIEW_METADATA), a warstwa
+// zgodnosci je gubi. camx wstawia posrednika CameraListener, ktory przekazuje
+// wszystko oryginalnemu CameraControl, a twarze kopiuje pod blokada do bufora;
+// aplikacja odczytuje je sama (camx_faces), bez wywolan zwrotnych do glibc
+// z watkow Bindera.
+//
+// Budowa (na telefonie): sh buduj.sh
+
+extern "C" {
+typedef long ssize_t;
+typedef unsigned long size_t;
+int pthread_mutex_lock(void *);
+int pthread_mutex_unlock(void *);
+void *memcpy(void *, const void *, size_t);
+size_t strlen(const char *);
+void *malloc(size_t);
+void free(void *);
+}
+
+typedef long nsecs_t;
+typedef int int32_t;
+typedef unsigned int uint32_t;
+
+// system/camera.h
+struct camera_face_t {
+	int32_t rect[4];
+	int32_t score;
+	int32_t id;
+	int32_t left_eye[2];
+	int32_t right_eye[2];
+	int32_t mouth[2];
+};
+struct camera_frame_metadata_t {
+	int32_t number_of_faces;
+	camera_face_t *faces;
+};
+struct native_handle_t;
+
+namespace android {
+// libutils RefBase.h (Android 11): uklad i kolejnosc wirtualnych musza sie zgadzac
+class RefBase {
+    public:
+	void incStrong(const void *id) const;
+	void decStrong(const void *id) const;
+
+    protected:
+	RefBase();
+	virtual ~RefBase();
+	virtual void onFirstRef();
+	virtual void onLastStrongRef(const void *id);
+	virtual bool onIncStrongAttempted(uint32_t flags, const void *id);
+	virtual void onLastWeakRef(const void *id);
+
+    private:
+	void *const mRefs;
+};
+
+template <typename T> class sp {
+    public:
+	sp(T *p)
+		: m_ptr(p)
+	{
+		if (p)
+			p->incStrong(this);
+	}
+	~sp()
+	{
+		if (m_ptr)
+			m_ptr->decStrong(this);
+	}
+	T *m_ptr;
+};
+
+class IMemory;
+struct NsecsVector; // std::vector<nsecs_t>, tylko przekazywany dalej przez referencje
+struct HandleVector; // std::vector<native_handle_t*>
+
+// frameworks/av/camera/include/camera/Camera.h (Android 11)
+class CameraListener : virtual public RefBase {
+    public:
+	virtual void notify(int32_t msgType, int32_t ext1, int32_t ext2) = 0;
+	virtual void postData(int32_t msgType, const sp<IMemory> &dataPtr,
+			      camera_frame_metadata_t *metadata) = 0;
+	virtual void postDataTimestamp(nsecs_t timestamp, int32_t msgType,
+				       const sp<IMemory> &dataPtr) = 0;
+	virtual void postRecordingFrameHandleTimestamp(nsecs_t timestamp,
+						       native_handle_t *handle) = 0;
+	virtual void postRecordingFrameHandleTimestampBatch(const NsecsVector &timestamps,
+							    const HandleVector &handles) = 0;
+};
+
+class String8 {
+    public:
+	String8(const char *s);
+	~String8();
+	const char *mString;
+};
+
+class CameraParameters {
+    public:
+	void set(const char *key, const char *value);
+	const char *get(const char *key) const;
+	String8 flatten() const;
+	void unflatten(const String8 &params);
+};
+
+class Camera {
+    public:
+	int setParameters(const String8 &params);
+	String8 getParameters() const;
+	int sendCommand(int cmd, int arg1, int arg2);
+	void setListener(const sp<CameraListener> &listener);
+};
+} // namespace android
+
+namespace {
+const int32_t CAMERA_MSG_PREVIEW_METADATA = 0x0400;
+const int MAX_TWARZY = 16;
+
+// bufor twarzy: pisze watek Bindera, czyta aplikacja przez camx_faces
+struct {
+	int mutex[10]; // bionic pthread_mutex_t (LP64: 40 B), zera = PTHREAD_MUTEX_INITIALIZER
+	int liczba;
+	unsigned pokolenie;
+	camera_face_t twarze[MAX_TWARZY];
+} bufor;
+
+// Posrednik: wszystko idzie do oryginalnego CameraControl (jego baza CameraListener
+// lezy na poczatku obiektu), twarze dodatkowo do bufora.
+class Posrednik : public android::CameraListener {
+    public:
+	explicit Posrednik(android::CameraListener *oryginal)
+		: m_oryginal(oryginal)
+	{
+		// Camera trzymala silna referencje do CameraControl; po podmianie trzymamy ja my
+		m_oryginal->incStrong(this);
+	}
+	~Posrednik() override
+	{
+		m_oryginal->decStrong(this);
+	}
+	void notify(int32_t t, int32_t a, int32_t b) override
+	{
+		m_oryginal->notify(t, a, b);
+	}
+	void postData(int32_t t, const android::sp<android::IMemory> &d,
+		      camera_frame_metadata_t *m) override
+	{
+		if ((t & CAMERA_MSG_PREVIEW_METADATA) && m) {
+			pthread_mutex_lock(bufor.mutex);
+			int n = m->number_of_faces;
+			if (n < 0)
+				n = 0;
+			if (n > MAX_TWARZY)
+				n = MAX_TWARZY;
+			if (n && m->faces)
+				memcpy(bufor.twarze, m->faces, n * sizeof(camera_face_t));
+			bufor.liczba = n;
+			bufor.pokolenie++;
+			pthread_mutex_unlock(bufor.mutex);
+			if (t == CAMERA_MSG_PREVIEW_METADATA)
+				return; // warstwa zgodnosci i tak tego nie obsluguje
+		}
+		m_oryginal->postData(t, d, m);
+	}
+	void postDataTimestamp(nsecs_t ts, int32_t t, const android::sp<android::IMemory> &d) override
+	{
+		m_oryginal->postDataTimestamp(ts, t, d);
+	}
+	void postRecordingFrameHandleTimestamp(nsecs_t ts, native_handle_t *h) override
+	{
+		m_oryginal->postRecordingFrameHandleTimestamp(ts, h);
+	}
+	void postRecordingFrameHandleTimestampBatch(const android::NsecsVector &ts,
+						    const android::HandleVector &h) override
+	{
+		m_oryginal->postRecordingFrameHandleTimestampBatch(ts, h);
+	}
+
+    private:
+	android::CameraListener *m_oryginal;
+};
+} // namespace
+
+namespace {
+const long OFF_GUARD = 16;
+const long OFF_LISTENER = 56;
+const long OFF_CAMERA = 64;
+const long OFF_PARAMS = 72;
+
+void *pole(void *cc, long off)
+{
+	return static_cast<char *>(cc) + off;
+}
+android::Camera *kamera(void *cc)
+{
+	return *static_cast<android::Camera **>(pole(cc, OFF_CAMERA));
+}
+android::CameraParameters *parametry(void *cc)
+{
+	return static_cast<android::CameraParameters *>(pole(cc, OFF_PARAMS));
+}
+
+// ostatnio sprawdzony CameraControl (0 = nie sprawdzono albo niezgodny)
+void *zgodny = nullptr;
+
+void kopiuj(char *dst, int len, const char *src)
+{
+	if (!dst || len <= 0)
+		return;
+	int n = src ? (int)strlen(src) : 0;
+	if (n > len - 1)
+		n = len - 1;
+	if (n > 0)
+		memcpy(dst, src, n);
+	dst[n] = 0;
+}
+
+// Zapisuje parametry kamery i przy odrzuceniu przez HAL wraca do stanu kamery
+// (tak samo jak setParameters_resilient w warstwie zgodnosci).
+int zapisz(void *cc)
+{
+	android::String8 plaski = parametry(cc)->flatten();
+	int err = kamera(cc)->setParameters(plaski);
+	if (err != 0) {
+		android::String8 biezace = kamera(cc)->getParameters();
+		parametry(cc)->unflatten(biezace);
+	}
+	return err;
+}
+} // namespace
+
+extern "C" {
+
+// 1 = uklad zgodny i mozna uzywac pozostalych funkcji
+int camx_check(void *cc, void *listener)
+{
+	zgodny = nullptr;
+	if (!cc || !listener)
+		return 0;
+	if (*static_cast<void **>(pole(cc, OFF_LISTENER)) != listener)
+		return 0;
+	if (!kamera(cc))
+		return 0;
+	pthread_mutex_lock(pole(cc, OFF_GUARD));
+	const char *ps = parametry(cc)->get("picture-size");
+	bool ok = ps && ps[0] >= '1' && ps[0] <= '9';
+	pthread_mutex_unlock(pole(cc, OFF_GUARD));
+	if (ok)
+		zgodny = cc;
+	return ok ? 1 : 0;
+}
+
+// Ustawia klucz Camera1. 0 = HAL przyjal, <0 = blad (stan wrocil do kamery),
+// -1000 = CameraControl nie przeszedl camx_check.
+int camx_set(void *cc, const char *key, const char *value)
+{
+	if (!cc || cc != zgodny || !key || !value)
+		return -1000;
+	pthread_mutex_lock(pole(cc, OFF_GUARD));
+	parametry(cc)->set(key, value);
+	int err = zapisz(cc);
+	pthread_mutex_unlock(pole(cc, OFF_GUARD));
+	return err;
+}
+
+// Biezaca wartosc klucza z kamery (nie z kopii): pusta, gdy brak klucza.
+int camx_get(void *cc, const char *key, char *out, int len)
+{
+	if (!cc || cc != zgodny || !key)
+		return -1000;
+	pthread_mutex_lock(pole(cc, OFF_GUARD));
+	android::String8 biezace = kamera(cc)->getParameters();
+	parametry(cc)->unflatten(biezace);
+	kopiuj(out, len, parametry(cc)->get(key));
+	pthread_mutex_unlock(pole(cc, OFF_GUARD));
+	return 0;
+}
+
+// Pelny zrzut parametrow kamery ("k=v;k=v;...").
+int camx_dump(void *cc, char *out, int len)
+{
+	if (!cc || cc != zgodny)
+		return -1000;
+	pthread_mutex_lock(pole(cc, OFF_GUARD));
+	android::String8 biezace = kamera(cc)->getParameters();
+	kopiuj(out, len, biezace.mString);
+	pthread_mutex_unlock(pole(cc, OFF_GUARD));
+	return 0;
+}
+
+// Camera::sendCommand (np. CAMERA_CMD_START_FACE_DETECTION = 6, STOP = 7)
+int camx_command(void *cc, int cmd, int arg1, int arg2)
+{
+	if (!cc || cc != zgodny)
+		return -1000;
+	return kamera(cc)->sendCommand(cmd, arg1, arg2);
+}
+
+// Wstawia posrednika zdarzen (raz na polaczenie z kamera), zeby dostawac twarze.
+// CameraControl jest glowna baza CameraListener, wiec lezy pod adresem cc.
+int camx_listen(void *cc)
+{
+	if (!cc || cc != zgodny)
+		return -1000;
+	pthread_mutex_lock(bufor.mutex);
+	bufor.liczba = 0;
+	pthread_mutex_unlock(bufor.mutex);
+	android::sp<android::CameraListener> p(
+		new Posrednik(static_cast<android::CameraListener *>(cc)));
+	kamera(cc)->setListener(p);
+	return 0;
+}
+
+// Twarze z ostatniej klatki metadanych: do max wpisow po 6 intow
+// (left, top, right, bottom w ukladzie -1000..1000, score 1..100, id).
+// Zwraca liczbe twarzy; *pokolenie rosnie z kazda paczka metadanych.
+int camx_faces(int *out, int max, unsigned *pokolenie)
+{
+	pthread_mutex_lock(bufor.mutex);
+	int n = bufor.liczba < max ? bufor.liczba : max;
+	for (int i = 0; i < n; i++) {
+		int *o = out + i * 6;
+		const camera_face_t &f = bufor.twarze[i];
+		o[0] = f.rect[0];
+		o[1] = f.rect[1];
+		o[2] = f.rect[2];
+		o[3] = f.rect[3];
+		o[4] = f.score;
+		o[5] = f.id;
+	}
+	if (pokolenie)
+		*pokolenie = bufor.pokolenie;
+	pthread_mutex_unlock(bufor.mutex);
+	return n;
+}
+
+} // extern "C"
