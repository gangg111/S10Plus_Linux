+
+// Sensor size and field of view of every camera label the lens picker and set
+// the zoom factors (.5x for the ultra wide). They are cached after a camera is
+// opened once; cameras never opened are probed here, one time only.
+void CameraManager::probeUncachedCameras()
+{
+	for (const CameraDevice &dev : m_cameras) {
+		const QString group = QString("Camera%1/").arg(dev.camId);
+		if (m_settings.contains(group + "megapixels") && m_settings.contains(group + "fov"))
+			continue;
+		CameraControl *cc = android_camera_connect_by_id(dev.camId, m_listener);
+		if (!cc)
+			continue;
+		CameraDevice probe{ dev.camId };
+		android_camera_enumerate_supported_picture_sizes(cc, setPicSize_cb, &probe);
+		qint64 maxArea = 0;
+		for (const QSize &s : probe.pictureSizes)
+			maxArea = qMax(maxArea, qint64(s.width()) * s.height());
+		if (maxArea > 0)
+			m_settings.setValue(group + "megapixels", maxArea / 1e6);
+		CameraExtras extras;
+		if (extras.attach(cc, m_listener)) {
+			const double fov = extras.parameters().value("horizontal-view-angle").toDouble();
+			if (fov > 0)
+				m_settings.setValue(group + "fov", fov);
+			extras.detach();
+		}
+		android_camera_unlock(cc);
+		android_camera_disconnect(cc);
+		android_camera_delete(cc);
+		qDebug() << "Probed camera" << dev.camId << "MP" << maxArea / 1e6;
+	}
 }
 
