diff --git a/src/camera-extras.cpp b/src/camera-extras.cpp
new file mode 100644
index 0000000..4728a1c
--- /dev/null
+++ b/src/camera-extras.cpp
@@ -0,0 +1,187 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <QCoreApplication>
+#include <QDebug>
+#include <QFile>
+
+#include <dlfcn.h>
+
+#include <camera-extras.h>
+
+extern "C" {
+void *android_dlopen(const char *filename, int flag);
+void *android_dlsym(void *handle, const char *symbol);
+}
+
+namespace {
+const int CAMERA_CMD_START_FACE_DETECTION = 6;
+const int CAMERA_CMD_STOP_FACE_DETECTION = 7;
+const int CAMERA_FACE_DETECTION_HW = 0;
+const int MAX_FACES = 16;
+const int DUMP_SIZE = 64 * 1024;
+} // namespace
+
+CameraExtras::CameraExtras()
+{
+}
+
+bool CameraExtras::load()
+{
+	if (m_loadTried)
+		return m_lib != nullptr;
+	m_loadTried = true;
+
+	QStringList candidates;
+	const QString env = qEnvironmentVariable("DROIDIAN_CAMERA_CAMX");
+	if (!env.isEmpty())
+		candidates << env;
+	candidates << QCoreApplication::applicationDirPath() +
+			      "/../lib/droidian-camera/libcamx.so"
+		   << "/usr/lib/droidian-camera/libcamx.so";
+
+	for (const QString &path : candidates) {
+		if (!QFile::exists(path))
+			continue;
+		m_lib = android_dlopen(path.toUtf8().constData(), RTLD_NOW);
+		if (m_lib) {
+			qDebug() << "camx loaded from" << path;
+			break;
+		}
+		qWarning() << "camx: android_dlopen failed for" << path;
+	}
+	if (!m_lib) {
+		qWarning() << "camx not found, advanced camera controls disabled";
+		return false;
+	}
+
+	m_check = reinterpret_cast<check_t>(android_dlsym(m_lib, "camx_check"));
+	m_set = reinterpret_cast<set_t>(android_dlsym(m_lib, "camx_set"));
+	m_get = reinterpret_cast<get_t>(android_dlsym(m_lib, "camx_get"));
+	m_dump = reinterpret_cast<dump_t>(android_dlsym(m_lib, "camx_dump"));
+	m_command = reinterpret_cast<command_t>(android_dlsym(m_lib, "camx_command"));
+	m_listen = reinterpret_cast<listen_t>(android_dlsym(m_lib, "camx_listen"));
+	m_faces = reinterpret_cast<faces_t>(android_dlsym(m_lib, "camx_faces"));
+
+	if (!m_check || !m_set || !m_get || !m_dump || !m_command || !m_listen || !m_faces) {
+		qWarning() << "camx: missing symbols, advanced camera controls disabled";
+		m_lib = nullptr;
+		return false;
+	}
+	return true;
+}
+
+bool CameraExtras::attach(CameraControl *cc, CameraControlListener *listener)
+{
+	detach();
+	if (!cc || !load())
+		return false;
+	if (m_check(cc, listener) != 1) {
+		qWarning() << "camx: CameraControl layout mismatch, advanced camera controls disabled";
+		return false;
+	}
+	m_cc = cc;
+	return true;
+}
+
+void CameraExtras::detach()
+{
+	m_cc = nullptr;
+	m_listening = false;
+}
+
+QMap<QString, QString> CameraExtras::parameters()
+{
+	QMap<QString, QString> map;
+	if (!m_cc)
+		return map;
+	QByteArray buf(DUMP_SIZE, '\0');
+	if (m_dump(m_cc, buf.data(), buf.size()) != 0)
+		return map;
+	const QString flat = QString::fromUtf8(buf.constData());
+	for (const QString &pair : flat.split(';', Qt::SkipEmptyParts)) {
+		const int eq = pair.indexOf('=');
+		if (eq > 0)
+			map.insert(pair.left(eq), pair.mid(eq + 1));
+	}
+	return map;
+}
+
+int CameraExtras::set(const QString &key, const QString &value)
+{
+	if (!m_cc)
+		return -1000;
+	const int err = m_set(m_cc, key.toUtf8().constData(), value.toUtf8().constData());
+	if (err != 0)
+		qWarning() << "camx: HAL rejected" << key << "=" << value << "error" << err;
+	return err;
+}
+
+QString CameraExtras::get(const QString &key)
+{
+	if (!m_cc)
+		return QString();
+	char buf[1024];
+	if (m_get(m_cc, key.toUtf8().constData(), buf, sizeof(buf)) != 0)
+		return QString();
+	return QString::fromUtf8(buf);
+}
+
+int CameraExtras::command(int cmd, int arg1, int arg2)
+{
+	if (!m_cc)
+		return -1000;
+	return m_command(m_cc, cmd, arg1, arg2);
+}
+
+bool CameraExtras::startFaceDetection()
+{
+	if (!m_cc)
+		return false;
+	// the proxy listener is installed once per connection; Camera1 delivers
+	// faces only through postData, which the compatibility layer drops
+	if (!m_listening) {
+		if (m_listen(m_cc) != 0)
+			return false;
+		m_listening = true;
+	}
+	const int err = command(CAMERA_CMD_START_FACE_DETECTION, CAMERA_FACE_DETECTION_HW, 0);
+	if (err != 0)
+		qWarning() << "camx: face detection not started, error" << err;
+	return err == 0;
+}
+
+void CameraExtras::stopFaceDetection()
+{
+	if (m_cc)
+		command(CAMERA_CMD_STOP_FACE_DETECTION, 0, 0);
+}
+
+QList<CameraFace> CameraExtras::faces(unsigned *generation)
+{
+	QList<CameraFace> list;
+	if (!m_lib || !m_cc)
+		return list;
+	int raw[MAX_FACES * 6];
+	const int n = m_faces(raw, MAX_FACES, generation);
+	for (int i = 0; i < n; ++i) {
+		const int *f = raw + i * 6;
+		list.append({ QRect(QPoint(f[0], f[1]), QPoint(f[2], f[3])), f[4], f[5] });
+	}
+	return list;
+}
+
+QStringList CameraExtras::splitValues(const QString &values)
+{
+	return values.split(',', Qt::SkipEmptyParts);
+}
+
+QList<QSize> CameraExtras::splitSizes(const QString &values)
+{
+	QList<QSize> sizes;
+	for (const QString &s : splitValues(values)) {
+		const QStringList wh = s.split('x');
+		if (wh.size() == 2)
+			sizes.append(QSize(wh[0].toInt(), wh[1].toInt()));
+	}
+	return sizes;
+}
