+// User choices (white balance, HDR, focus mode, EV, locks, ...) are stored per
+// camera and applied again after reconnecting and after mode switches, which
+// reset focus and flash.
+void CameraManager::reapplySavedParameters()
+{
+	if (!m_extras.available())
+		return;
+	m_settings.beginGroup(savedParameterGroup());
+	const QStringList keys = m_settings.childKeys();
+	QMap<QString, QString> saved;
+	for (const QString &k : keys)
+		saved.insert(k, m_settings.value(k).toString());
+	m_settings.endGroup();
+
+	for (auto it = saved.cbegin(); it != saved.cend(); ++it)
+		m_extras.set(it.key(), it.value());
+	if (!saved.isEmpty()) {
+		m_params = m_extras.parameters();
+		Q_EMIT parametersChanged();
+	}
+}
