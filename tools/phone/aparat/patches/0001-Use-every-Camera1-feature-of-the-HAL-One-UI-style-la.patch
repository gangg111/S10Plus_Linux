+# libcamx.so: bionic-side helper for the Camera1 parameters the libhybris
+# compatibility layer lacks (see src/camx/camx.cpp). Built with clang for the
+# Android target against the device's own system libraries.
+set(ANDROID_SYSTEM_LIBS "/android/system/lib64" CACHE PATH "Android system libraries to link libcamx against")
+set(ANDROID_LIBC "/apex/com.android.runtime/lib64/bionic/libc.so" CACHE FILEPATH "Android libc to link libcamx against")
+find_program(CAMX_CXX NAMES clang++ clang++-21)
+find_program(CAMX_LLD NAMES ld.lld ld.lld-21)
+if (CAMX_CXX AND CAMX_LLD AND EXISTS ${ANDROID_SYSTEM_LIBS}/libcamera_client.so)
+	set(CAMX_SO ${CMAKE_BINARY_DIR}/libcamx.so)
+	add_custom_command(OUTPUT ${CAMX_SO}
+		COMMAND ${CAMX_CXX} --target=aarch64-linux-android30 -O2 -fPIC -shared -nostdlib
+			-fno-exceptions -fno-rtti -fno-stack-protector -fuse-ld=${CAMX_LLD}
+			-Wl,-soname,libcamx.so -Wl,--hash-style=both -Wl,-z,defs
+			-o ${CAMX_SO} ${CMAKE_SOURCE_DIR}/src/camx/camx.cpp
+			${ANDROID_SYSTEM_LIBS}/libcamera_client.so ${ANDROID_SYSTEM_LIBS}/libutils.so
+			${ANDROID_SYSTEM_LIBS}/libc++.so ${ANDROID_LIBC}
+		DEPENDS ${CMAKE_SOURCE_DIR}/src/camx/camx.cpp
+		COMMENT "Building libcamx.so for the Android side")
+	add_custom_target(camx ALL DEPENDS ${CAMX_SO})
+	install(FILES ${CAMX_SO} DESTINATION /usr/lib/droidian-camera)
+else()
+	message(WARNING "libcamx.so not built (needs clang, lld and ${ANDROID_SYSTEM_LIBS}); advanced camera controls will be unavailable")
+endif()
+
 install(TARGETS ${PROJECT_NAME} DESTINATION /usr/bin)
 install(FILES ${CMAKE_SOURCE_DIR}/droidian-camera.desktop DESTINATION /usr/share/applications)
