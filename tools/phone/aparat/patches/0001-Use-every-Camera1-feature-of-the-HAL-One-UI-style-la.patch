+                width: 2
+                height: major ? 24 : 16
+                color: Qt.rgba(1, 1, 1, major ? 0.9 : 0.45)
+            }
+        }
+        Rectangle {
+            x: slider.xFor(zoom.currentFactor) - 1
+            y: 8
+            width: 3
+            height: 34
+            radius: 1
+            color: zoom.accent
+        }
+        Text {
+            anchors.bottom: parent.top
+            anchors.bottomMargin: 8
+            x: slider.xFor(zoom.currentFactor) - width / 2
+            text: zoom.label(zoom.currentFactor) + " ×"
+            color: zoom.accent
+            font.pixelSize: 22
+            font.bold: true
+        }
+        Rectangle {
+            anchors.right: parent.right
+            anchors.rightMargin: 8
+            anchors.verticalCenter: parent.verticalCenter
+            width: 34
+            height: 34
+            radius: 17
+            color: Qt.rgba(1, 1, 1, 0.15)
+            Text {
+                anchors.centerIn: parent
+                text: ""
+                font.family: mdiFont.name
+                font.pixelSize: 20
+                color: "white"
+            }
+            MouseArea {
+                anchors.fill: parent
+                onClicked: zoom.sliderOpen = false
+            }
+        }
+        MouseArea {
+            anchors.fill: parent
+            anchors.rightMargin: 50
+            onPressed: mouse => zoom.setFactor(slider.factorAt(mouse.x))
+            onPositionChanged: mouse => zoom.setFactor(slider.factorAt(mouse.x))
+        }
+
+        // labels under the scale
+        Item {
+            anchors.top: parent.bottom
+            anchors.topMargin: 8
+            width: parent.width
+            height: 20
+            Repeater {
+                model: [zoom.minFactor, 1, 2, 4, zoom.maxLimit].filter((f, i, a) => f <= zoom.maxLimit && a.indexOf(f) === i)
+                delegate: Text {
+                    required property real modelData
+                    x: slider.xFor(modelData) - width / 2
+                    text: zoom.label(modelData)
+                    color: "white"
+                    font.pixelSize: 15
+                }
+            }
+        }
+    }
+}
