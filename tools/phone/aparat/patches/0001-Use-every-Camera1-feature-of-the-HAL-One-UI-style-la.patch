+                    anchors.centerIn: parent
+                    text: ""
+                    font.family: mdiFont.name
+                    font.pixelSize: 30
+                    color: "white"
+                }
+                MouseArea {
+                    anchors.fill: parent
+                    onClicked: {
+                        root.lastLens[root.frontSide ? "front" : "back"] = camera.camId
+                        const other = camera.lenses.filter(l => l.front !== root.frontSide)
+                        if (other.length === 0)
+                            return
+                        const remembered = root.lastLens[root.frontSide ? "back" : "front"]
+                        camera.camId = other.some(l => l.id === remembered) ? remembered
+                                     : other.reduce((a, b) => a.id < b.id ? a : b).id
+                    }
+                }
             }
-            AnchorChanges {
-                target: sideControl_B
-                anchors.left: root.left
-                anchors.bottom: root.bottom
+        }
+
+        // mode tabs
+        Row {
+            visible: !camera.isRecording
+            anchors.horizontalCenter: parent.horizontalCenter
+            spacing: 34
+            Repeater {
+                model: {
+                    const tabs = [{ mode: "photo", name: qsTr("PHOTO") }, { mode: "video", name: qsTr("VIDEO") }]
+                    const extra = moreModes.find(m => m.mode === root.uiMode)
+                    if (extra)
+                        tabs.push({ mode: extra.mode, name: extra.name })
+                    tabs.push({ mode: "more", name: qsTr("MORE") })
+                    return tabs
+                }
+                delegate: Text {
+                    required property var modelData
+                    readonly property bool active: modelData.mode === "more" ? moreGrid.visible
+                                                   : !moreGrid.visible && root.uiMode === modelData.mode
+                    text: modelData.name
+                    color: active ? "white" : Qt.rgba(1, 1, 1, 0.6)
+                    font.pixelSize: 17
+                    font.bold: active
+                    MouseArea {
+                        anchors.fill: parent
+                        anchors.margins: -10
+                        onClicked: {
+                            if (modelData.mode === "more")
+                                moreGrid.visible = !moreGrid.visible
+                            else
+                                root.setMode(modelData.mode)
+                        }
+                    }
+                }
             }
         }
+    }
+
+    // ---------------------------------------------------------- "more" modes
+    readonly property var moreModes: [
+        { mode: "pro", name: qsTr("PRO"), icon: "" },
+        { mode: "provideo", name: qsTr("PRO VIDEO"), icon: "" },
+        { mode: "hyperlapse", name: qsTr("HYPERLAPSE"), icon: "" },
+        { mode: "qr", name: qsTr("QR CODE"), icon: "" }
     ]
+
+    Rectangle {
+        id: moreGrid
+        visible: false
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.bottom: bottomColumn.bottom
+        anchors.bottomMargin: 48
+        anchors.margins: 16
+        height: grid.implicitHeight + 48
+        radius: 28
+        color: Qt.rgba(0.3, 0.3, 0.3, 0.85)
+
+        Grid {
+            id: grid
+            anchors.centerIn: parent
+            columns: 4
+            columnSpacing: 12
+            rowSpacing: 24
+            Repeater {
+                model: root.moreModes
+                delegate: Item {
+                    id: tile
+                    required property var modelData
+                    width: (moreGrid.width - 80) / 4
+                    height: tileColumn.implicitHeight
+                    MouseArea {
+                        anchors.fill: parent
+                        onClicked: root.setMode(tile.modelData.mode)
+                    }
+                  Column {
+                    id: tileColumn
+                    width: parent.width
+                    spacing: 8
+                    Rectangle {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        width: 56
+                        height: 56
+                        radius: 28
+                        color: "transparent"
+                        border.color: "white"
+                        border.width: 2
+                        Text {
+                            anchors.centerIn: parent
+                            text: modelData.icon
+                            font.family: mdiFont.name
+                            font.pixelSize: 28
+                            color: "white"
+                        }
+                    }
+                    Text {
+                        width: parent.width
+                        horizontalAlignment: Text.AlignHCenter
+                        wrapMode: Text.WordWrap
+                        text: modelData.name
+                        color: "white"
+                        font.pixelSize: 14
+                    }
+                  }
+                }
+            }
+        }
+    }
+
+    // ------------------------------------------------------------- settings
+    ProPanel {
+        id: settingsSheet
+        visible: false
+        anchors.top: topBar.bottom
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.margins: 12
+        height: parent.height * 0.62
+    }
+
+    // QR mode: back to photo
+    Rectangle {
+        visible: camera.camMode === HybrisCamera.QrMode
+        anchors.bottom: parent.bottom
+        anchors.bottomMargin: 40
+        anchors.horizontalCenter: parent.horizontalCenter
+        width: 64
+        height: 64
+        radius: 32
+        color: Qt.rgba(0, 0, 0, 0.5)
+        Text {
+            anchors.centerIn: parent
+            text: ""
+            font.family: mdiFont.name
+            font.pixelSize: 30
+            color: "white"
+        }
+        MouseArea {
+            anchors.fill: parent
+            onClicked: root.setMode("photo")
+        }
+    }
+
+    Connections {
+        target: camera
+        // startup QR mode and external mode changes
+        function onCamModeChanged() {
+            if (camera.camMode === HybrisCamera.QrMode && root.uiMode !== "qr")
+                root.uiMode = "qr"
+        }
+    }
 }
diff --git a/src/qml/DefaultUI/ProPanel.qml b/src/qml/DefaultUI/ProPanel.qml
new file mode 100644
index 0000000..f210c29
--- /dev/null
+++ b/src/qml/DefaultUI/ProPanel.qml
@@ -0,0 +1,374 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Every Camera1 control the HAL of the current camera reports. Sections are
+ * built from the HAL's own capability keys (…-values, …-supported, ranges),
+ * so a camera shows only what it can do.
+ */
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls
+import HybrisCamera
+import ThemeUtils
+
+Rectangle {
+    id: panel
+    color: Qt.rgba(0, 0, 0, 0.85)
+    radius: 16
+
+    readonly property var p: camera.parameters
+    readonly property color accent: ThemeUtils.getAccentColor()
+
+    function values(key) {
+        const v = p[key]
+        return v ? v.split(",").filter(s => s.length > 0) : []
+    }
+    function supported(key) {
+        return p[key] === "true"
+    }
+
+    readonly property var labels: ({
+        "auto": qsTr("Auto"), "off": qsTr("Off"), "on": qsTr("On"),
+        "incandescent": qsTr("Incandescent"), "fluorescent": qsTr("Fluorescent"),
+        "warm-fluorescent": qsTr("Warm fluorescent"), "daylight": qsTr("Daylight"),
+        "cloudy-daylight": qsTr("Cloudy"), "twilight": qsTr("Twilight"), "shade": qsTr("Shade"),
+        "none": qsTr("None"), "mono": qsTr("Mono"), "negative": qsTr("Negative"),
+        "solarize": qsTr("Solarize"), "sepia": qsTr("Sepia"), "posterize": qsTr("Posterize"),
+        "whiteboard": qsTr("Whiteboard"), "blackboard": qsTr("Blackboard"), "aqua": qsTr("Aqua"),
+        "infinity": qsTr("Infinity"), "macro": qsTr("Macro"), "fixed": qsTr("Fixed"), "edof": qsTr("EDOF"),
+        "continuous-video": qsTr("Continuous (video)"), "continuous-picture": qsTr("Continuous"),
+        "hdr": qsTr("HDR"), "50hz": qsTr("50 Hz"), "60hz": qsTr("60 Hz")
+    })
+    function label(v) {
+        return labels[v] !== undefined ? labels[v] : v
+    }
+
+    // one row of mutually exclusive choices bound to a HAL key
+    component Choice: ColumnLayout {
+        id: choice
+        property string title
+        property string key
+        property var options: panel.values(key + "-values")
+        visible: options.length > 1
+        Layout.fillWidth: true
+        spacing: 6
+
+        Text {
+            text: choice.title
+            color: "white"
+            font.pixelSize: 15
+            font.bold: true
+        }
+        Flow {
+            Layout.fillWidth: true
+            spacing: 6
+            Repeater {
+                model: choice.options
+                delegate: Chip {
+                    required property string modelData
+                    text: panel.label(modelData)
+                    selected: panel.p[choice.key] === modelData
+                    onClicked: camera.setParameter(choice.key, modelData)
+                }
+            }
+        }
+    }
+
+    component Chip: Rectangle {
+        id: chip
+        property string text
+        property bool selected: false
+        signal clicked()
+        implicitWidth: chipText.implicitWidth + 24
+        implicitHeight: 34
+        radius: height / 2
+        color: selected ? panel.accent : Qt.rgba(1, 1, 1, 0.12)
+        Text {
+            id: chipText
+            anchors.centerIn: parent
+            text: chip.text
+            color: chip.selected ? "black" : "white"
+            font.pixelSize: 14
+        }
+        MouseArea {
+            anchors.fill: parent
+            onClicked: chip.clicked()
+        }
+    }
+
+    component Toggle: RowLayout {
+        id: toggle
+        property string title
+        property bool checked
+        signal toggled(bool on)
+        Layout.fillWidth: true
+        Text {
+            text: toggle.title
+            color: "white"
+            font.pixelSize: 15
+            font.bold: true
+            Layout.fillWidth: true
+        }
+        // own switch: the platform style draws it dark on this dark panel
+        Rectangle {
+            width: 52
+            height: 30
+            radius: height / 2
+            color: toggle.checked ? panel.accent : Qt.rgba(1, 1, 1, 0.25)
+            Rectangle {
+                width: 24
+                height: 24
+                radius: 12
+                y: 3
+                x: toggle.checked ? parent.width - width - 3 : 3
+                color: "white"
+                Behavior on x { NumberAnimation { duration: 120 } }
+            }
+            MouseArea {
+                anchors.fill: parent
+                anchors.margins: -8
+                onClicked: toggle.toggled(!toggle.checked)
+            }
+        }
+    }
+
+    Flickable {
+        id: flick
+        anchors.fill: parent
+        anchors.margins: 14
+        contentHeight: column.implicitHeight
+        clip: true
+
+        ColumnLayout {
+            id: column
+            width: flick.width
+            spacing: 14
+
+            Text {
+                visible: !camera.proAvailable
+                Layout.fillWidth: true
+                wrapMode: Text.WordWrap
+                color: "#ffb74d"
+                font.pixelSize: 14
+                text: qsTr("Advanced controls unavailable: libcamx.so not loaded")
+            }
+
+            // exposure compensation: HAL index between min/max, step in EV
+            ColumnLayout {
+                readonly property int evMin: parseInt(panel.p["min-exposure-compensation"] || "0")
+                readonly property int evMax: parseInt(panel.p["max-exposure-compensation"] || "0")
+                readonly property real evStep: parseFloat(panel.p["exposure-compensation-step"] || "0")
+                id: ev
+                visible: evMax > evMin && evStep > 0
+                Layout.fillWidth: true
+                RowLayout {
+                    Layout.fillWidth: true
+                    Text {
+                        text: qsTr("Exposure")
+                        color: "white"
+                        font.pixelSize: 15
+                        font.bold: true
+                        Layout.fillWidth: true
+                    }
+                    Text {
+                        readonly property real evValue: parseInt(panel.p["exposure-compensation"] || "0") * ev.evStep
+                        text: (evValue > 0 ? "+" : "") + evValue.toFixed(1) + " EV"
+                        color: panel.accent
+                        font.pixelSize: 15
+                    }
+                }
+                Slider {
+                    Layout.fillWidth: true
+                    from: ev.evMin
+                    to: ev.evMax
+                    stepSize: 1
+                    value: parseInt(panel.p["exposure-compensation"] || "0")
+                    onMoved: camera.setParameter("exposure-compensation", Math.round(value).toString())
+                }
+            }
+
+            Toggle {
+                visible: panel.supported("auto-exposure-lock-supported")
+                title: qsTr("Lock exposure (AE)")
+                checked: panel.p["auto-exposure-lock"] === "true"
+                onToggled: on => camera.setParameter("auto-exposure-lock", on ? "true" : "false")
+            }
+            Toggle {
+                visible: panel.supported("auto-whitebalance-lock-supported")
+                title: qsTr("Lock white balance (AWB)")
+                checked: panel.p["auto-whitebalance-lock"] === "true"
+                onToggled: on => camera.setParameter("auto-whitebalance-lock", on ? "true" : "false")
+            }
+
+            Choice { title: qsTr("Scene"); key: "scene-mode" }
+            Choice { title: qsTr("White balance"); key: "whitebalance" }
+            Choice { title: qsTr("Focus"); key: "focus-mode" }
+            Choice { title: qsTr("Color effect"); key: "effect" }
+            Choice { title: qsTr("Anti-flicker"); key: "antibanding" }
+
+            Toggle {
+                visible: parseInt(panel.p["max-num-detected-faces-hw"] || "0") > 0
+                title: qsTr("Face detection")
+                checked: camera.faceDetection
+                onToggled: on => camera.faceDetection = on
+            }
+
+            Toggle {
+                title: qsTr("Geotag photos") + (camera.geotag && !camera.hasLocation ? " " + qsTr("(no fix yet)") : "")
+                checked: camera.geotag
+                onToggled: on => camera.geotag = on
+            }
+
+            // photo size: every size the HAL can capture, largest first
+            ColumnLayout {
+                id: sizes
+                visible: camera.camMode === HybrisCamera.PictureMode && list.length > 0
+                Layout.fillWidth: true
+                readonly property var list: panel.values("picture-size-values")
+                    .map(s => { const wh = s.split("x"); return { w: parseInt(wh[0]), h: parseInt(wh[1]) } })
+                    .sort((a, b) => b.w * b.h - a.w * a.h)
+                Text {
+                    text: qsTr("Photo size")
+                    color: "white"
+                    font.pixelSize: 15
+                    font.bold: true
+                }
+                Flow {
+                    Layout.fillWidth: true
+                    spacing: 6
+                    Repeater {
+                        model: sizes.list
+                        delegate: Chip {
+                            required property var modelData
+                            readonly property real mp: modelData.w * modelData.h / 1e6
+                            text: (mp >= 1 ? mp.toFixed(1) + " MP" : modelData.w + "x" + modelData.h)
+                                  + "  " + modelData.w + "x" + modelData.h
+                            selected: camera.pictureSize === modelData.w + "x" + modelData.h
+                            onClicked: camera.setPictureSize(modelData.w, modelData.h)
+                        }
+                    }
+                }
+            }
+
+            ColumnLayout {
+                visible: camera.camMode === HybrisCamera.PictureMode
+                Layout.fillWidth: true
+                RowLayout {
+                    Layout.fillWidth: true
+                    Text {
+                        text: qsTr("JPEG quality")
+                        color: "white"
+                        font.pixelSize: 15
+                        font.bold: true
+                        Layout.fillWidth: true
+                    }
+                    Text {
+                        text: camera.jpegQuality
+                        color: panel.accent
+                        font.pixelSize: 15
+                    }
+                }
+                Slider {
+                    Layout.fillWidth: true
+                    from: 50
+                    to: 100
+                    stepSize: 1
+                    value: camera.jpegQuality
+                    onMoved: camera.jpegQuality = Math.round(value)
+                }
+            }
+
+            // video: frame rate from the HAL's preview frame rates, codec of the encoder
+            ColumnLayout {
+                id: fps
+                visible: camera.camMode === HybrisCamera.VideoMode
+                Layout.fillWidth: true
+                readonly property var rates: panel.values("preview-frame-rate-values").map(s => parseInt(s))
+                Text {
+                    text: qsTr("Video frame rate")
+                    color: "white"
+                    font.pixelSize: 15
+                    font.bold: true
+                }
+                Flow {
+                    Layout.fillWidth: true
+                    spacing: 6
+                    Repeater {
+                        model: fps.rates
+                        delegate: Chip {
+                            required property int modelData
+                            text: modelData + " fps"
+                            selected: camera.videoFps === modelData
+                            onClicked: camera.videoFps = modelData
+                        }
+                    }
+                }
+                Text {
+                    text: qsTr("Video codec")
+                    color: "white"
+                    font.pixelSize: 15
+                    font.bold: true
+                }
+                Flow {
+                    Layout.fillWidth: true
+                    spacing: 6
+                    Chip {
+                        text: "H.264"
+                        selected: !camera.hevc
+                        onClicked: camera.hevc = false
+                    }
+                    Chip {
+                        text: "HEVC (H.265)"
+                        selected: camera.hevc
+                        onClicked: camera.hevc = true
+                    }
+                }
+                Text {
+                    text: qsTr("Encoder")
+                    color: "white"
+                    font.pixelSize: 15
+                    font.bold: true
+                }
+                Flow {
+                    Layout.fillWidth: true
+                    spacing: 6
+                    Chip {
+                        text: qsTr("Hardware")
+                        selected: !camera.swEncode
+                        onClicked: camera.swEncode = false
+                    }
+                    Chip {
+                        text: qsTr("Software (FFmpeg)")
+                        selected: camera.swEncode
+                        onClicked: camera.swEncode = true
+                    }
+                }
+                Text {
+                    text: camera.swEncode ? qsTr("Quality (CRF, lower is better)") : qsTr("Bit rate")
+                    color: "white"
+                    font.pixelSize: 15
+                    font.bold: true
+                }
+                Flow {
+                    Layout.fillWidth: true
+                    spacing: 6
+                    Repeater {
+                        model: camera.swEncode ? [18, 20, 23, 26, 28, 32] : [6, 12, 17, 24, 32, 40, 50, 60]
+                        delegate: Chip {
+                            required property int modelData
+                            text: camera.swEncode ? modelData.toString() : modelData + " Mb/s"
+                            selected: camera.swEncode ? camera.encCrf === modelData
+                                                      : camera.videoBitRate === modelData
+                            onClicked: {
+                                if (camera.swEncode)
+                                    camera.encCrf = modelData
+                                else
+                                    camera.videoBitRate = modelData
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/src/qml/DefaultUI/ZoomControl.qml b/src/qml/DefaultUI/ZoomControl.qml
new file mode 100644
index 0000000..cc6cf13
--- /dev/null
+++ b/src/qml/DefaultUI/ZoomControl.qml
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * One UI style zoom: a pill with the lenses of the current side (factor from
+ * the HAL's field of view, relative to the main lens) and digital stops from
+ * the HAL's zoom-ratios; press and hold or drag for a slider with a scale.
+ */
+
+import QtQuick
+import QtQuick.Layouts
+import HybrisCamera
+import ThemeUtils
+
+Item {
+    id: zoom
+    implicitHeight: 64
+
+    required property var lenses        // lenses of the current side
+    readonly property color accent: "#ffcc33"
+
+    // main lens of the side: Android lists it first (lowest id)
+    readonly property var mainLens: lenses.length ? lenses.reduce((a, b) => a.id < b.id ? a : b) : null
+    function lensFactor(l) {
+        if (!mainLens || !l || !(l.fov > 0) || !(mainLens.fov > 0))
+            return 1
+        const rad = Math.PI / 180
+        return Math.tan(mainLens.fov / 2 * rad) / Math.tan(l.fov / 2 * rad)
+    }
+    // every lens with its factor, widest first (main = 1)
+    readonly property var lensStops: lenses.map(l => ({ lens: l, factor: l === mainLens ? 1 : lensFactor(l) }))
+                                          .sort((a, b) => a.factor - b.factor)
+    readonly property var wideLenses: lensStops.filter(s => s.factor < 0.95).map(s => s.lens)
+
+    // digital zoom of the current camera
+    readonly property var ratios: (camera.parameters["zoom-ratios"] || "100").split(",").map(r => parseInt(r) / 100)
+    readonly property real maxRatio: ratios[ratios.length - 1]
+    function indexForRatio(r) {
+        let best = 0
+        for (let i = 0; i < ratios.length; i++)
+            if (Math.abs(ratios[i] - r) < Math.abs(ratios[best] - r))
+                best = i
+        return best
+    }
+    readonly property var currentStop: lensStops.find(s => s.lens.id === camera.camId)
+    readonly property real currentFactor: (currentStop ? currentStop.factor : 1)
+                                          * (ratios[Math.min(camera.zoom, ratios.length - 1)] || 1)
+    // digital stops past the longest lens
+    readonly property real longestLens: lensStops.length ? lensStops[lensStops.length - 1].factor : 1
+    readonly property var digitalStops: [2, 4].filter(s => s <= maxRatio && s > longestLens * 1.2)
+
+    function setFactor(f) {
+        // the lens with the largest factor not above f, digital zoom for the rest
+        let pick = lensStops.length ? lensStops[0] : null
+        for (const s of lensStops)
+            if (s.factor <= f * 1.02)
+                pick = s
+        if (!pick)
+            return
+        if (camera.camId !== pick.lens.id)
+            camera.camId = pick.lens.id
+        camera.zoom = indexForRatio(Math.max(1, f / pick.factor))
+    }
+    // which stop the current zoom belongs to
+    function stopActive(f, next) {
+        return currentFactor >= f * 0.97 && (next === undefined || currentFactor < next * 0.97)
+    }
+    function label(f) {
+        const t = f < 1 ? f.toFixed(1).replace(/^0/, "") : (Math.round(f * 10) / 10).toString()
+        return t
+    }
+
+    readonly property var allStops: lensStops.map(s => s.factor).concat(digitalStops)
+    property bool sliderOpen: false
+    readonly property real minFactor: lensStops.length ? Math.min(1, lensStops[0].factor) : 1
+    // digital zoom on top of the longest lens
+    readonly property real maxLimit: Math.max(maxRatio, longestLens * maxRatio)
+
+    // pill
+    Rectangle {
+        id: pill
+        visible: !zoom.sliderOpen
+        anchors.centerIn: parent
+        height: 50
+        width: pillRow.implicitWidth + 12
+        radius: height / 2
+        color: Qt.rgba(0, 0, 0, 0.45)
+
+        Row {
+            id: pillRow
+            anchors.centerIn: parent
+            spacing: 4
+            Repeater {
+                model: zoom.allStops
+                delegate: ZoomStop {
+                    required property real modelData
+                    required property int index
+                    factor: modelData
+                    active: index === 0 ? zoom.currentFactor < (zoom.allStops.length > 1 ? zoom.allStops[1] * 0.97 : 1e9)
+                                        : zoom.stopActive(modelData, zoom.allStops[index + 1])
+                }
+            }
+        }
+    }
+
+    component ZoomStop: Rectangle {
+        id: stop
+        property real factor
+        property bool active
+        width: 42
+        height: 42
+        radius: 21
+        color: active ? Qt.rgba(0, 0, 0, 0.55) : "transparent"
+        Text {
+            anchors.centerIn: parent
+            text: stop.active ? zoom.label(zoom.currentFactor) + "×" : zoom.label(stop.factor)
+            color: stop.active ? zoom.accent : "white"
+            font.pixelSize: stop.active ? 14 : 16
+            font.bold: true
+        }
+        MouseArea {
+            anchors.fill: parent
+            onClicked: zoom.setFactor(stop.factor)
+            onPressAndHold: zoom.sliderOpen = true
+        }
+    }
+
+    // slider with a logarithmic scale, like One UI
+    Rectangle {
+        id: slider
+        visible: zoom.sliderOpen
+        anchors.centerIn: parent
+        width: parent.width
+        height: 50
+        radius: height / 2
+        color: Qt.rgba(0, 0, 0, 0.55)
+
+        readonly property real lmin: Math.log(zoom.minFactor)
+        readonly property real lmax: Math.log(zoom.maxLimit)
+        function xFor(f) {
+            return 20 + (Math.log(f) - lmin) / (lmax - lmin) * (width - 80)
+        }
+        function factorAt(x) {
+            const t = Math.max(0, Math.min(1, (x - 20) / (width - 80)))
+            return Math.exp(lmin + t * (lmax - lmin))
+        }
+
+        Repeater {
+            model: 41
+            delegate: Rectangle {
