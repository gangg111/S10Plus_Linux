+bool CameraManager::setParameter(const QString &key, const QString &value)
+{
+	if (!m_extras.available())
+		return false;
+	const bool ok = m_extras.set(key, value) == 0;
+	if (ok)
+		m_settings.setValue(savedParameterGroup() + "/" + key, value);
+	m_params = m_extras.parameters();
+	Q_EMIT parametersChanged();
+	return ok;
