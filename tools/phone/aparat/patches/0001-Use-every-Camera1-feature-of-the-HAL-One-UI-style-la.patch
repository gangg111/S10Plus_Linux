@@ -0,0 +1,250 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Full Camera1 feature set of the HAL: lens picker, HAL parameters (through
+ * libcamx), face detection, tap to focus/meter, JPEG quality, geotagging and
+ * video frame rate/codec.
+ */
+
+#include <QDateTime>
+#include <QDebug>
+#include <QSettings>
+
+#include <hybris-camera.h>
+
+namespace {
+const int FOCUS_AREA_HALF = 100; // tap area: 10% of the field of view each way
+}
+
+QVariantList HybrisCamera::lenses() const
+{
+	QVariantList list;
+	QSettings settings;
+	for (const CameraDevice &dev : m_cameraManager->availableCameras()) {
+		QVariantMap lens;
+		lens["id"] = dev.camId;
+		lens["front"] = dev.type != 0;
+		lens["megapixels"] =
+			settings.value(QString("Camera%1/megapixels").arg(dev.camId), 0.0).toDouble();
+		lens["fov"] = settings.value(QString("Camera%1/fov").arg(dev.camId), 0.0).toDouble();
+		list.append(lens);
+	}
+	return list;
+}
+
+QVariantMap HybrisCamera::parameters() const
+{
+	QVariantMap map;
+	const QMap<QString, QString> params = m_cameraManager->parameters();
+	for (auto it = params.cbegin(); it != params.cend(); ++it)
+		map.insert(it.key(), it.value());
+	return map;
+}
+
+void HybrisCamera::setVideoFps(int fps)
+{
+	if (fps == m_videoFps)
+		return;
+	m_videoFps = fps;
+	QSettings().setValue("AppSettings/video-fps", fps);
+	Q_EMIT videoFpsChanged();
+}
+
+void HybrisCamera::setHevc(bool hevc)
+{
+	if (hevc == m_hevc)
+		return;
+	m_hevc = hevc;
+	QSettings().setValue("AppSettings/hevc", hevc);
+	Q_EMIT hevcChanged();
+}
+
+void HybrisCamera::setFaceDetection(bool enable)
+{
+	if (enable == m_faceDetection)
+		return;
+	m_faceDetection = enable;
+	QSettings().setValue("AppSettings/face-detection", enable);
+	if (enable) {
+		m_cameraManager->extras().startFaceDetection();
+		m_faceTimer->start();
+	} else {
+		m_faceTimer->stop();
+		m_cameraManager->extras().stopFaceDetection();
+		m_faces.clear();
+		Q_EMIT facesChanged();
+	}
+	Q_EMIT faceDetectionChanged();
+}
+
+void HybrisCamera::pollFaces()
+{
+	// Camera2Client drops face detection whenever the preview restarts
+	// (camera, mode or size change); starting it again is a no-op while it runs
+	static int tick = 0;
+	if (++tick % 10 == 0)
+		m_cameraManager->extras().startFaceDetection();
+
+	unsigned generation = 0;
+	const QList<CameraFace> faces = m_cameraManager->extras().faces(&generation);
+	if (generation == m_faceGeneration && !m_faces.isEmpty() == !faces.isEmpty())
+		return;
+	m_faceGeneration = generation;
+
+	QVariantList list;
+	for (const CameraFace &f : faces) {
+		const QPointF a = sensorToItem(QPointF(f.rect.left(), f.rect.top()));
+		const QPointF b = sensorToItem(QPointF(f.rect.right(), f.rect.bottom()));
+		QVariantMap face;
+		face["x"] = qMin(a.x(), b.x());
+		face["y"] = qMin(a.y(), b.y());
+		face["width"] = qAbs(b.x() - a.x());
+		face["height"] = qAbs(b.y() - a.y());
+		face["score"] = f.score;
+		list.append(face);
+	}
+	m_faces = list;
+	Q_EMIT facesChanged();
+}
+
+// Where the preview is drawn inside the item, with the same math as
+// CameraRenderer::paint(): scaled to fit, top aligned when letterboxed.
+QRectF HybrisCamera::previewRect() const
+{
+	const qreal w = width(), h = height();
+	const QSize tex = m_renderer ? m_renderer->drawnTextureSize() : m_previewSize;
+	if (w <= 0 || h <= 0 || tex.isEmpty())
+		return QRectF();
+	const int r = m_cameraManager->effectiveRotation();
+	const bool rotated = r == 90 || r == 270;
+	const qreal texW = rotated ? tex.height() : tex.width();
+	const qreal texH = rotated ? tex.width() : tex.height();
+	const qreal ta = texW / texH, va = w / h;
+	if (ta > va)
+		return QRectF(0, 0, w, h * va / ta);
+	const qreal f = ta / va;
+	return QRectF(w * (1 - f) / 2, 0, w * f, h);
+}
+
+// Texture coordinates of the renderer: base (X, 1 - Y), mirrored for front
+// cameras, rotated k times by (u, v) -> (1 - v, u), sampled at (u, 1 - v).
+// Camera1 areas and faces use the sensor frame -1000..1000, top-left origin.
+QPointF HybrisCamera::itemToSensor(const QPointF &itemNorm, bool *inside) const
+{
+	const QRectF rect = previewRect();
+	const qreal px = itemNorm.x() * width(), py = itemNorm.y() * height();
+	if (inside)
+		*inside = rect.contains(px, py);
+	if (rect.isEmpty())
+		return QPointF();
+	qreal u = (px - rect.x()) / rect.width();
+	qreal v = 1.0 - (py - rect.y()) / rect.height();
+	if (m_cameraManager->currentCamera().type)
+		u = 1.0 - u;
+	const int k = (m_cameraManager->effectiveRotation() / 90) % 4;
+	for (int i = 0; i < k; ++i) {
+		const qreal t = u;
+		u = 1.0 - v;
+		v = t;
+	}
+	return QPointF(u * 2000.0 - 1000.0, (1.0 - v) * 2000.0 - 1000.0);
+}
+
+QPointF HybrisCamera::sensorToItem(const QPointF &sensor) const
+{
+	const QRectF rect = previewRect();
+	if (rect.isEmpty() || width() <= 0 || height() <= 0)
+		return QPointF();
+	qreal u = (sensor.x() + 1000.0) / 2000.0;
+	qreal v = 1.0 - (sensor.y() + 1000.0) / 2000.0;
+	const int k = (m_cameraManager->effectiveRotation() / 90) % 4;
+	for (int i = 0; i < k; ++i) {
+		const qreal t = u;
+		u = v;
+		v = 1.0 - t;
+	}
+	if (m_cameraManager->currentCamera().type)
+		u = 1.0 - u;
+	const qreal px = rect.x() + u * rect.width();
+	const qreal py = rect.y() + (1.0 - v) * rect.height();
+	return QPointF(px / width(), py / height());
+}
+
+bool HybrisCamera::focusAt(qreal x, qreal y)
+{
+	CameraControl *cc = m_cameraManager->cameraControl();
+	if (!cc)
+		return false;
+	bool inside = false;
+	const QPointF s = itemToSensor(QPointF(x, y), &inside);
+	if (!inside)
+		return false;
+
+	const int cx = qBound(-1000 + FOCUS_AREA_HALF, int(s.x()), 1000 - FOCUS_AREA_HALF);
+	const int cy = qBound(-1000 + FOCUS_AREA_HALF, int(s.y()), 1000 - FOCUS_AREA_HALF);
+	FocusRegion region{ cy - FOCUS_AREA_HALF, cx - FOCUS_AREA_HALF, cy + FOCUS_AREA_HALF,
+			    cx + FOCUS_AREA_HALF, 1000 };
+	qDebug() << "Focus/metering area (sensor)" << region.left << region.top << region.right
+		 << region.bottom << "from item point" << x << y << "preview" << previewRect()
+		 << (m_renderer ? m_renderer->drawnTextureSize() : m_previewSize) << "rotation"
+		 << m_cameraManager->effectiveRotation();
+	android_camera_set_focus_region(cc, &region);
+	android_camera_set_metering_region(cc, &region);
+	// single AF only in "auto"; continuous modes follow the area by themselves
+	if (m_cameraManager->parameters().value("focus-mode") == "auto")
+		android_camera_start_autofocus(cc);
+	return true;
+}
+
+void HybrisCamera::resetFocus()
+{
+	CameraControl *cc = m_cameraManager->cameraControl();
+	if (!cc)
+		return;
+	android_camera_reset_focus_region(cc);
+	android_camera_reset_metering_region(cc);
+}
+
+void HybrisCamera::setGeotag(bool enable)
+{
+	if (enable == m_geotag)
+		return;
+	m_geotag = enable;
+	QSettings().setValue("AppSettings/geotag", enable);
+	if (!m_positionSource) {
+		m_positionSource = QGeoPositionInfoSource::createDefaultSource(this);
+		if (m_positionSource) {
+			connect(m_positionSource, &QGeoPositionInfoSource::positionUpdated, this,
+				[this](const QGeoPositionInfo &info) {
+					const bool had = m_position.isValid();
+					m_position = info;
+					if (had != m_position.isValid())
+						Q_EMIT hasLocationChanged();
+				});
+			connect(m_positionSource, &QGeoPositionInfoSource::errorOccurred, this,
+				[](QGeoPositionInfoSource::Error e) {
+					qWarning() << "Position source error" << e;
+				});
+		} else {
+			qWarning() << "No position source, photos will not be geotagged";
+		}
+	}
+	if (m_positionSource) {
+		if (enable)
+			m_positionSource->startUpdates();
+		else
+			m_positionSource->stopUpdates();
+	}
+	Q_EMIT geotagChanged();
+}
+
+void HybrisCamera::applyLocation()
+{
+	CameraControl *cc = m_cameraManager->cameraControl();
+	if (!cc || !m_geotag || !m_position.isValid())
+		return;
+	const QGeoCoordinate c = m_position.coordinate();
+	const float lat = c.latitude(), lon = c.longitude();
+	const float alt = c.type() == QGeoCoordinate::Coordinate3D ? c.altitude() : 0.0f;
+	android_camera_set_location(cc, &lat, &lon, &alt,
+				    int(m_position.timestamp().toSecsSinceEpoch()), "GPS");
+}
