+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#pragma once
+
+#include <camx/cam2.h>
+
+// Writes a Bayer RAW16 frame as an uncompressed DNG 1.4 with the colour data
+// of the camera (what Android's DngCreator writes). orientation: clockwise
+// degrees the image must be turned to stand upright (0, 90, 180, 270).
+bool writeDng(const char *path, const unsigned short *data, const Cam2Dng &m, int orientation,
+	      const char *make, const char *model, const char *dateTime);
diff --git a/src/hybris-camera-cam2.cpp b/src/hybris-camera-cam2.cpp
new file mode 100644
index 0000000..18ebe2e
--- /dev/null
+++ b/src/hybris-camera-cam2.cpp
@@ -0,0 +1,268 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * The HAL3 features Camera1 cannot reach, through a Camera2 still capture in
+ * libcamx (camx/cam2.cpp): manual ISO and shutter, manual focus distance,
+ * OIS off, RAW (saved as DNG) and burst. Camera1 gives the device up for the
+ * shot and takes it back afterwards; the preview stops for that time.
+ */
+
+#include <QDateTime>
+#include <QDebug>
+#include <QFile>
+#include <QSettings>
+#include <QThread>
+
+#include <dng-writer.h>
+#include <hybris-camera.h>
+
+namespace {
+
+struct Job {
+	QString base; // path without extension
+	int count = 1;
+	int orientation = 0;
+	QStringList saved;
+};
+
+void onJpeg(void *ctx, const unsigned char *data, int size, int index)
+{
+	Job *job = static_cast<Job *>(ctx);
+	// One UI names burst frames like this too
+	const QString path = job->count > 1 ? job->base + QString("_BURST%1.jpg").arg(index + 1, 3, 10, QChar('0'))
+					    : job->base + ".jpg";
+	QFile file(path);
+	if (file.open(QIODevice::WriteOnly) && file.write(reinterpret_cast<const char *>(data), size) == size)
+		job->saved.append(path);
+	else
+		qWarning() << "cam2: could not save" << path;
+}
+
+void onRaw(void *ctx, const unsigned short *data, const Cam2Dng *meta)
+{
+	Job *job = static_cast<Job *>(ctx);
+	const QString path = job->base + ".dng";
+	const QByteArray date = QDateTime::currentDateTime().toString("yyyy:MM:dd hh:mm:ss").toLatin1();
+	if (writeDng(path.toUtf8().constData(), data, *meta, job->orientation, "samsung", "SM-G975F",
+		     date.constData()))
+		job->saved.append(path);
+	else
+		qWarning() << "cam2: could not save" << path;
+}
+
+// Camera1 names of android.control.awbMode values
+int awbMode(const QString &whiteBalance)
+{
+	static const QMap<QString, int> modes = { { "incandescent", 2 }, { "fluorescent", 3 },
+						  { "warm-fluorescent", 4 }, { "daylight", 5 },
+						  { "cloudy-daylight", 6 }, { "twilight", 7 },
+						  { "shade", 8 } };
+	return modes.value(whiteBalance, -1);
+}
+
+// Camera1 names of android.control.effectMode values
+int effectMode(const QString &effect)
+{
+	static const QMap<QString, int> modes = { { "mono", 1 }, { "negative", 2 }, { "solarize", 3 },
+						  { "sepia", 4 }, { "posterize", 5 }, { "whiteboard", 6 },
+						  { "blackboard", 7 }, { "aqua", 8 } };
+	return modes.value(effect, -1);
+}
+
+// Camera1 names of android.control.aeAntibandingMode values
+int antibandingMode(const QString &antibanding)
+{
+	static const QMap<QString, int> modes = { { "off", 0 }, { "50hz", 1 }, { "60hz", 2 }, { "auto", 3 } };
+	return modes.value(antibanding, -1);
+}
+
+} // namespace
+
+void HybrisCamera::loadProSettings()
+{
+	QSettings s;
+	m_manualIso = s.value("Pro/iso", 0).toInt();
+	m_manualExposureUs = s.value("Pro/exposure-us", 0).toInt();
+	m_manualFocus = s.value("Pro/focus", -1.0).toDouble();
+	m_rawCapture = s.value("Pro/raw", false).toBool();
+	m_ois = s.value("Pro/ois", true).toBool();
+	m_burstCount = s.value("Pro/burst", 10).toInt();
+}
+
+void HybrisCamera::refreshCam2()
+{
+	Cam2Info info = {};
+	QVariantMap map;
+	const bool ok = m_cameraManager->extras().cam2Info(m_cameraManager->camId(), &info);
+	map["available"] = ok;
+	if (ok) {
+		map["manualSensor"] = info.manualSensor != 0;
+		map["isoMin"] = info.isoMin;
+		map["isoMax"] = info.isoMax;
+		map["expMinUs"] = double(info.expMinNs) / 1000.0;
+		map["expMaxUs"] = double(info.expMaxNs) / 1000.0;
+		map["minFocus"] = info.minFocusDiopters;
+		map["raw"] = info.raw != 0;
+		map["ois"] = info.ois != 0;
+		map["burst"] = info.burst != 0;
+		map["evStep"] = info.evStep;
+	}
+	m_cam2 = map;
+	Q_EMIT cam2Changed();
+}
+
+void HybrisCamera::setProActive(bool active)
+{
+	if (active == m_proActive)
+		return;
+	m_proActive = active;
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setManualIso(int iso)
+{
+	if (iso == m_manualIso)
+		return;
+	m_manualIso = iso;
+	QSettings().setValue("Pro/iso", iso);
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setManualExposureUs(int us)
+{
+	if (us == m_manualExposureUs)
+		return;
+	m_manualExposureUs = us;
+	QSettings().setValue("Pro/exposure-us", us);
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setManualFocus(double diopters)
+{
+	if (qFuzzyCompare(diopters + 2, m_manualFocus + 2))
+		return;
+	m_manualFocus = diopters;
+	QSettings().setValue("Pro/focus", diopters);
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setRawCapture(bool raw)
+{
+	if (raw == m_rawCapture)
+		return;
+	m_rawCapture = raw;
+	QSettings().setValue("Pro/raw", raw);
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setOis(bool on)
+{
+	if (on == m_ois)
+		return;
+	m_ois = on;
+	QSettings().setValue("Pro/ois", on);
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setBurstCount(int count)
+{
+	count = qBound(2, count, 30);
+	if (count == m_burstCount)
+		return;
+	m_burstCount = count;
+	QSettings().setValue("Pro/burst", count);
+	Q_EMIT proChanged();
+}
+
+// a PRO value Camera1 has no key for is set
+bool HybrisCamera::needsCam2() const
+{
+	if (!m_proActive || !m_cam2.value("available").toBool() ||
+	    m_cameraManager->camMode() != CameraManager::PictureMode)
+		return false;
+	const bool manual = m_cam2.value("manualSensor").toBool() &&
+			    (m_manualIso > 0 || m_manualExposureUs > 0 ||
+			     (m_manualFocus >= 0 && m_cam2.value("minFocus").toDouble() > 0));
+	return manual || (m_rawCapture && m_cam2.value("raw").toBool()) || (!m_ois && m_cam2.value("ois").toBool());
+}
+
+void HybrisCamera::takeBurst()
+{
+	if (m_cam2.value("burst").toBool() && m_cameraManager->camMode() == CameraManager::PictureMode)
+		captureCam2(m_burstCount, false);
+}
+
+void HybrisCamera::captureCam2(int count, bool raw)
+{
+	if (m_busy || m_isRecording || !m_cameraManager->cameraControl())
+		return;
+
+	const QMap<QString, QString> p = m_cameraManager->parameters();
+	Cam2Settings s = {};
+	const bool pro = m_proActive;
+	s.iso = pro ? m_manualIso : 0;
+	s.expNs = pro ? qint64(m_manualExposureUs) * 1000 : 0;
+	s.focus = pro && m_manualFocus >= 0 ? float(m_manualFocus) : -1.0f;
+	s.ois = pro && !m_ois ? 0 : -1;
+	s.awb = awbMode(p.value("whitebalance"));
+	s.effect = effectMode(p.value("effect"));
+	s.antibanding = antibandingMode(p.value("antibanding"));
+	const double evStep = m_cam2.value("evStep").toDouble();
+	if (evStep > 0)
+		s.evSteps = qRound(p.value("exposure-compensation").toInt() *
+				   p.value("exposure-compensation-step").toDouble() / evStep);
+	const QSize size = m_cameraManager->currentPictureSize();
+	s.jpegWidth = size.width();
+	s.jpegHeight = size.height();
+	s.quality = m_cameraManager->jpegQuality();
+	s.orientation = m_cameraManager->effectiveRotation();
+	const QStringList ratios = p.value("zoom-ratios").split(',', Qt::SkipEmptyParts);
+	const int zoom = m_cameraManager->zoom();
+	s.zoom = zoom >= 0 && zoom < ratios.size() ? ratios[zoom].toFloat() / 100.0f : 1.0f;
+	const CameraManager::Flash flash = m_cameraManager->flash();
+	s.flash = flash == CameraManager::FLASH_OFF ? 0 : flash == CameraManager::FLASH_AUTO ? 1 : 2;
+	s.raw = raw && m_cam2.value("raw").toBool();
+	s.count = count;
+	if (m_geotag && m_position.isValid()) {
+		const QGeoCoordinate c = m_position.coordinate();
+		s.gps = 1;
+		s.latitude = c.latitude();
+		s.longitude = c.longitude();
+		s.altitude = c.type() == QGeoCoordinate::Coordinate3D ? c.altitude() : 0.0;
+		s.gpsTime = m_position.timestamp().toSecsSinceEpoch();
+	}
+
+	Job *job = new Job;
+	job->base = m_picturePath + "/IMG" + QDateTime::currentDateTime().toString("yyyyMMdd_hhmmsszzz");
+	job->count = count;
+	job->orientation = s.orientation;
+	const int camId = m_cameraManager->camId();
+
+	m_busy = true;
+	Q_EMIT busyChanged();
+	if (m_renderer)
+		m_renderer->detachCamera();
+	// let a frame the render thread may be drawing finish with the old camera
+	QTimer::singleShot(80, this, [this, s, job, camId]() {
+		m_cameraManager->releaseCamera();
+		QThread *worker = QThread::create([this, s, job, camId]() {
+			int iso = 0;
+			long long exp = 0;
+			const int n = m_cameraManager->extras().cam2Capture(camId, s, onJpeg, onRaw, job, &iso, &exp);
+			qDebug() << "cam2 capture:" << n << "frames, settings ISO" << s.iso << "exposure us"
+				 << s.expNs / 1000 << "focus" << s.focus << "ois" << s.ois << "raw" << s.raw
+				 << "zoom" << s.zoom << "metered ISO" << iso << "exposure us" << exp / 1000
+				 << "files" << job->saved;
+			QMetaObject::invokeMethod(this, [this, job]() {
+				m_cameraManager->reconnectCamera();
+				m_busy = false;
+				Q_EMIT busyChanged();
+				for (const QString &path : job->saved)
+					if (path.endsWith(".jpg"))
+						Q_EMIT newMediaSaved(path);
+				delete job;
+			}, Qt::QueuedConnection);
+		});
+		connect(worker, &QThread::finished, worker, &QObject::deleteLater);
+		worker->start();
+	});
+}
