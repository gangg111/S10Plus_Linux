diff --git a/src/camx/cam2.cpp b/src/camx/cam2.cpp
new file mode 100644
index 0000000..d410d34
--- /dev/null
+++ b/src/camx/cam2.cpp
@@ -0,0 +1,525 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Camera2 (NDK) still capture for the controls Camera1 does not reach on this
+ * HAL. Runs in the application process through libhybris; the process needs a
+ * binder thread pool, otherwise the camera service can neither return buffers
+ * nor deliver results (no frame ever arrives).
+ */
+
+#include "ndk-camera.h"
+#include "cam2.h"
+
+namespace {
+
+void startPool()
+{
+	static bool started = false;
+	if (started)
+		return;
+	started = true;
+	// no setThreadPoolMaxThreadCount: the compatibility layer may have started
+	// the pool already, and shrinking a running pool aborts the process.
+	// libbinder names the calling thread "Binder:<pid>_N"; on the main thread
+	// that renames the whole process (pkill, top), so the name is put back.
+	char name[16] = {};
+	prctl(PR_GET_NAME, name, 0, 0, 0);
+	ABinderProcess_startThreadPool();
+	prctl(PR_SET_NAME, name, 0, 0, 0);
+}
+
+bool entry(const ACameraMetadata *m, uint32_t tag, ACameraMetadata_const_entry *e)
+{
+	return m && ACameraMetadata_getConstEntry(m, tag, e) == ACAMERA_OK && e->count > 0;
+}
+
+bool hasCap(const ACameraMetadata *ch, int cap)
+{
+	ACameraMetadata_const_entry e;
+	if (!entry(ch, ACAMERA_REQUEST_AVAILABLE_CAPABILITIES, &e))
+		return false;
+	for (uint32_t i = 0; i < e.count; i++)
+		if (e.data.u8[i] == cap)
+			return true;
+	return false;
+}
+
+// largest output size of a format (w * h), 0 when none
+void largest(const ACameraMetadata *ch, int format, int *w, int *h)
+{
+	*w = *h = 0;
+	ACameraMetadata_const_entry e;
+	if (!entry(ch, ACAMERA_SCALER_AVAILABLE_STREAM_CONFIGURATIONS, &e))
+		return;
+	for (uint32_t k = 0; k + 3 < e.count; k += 4)
+		if (e.data.i32[k] == format && e.data.i32[k + 3] == 0 &&
+		    (long long)e.data.i32[k + 1] * e.data.i32[k + 2] > (long long)*w * *h) {
+			*w = e.data.i32[k + 1];
+			*h = e.data.i32[k + 2];
+		}
+}
+
+bool hasSize(const ACameraMetadata *ch, int format, int w, int h)
+{
+	ACameraMetadata_const_entry e;
+	if (!entry(ch, ACAMERA_SCALER_AVAILABLE_STREAM_CONFIGURATIONS, &e))
+		return false;
+	for (uint32_t k = 0; k + 3 < e.count; k += 4)
+		if (e.data.i32[k] == format && e.data.i32[k + 3] == 0 && e.data.i32[k + 1] == w &&
+		    e.data.i32[k + 2] == h)
+			return true;
+	return false;
+}
+
+void matrix(const ACameraMetadata *m, uint32_t tag, float *out, int n)
+{
+	for (int i = 0; i < n; i++)
+		out[i] = 0;
+	ACameraMetadata_const_entry e;
+	if (!entry(m, tag, &e))
+		return;
+	for (int i = 0; i < n && i < (int)e.count; i++)
+		out[i] = e.data.r[i].denominator ? (float)e.data.r[i].numerator / e.data.r[i].denominator : 0;
+}
+
+long long clampLL(long long v, long long lo, long long hi)
+{
+	return v < lo ? lo : v > hi ? hi : v;
+}
+
+// state shared with the capture callbacks (binder threads)
+// the callbacks get a copy of the request, not the submitted pointer: the
+// shot is told apart by its user context
+struct Shared {
+	ACameraMetadata *stillResult = nullptr; // first still result, copied
+	int stillResults = 0;
+	int aeState = -1, afState = -1, previewResults = 0;
+	int iso = 0;
+	long long exp = 0;
+};
+
+void onCompleted(void *ctx, ACameraCaptureSession *, ACaptureRequest *req, const ACameraMetadata *m)
+{
+	Shared *s = static_cast<Shared *>(ctx);
+	ACameraMetadata_const_entry e;
+	void *tag = nullptr;
+	ACaptureRequest_getUserContext(req, &tag);
+	if (tag == &s->stillResults) {
+		if (!__atomic_load_n(&s->stillResult, __ATOMIC_ACQUIRE))
+			__atomic_store_n(&s->stillResult, ACameraMetadata_copy(m), __ATOMIC_RELEASE);
+		__atomic_add_fetch(&s->stillResults, 1, __ATOMIC_RELEASE);
+		return;
+	}
+	if (entry(m, ACAMERA_CONTROL_AE_STATE, &e))
+		__atomic_store_n(&s->aeState, (int)e.data.u8[0], __ATOMIC_RELAXED);
+	if (entry(m, ACAMERA_CONTROL_AF_STATE, &e))
+		__atomic_store_n(&s->afState, (int)e.data.u8[0], __ATOMIC_RELAXED);
+	if (entry(m, ACAMERA_SENSOR_SENSITIVITY, &e))
+		__atomic_store_n(&s->iso, e.data.i32[0], __ATOMIC_RELAXED);
+	if (entry(m, ACAMERA_SENSOR_EXPOSURE_TIME, &e))
+		__atomic_store_n(&s->exp, (long long)e.data.i64[0], __ATOMIC_RELAXED);
+	__atomic_add_fetch(&s->previewResults, 1, __ATOMIC_RELEASE);
+}
+
+void noDevice(void *, ACameraDevice *) {}
+void devError(void *, ACameraDevice *, int) {}
+void noSession(void *, ACameraCaptureSession *) {}
+
+struct Output {
+	AImageReader *reader = nullptr;
+	ANativeWindow *window = nullptr;
+	ACaptureSessionOutput *output = nullptr;
+	ACameraOutputTarget *target = nullptr;
+
+	bool create(int w, int h, int format, int images, ACaptureSessionOutputContainer *c)
+	{
+		if (AImageReader_new(w, h, format, images, &reader) != AMEDIA_OK)
+			return false;
+		AImageReader_getWindow(reader, &window);
+		ACaptureSessionOutput_create(window, &output);
+		ACaptureSessionOutputContainer_add(c, output);
+		ACameraOutputTarget_create(window, &target);
+		return true;
+	}
+	void destroy()
+	{
+		if (target)
+			ACameraOutputTarget_free(target);
+		if (output)
+			ACaptureSessionOutput_free(output);
+		if (reader)
+			AImageReader_delete(reader);
+	}
+};
+
+// JPEG buffers carry a blob trailer after the image; cut at the last EOI
+int jpegSize(const uint8_t *d, int n)
+{
+	for (int i = n - 2; i > 1; i--)
+		if (d[i] == 0xff && d[i + 1] == 0xd9)
+			return i + 2;
+	return n;
+}
+
+// the controls both the metering stream and the shot use
+// flash: 0 off, 1 auto, 2 on (already 0 on a lens without flash)
+void controls(ACaptureRequest *r, const Cam2Settings *s, int iso, long long exp, const int32_t *crop, int flash,
+	      bool still)
+{
+	const uint8_t modeAuto = 1;
+	ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_MODE, 1, &modeAuto);
+	if (iso > 0 && exp > 0) {
+		const uint8_t off = 0;
+		const int32_t i = iso;
+		const int64_t e = exp, frame = exp > 33333333 ? exp : 33333333;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AE_MODE, 1, &off);
+		ACaptureRequest_setEntry_i32(r, ACAMERA_SENSOR_SENSITIVITY, 1, &i);
+		ACaptureRequest_setEntry_i64(r, ACAMERA_SENSOR_EXPOSURE_TIME, 1, &e);
+		ACaptureRequest_setEntry_i64(r, ACAMERA_SENSOR_FRAME_DURATION, 1, &frame);
+		if (still && flash == 2) {
+			const uint8_t single = 1;
+			ACaptureRequest_setEntry_u8(r, ACAMERA_FLASH_MODE, 1, &single);
+		}
+	} else {
+		// ON, ON_AUTO_FLASH, ON_ALWAYS_FLASH
+		const uint8_t on = flash == 1 ? 2 : flash == 2 ? 3 : 1;
+		const int32_t ev = s->evSteps;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AE_MODE, 1, &on);
+		ACaptureRequest_setEntry_i32(r, ACAMERA_CONTROL_AE_EXPOSURE_COMPENSATION, 1, &ev);
+	}
+	if (s->focus >= 0) {
+		const uint8_t off = 0;
+		const float d = s->focus;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AF_MODE, 1, &off);
+		ACaptureRequest_setEntry_float(r, ACAMERA_LENS_FOCUS_DISTANCE, 1, &d);
+	} else {
+		const uint8_t continuous = 4; // CONTINUOUS_PICTURE
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AF_MODE, 1, &continuous);
+	}
+	if (s->awb >= 0) {
+		const uint8_t awb = (uint8_t)s->awb;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AWB_MODE, 1, &awb);
+	}
+	if (s->effect >= 0) {
+		const uint8_t effect = (uint8_t)s->effect;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_EFFECT_MODE, 1, &effect);
+	}
+	if (s->antibanding >= 0) {
+		const uint8_t ab = (uint8_t)s->antibanding;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AE_ANTIBANDING_MODE, 1, &ab);
+	}
+	if (s->ois >= 0) {
+		const uint8_t ois = (uint8_t)s->ois;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_LENS_OPTICAL_STABILIZATION_MODE, 1, &ois);
+	}
+	if (crop)
+		ACaptureRequest_setEntry_i32(r, ACAMERA_SCALER_CROP_REGION, 4, crop);
+}
+
+} // namespace
+
+extern "C" int cam2_info(const char *id, Cam2Info *out)
+{
+	// a plain synchronous query: no binder thread pool needed
+	ACameraManager *mgr = ACameraManager_create();
+	ACameraMetadata *ch = nullptr;
+	if (ACameraManager_getCameraCharacteristics(mgr, id, &ch) != ACAMERA_OK) {
+		ACameraManager_delete(mgr);
+		return -1;
+	}
+	ACameraMetadata_const_entry e;
+	*out = Cam2Info();
+	if (entry(ch, ACAMERA_SENSOR_INFO_SENSITIVITY_RANGE, &e)) {
+		out->isoMin = e.data.i32[0];
+		out->isoMax = e.data.i32[1];
+	}
+	if (entry(ch, ACAMERA_SENSOR_INFO_EXPOSURE_TIME_RANGE, &e)) {
+		out->expMinNs = e.data.i64[0];
+		out->expMaxNs = e.data.i64[1];
+	}
+	if (entry(ch, ACAMERA_LENS_INFO_MINIMUM_FOCUS_DISTANCE, &e))
+		out->minFocusDiopters = e.data.f[0];
+	if (entry(ch, ACAMERA_LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION, &e))
+		for (uint32_t i = 0; i < e.count; i++)
+			if (e.data.u8[i] == 1)
+				out->ois = 1;
+	out->manualSensor = hasCap(ch, CAP_MANUAL_SENSOR);
+	out->manualPost = hasCap(ch, CAP_MANUAL_POST_PROCESSING);
+	out->raw = hasCap(ch, CAP_RAW);
+	out->burst = hasCap(ch, CAP_BURST_CAPTURE);
+	largest(ch, AIMAGE_FORMAT_RAW16, &out->rawWidth, &out->rawHeight);
+	largest(ch, AIMAGE_FORMAT_JPEG, &out->jpegWidth, &out->jpegHeight);
+	if (entry(ch, ACAMERA_CONTROL_AE_COMPENSATION_STEP, &e) && e.data.r[0].denominator)
+		out->evStep = (float)e.data.r[0].numerator / e.data.r[0].denominator;
+	if (!out->rawWidth)
+		out->raw = 0;
+	ACameraMetadata_free(ch);
+	ACameraManager_delete(mgr);
+	return 0;
+}
+
+extern "C" int cam2_capture(const char *id, const Cam2Settings *s, cam2_jpeg_cb onJpeg, cam2_raw_cb onRaw,
+			    void *ctx, int *meteredIso, long long *meteredExpNs)
+{
+	startPool();
+	ACameraManager *mgr = ACameraManager_create();
+	ACameraMetadata *ch = nullptr;
+	if (ACameraManager_getCameraCharacteristics(mgr, id, &ch) != ACAMERA_OK) {
+		ACameraManager_delete(mgr);
+		return -1;
+	}
+	int jw = s->jpegWidth, jh = s->jpegHeight;
+	if (!hasSize(ch, AIMAGE_FORMAT_JPEG, jw, jh))
+		largest(ch, AIMAGE_FORMAT_JPEG, &jw, &jh);
+	int rw = 0, rh = 0;
+	if (s->raw && hasCap(ch, CAP_RAW))
+		largest(ch, AIMAGE_FORMAT_RAW16, &rw, &rh);
+	const bool manualOk = hasCap(ch, CAP_MANUAL_SENSOR);
+	ACameraMetadata_const_entry fe;
+	// automatic flash only with fully automatic exposure: after a precapture
+	// sequence the HAL applies its own flash exposure and ignores manual values
+	int flash = entry(ch, ACAMERA_FLASH_INFO_AVAILABLE, &fe) && fe.data.u8[0] ? s->flash : 0;
+	if (flash == 1 && ((manualOk && s->iso > 0) || (manualOk && s->expNs > 0)))
+		flash = 0;
+
+	int32_t crop[4];
+	const int32_t *cropp = nullptr;
+	ACameraMetadata_const_entry e;
+	if (s->zoom > 1.01f && entry(ch, ACAMERA_SENSOR_INFO_ACTIVE_ARRAY_SIZE, &e)) {
+		const int aw = e.data.i32[2] - e.data.i32[0], ah = e.data.i32[3] - e.data.i32[1];
+		crop[2] = (int32_t)(aw / s->zoom);
+		crop[3] = (int32_t)(ah / s->zoom);
+		crop[0] = e.data.i32[0] + (aw - crop[2]) / 2;
+		crop[1] = e.data.i32[1] + (ah - crop[3]) / 2;
+		cropp = crop;
+	}
+	long long expMin = 0, expMax = 0;
+	int isoMin = 0, isoMax = 0;
+	if (entry(ch, ACAMERA_SENSOR_INFO_EXPOSURE_TIME_RANGE, &e)) {
+		expMin = e.data.i64[0];
+		expMax = e.data.i64[1];
+	}
+	if (entry(ch, ACAMERA_SENSOR_INFO_SENSITIVITY_RANGE, &e)) {
+		isoMin = e.data.i32[0];
+		isoMax = e.data.i32[1];
+	}
+
+	ACameraDevice_StateCallbacks devCb = { nullptr, noDevice, devError };
+	ACameraDevice *dev = nullptr;
+	if (ACameraManager_openCamera(mgr, id, &devCb, &dev) != ACAMERA_OK) {
+		ACameraMetadata_free(ch);
+		ACameraManager_delete(mgr);
+		return -2;
+	}
+
+	ACaptureSessionOutputContainer *container = nullptr;
+	ACaptureSessionOutputContainer_create(&container);
+	Output preview, jpeg, raw;
+	int ret = -3;
+	ACameraCaptureSession *session = nullptr;
+	ACaptureRequest *meter = nullptr, *shot = nullptr;
+	// static: results of the metering stream may still arrive after close()
+	static Shared shared;
+	shared = Shared();
+	ACameraCaptureSession_captureCallbacks cb = {};
+	cb.context = &shared;
+	cb.onCaptureCompleted = onCompleted;
+	ACameraCaptureSession_stateCallbacks sesCb = { nullptr, noSession, noSession, noSession };
+	int iso = manualOk ? s->iso : 0;
+	long long exp = manualOk ? s->expNs : 0;
+	int delivered = 0;
+	AImage *rawImage = nullptr;
+
+	if (!preview.create(640, 480, AIMAGE_FORMAT_YUV_420_888, 3, container) ||
+	    !jpeg.create(jw, jh, AIMAGE_FORMAT_JPEG, 2, container) ||
+	    (rw && !raw.create(rw, rh, AIMAGE_FORMAT_RAW16, 1, container)))
+		goto out;
+	ret = -4;
+	if (ACameraDevice_createCaptureSession(dev, container, &sesCb, &session) != ACAMERA_OK)
+		goto out;
+
+	// metering and focusing stream; with both values manual it only lets the
+	// sensor and the lens settle
+	ACameraDevice_createCaptureRequest(dev, TEMPLATE_PREVIEW, &meter);
+	ACaptureRequest_addTarget(meter, preview.target);
+	controls(meter, s, iso > 0 && exp > 0 ? iso : 0, iso > 0 && exp > 0 ? exp : 0, cropp, flash, false);
+	ret = -5;
+	if (ACameraCaptureSession_setRepeatingRequest(session, &cb, 1, &meter, nullptr) != ACAMERA_OK)
+		goto out;
+	for (int t = 0, settled = 0; t < 300; t++) { // up to 3 s
+		usleep(10000);
+		AImage *img = nullptr;
+		if (AImageReader_acquireLatestImage(preview.reader, &img) == AMEDIA_OK && img)
+			AImage_delete(img);
+		const int n = __atomic_load_n(&shared.previewResults, __ATOMIC_ACQUIRE);
+		const int ae = __atomic_load_n(&shared.aeState, __ATOMIC_RELAXED);
+		const int af = __atomic_load_n(&shared.afState, __ATOMIC_RELAXED);
+		const bool aeOk = (iso > 0 && exp > 0) || ae == 2 || ae == 3 || ae == 4;
+		const bool afOk = s->focus >= 0 || af == 0 || af == 2 || af == 4 || af == 6;
+		settled = aeOk && afOk ? settled + 1 : 0;
+		if (n >= 5 && settled >= 3)
+			break;
+	}
+	// flash with automatic exposure: precapture metering (pre-flash) first
+	if (flash && iso <= 0 && exp <= 0) {
+		const uint8_t start = 1;
+		ACaptureRequest_setEntry_u8(meter, ACAMERA_CONTROL_AE_PRECAPTURE_TRIGGER, 1, &start);
+		ACameraCaptureSession_capture(session, &cb, 1, &meter, nullptr);
+		bool seen = false;
+		for (int t = 0; t < 150; t++) { // up to 1.5 s
+			usleep(10000);
+			AImage *img = nullptr;
+			if (AImageReader_acquireLatestImage(preview.reader, &img) == AMEDIA_OK && img)
+				AImage_delete(img);
+			const int ae = __atomic_load_n(&shared.aeState, __ATOMIC_RELAXED);
+			if (ae == 5) // PRECAPTURE
+				seen = true;
+			else if ((seen || t > 50) && (ae == 2 || ae == 3 || ae == 4))
+				break;
+		}
+	}
+	*meteredIso = __atomic_load_n(&shared.iso, __ATOMIC_RELAXED);
+	*meteredExpNs = __atomic_load_n(&shared.exp, __ATOMIC_RELAXED);
+	// one value manual: keep the metered exposure (ISO x time)
+	if (iso > 0 && exp <= 0 && *meteredIso > 0)
+		exp = clampLL((long long)((double)*meteredExpNs * *meteredIso / iso), expMin, expMax);
+	else if (exp > 0 && iso <= 0 && *meteredExpNs > 0)
+		iso = (int)clampLL((long long)((double)*meteredIso * *meteredExpNs / exp), isoMin, isoMax);
+	// the HAL takes the exposure of a still shot from the running stream, not
+	// from the shot's own AE_MODE_OFF: a half-manual setting has to be moved to
+	// the stream first and confirmed by its results
+	if (iso > 0 && exp > 0 && !(manualOk && s->iso > 0 && s->expNs > 0)) {
+		controls(meter, s, iso, exp, cropp, flash == 2 ? 2 : 0, false);
+		if (ACameraCaptureSession_setRepeatingRequest(session, &cb, 1, &meter, nullptr) == ACAMERA_OK)
+			for (int t = 0, ok = 0; t < 150 && ok < 2; t++) { // up to 1.5 s
+				usleep(10000);
+				AImage *img = nullptr;
+				if (AImageReader_acquireLatestImage(preview.reader, &img) == AMEDIA_OK && img)
+					AImage_delete(img);
+				// the sensor rounds the exposure to its line time (30006 for 30000 us)
+				const long long d = __atomic_load_n(&shared.exp, __ATOMIC_RELAXED) - exp;
+				const bool applied = __atomic_load_n(&shared.iso, __ATOMIC_RELAXED) == iso &&
+						     (d < 0 ? -d : d) * 50 < exp;
+				if (applied)
+					ok++;
+			}
+	}
+
+	ACameraDevice_createCaptureRequest(dev, TEMPLATE_STILL_CAPTURE, &shot);
+	ACaptureRequest_addTarget(shot, preview.target);
+	ACaptureRequest_addTarget(shot, jpeg.target);
+	if (rw)
+		ACaptureRequest_addTarget(shot, raw.target);
+	controls(shot, s, iso, exp, cropp, flash, true);
+	{
+		const uint8_t q = (uint8_t)(s->quality > 0 && s->quality <= 100 ? s->quality : 95);
+		const int32_t o = s->orientation;
+		ACaptureRequest_setEntry_u8(shot, ACAMERA_JPEG_QUALITY, 1, &q);
+		ACaptureRequest_setEntry_i32(shot, ACAMERA_JPEG_ORIENTATION, 1, &o);
+		if (s->gps) {
+			const double c[3] = { s->latitude, s->longitude, s->altitude };
+			const int64_t ts = s->gpsTime;
+			static const uint8_t method[] = "GPS";
+			ACaptureRequest_setEntry_double(shot, ACAMERA_JPEG_GPS_COORDINATES, 3, c);
+			ACaptureRequest_setEntry_i64(shot, ACAMERA_JPEG_GPS_TIMESTAMP, 1, &ts);
+			ACaptureRequest_setEntry_u8(shot, ACAMERA_JPEG_GPS_PROCESSING_METHOD, sizeof(method), method);
+		}
+	}
+	ACaptureRequest_setUserContext(shot, &shared.stillResults);
+	{
+		const int count = s->count > 1 ? (s->count > 30 ? 30 : s->count) : 1;
+		ACaptureRequest *shots[30];
+		for (int i = 0; i < count; i++)
+			shots[i] = shot;
+		ret = -6;
+		if (ACameraCaptureSession_capture(session, &cb, count, shots, nullptr) != ACAMERA_OK)
+			goto out;
+		const long long perShot = (exp > 0 ? exp : 100000000LL) / 1000000 + 400;
+		const long long limit = 3000 + perShot * count;
+		bool rawDone = !rw;
+		for (long long t = 0; t < limit && (delivered < count || !rawDone); t += 5) {
+			usleep(5000);
+			AImage *img = nullptr;
+			if (AImageReader_acquireLatestImage(preview.reader, &img) == AMEDIA_OK && img)
+				AImage_delete(img);
+			img = nullptr;
+			if (AImageReader_acquireNextImage(jpeg.reader, &img) == AMEDIA_OK && img) {
+				uint8_t *d = nullptr;
+				int n = 0;
+				AImage_getPlaneData(img, 0, &d, &n);
+				if (d && n > 0)
+					onJpeg(ctx, d, jpegSize(d, n), delivered);
+				delivered++;
+				AImage_delete(img);
+			}
+			if (!rawDone && !rawImage) {
+				if (AImageReader_acquireNextImage(raw.reader, &rawImage) != AMEDIA_OK)
+					rawImage = nullptr;
+			}
+			// the RAW frame waits for its capture result (white balance, gain)
+			ACameraMetadata *res = __atomic_load_n(&shared.stillResult, __ATOMIC_ACQUIRE);
+			if (!rawDone && rawImage && res) {
+				Cam2Dng m = {};
+				uint8_t *d = nullptr;
+				int n = 0;
+				AImage_getPlaneData(rawImage, 0, &d, &n);
+				AImage_getWidth(rawImage, &m.width);
+				AImage_getHeight(rawImage, &m.height);
+				AImage_getPlaneRowStride(rawImage, 0, &m.rowStride);
+				if (entry(ch, ACAMERA_SENSOR_INFO_COLOR_FILTER_ARRANGEMENT, &e))
+					m.cfa = e.data.u8[0];
+				if (entry(ch, ACAMERA_SENSOR_BLACK_LEVEL_PATTERN, &e))
+					for (int i = 0; i < 4 && i < (int)e.count; i++)
+						m.black[i] = e.data.i32[i];
+				if (entry(ch, ACAMERA_SENSOR_INFO_WHITE_LEVEL, &e))
+					m.white = e.data.i32[0];
+				if (entry(ch, ACAMERA_SENSOR_REFERENCE_ILLUMINANT1, &e))
+					m.illuminant1 = e.data.u8[0];
+				if (entry(ch, ACAMERA_SENSOR_REFERENCE_ILLUMINANT2, &e))
+					m.illuminant2 = e.data.u8[0];
+				matrix(ch, ACAMERA_SENSOR_COLOR_TRANSFORM1, m.colorMatrix1, 9);
+				matrix(ch, ACAMERA_SENSOR_COLOR_TRANSFORM2, m.colorMatrix2, 9);
+				matrix(ch, ACAMERA_SENSOR_FORWARD_MATRIX1, m.forwardMatrix1, 9);
+				matrix(ch, ACAMERA_SENSOR_FORWARD_MATRIX2, m.forwardMatrix2, 9);
+				matrix(ch, ACAMERA_SENSOR_CALIBRATION_TRANSFORM1, m.calibration1, 9);
+				matrix(ch, ACAMERA_SENSOR_CALIBRATION_TRANSFORM2, m.calibration2, 9);
+				matrix(res, ACAMERA_SENSOR_NEUTRAL_COLOR_POINT, m.neutral, 3);
+				if (entry(res, ACAMERA_SENSOR_SENSITIVITY, &e))
+					m.iso = e.data.i32[0];
+				if (entry(res, ACAMERA_SENSOR_EXPOSURE_TIME, &e))
+					m.expNs = e.data.i64[0];
+				if (entry(res, ACAMERA_LENS_APERTURE, &e))
+					m.fNumber = e.data.f[0];
+				if (entry(res, ACAMERA_LENS_FOCAL_LENGTH, &e))
+					m.focalLength = e.data.f[0];
+				if (d && n >= m.rowStride * m.height)
+					onRaw(ctx, reinterpret_cast<const unsigned short *>(d), &m);
+				AImage_delete(rawImage);
+				rawImage = nullptr;
+				rawDone = true;
+			}
+		}
+		ret = delivered;
+	}
+
+out:
+	if (rawImage)
+		AImage_delete(rawImage);
+	if (session) {
+		ACameraCaptureSession_stopRepeating(session);
+		ACameraCaptureSession_close(session);
+	}
+	if (meter)
+		ACaptureRequest_free(meter);
+	if (shot)
+		ACaptureRequest_free(shot);
+	ACameraDevice_close(dev);
+	preview.destroy();
+	jpeg.destroy();
+	raw.destroy();
+	ACaptureSessionOutputContainer_free(container);
+	if (ACameraMetadata *res = __atomic_exchange_n(&shared.stillResult, nullptr, __ATOMIC_ACQ_REL))
+		ACameraMetadata_free(res);
+	ACameraMetadata_free(ch);
+	ACameraManager_delete(mgr);
+	return ret;
+}
diff --git a/src/camx/cam2.h b/src/camx/cam2.h
new file mode 100644
index 0000000..f84166a
--- /dev/null
+++ b/src/camx/cam2.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Camera2 still capture in libcamx: what Camera1 cannot do on this HAL
+ * (manual ISO and shutter, manual focus distance, OIS off, RAW sensor data,
+ * burst). Shared by cam2.cpp (bionic side) and the application (glibc side),
+ * so it holds plain C types only.
+ */
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct Cam2Info {
+	int isoMin, isoMax;
+	long long expMinNs, expMaxNs;
+	float minFocusDiopters; // 0: fixed focus
+	int manualSensor, manualPost, raw, burst, ois;
+	int rawWidth, rawHeight;
+	int jpegWidth, jpegHeight; // largest JPEG size
+	float evStep; // exposure compensation step in EV
+};
+
+struct Cam2Settings {
+	int iso; // 0: automatic
+	long long expNs; // 0: automatic
+	float focus; // < 0: autofocus, otherwise diopters (0 = infinity)
+	int ois; // -1: HAL default, 0: off, 1: on
+	int awb; // -1: auto, otherwise android.control.awbMode
+	int evSteps; // exposure compensation when exposure is automatic
+	int jpegWidth, jpegHeight, quality, orientation;
+	float zoom; // >= 1, centred crop of the active array
+	int raw; // also deliver the RAW16 frame of the first shot
+	int count; // JPEG frames (burst when > 1)
+	int gps; // write the location below into the EXIF data
+	double latitude, longitude, altitude;
+	long long gpsTime; // seconds since the epoch
+	int flash; // 0: off, 1: auto (automatic exposure only), 2: on
+	int effect; // -1: none, otherwise android.control.effectMode
+	int antibanding; // -1: HAL default, otherwise android.control.aeAntibandingMode
+};
+
+// what a DNG writer needs, from the static and the capture metadata
+struct Cam2Dng {
+	int width, height, rowStride;
+	int cfa; // android.sensor.info.colorFilterArrangement: 0 RGGB, 1 GRBG, 2 GBRG, 3 BGGR
+	int black[4], white;
+	int illuminant1, illuminant2; // EXIF LightSource values
+	float colorMatrix1[9], colorMatrix2[9], forwardMatrix1[9], forwardMatrix2[9];
+	float calibration1[9], calibration2[9], neutral[3];
+	int iso;
+	long long expNs;
+	float fNumber, focalLength;
+};
+
+typedef void (*cam2_jpeg_cb)(void *ctx, const unsigned char *data, int size, int index);
+typedef void (*cam2_raw_cb)(void *ctx, const unsigned short *data, const struct Cam2Dng *meta);
+
+// 0 on success
+int cam2_info(const char *id, struct Cam2Info *out);
+// Opens the camera (Camera1 must be disconnected), meters, focuses and shoots;
+// the callbacks run on the calling thread. metered: ISO and exposure the
+// automatic exposure chose, from which a half-manual setting is completed.
+// Returns the number of JPEG frames delivered, or a negative error.
+int cam2_capture(const char *id, const struct Cam2Settings *s, cam2_jpeg_cb onJpeg, cam2_raw_cb onRaw,
+		 void *ctx, int *meteredIso, long long *meteredExpNs);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/camx/ndk-camera.h b/src/camx/ndk-camera.h
new file mode 100644
index 0000000..3d5b4f2
--- /dev/null
+++ b/src/camx/ndk-camera.h
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ *
+ * The part of the Android 11 camera NDK (libcamera2ndk, libmediandk,
+ * libbinder_ndk) that cam2.cpp uses, declared by hand so that the build needs
+ * no NDK. Tag and format values are those of the NDK headers of
+ * android-11.0.0_r48 (read from them by the compiler, not typed in).
+ */
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+
+extern "C" {
+
+typedef int32_t camera_status_t;
+typedef int32_t media_status_t;
+enum { ACAMERA_OK = 0, AMEDIA_OK = 0 };
+
+typedef struct ACameraManager ACameraManager;
+typedef struct ACameraDevice ACameraDevice;
+typedef struct ACameraMetadata ACameraMetadata;
+typedef struct ACaptureRequest ACaptureRequest;
+typedef struct ACameraCaptureSession ACameraCaptureSession;
+typedef struct ACaptureSessionOutput ACaptureSessionOutput;
+typedef struct ACaptureSessionOutputContainer ACaptureSessionOutputContainer;
+typedef struct ACameraOutputTarget ACameraOutputTarget;
+typedef struct ANativeWindow ANativeWindow;
+typedef struct AImageReader AImageReader;
+typedef struct AImage AImage;
+
+typedef struct ACameraIdList {
+	int numCameras;
+	const char **cameraIds;
+} ACameraIdList;
+
+typedef struct ACameraMetadata_rational {
+	int32_t numerator;
+	int32_t denominator;
+} ACameraMetadata_rational;
+
+typedef struct ACameraMetadata_const_entry {
+	uint32_t tag;
+	uint8_t type;
+	uint32_t count;
+	union {
+		const uint8_t *u8;
+		const int32_t *i32;
+		const float *f;
+		const int64_t *i64;
+		const double *d;
+		const ACameraMetadata_rational *r;
+	} data;
+} ACameraMetadata_const_entry;
+
+typedef struct ACameraDevice_StateCallbacks {
+	void *context;
+	void (*onDisconnected)(void *context, ACameraDevice *device);
+	void (*onError)(void *context, ACameraDevice *device, int error);
+} ACameraDevice_StateCallbacks;
+
+typedef struct ACameraCaptureSession_stateCallbacks {
+	void *context;
+	void (*onClosed)(void *context, ACameraCaptureSession *session);
+	void (*onReady)(void *context, ACameraCaptureSession *session);
+	void (*onActive)(void *context, ACameraCaptureSession *session);
+} ACameraCaptureSession_stateCallbacks;
+
+typedef struct ACameraCaptureSession_captureCallbacks {
+	void *context;
+	void (*onCaptureStarted)(void *, ACameraCaptureSession *, const ACaptureRequest *, int64_t);
+	void (*onCaptureProgressed)(void *, ACameraCaptureSession *, ACaptureRequest *, const ACameraMetadata *);
+	void (*onCaptureCompleted)(void *, ACameraCaptureSession *, ACaptureRequest *, const ACameraMetadata *);
+	void (*onCaptureFailed)(void *, ACameraCaptureSession *, ACaptureRequest *, void *failure);
+	void (*onCaptureSequenceCompleted)(void *, ACameraCaptureSession *, int, int64_t);
+	void (*onCaptureSequenceAborted)(void *, ACameraCaptureSession *, int);
+	void (*onCaptureBufferLost)(void *, ACameraCaptureSession *, ACaptureRequest *, ANativeWindow *, int64_t);
+} ACameraCaptureSession_captureCallbacks;
+
+// sizes checked against the NDK headers: entry 24 B (count at 8, data at 16),
+// capture callbacks 64 B (onCaptureCompleted at 24), id list 16 B
+static_assert(sizeof(ACameraMetadata_const_entry) == 24, "entry layout");
+static_assert(offsetof(ACameraMetadata_const_entry, data) == 16, "entry layout");
+static_assert(sizeof(ACameraCaptureSession_captureCallbacks) == 64, "callbacks layout");
+static_assert(offsetof(ACameraCaptureSession_captureCallbacks, onCaptureCompleted) == 24, "callbacks layout");
+
+enum {
+	ACAMERA_CONTROL_AE_ANTIBANDING_MODE = 65536,
+	ACAMERA_CONTROL_AE_EXPOSURE_COMPENSATION = 65537,
+	ACAMERA_CONTROL_AE_MODE = 65539,
+	ACAMERA_CONTROL_AE_PRECAPTURE_TRIGGER = 65542,
+	ACAMERA_CONTROL_AF_MODE = 65543,
+	ACAMERA_CONTROL_AWB_MODE = 65547,
+	ACAMERA_CONTROL_EFFECT_MODE = 65550,
+	ACAMERA_CONTROL_MODE = 65551,
+	ACAMERA_CONTROL_AE_COMPENSATION_STEP = 65558,
+	ACAMERA_CONTROL_AE_STATE = 65567,
+	ACAMERA_CONTROL_AF_STATE = 65568,
+	ACAMERA_FLASH_MODE = 262146,
+	ACAMERA_FLASH_INFO_AVAILABLE = 327680,
+	ACAMERA_JPEG_GPS_COORDINATES = 458752,
+	ACAMERA_JPEG_GPS_PROCESSING_METHOD = 458753,
+	ACAMERA_JPEG_GPS_TIMESTAMP = 458754,
+	ACAMERA_JPEG_ORIENTATION = 458755,
+	ACAMERA_JPEG_QUALITY = 458756,
+	ACAMERA_LENS_APERTURE = 524288,
+	ACAMERA_LENS_FOCAL_LENGTH = 524290,
+	ACAMERA_LENS_FOCUS_DISTANCE = 524291,
+	ACAMERA_LENS_OPTICAL_STABILIZATION_MODE = 524292,
+	ACAMERA_LENS_FACING = 524293,
+	ACAMERA_LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION = 589827,
+	ACAMERA_LENS_INFO_MINIMUM_FOCUS_DISTANCE = 589829,
+	ACAMERA_REQUEST_AVAILABLE_CAPABILITIES = 786444,
+	ACAMERA_SCALER_CROP_REGION = 851968,
+	ACAMERA_SCALER_AVAILABLE_STREAM_CONFIGURATIONS = 851978,
+	ACAMERA_SENSOR_EXPOSURE_TIME = 917504,
+	ACAMERA_SENSOR_FRAME_DURATION = 917505,
+	ACAMERA_SENSOR_SENSITIVITY = 917506,
+	ACAMERA_SENSOR_REFERENCE_ILLUMINANT1 = 917507,
+	ACAMERA_SENSOR_REFERENCE_ILLUMINANT2 = 917508,
+	ACAMERA_SENSOR_CALIBRATION_TRANSFORM1 = 917509,
+	ACAMERA_SENSOR_CALIBRATION_TRANSFORM2 = 917510,
+	ACAMERA_SENSOR_COLOR_TRANSFORM1 = 917511,
+	ACAMERA_SENSOR_COLOR_TRANSFORM2 = 917512,
