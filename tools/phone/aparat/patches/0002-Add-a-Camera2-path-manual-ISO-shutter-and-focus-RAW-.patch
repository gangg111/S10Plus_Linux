diff --git a/src/dng-writer.cpp b/src/dng-writer.cpp
new file mode 100644
index 0000000..a968457
--- /dev/null
+++ b/src/dng-writer.cpp
@@ -0,0 +1,193 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <dng-writer.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+
+enum Type { BYTE = 1, ASCII = 2, SHORT = 3, LONG = 4, RATIONAL = 5, SRATIONAL = 10 };
+
+struct Tag {
+	unsigned short id;
+	unsigned short type;
+	unsigned count;
+	std::vector<unsigned char> value; // little endian, count * size of type
+};
+
+void put16(std::vector<unsigned char> &v, unsigned x)
+{
+	v.push_back(x & 0xff);
+	v.push_back((x >> 8) & 0xff);
+}
+
+void put32(std::vector<unsigned char> &v, unsigned x)
+{
+	for (int i = 0; i < 4; i++)
+		v.push_back((x >> (8 * i)) & 0xff);
+}
+
+Tag shorts(unsigned short id, std::initializer_list<unsigned> xs)
+{
+	Tag t{ id, SHORT, (unsigned)xs.size(), {} };
+	for (unsigned x : xs)
+		put16(t.value, x);
+	return t;
+}
+
+Tag longs(unsigned short id, const std::vector<unsigned> &xs)
+{
+	Tag t{ id, LONG, (unsigned)xs.size(), {} };
+	for (unsigned x : xs)
+		put32(t.value, x);
+	return t;
+}
+
+Tag bytes(unsigned short id, std::initializer_list<unsigned> xs)
+{
+	Tag t{ id, BYTE, (unsigned)xs.size(), {} };
+	for (unsigned x : xs)
+		t.value.push_back(x);
+	return t;
+}
+
+Tag ascii(unsigned short id, const std::string &s)
+{
+	Tag t{ id, ASCII, (unsigned)s.size() + 1, {} };
+	t.value.assign(s.begin(), s.end());
+	t.value.push_back(0);
+	return t;
+}
+
+// rationals with a fixed denominator are exact enough for camera matrices
+Tag rationals(unsigned short id, const float *xs, int n, bool isSigned)
+{
+	Tag t{ id, (unsigned short)(isSigned ? SRATIONAL : RATIONAL), (unsigned)n, {} };
+	for (int i = 0; i < n; i++) {
+		const int den = 10000;
+		put32(t.value, (unsigned)(int)std::lround(xs[i] * den));
+		put32(t.value, den);
+	}
+	return t;
+}
+
+Tag rational(unsigned short id, double x, unsigned den)
+{
+	Tag t{ id, RATIONAL, 1, {} };
+	put32(t.value, (unsigned)std::llround(x * den));
+	put32(t.value, den);
+	return t;
+}
+
+bool empty(const float *m, int n)
+{
+	for (int i = 0; i < n; i++)
+		if (m[i] != 0)
+			return false;
+	return true;
+}
+
+} // namespace
+
+bool writeDng(const char *path, const unsigned short *data, const Cam2Dng &m, int orientation,
+	      const char *make, const char *model, const char *dateTime)
+{
+	// CFA pattern colours: 0 red, 1 green, 2 blue
+	static const unsigned char cfa[4][4] = { { 0, 1, 1, 2 }, { 1, 0, 2, 1 }, { 1, 2, 0, 1 }, { 2, 1, 1, 0 } };
+	const unsigned char *pat = cfa[m.cfa >= 0 && m.cfa < 4 ? m.cfa : 0];
+	const unsigned tiffOrientation = orientation == 90 ? 6 : orientation == 180 ? 3 : orientation == 270 ? 8 : 1;
+	const unsigned imageBytes = unsigned(m.width) * m.height * 2;
+
+	std::vector<Tag> tags;
+	tags.push_back(longs(254, { 0 })); // NewSubFileType: main image
+	tags.push_back(longs(256, { unsigned(m.width) }));
+	tags.push_back(longs(257, { unsigned(m.height) }));
+	tags.push_back(shorts(258, { 16 }));
+	tags.push_back(shorts(259, { 1 })); // no compression
+	tags.push_back(shorts(262, { 32803 })); // CFA
+	tags.push_back(ascii(271, make));
+	tags.push_back(ascii(272, model));
+	tags.push_back(longs(273, { 0 })); // StripOffsets, patched below
+	tags.push_back(shorts(274, { tiffOrientation }));
+	tags.push_back(shorts(277, { 1 }));
+	tags.push_back(longs(278, { unsigned(m.height) }));
+	tags.push_back(longs(279, { imageBytes }));
+	tags.push_back(shorts(284, { 1 }));
+	tags.push_back(ascii(305, "droidian-camera"));
+	tags.push_back(ascii(306, dateTime));
+	tags.push_back(shorts(33421, { 2, 2 })); // CFARepeatPatternDim
+	tags.push_back(bytes(33422, { pat[0], pat[1], pat[2], pat[3] }));
+	if (m.expNs > 0)
+		tags.push_back(rational(33434, m.expNs / 1e9, 1000000000u)); // ExposureTime
+	if (m.fNumber > 0)
+		tags.push_back(rational(33437, m.fNumber, 100)); // FNumber
+	if (m.iso > 0)
+		tags.push_back(shorts(34855, { unsigned(m.iso) })); // ISO
+	if (m.focalLength > 0)
+		tags.push_back(rational(37386, m.focalLength, 100)); // FocalLength
+	tags.push_back(bytes(50706, { 1, 4, 0, 0 })); // DNGVersion
+	tags.push_back(bytes(50707, { 1, 1, 0, 0 })); // DNGBackwardVersion
+	tags.push_back(ascii(50708, std::string(make) + " " + model)); // UniqueCameraModel
+	tags.push_back(shorts(50713, { 2, 2 })); // BlackLevelRepeatDim
+	tags.push_back(longs(50714, { unsigned(m.black[0]), unsigned(m.black[1]), unsigned(m.black[2]),
+				      unsigned(m.black[3]) }));
+	tags.push_back(longs(50717, { unsigned(m.white) }));
+	tags.push_back(rationals(50721, m.colorMatrix1, 9, true));
+	if (!empty(m.colorMatrix2, 9))
+		tags.push_back(rationals(50722, m.colorMatrix2, 9, true));
+	if (!empty(m.calibration1, 9))
+		tags.push_back(rationals(50723, m.calibration1, 9, true));
+	if (!empty(m.calibration2, 9))
+		tags.push_back(rationals(50724, m.calibration2, 9, true));
+	if (!empty(m.neutral, 3))
+		tags.push_back(rationals(50728, m.neutral, 3, false)); // AsShotNeutral
+	tags.push_back(shorts(50778, { unsigned(m.illuminant1) }));
+	if (!empty(m.colorMatrix2, 9))
+		tags.push_back(shorts(50779, { unsigned(m.illuminant2) }));
+	if (!empty(m.forwardMatrix1, 9))
+		tags.push_back(rationals(50964, m.forwardMatrix1, 9, true));
+	if (!empty(m.forwardMatrix2, 9))
+		tags.push_back(rationals(50965, m.forwardMatrix2, 9, true));
+
+	// layout: header, IFD, out-of-line values, image
+	const unsigned ifdSize = 2 + tags.size() * 12 + 4;
+	unsigned extra = 8 + ifdSize;
+	std::vector<unsigned char> ifd, values;
+	put16(ifd, tags.size());
+	for (Tag &t : tags) {
+		put16(ifd, t.id);
+		put16(ifd, t.type);
+		put32(ifd, t.count);
+		if (t.value.size() <= 4) {
+			std::vector<unsigned char> v = t.value;
+			v.resize(4, 0);
+			ifd.insert(ifd.end(), v.begin(), v.end());
+		} else {
+			put32(ifd, extra + values.size());
+			values.insert(values.end(), t.value.begin(), t.value.end());
+			if (values.size() & 1)
+				values.push_back(0);
+		}
+	}
+	put32(ifd, 0); // no next IFD
+	const unsigned imageOffset = extra + values.size();
+	// StripOffsets is the 9th entry (index 8), value at 2 + 8 * 12 + 8
+	const unsigned at = 2 + 8 * 12 + 8;
+	for (int i = 0; i < 4; i++)
+		ifd[at + i] = (imageOffset >> (8 * i)) & 0xff;
+
+	FILE *f = std::fopen(path, "wb");
+	if (!f)
+		return false;
+	const unsigned char header[8] = { 'I', 'I', 42, 0, 8, 0, 0, 0 };
+	bool ok = std::fwrite(header, 1, 8, f) == 8 && std::fwrite(ifd.data(), 1, ifd.size(), f) == ifd.size() &&
+		  std::fwrite(values.data(), 1, values.size(), f) == values.size();
+	const unsigned char *row = reinterpret_cast<const unsigned char *>(data);
+	for (int y = 0; ok && y < m.height; y++, row += m.rowStride)
+		ok = std::fwrite(row, 1, m.width * 2, f) == size_t(m.width) * 2;
+	return std::fclose(f) == 0 && ok;
+}
