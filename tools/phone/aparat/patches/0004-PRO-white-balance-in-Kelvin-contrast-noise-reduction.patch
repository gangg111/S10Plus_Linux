+// colour temperature of an EXIF LightSource value (the two calibration illuminants)
+double illuminantKelvin(int e)
+{
+	switch (e) {
+	case 17: return 2856; // standard light A
+	case 18: return 4874; // B
+	case 19: return 6774; // C
+	case 20: return 5503; // D55
+	case 21: return 6504; // D65
+	case 22: return 7504; // D75
+	case 23: return 5003; // D50
+	case 2: return 4230; // fluorescent
+	case 3: return 2856; // tungsten
+	default: return 0;
+	}
+}
+
+// White balance gains (R, Geven, Godd, B) for a colour temperature the way a DNG
+// reader computes them: point on the Planckian locus (Kim et al. 2002) -> XYZ ->
+// camera through the colour matrix interpolated in 1/T between the two
+// calibration illuminants. Returns false without calibration data.
+bool kelvinGains(const ACameraMetadata *ch, double t, float g[4])
+{
+	float m1[9], m2[9];
+	matrix(ch, ACAMERA_SENSOR_COLOR_TRANSFORM1, m1, 9);
+	matrix(ch, ACAMERA_SENSOR_COLOR_TRANSFORM2, m2, 9);
+	ACameraMetadata_const_entry e;
+	const double t1 = entry(ch, ACAMERA_SENSOR_REFERENCE_ILLUMINANT1, &e) ? illuminantKelvin(e.data.u8[0]) : 0;
+	const double t2 = entry(ch, ACAMERA_SENSOR_REFERENCE_ILLUMINANT2, &e) ? illuminantKelvin(e.data.u8[0]) : 0;
+	if (t1 <= 0 || m1[0] == 0)
+		return false;
+	t = t < 1667 ? 1667 : t > 25000 ? 25000 : t;
+	const double t3 = t * t * t;
+	const double x = t <= 4000 ? -0.2661239e9 / t3 - 0.2343589e6 / (t * t) + 0.8776956e3 / t + 0.179910
+				   : -3.0258469e9 / t3 + 2.1070379e6 / (t * t) + 0.2226347e3 / t + 0.240390;
+	const double y = t <= 2222 ? -1.1063814 * x * x * x - 1.34811020 * x * x + 2.18555832 * x - 0.20219683
+			 : t <= 4000 ? -0.9549476 * x * x * x - 1.37418593 * x * x + 2.09137015 * x - 0.16748867
+				     : 3.0817580 * x * x * x - 5.87338670 * x * x + 3.75112997 * x - 0.37001483;
+	const double xyz[3] = { x / y, 1.0, (1.0 - x - y) / y };
+	double w = 1;
+	if (t2 > 0 && m2[0] != 0 && t1 != t2) {
+		w = (1.0 / t - 1.0 / t2) / (1.0 / t1 - 1.0 / t2);
+		w = w < 0 ? 0 : w > 1 ? 1 : w;
+	}
+	double cam[3];
+	for (int r = 0; r < 3; r++) {
+		cam[r] = 0;
+		for (int c = 0; c < 3; c++)
+			cam[r] += (w * m1[3 * r + c] + (1 - w) * (t2 > 0 && m2[0] != 0 ? m2[3 * r + c] : m1[3 * r + c])) * xyz[c];
+	}
+	if (cam[0] <= 0 || cam[1] <= 0 || cam[2] <= 0)
+		return false;
+	g[0] = (float)(cam[1] / cam[0]);
+	g[1] = g[2] = 1.0f;
+	g[3] = (float)(cam[1] / cam[2]);
+	return true;
+}
+
+// manual white balance, tone curve, noise reduction and sharpening
+void postProcessing(ACaptureRequest *r, const Cam2Settings *s, const ACameraMetadata *ch, const Shared *sh)
+{
+	if (s->noise >= 0) {
+		const uint8_t v = (uint8_t)s->noise;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_NOISE_REDUCTION_MODE, 1, &v);
+	}
+	if (s->edge >= 0) {
+		const uint8_t v = (uint8_t)s->edge;
+		ACaptureRequest_setEntry_u8(r, ACAMERA_EDGE_MODE, 1, &v);
+	}
+	if (!ch || !hasCap(ch, CAP_MANUAL_POST_PROCESSING))
+		return;
+	float g[4];
+	if (s->kelvin > 0 && kelvinGains(ch, s->kelvin, g)) {
+		const uint8_t off = 0, matrixMode = 0; // AWB OFF, TRANSFORM_MATRIX
+		ACaptureRequest_setEntry_u8(r, ACAMERA_CONTROL_AWB_MODE, 1, &off);
+		ACaptureRequest_setEntry_u8(r, ACAMERA_COLOR_CORRECTION_MODE, 1, &matrixMode);
+		ACaptureRequest_setEntry_float(r, ACAMERA_COLOR_CORRECTION_GAINS, 4, g);
+		// keep the camera -> sRGB matrix the automatic white balance used last
+		if (sh && __atomic_load_n(&sh->haveCcm, __ATOMIC_ACQUIRE))
+			ACaptureRequest_setEntry_rational(r, ACAMERA_COLOR_CORRECTION_TRANSFORM, 9, sh->ccm);
+	}
+	if (s->contrast != 0) {
+		// sRGB curve with an S (or inverted S) on top; monotonic for |contrast| <= 2
+		enum { N = 64 };
+		float curve[2 * N];
+		const double k = 0.075 * (s->contrast < -2 ? -2 : s->contrast > 2 ? 2 : s->contrast);
+		for (int i = 0; i < N; i++) {
+			const double in = (double)i / (N - 1);
+			const double srgb = in <= 0.0031308 ? 12.92 * in : 1.055 * __builtin_pow(in, 1 / 2.4) - 0.055;
+			double out = srgb - k * __builtin_sin(6.283185307179586 * srgb);
+			out = out < 0 ? 0 : out > 1 ? 1 : out;
+			curve[2 * i] = (float)in;
+			curve[2 * i + 1] = (float)out;
+		}
+		const uint8_t contrastCurve = 0; // TONEMAP_MODE_CONTRAST_CURVE
+		ACaptureRequest_setEntry_u8(r, ACAMERA_TONEMAP_MODE, 1, &contrastCurve);
+		ACaptureRequest_setEntry_float(r, ACAMERA_TONEMAP_CURVE_RED, 2 * N, curve);
+		ACaptureRequest_setEntry_float(r, ACAMERA_TONEMAP_CURVE_GREEN, 2 * N, curve);
+		ACaptureRequest_setEntry_float(r, ACAMERA_TONEMAP_CURVE_BLUE, 2 * N, curve);
+	}
+}
+
 // the controls both the metering stream and the shot use
 // flash: 0 off, 1 auto, 2 on (already 0 on a lens without flash); active: the
 // active array, given for a live session (area, torch, locks, AF trigger)
@@ -372,6 +484,12 @@ extern "C" int cam2_info(const char *id, Cam2Info *out)
 	largest(ch, AIMAGE_FORMAT_JPEG, &out->jpegWidth, &out->jpegHeight);
 	if (entry(ch, ACAMERA_CONTROL_AE_COMPENSATION_STEP, &e) && e.data.r[0].denominator)
 		out->evStep = (float)e.data.r[0].numerator / e.data.r[0].denominator;
+	if (entry(ch, ACAMERA_NOISE_REDUCTION_AVAILABLE_NOISE_REDUCTION_MODES, &e))
+		for (uint32_t i = 0; i < e.count; i++)
+			out->noiseModes |= 1 << e.data.u8[i];
+	if (entry(ch, ACAMERA_EDGE_AVAILABLE_EDGE_MODES, &e))
+		for (uint32_t i = 0; i < e.count; i++)
+			out->edgeModes |= 1 << e.data.u8[i];
 	if (!out->rawWidth)
 		out->raw = 0;
 	ACameraMetadata_free(ch);
@@ -530,6 +648,7 @@ extern "C" int cam2_capture(const char *id, const Cam2Settings *s, cam2_jpeg_cb
 	if (rw)
 		ACaptureRequest_addTarget(shot, raw.target);
 	controls(shot, s, iso, exp, cropp, flash, true);
+	postProcessing(shot, s, ch, &shared);
 	{
 		const uint8_t q = (uint8_t)(s->quality > 0 && s->quality <= 100 ? s->quality : 95);
 		const int32_t o = s->orientation;
@@ -711,6 +830,7 @@ ACaptureRequest *streamRequest(Session *S, bool trigger)
 		ACaptureRequest_addTarget(r, S->encTarget);
 	const int flash = S->cfg.video || !S->flashAvail ? 0 : S->ctl.flash;
 	controls(r, &S->ctl, S->liveIso, S->liveExp, S->hasCrop ? S->crop : nullptr, flash, false, S->active);
+	postProcessing(r, &S->ctl, S->ch, &S->shared);
 	const int fps = S->cfg.fps > 0 ? S->cfg.fps : 30;
 	if (S->liveIso > 0 && S->liveExp > 0) {
 		const int64_t frame = S->liveExp > 1000000000LL / fps ? S->liveExp : 1000000000LL / fps;
@@ -865,6 +985,8 @@ extern "C" void *cam2s_open(const char *id, const Cam2SessionConfig *cfg, int *e
 	S->ctl.awb = -1;
 	S->ctl.effect = -1;
 	S->ctl.antibanding = -1;
+	S->ctl.noise = -1;
+	S->ctl.edge = -1;
 	S->ctl.zoom = 1;
 	*error = -1;
 	S->mgr = ACameraManager_create();
@@ -1059,6 +1181,7 @@ extern "C" int cam2s_still(void *session, const Cam2Settings *s, cam2_jpeg_cb on
 	Cam2Settings c = S->ctl;
 	c.flash = s->flash;
 	controls(shot, &c, S->liveIso, S->liveExp, S->hasCrop ? S->crop : nullptr, flash, true, S->active);
+	postProcessing(shot, &c, S->ch, &S->shared);
 	const uint8_t q = (uint8_t)(s->quality > 0 && s->quality <= 100 ? s->quality : 95);
 	const int32_t o = s->orientation;
 	ACaptureRequest_setEntry_u8(shot, ACAMERA_JPEG_QUALITY, 1, &q);
