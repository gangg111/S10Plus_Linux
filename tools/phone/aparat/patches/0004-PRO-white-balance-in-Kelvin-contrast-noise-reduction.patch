diff --git a/src/hybris-camera-cam2.cpp b/src/hybris-camera-cam2.cpp
index de506db..12955cb 100644
--- a/src/hybris-camera-cam2.cpp
+++ b/src/hybris-camera-cam2.cpp
@@ -97,6 +97,48 @@ void HybrisCamera::loadProSettings()
 	m_rawCapture = s.value("Pro/raw", false).toBool();
 	m_ois = s.value("Pro/ois", true).toBool();
 	m_burstCount = s.value("Pro/burst", 10).toInt();
+	m_kelvin = s.value("Pro/kelvin", 0).toInt();
+	m_contrast = s.value("Pro/contrast", 0).toInt();
+	m_noiseMode = s.value("Pro/noise", -1).toInt();
+	m_edgeMode = s.value("Pro/edge", -1).toInt();
+}
+
+void HybrisCamera::setKelvin(int k)
+{
+	k = k <= 0 ? 0 : qBound(2300, k, 10000);
+	if (k == m_kelvin)
+		return;
+	m_kelvin = k;
+	QSettings().setValue("Pro/kelvin", k);
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setContrast(int c)
+{
+	c = qBound(-2, c, 2);
+	if (c == m_contrast)
+		return;
+	m_contrast = c;
+	QSettings().setValue("Pro/contrast", c);
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setNoiseMode(int m)
+{
+	if (m == m_noiseMode)
+		return;
+	m_noiseMode = m;
+	QSettings().setValue("Pro/noise", m);
+	Q_EMIT proChanged();
+}
+
+void HybrisCamera::setEdgeMode(int m)
+{
+	if (m == m_edgeMode)
+		return;
+	m_edgeMode = m;
+	QSettings().setValue("Pro/edge", m);
+	Q_EMIT proChanged();
 }
 
