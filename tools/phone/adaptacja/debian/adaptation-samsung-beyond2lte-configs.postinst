#!/bin/sh
set -e

# copies of a packaged file left in a place that shadows or duplicates it
drop_if_same() {
	if [ -f "$2" ] && cmp -s "$1" "$2"; then
		rm -f "$2"
	fi
}

# Firefox: mobile-config-firefox sklada userChrome.css i userContent.css z fragmentow
# wymienionych w swoich listach w /etc i nie ma katalogu na dodatkowe wpisy, wiec
# nasze dwa fragmenty dopisujemy na koniec list (ostatni wygrywa).  Wyzwalacz na
# /etc/mobile-config-firefox wola nas znowu, gdy aktualizacja podmieni listy.
firefox_fragments() {
	M=/etc/mobile-config-firefox
	for pair in userChrome:userChrome/s10plus-pasek-u-gory.css \
	            userContent:userContent/s10plus-strona-glowna.css; do
		list=$M/${pair%%:*}.files
		line=${pair#*:}
		if [ -f "$list" ] && [ -f "$M/$line" ] && ! grep -qxF "$line" "$list"; then
			echo "$line" >> "$list"
		fi
	done
}

if [ "$1" = triggered ]; then
	firefox_fragments
fi

if [ "$1" = configure ]; then
	firefox_fragments

	# hand-installed copies from before version 2 (rules in /etc override
	# the packaged ones in /usr/lib, so identical ones are dropped)
	drop_if_same /usr/lib/udev/rules.d/70-beyond2lte.rules /etc/udev/rules.d/70-beyond2lte.rules
	drop_if_same /usr/lib/udev/rules.d/70-wibrator.rules /etc/udev/rules.d/70-wibrator.rules
	drop_if_same /usr/lib/s10plus/autojasnosc.py /usr/local/lib/autojasnosc/autojasnosc.py
	drop_if_same /usr/lib/s10plus/dotyk-boost.py /usr/local/lib/dotyk-boost/dotyk-boost.py
	drop_if_same /usr/lib/s10plus/rndis-usb.sh /usr/local/sbin/rndis-usb.sh
	rmdir /usr/local/lib/autojasnosc /usr/local/lib/dotyk-boost 2>/dev/null || true

	# RNDIS wlaczony recznie przed wersja 15 zostaje wlaczony (znacznik z preinst)
	M=/var/lib/adaptation-samsung-beyond2lte/rndis-usb-enabled
	if [ -f "$M" ]; then
		systemctl enable rndis-usb.service >/dev/null 2>&1 || true
		rm -f "$M"
		rmdir /var/lib/adaptation-samsung-beyond2lte 2>/dev/null || true
	fi

	# Do wersji 15 binder.conf z ofono-configs-binder-common byl przekierowany
	# i zastapiony naszym; przekierowanie konfiguracji z /etc konczylo sie
	# pytaniem dpkg ("Deleted locally since installation"), na ktorym staje
	# budowa obrazu.  Teraz zakres sygnalu siedzi w binder.d/90-s10plus.conf,
	# wiec nasz stary plik znika, a oryginal wraca z .distrib.
	B=/etc/ofono/binder.conf
	if [ "$(dpkg-divert --listpackage "$B")" = adaptation-samsung-beyond2lte-configs ]; then
		rm -f "$B"
		dpkg-divert --package adaptation-samsung-beyond2lte-configs --rename --remove "$B"
	fi

	if command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload-rules 2>/dev/null || true
	fi

	# boot splash: the frame S-Boot leaves on the panel, no jump at hand-over
	if command -v plymouth-set-default-theme >/dev/null 2>&1 &&
	   [ "$(plymouth-set-default-theme 2>/dev/null)" != debian-s10 ]; then
		plymouth-set-default-theme debian-s10 || true
	fi
fi

#DEBHELPER#

exit 0
