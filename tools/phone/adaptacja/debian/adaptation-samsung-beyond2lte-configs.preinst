#!/bin/sh
# Before the files of this package are unpacked: the same functions were
# installed by hand on the first phone (version 1 did not carry them).  The
# hand-made unit and autostart entry are removed here so dpkg can install the
# packaged ones (an unowned /etc file that differs would stop on a conffile
# prompt).
set -e

if [ "$1" = install ] || [ "$1" = upgrade ]; then
	if [ -z "$2" ] || dpkg --compare-versions "$2" lt 2; then
		if [ -f /etc/systemd/system/dotyk-boost.service ] && [ ! -L /etc/systemd/system/dotyk-boost.service ]; then
			rm -f /etc/systemd/system/multi-user.target.wants/dotyk-boost.service
			rm -f /etc/systemd/system/dotyk-boost.service
		fi
		rm -f /etc/xdg/autostart/autojasnosc.desktop
	fi

	# Wersja 15 pakuje to, co na pierwszym telefonie bylo wgrane recznie: uslugi
	# modemu i RNDIS (jednostka w /etc przeslania te z pakietu), stare ustawienia
	# bezczynnosci logind (teraz 90-s10plus.conf) i skrypt RNDIS w /usr/local.
	# Wlaczony recznie RNDIS zostaje wlaczony (znacznik dla postinst).
	if [ -z "$2" ] || dpkg --compare-versions "$2" lt 15; then
		W=/etc/systemd/system/multi-user.target.wants
		if [ -L "$W/rndis-usb.service" ]; then
			mkdir -p /var/lib/adaptation-samsung-beyond2lte
			touch /var/lib/adaptation-samsung-beyond2lte/rndis-usb-enabled
		fi
		for u in modem-radio-on modem-mm-kick rndis-usb; do
			if [ -f "/etc/systemd/system/$u.service" ] && [ ! -L "/etc/systemd/system/$u.service" ]; then
				rm -f "$W/$u.service" "/etc/systemd/system/$u.service"
			fi
		done
		for f in /etc/systemd/logind.conf.d/20-idle-suspend.conf /etc/systemd/logind.conf.d/50-no-idle-suspend.conf; do
			if [ -f "$f" ] && ! dpkg -S "$f" >/dev/null 2>&1 && grep -q '^IdleAction=' "$f"; then
				rm -f "$f"
			fi
		done
	fi

	# mm_modem.py: ofono2mm z bramka na PinRequired, ktorego ofono jeszcze nie
	# wyslal zaraz po wlozeniu karty (bez niej KeyError i modem w stanie failed).
	# (binder.conf do wersji 15 tez byl przekierowany; teraz binder.d, patrz postinst)
	# keep in sync with postrm
	PKG=adaptation-samsung-beyond2lte-configs
	for f in /usr/lib/ofono2mm/ofono2mm/mm_modem.py; do
		owner=$(dpkg-divert --listpackage "$f")
		if [ "$owner" = "$PKG" ]; then
			:
		elif [ -z "$owner" ]; then
			dpkg-divert --package "$PKG" --divert "$f.distrib" --rename --add "$f"
		else
			echo "$f is diverted by $owner, not touching it" >&2
			exit 1
		fi
	done
fi

#DEBHELPER#

exit 0
