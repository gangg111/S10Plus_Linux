#!/usr/bin/make -f

%:
	dh $@

# The prebuilt binaries are shipped exactly as they were built and tested on
# the phone (no stripping, no debug split), so their checksums stay comparable.
override_dh_strip:
override_dh_dwz:

# The One UI QML overlays are made from the archive packages at build time
# (qml-oneui.sh).  After dh_prep, which deletes the substvars it writes.
override_dh_install:
	sh qml-oneui.sh build/oneui debian/adaptation-samsung-beyond2lte-tools.substvars
	dh_install

override_dh_clean:
	dh_clean
	rm -rf build

# debian/adaptation-samsung-beyond2lte-configs.<name>.service
# rndis-usb to jedyna dzialajaca siec po kablu na tym jadrze (usb-tethering z
# hybris-usb pada), wiec jest wlaczona od pierwszego startu; --no-start, bo
# przelaczenie gadzetu w trakcie instalacji zrywa polaczenie po kablu.
override_dh_installsystemd:
	dh_installsystemd --name=dotyk-boost
	dh_installsystemd --name=s10-autosleep
	dh_installsystemd --name=modem-mm-kick
	dh_installsystemd --name=modem-radio-on
	dh_installsystemd --name=rndis-usb --no-start
