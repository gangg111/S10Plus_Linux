#!/bin/sh
# plasma_session and ksplashqml of plasma-workspace are replaced by builds with
# the Droidian KDE_NO_KWIN patches.  The first phone had local diversions made
# by hand (the Debian binaries moved to *.distrib); they become diversions of
# this package without moving any file again.  The default wayfire.ini of
# plasma-mobile-wf (copied to ~/.config on the first session start) is
# replaced by the S10+ one: podglad plugin, task switcher gestures, scale 3,
# no grid crossfade.  plasma-settings is replaced by the One UI build, with its
# Polish strings and the top level categories in One UI order (the originals
# move to *.distrib, which the category loader does not read).  FormCard of
# kirigami-addons gets One UI cards on the phone: margin and rounded corners
# instead of edge to edge; its qmldir loses "prefer", so the QML files on disk
# are used instead of the copies compiled into the plugin.  The same for the
# Kirigami page header and the Breeze ToolBar: with the panels auto-hidden
# they end before the front camera hole in the top right corner.
# maliit-keyboard becomes a wrapper that preloads librgba8888 (the real binary
# moves to *.distrib), so the keyboard panel is transparent instead of black.
set -e

PKG=adaptation-samsung-beyond2lte-tools
C=/usr/share/plasma-settings/categories
Q=/usr/lib/aarch64-linux-gnu/qt6/qml/org/kde/kirigamiaddons/formcard
K=/usr/lib/aarch64-linux-gnu/qt6/qml/org/kde/kirigami/controls
B=/usr/lib/aarch64-linux-gnu/qt6/qml/org/kde/breeze
# keep in sync with postrm
DIVERTED="/usr/bin/plasma_session /usr/bin/ksplashqml /usr/share/plasma-mobile-wf/wayfire.ini
/usr/bin/plasma-settings /usr/share/locale/pl/LC_MESSAGES/mobile.plasmasettings.mo
$C/settings-network.desktop $C/settings-hardware.desktop $C/settings-hardware-input.desktop
$C/settings-applications.desktop $C/settings-appearance.desktop $C/settings-personalization.desktop
$Q/qmldir $Q/FormCard.qml $Q/FormDelegateBackground.qml $Q/FormHeader.qml
$Q/FormTextDelegate.qml $Q/FormSwitchDelegate.qml $Q/FormButtonDelegate.qml $Q/private/FormCardUnits.qml
$K/qmldir $K/private/globaltoolbar/ToolBarPageHeader.qml $B/qmldir $B/ToolBar.qml
/usr/bin/maliit-keyboard"

if [ "$1" = install ] || [ "$1" = upgrade ]; then
	for f in $DIVERTED; do
		owner=$(dpkg-divert --listpackage "$f")
		if [ "$owner" = "$PKG" ]; then
			continue
		elif [ "$owner" = LOCAL ]; then
			# the Debian binary already sits in $f.distrib
			dpkg-divert --local --no-rename --remove "$f"
			dpkg-divert --package "$PKG" --divert "$f.distrib" --no-rename --add "$f"
		elif [ -z "$owner" ]; then
			dpkg-divert --package "$PKG" --divert "$f.distrib" --rename --add "$f"
		else
			echo "$f is diverted by $owner, not touching it" >&2
			exit 1
		fi
	done
fi

#DEBHELPER#

exit 0
