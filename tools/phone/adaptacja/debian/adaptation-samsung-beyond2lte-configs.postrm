#!/bin/sh
set -e

if [ "$1" = remove ] || [ "$1" = purge ]; then
	# back to the theme of the distribution when ours goes away
	if command -v plymouth-set-default-theme >/dev/null 2>&1 &&
	   [ "$(plymouth-set-default-theme 2>/dev/null)" = debian-s10 ]; then
		plymouth-set-default-theme droidian 2>/dev/null || true
	fi
fi

if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
	# binder.conf i mm_modem.py wracaja do wersji z ich pakietow
	# keep in sync with preinst
	PKG=adaptation-samsung-beyond2lte-configs
	for f in /etc/ofono/binder.conf /usr/lib/ofono2mm/ofono2mm/mm_modem.py; do
		if [ "$(dpkg-divert --listpackage "$f")" = "$PKG" ]; then
			dpkg-divert --package "$PKG" --rename --remove "$f"
		fi
	done
fi

#DEBHELPER#

exit 0
