+}
+
+QString ShellUtil::symbolicIcon(const QString &name)
+{
+    // not a theme icon name (a path or a URL)
+    if (name.isEmpty() || name.contains(QLatin1Char('/'))) {
+        return name;
+    }
+
+    static QHash<QString, QString> cache;
+    const auto cached = cache.constFind(name);
+    if (cached != cache.constEnd()) {
+        return *cached;
+    }
+
+    QString base = name;
+    if (base.endsWith(QLatin1String("-symbolic"))) {
+        base.chop(int(qstrlen("-symbolic")));
+    }
+
+    // the small Breeze sizes are all flat glyphs, symbolic or not
+    static const QStringList contexts{QStringLiteral("actions"),
+                                      QStringLiteral("status"),
+                                      QStringLiteral("devices"),
+                                      QStringLiteral("preferences"),
+                                      QStringLiteral("places"),
+                                      QStringLiteral("apps"),
+                                      QStringLiteral("applets"),
+                                      QStringLiteral("emblems"),
+                                      QStringLiteral("categories")};
+    static const QStringList sizes{QStringLiteral("24"), QStringLiteral("22"), QStringLiteral("16")};
+    static const QStringList suffixes{QStringLiteral("-symbolic.svg"), QStringLiteral(".svg")};
+
+    const QString root = QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("icons/breeze"), QStandardPaths::LocateDirectory);
+    const auto find = [&]() -> QString {
+        if (root.isEmpty()) {
+            return name;
+        }
+        for (const QString &suffix : suffixes) {
+            for (const QString &size : sizes) {
+                for (const QString &context : contexts) {
+                    const QString path = root + QLatin1Char('/') + context + QLatin1Char('/') + size + QLatin1Char('/') + base + suffix;
+                    if (QFile::exists(path)) {
+                        return path;
+                    }
+                }
+            }
+        }
+        return name;
+    };
+
+    const QString found = find();
+    cache.insert(name, found);
+    return found;
+}
