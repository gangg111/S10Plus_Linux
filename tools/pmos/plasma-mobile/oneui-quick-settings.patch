--- a/kwin/mobiletaskswitcher/plugin/drawerblur.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/kwin/mobiletaskswitcher/plugin/drawerblur.cpp	2026-09-27 21:56:26.948696100 +0200
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: 2026 Artur Szafraniec <ganggg111@gmail.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "drawerblur.h"
+
+#include <effect/effecthandler.h>
+#include <effect/effectwindow.h>
+#include <window.h>
+
+#include <QDBusConnection>
+
+#include <algorithm>
+#include <cmath>
+
+namespace KWin
+{
+
+DrawerBlur::DrawerBlur(QObject *parent)
+    : QObject{parent}
+{
+    QDBusConnection::sessionBus().registerObject(QStringLiteral("/org/kde/plasma/mobile/DrawerBlur"), this, QDBusConnection::ExportScriptableSlots);
+
+    // a freshly shown blur window must not flash at full blur before the
+    // shell sends the current strength
+    connect(effects, &EffectsHandler::windowAdded, this, [this](EffectWindow *window) {
+        apply(window);
+    });
+}
+
+void DrawerBlur::setStrength(double strength)
+{
+    // the blur is blended with opacity squared: take the square root so the
+    // blur grows evenly with the strength
+    m_opacity = std::sqrt(std::clamp(strength, 0.0, 1.0));
+
+    const auto windows = effects->stackingOrder();
+    for (EffectWindow *window : windows) {
+        apply(window);
+    }
+}
+
+void DrawerBlur::apply(EffectWindow *window) const
+{
+    // the shell's blur window is its only window with the "splash" scope
+    // (the login splash screen is a splash too, but not from plasmashell)
+    if (window && window->isSplash() && window->window() && window->windowClass().contains(QLatin1String("plasmashell"))) {
+        window->window()->setOpacity(m_opacity);
+    }
+}
+}
diff -ruN la2/kwin/mobiletaskswitcher/plugin/drawerblur.h lb/kwin/mobiletaskswitcher/plugin/drawerblur.h
--- a/kwin/mobiletaskswitcher/plugin/drawerblur.h	1970-01-01 01:00:00.000000000 +0100
+++ b/kwin/mobiletaskswitcher/plugin/drawerblur.h	2026-09-27 21:56:26.950202600 +0200
@@ -0,0 +1,41 @@
+// SPDX-FileCopyrightText: 2026 Artur Szafraniec <ganggg111@gmail.com>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QObject>
+
+namespace KWin
+{
+class EffectWindow;
+
+/**
+ * Lets the shell fade the blur behind the action drawer in and out.
+ *
+ * The shell shows an empty, transparent "splash" layer window under the
+ * drawer that asks for blur.  KWin blends the blurred background with the
+ * square of the window opacity, so setting the opacity of that window from
+ * here controls how strong the blur looks, from none to full, while the
+ * drawer is being pulled.  Clients can not set a window opacity on Wayland,
+ * hence this D-Bus object inside KWin.
+ */
+class DrawerBlur : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.plasma.mobile.DrawerBlur")
+
+public:
+    explicit DrawerBlur(QObject *parent = nullptr);
+
+public Q_SLOTS:
+    /**
+     * @param strength 0 (no blur) to 1 (full blur)
+     */
+    Q_SCRIPTABLE void setStrength(double strength);
+
+private:
+    void apply(EffectWindow *window) const;
+
+    qreal m_opacity = 0;
+};
+}
