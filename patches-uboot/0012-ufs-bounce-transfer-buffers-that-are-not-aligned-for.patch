 		return 0;
 	}
+
+#ifdef CONFIG_PHYS_64BIT
+	{
+		size_t len = state->len_aligned;
+
+		/* Check if below 32bit boundary */
+		if ((hba->quirks & UFSHCD_QUIRK_BROKEN_64BIT_ADDRESS) &&
+		    ((ubuf >> 32) || (ubuf + len) >> 32)) {
+			dev_dbg(scsi_dev, "Buffer above 32bit boundary %lx-%lx\n",
+				ubuf, ubuf + len);
+			return 0;
+		}
+	}
 #endif
 	return 1;
 }
 #endif	/* CONFIG_BOUNCE_BUFFER */
 
+/*
+ * A device fresh out of reset answers the first command it is given with a
+ * check condition, its way of saying that it has just been reset.  Asking it
+ * for the detail clears the condition, and the command is then given again.
+ * A handful of goes is plenty, and the count is there so that a device that
+ * complains about everything cannot hold the boot forever.
+ */
+#define UFS_CHECK_COND_TRIES	4
+
+static int ufs_scsi_exec(struct udevice *scsi_dev, struct scsi_cmd *pccb)
+{
+	int ret, i;
+
+	for (i = 0; i < UFS_CHECK_COND_TRIES; i++) {
+		ret = ufs_scsi_exec_once(scsi_dev, pccb);
+		if (ret != -EAGAIN)
+			return ret;
+
+	}
+
+	return ret;
+}
+
 static struct scsi_ops ufs_ops = {
 	.exec		= ufs_scsi_exec,
 #if IS_ENABLED(CONFIG_BOUNCE_BUFFER)
