 		case UPIU_TRANSACTION_REJECT_UPIU:
@@ -2188,7 +2367,14 @@ int ufshcd_probe(struct udevice *ufs_dev, struct ufs_hba_ops *hba_ops)
 
 	scsi_plat = dev_get_uclass_plat(scsi_dev);
 	scsi_plat->max_id = UFSHCD_MAX_ID;
-	scsi_plat->max_lun = UFS_MAX_LUNS;
+	/*
+	 * Everything this board boots from lives on the first logical unit.
