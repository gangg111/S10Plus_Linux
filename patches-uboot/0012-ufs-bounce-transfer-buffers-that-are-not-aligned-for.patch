@@ -43,6 +43,14 @@
 #define QUERY_REQ_RETRIES 3
 /* Query request timeout */
 #define QUERY_REQ_TIMEOUT 1500 /* 1.5 seconds */
+/*
+ * A command bound for a logical unit gets more room than a query does, but not
+ * the thirty seconds an operating system hands out.  Measured on the phone this
+ * was written for, a device that answers at all answers in under fifty
+ * milliseconds, so a wait that runs into seconds is a fault and not patience,
+ * and a long limit only draws the fault out.
+ */
+#define SCSI_CMD_TIMEOUT 5000 /* 5 seconds, a hundred times the measured wait */
 
 /* maximum timeout in ms for a general UIC command */
 #define UFS_UIC_CMD_TIMEOUT	1000
@@ -671,9 +679,26 @@ static void ufshcd_host_memory_configure(struct ufs_hba *hba)
 	response_offset = offsetof(struct utp_transfer_cmd_desc, response_upiu);
 	prdt_offset = offsetof(struct utp_transfer_cmd_desc, prd_table);
 
-	utrdlp->response_upiu_offset = cpu_to_le16(response_offset >> 2);
-	utrdlp->prd_table_offset = cpu_to_le16(prdt_offset >> 2);
-	utrdlp->response_upiu_length = cpu_to_le16(ALIGNED_UPIU_SIZE >> 2);
+	/*
+	 * These three are counted in double words, except on hosts that count
+	 * them in bytes and say so with the quirk below.  Getting it wrong
+	 * costs nothing at the time: the request is laid out, the host takes
+	 * it and finishes it, and the response is simply written somewhere
+	 * other than where it is read back from, so what comes back is
+	 * whatever was in that memory before.
+	 */
+	if (hba->quirks & UFSHCD_QUIRK_PRDT_BYTE_GRAN) {
+		utrdlp->response_upiu_offset = cpu_to_le16(response_offset);
+		utrdlp->prd_table_offset = cpu_to_le16(prdt_offset);
+		utrdlp->response_upiu_length =
+					cpu_to_le16(ALIGNED_UPIU_SIZE);
+	} else {
+		utrdlp->response_upiu_offset =
+					cpu_to_le16(response_offset >> 2);
+		utrdlp->prd_table_offset = cpu_to_le16(prdt_offset >> 2);
+		utrdlp->response_upiu_length =
+					cpu_to_le16(ALIGNED_UPIU_SIZE >> 2);
+	}
 
 	hba->ucd_req_ptr = (struct utp_upiu_req *)hba->ucdl;
 	hba->ucd_rsp_ptr =
@@ -709,6 +734,18 @@ static int ufshcd_memory_alloc(struct ufs_hba *hba)
 		return -ENOMEM;
 	}
 
+	/*
+	 * Handed to the controller as it stands, so none of it may start as
+	 * whatever was in this memory before.  The descriptor of a data
+	 * segment has a field this driver never writes, which the standard
+	 * requires to be zero, and a controller that checks it refuses the
+	 * whole command.
+	 */
+	memset(hba->utrdl, 0, ALIGN(sizeof(struct utp_transfer_req_desc),
+				    ARCH_DMA_MINALIGN));
+	memset(hba->ucdl, 0, ALIGN(sizeof(struct utp_transfer_cmd_desc),
+				   ARCH_DMA_MINALIGN));
+
 	return 0;
 }
 
