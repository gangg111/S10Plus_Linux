+	 */
+	scsi_plat->max_lun = 1;
 	scsi_plat->max_bytes_per_req = UFS_MAX_BYTES;
 
 	hba->dev = ufs_dev;
@@ -2211,6 +2397,14 @@ int ufshcd_probe(struct udevice *ufs_dev, struct ufs_hba_ops *hba_ops)
 		return err;
 	}
 
+	/*
+	 * How much one descriptor entry may cover is the host's to say, and it
