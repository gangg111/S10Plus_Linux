 }
 
-static int ufs_scsi_exec(struct udevice *scsi_dev, struct scsi_cmd *pccb)
+/*
+ * Put the transfer list back on its feet after a command that did not come
+ * back clean.
+ *
+ * There is nothing of the sort anywhere else in this driver: a request that
+ * ends in anything but plain success is simply left where it lies, and this
+ * host will not take another one afterwards.  Measured on the phone this was
+ * written for: a command carrying a check condition completes properly, and
+ * the next one, laid out byte for byte the same, is never picked up, with the
+ * slot still claimed and not one interrupt raised.  Stopping the list and
+ * starting it again gives the host somewhere to begin from.
+ */
+static void ufshcd_restart_tr_list(struct ufs_hba *hba)
+{
+	dev_info(hba->dev, "restarting the list, doorbell %08x\n",
+		 ufshcd_readl(hba, REG_UTP_TRANSFER_REQ_DOOR_BELL));
+
+	ufshcd_writel(hba, 0, REG_UTP_TRANSFER_REQ_LIST_RUN_STOP);
+	ufshcd_wait_for_register(hba, REG_UTP_TRANSFER_REQ_LIST_RUN_STOP,
+				 UTP_TRANSFER_REQ_LIST_RUN_STOP_BIT, 0, 100);
+
+	ufshcd_writel(hba, UTP_TRANSFER_REQ_LIST_RUN_STOP_BIT,
+		      REG_UTP_TRANSFER_REQ_LIST_RUN_STOP);
+
+	if (ufshcd_wait_for_register(hba, REG_CONTROLLER_STATUS,
+				     UTP_TRANSFER_REQ_LIST_READY,
+				     UTP_TRANSFER_REQ_LIST_READY, 100))
+		dev_err(hba->dev, "the list would not come back\n");
+
+	dev_info(hba->dev, "list restarted, doorbell %08x, status %08x\n",
+		 ufshcd_readl(hba, REG_UTP_TRANSFER_REQ_DOOR_BELL),
+		 ufshcd_readl(hba, REG_CONTROLLER_STATUS));
+}
+
+static int ufs_scsi_exec_once(struct udevice *scsi_dev,
+			      struct scsi_cmd *pccb)
 {
 	struct ufs_hba *hba = dev_get_uclass_priv(scsi_dev->parent);
 	u32 upiu_flags;
-	int ocs, result = 0;
+	int ocs, ret, result = 0;
+	unsigned long zaczeto;
 	u8 scsi_status;
 
 	ufshcd_prepare_req_desc_hdr(hba, &upiu_flags, pccb->dma_dir);
+	ufshcd_ops_setup_xfer_req(hba, TASK_TAG, true);
 	ufshcd_prepare_utp_scsi_cmd_upiu(hba, pccb, upiu_flags);
-	prepare_prdt_table(hba, pccb);
+	ret = prepare_prdt_table(hba, pccb);
+	if (ret)
+		return ret;
 
 	ufshcd_cache_flush(pccb->pdata, pccb->datalen);
 
-	ufshcd_send_command(hba, TASK_TAG);
+	zaczeto = get_timer(0);
+	ret = ufshcd_send_command(hba, TASK_TAG, SCSI_CMD_TIMEOUT);
+
+	/*
+	 * BRING UP: which command is slow, and how slow.  A device that has
+	 * just been reset has work of its own to finish, and the difference
+	 * between waiting two seconds for that and waiting out a full timeout
+	 * on a command that was never going to come back is the whole
+	 * question.
+	 */
+	if (get_timer(zaczeto) > 50)
+		dev_info(hba->dev, "command %02x took %lu ms%s\n",
+			 pccb->cmd[0], get_timer(zaczeto),
+			 ret ? " and failed" : "");
+
+	if (ret)
+		return ret;
 
 	ufshcd_cache_invalidate(pccb->pdata, pccb->datalen);
 
 	ocs = ufshcd_get_tr_ocs(hba);
+
+	/*
+	 * Some hosts report a fatal error of their own where there is none.
+	 * Where the device sent a response frame back, the command did reach
+	 * it and did come back, so what the device said is what counts and the
+	 * host's complaint is discarded.
+	 */
+	if ((hba->quirks & UFSHCD_QUIRK_BROKEN_OCS_FATAL_ERROR) &&
+	    ocs == OCS_FATAL_ERROR &&
+	    ufshcd_get_req_rsp(hba->ucd_rsp_ptr) == UPIU_TRANSACTION_RESPONSE) {
+		dev_dbg(hba->dev, "host claimed a fatal error, device answered\n");
+		ocs = OCS_SUCCESS;
+	}
+
 	switch (ocs) {
 	case OCS_SUCCESS:
 		result = ufshcd_get_req_rsp(hba->ucd_rsp_ptr);
@@ -1683,8 +1847,23 @@ static int ufs_scsi_exec(struct udevice *scsi_dev, struct scsi_cmd *pccb)
 			result = ufshcd_get_rsp_upiu_result(hba->ucd_rsp_ptr);
 
 			scsi_status = result & MASK_SCSI_STATUS;
-			if (scsi_status)
