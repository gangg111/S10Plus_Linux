+			if (get_timer(start) > timeout_ms) {
 				dev_err(hba->dev,
 					"Timedout waiting for UTP response\n");
+				dev_err(hba->dev,
+					"  doorbell %08x, run %08x, status %08x, irq %08x\n",
+					ufshcd_readl(hba, REG_UTP_TRANSFER_REQ_DOOR_BELL),
+					ufshcd_readl(hba, REG_UTP_TRANSFER_REQ_LIST_RUN_STOP),
+					ufshcd_readl(hba, REG_CONTROLLER_STATUS),
+					intr_status);
 				return -ETIMEDOUT;
 			}
 		}
@@ -1034,7 +1105,7 @@ static int ufshcd_exec_dev_cmd(struct ufs_hba *hba, enum dev_cmd_type cmd_type,
 	if (err)
