+++ b/board/samsung/exynos-mobile/exynos-mobile.env
@@ -9,12 +9,15 @@ preboot=run blkmapcmd
 
 bootdelay=0
 bootmenu_delay=-1
-bootcmd=bootefi bootmgr; pause; bootmenu
+efiboot=bootefi bootmgr
+bootcmd=bootefi bootmgr; echo "<-- EFI boot returned, menu in 5 s"; sleep 5; bootmenu
 
 fastbootcmd=echo "Fastboot Mode";
-	fastboot -l $fastboot_addr_r usb 0
