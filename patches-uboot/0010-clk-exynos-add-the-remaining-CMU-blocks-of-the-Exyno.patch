+/*
+ * The muxes are registered in two goes, because a clock is bound to its parent
+ * by name at the moment it is registered, and a parent that does not exist yet
+ * is not reported as an error: the clock is simply bound without one, and every
+ * rate taken from it afterwards is an error code wearing the shape of a
+ * frequency.  The two muxes above the PLLs pick between the PLLs, so they go
+ * before the dividers; the four below pick between the divided PLLs, so they
+ * have to go after them.
+ */
+/*
+ * The divider the UFS link is timed from hangs below its gate, so it cannot be
+ * registered until the gates are there.
+ *
+ * The two dividers of the peripheral block hang the same way and are NOT here
+ * on purpose.  Moving them stops this phone dead in board_f: they feed the
+ * clock the console works its baud divider out from, the console runs before
+ * relocation, and the port it writes to has no wire on it on this board.  The
+ * clock they carry is wrong either way; left where they are, it is wrong in
+ * the way this phone already boots with.
+ */
+static const struct samsung_div_clock top_div_ufs_clks[] = {
+	DIV(CLK_DOUT_CMU_FSYS1_UFS_EMBD, "dout_cmu_fsys1_ufs_embd",
+	    "gout_cmu_fsys1_ufs_embd", CLK_CON_DIV_CLKCMU_FSYS1_UFS_EMBD, 0, 3),
+};
+
+/*
+ * The three clocks the USB block is fed with hang below their gates in just
+ * the same way the UFS one does, so they are registered after the gates for
+ * the same reason.  The debug clock of the DisplayPort side of the combined
+ * PHY has no divider field at all: the vendor table carries its ratio as a
+ * fixed factor of eight, so there is nothing to program and it is declared
+ * rather than read.
