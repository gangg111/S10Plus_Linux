diff --git a/arch/arm/dts/exynos9820-beyond2lte-u-boot.dtsi b/arch/arm/dts/exynos9820-beyond2lte-u-boot.dtsi
new file mode 100644
index 00000000..bd2d5247
--- /dev/null
+++ b/arch/arm/dts/exynos9820-beyond2lte-u-boot.dtsi
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ *
+ * What this board needs on top of the device tree it shares with Linux.
+ *
+ * The storage of this phone is UFS, and neither the controller nor the clock
+ * block that feeds it is described in the tree yet, because the Linux side of
+ * this port has no driver for either.  Both are described here instead of in
+ * the shared tree, so that the shared copy stays exactly what the kernel has
+ * and the next sync of dts/upstream does not have to merge anything.  When the
+ * kernel gains UFS for this SoC, these nodes move there and this file loses
+ * them.
+ *
+ * Addresses come from the vendor tree, arch/arm64/boot/dts/exynos/exynos9820.dts
+ * of the Samsung kernel for this phone, node ufs@0x13D60000 at line 5865.
+ */
+
+#include <dt-bindings/clock/samsung,exynos9820.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include "exynos-pinctrl.h"
+
+/ {
+	/*
+	 * UNVERIFIED: the boot loader of this phone reads these out of the
+	 * image it is handed.  The neighbouring board of this family carries
+	 * them with a note that S-BOOT requires them, and the chip number is
+	 * the only part of the shape that differs, but whether this phone's
+	 * S-BOOT insists on them has not been tried.
+	 */
+	model_info-chip = <9820>;
+	model_info-hw_rev = <0>;
+	model_info-hw_rev_end = <255>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * The screen this phone comes up with, left running by whatever
+		 * ran before.  Its address is not guessed: the primary boot
+		 * loader of this very phone passes it to the kernel it starts,
+		 * as s3cfb.bootloaderfb=0xca000000, and that is what was read
+		 * off the device.  The geometry is the panel's own, 1440 by
+		 * 3040, four bytes to a pixel.
+		 */
+		framebuffer@ca000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
+			width = <1440>;
+			height = <3040>;
+			stride = <(1440 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+};
+
+&soc {
+	/*
+	 * The clock block the embedded storage hangs off.  Three of its gates
+	 * matter: the controller clock, the clock of the link, whose rate every
+	 * timing of that link is computed from, and the one for the encryption
+	 * unit, which a boot loader does not use.
+	 */
+	cmu_fsys1: clock-controller@13c00000 {
+		compatible = "samsung,exynos9820-cmu-fsys1";
+		reg = <0x13c00000 0x8000>;
+		#clock-cells = <1>;
+
+		clocks = <&oscclk>,
+			 <&cmu_top CLK_GOUT_CMU_FSYS1_BUS>,
+			 <&cmu_top CLK_DOUT_CMU_FSYS1_UFS_EMBD>;
+		clock-names = "oscclk", "bus", "ufs_embd";
+	};
+
+	ufs: ufs@13d60000 {
+		compatible = "samsung,exynos9820-ufs";
+		reg = <0x13d60000 0x200>,	/* standard host controller */
+		      <0x13d61100 0x200>,	/* the vendor's own block   */
+		      <0x13d50000 0x8000>,	/* UniPro                   */
+		      <0x13d70000 0x100>;	/* encryption unit, unused  */
+		interrupts = <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH>;
+
+		clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_UFS_EMBD_I_ACLK>,
+			 <&cmu_fsys1 CLK_GOUT_FSYS1_UFS_EMBD_I_CLK_UNIPRO>;
+		clock-names = "hci", "unipro";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ufs_rst_n &ufs_refclk_out>;
+
+		phys = <&ufs_phy>;
+		phy-names = "ufs-phy";
+
+		/*
+		 * The supply of this storage is a fixed regulator the vendor
+		 * marks regulator-boot-on (exynos9820.dts:5919), so whatever
+		 * runs before hands it over already on and nothing here has to
+		 * switch it.
+		 */
+	};
+
+	ufs_phy: phy@13d64000 {
+		compatible = "samsung,exynos9820-ufs-phy";
+		/*
+		 * The vendor gives this window 0x800, which covers the first
+		 * lane only; its own calibration tables reach 0xbbc on the
+		 * second one.  That goes unnoticed there because an operating
+		 * system maps whole pages.  A page is what is asked for here.
+		 */
+		reg = <0x13d64000 0x1000>;
+		#phy-cells = <0>;
+
+		samsung,pmu-syscon = <&pmu_system_controller 0x724>;
+	};
+};
+
+/*
+ * The two pins of the storage: the reset line of the device and the reference
+ * clock going out to it.  Both are on the pin controller of this domain, in
+ * their second function.  Vendor tree, exynos9820.dts:1164 and :1173.
+ */
+&pinctrl_fsys1 {
+	ufs_rst_n: ufs-rst-n-pins {
+		samsung,pins = "gpf3-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+	};
+
+	ufs_refclk_out: ufs-refclk-out-pins {
+		samsung,pins = "gpf3-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+	};
+};
diff --git a/board/samsung/exynos-mobile/debug-exynos9820.config b/board/samsung/exynos-mobile/debug-exynos9820.config
new file mode 100644
index 00000000..229790e1
--- /dev/null
+++ b/board/samsung/exynos-mobile/debug-exynos9820.config
@@ -0,0 +1,17 @@
+# Early console for bringing up an Exynos9820 phone, before the driver model
+# is up.  Merge this into the configuration by hand; it is not part of the
+# defconfig, because one of its two numbers is not known yet.
+#
+# The address is the debug UART of this SoC, serial@10440000 in its device
+# tree.  The clock is NOT: nothing in this port has measured the rate that
+# block is fed at, and the value below is the one the Exynos7870 phones of
+# this board use, carried over only so the option has something to hold.
+# Confirm it against the hardware before trusting what this console prints;
+# the driver model console does not need it, because it asks the clock driver.
+CONFIG_DEBUG_UART=y
+CONFIG_DEBUG_UART_BASE=0x10440000
+CONFIG_DEBUG_UART_CLOCK=133250000
+CONFIG_DEBUG_UART_S5P=y
+CONFIG_LOG=y
+CONFIG_LOG_CONSOLE=y
+CONFIG_LOG_MAX_LEVEL=8
