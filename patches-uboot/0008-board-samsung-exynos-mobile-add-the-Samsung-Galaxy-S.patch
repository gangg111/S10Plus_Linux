 #include <asm/armv8/mmu.h>
+#include <asm/io.h>
 #include <blk.h>
 #include <bootflow.h>
 #include <ctype.h>
@@ -357,8 +358,92 @@ int timer_init(void)
 	return 0;
 }
 
+/*
+ * A sign of life, put on the screen before anything else has run.
+ *
+ * Two things are going on here, and both are for the same reason: on a phone
+ * there is nowhere else for a boot loader to say that it got as far as running
+ * at all.  There is no serial port to plug into, and whether the console comes
+ * up depends on clocks, drivers and a device tree that may all be wrong.  So a
+ * band of colour is painted along the bottom of the screen from the earliest
+ * hook there is, before relocation, before any driver and before the console.
+ * If the band shows and no text follows, the boot loader started and something
+ * later hung; if nothing shows at all, it never ran or the screen is not where
+ * this thinks it is.  Those two used to look exactly alike.
+ *
+ * The band goes at the bottom because the console starts writing at the top,
+ * so the two do not overwrite each other and can be read together.
+ *
+ * Before any of that the display controller has to be told to push what is in
+ * the framebuffer out to the panel.  The panel of these phones is a command
+ * mode one: it shows a picture when it is triggered, and by the time a boot
+ * loader runs nothing is triggering it any more, so whatever is written to the
+ * framebuffer stays invisible and the screen keeps the picture it came up
+ * with.  The register is this SoC's DECON_HW_SW_TRIG_CONTROL, and the address
+ * of the controller comes out of the device tree, so nothing at all happens on
+ * a board whose tree has no such controller.  The value written to it is the
+ * one uniLoader hands the sibling phone of this family.
+ *
+ * UNVERIFIED: none of this has been tried on hardware.
+ */
+#define EXYNOS_DECON_HW_SW_TRIG_CONTROL		0x70
+#define EXYNOS_DECON_SW_TRIG_ON			0x1281
+#define EXYNOS_SIGN_OF_LIFE_ROWS		128
+#define EXYNOS_SIGN_OF_LIFE_COLOUR		0xffff00ff	/* opaque magenta */
+
+static void exynos_show_sign_of_life(const void *fdt)
+{
+	u32 height, stride, rows, *pixel;
+	fdt_addr_t base;
+	fdt_size_t size;
+	int node, parent;
+	u64 offset;
+	u32 i, words;
+
+	node = fdt_node_offset_by_compatible(fdt, -1, "samsung,exynos9820-decon");
+	if (node >= 0) {
+		parent = fdt_parent_offset(fdt, node);
+		base = fdtdec_get_addr_size_auto_parent(fdt, parent, node, "reg",
+							0, NULL, false);
+		if (base != FDT_ADDR_T_NONE)
+			writel(EXYNOS_DECON_SW_TRIG_ON,
+			       (void __iomem *)(uintptr_t)base +
+			       EXYNOS_DECON_HW_SW_TRIG_CONTROL);
+	}
+
+	node = fdt_node_offset_by_compatible(fdt, -1, "simple-framebuffer");
+	if (node < 0)
+		return;
+
+	parent = fdt_parent_offset(fdt, node);
+	base = fdtdec_get_addr_size_auto_parent(fdt, parent, node, "reg", 0,
+						&size, false);
+	if (base == FDT_ADDR_T_NONE)
+		return;
+
+	height = fdtdec_get_int(fdt, node, "height", 0);
+	stride = fdtdec_get_int(fdt, node, "stride", 0);
+	if (!height || !stride || stride % sizeof(*pixel))
+		return;
+
+	/* Do not write past what the tree says is there. */
+	if ((u64)stride * height > size)
+		return;
+
+	rows = EXYNOS_SIGN_OF_LIFE_ROWS;
+	if (height < rows)
+		rows = height;
+	offset = (u64)stride * (height - rows);
+	words = rows * (stride / sizeof(*pixel));
+
+	pixel = (u32 *)(uintptr_t)(base + offset);
+	for (i = 0; i < words; i++)
+		pixel[i] = EXYNOS_SIGN_OF_LIFE_COLOUR;
+}
+
 int board_early_init_f(void)
 {
+	exynos_show_sign_of_life(gd->fdt_blob);
 	exynos_parse_dram_banks(gd->fdt_blob);
 
 	return 0;
