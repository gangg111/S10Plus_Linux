+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * UFS host controller driver for Samsung Exynos SoCs.
+ *
+ * Copyright (c) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ *
+ * Offsets and field names follow the vendor header for this SoC,
+ * drivers/scsi/ufs/ufs-exynos.h of the Samsung kernel, and the mainline Linux
+ * driver drivers/ufs/host/ufs-exynos.c, which agree on all of them.
+ */
+
+#ifndef __UFS_EXYNOS_H__
+#define __UFS_EXYNOS_H__
+
+#include <linux/bitops.h>
+
+/*
+ * Registers of the vendor's own block, which sits in its own window next to
+ * the standard host controller one.  The standard window belongs to the UFS
+ * uclass and is not touched here.
+ */
+#define HCI_TXPRDT_ENTRY_SIZE		0x00
+#define HCI_RXPRDT_ENTRY_SIZE		0x04
+#define PRDT_PREFETCH_EN		BIT(31)
+#define PRDT_SET_SIZE(x)		((x) & 0x1f)
+
+#define HCI_1US_TO_CNT_VAL		0x0c
+#define CNT_VAL_1US_MASK		0x3ff
+
+#define HCI_UTRL_NEXUS_TYPE		0x40
+#define HCI_UTMRL_NEXUS_TYPE		0x44
+
+#define HCI_SW_RST			0x50
+#define UFS_LINK_SW_RST			BIT(0)
+#define UFS_UNIPRO_SW_RST		BIT(1)
+#define UFS_SW_RST_MASK			(UFS_UNIPRO_SW_RST | UFS_LINK_SW_RST)
+
+#define HCI_DATA_REORDER		0x60
+
+#define HCI_AXIDMA_RWDATA_BURST_LEN	0x6c
+#define WLU_EN				BIT(31)
+#define BURST_LEN(x)			(((x) << 27) | (x))
+
+/* Bit 0 drives the reset pin of the storage device. */
+#define HCI_GPIO_OUT			0x70
+
+#define HCI_UFSHCI_V2P1_CTRL		0x8c
+#define IA_TICK_SEL			BIT(16)
+
+/*
+ * Which clocks the hardware is allowed to stop on its own.  Every bit here is
+ * cleared for the whole of bring-up, including the one that gates the APB
+ * clock of the PHY: without it the PHY driver cannot reach its own registers.
+ *
+ * The vendor leaves that one bit out of its bulk mask and instead clears and
+ * restores it around every single access to the PHY, which needs the PHY
+ * driver to reach into this window.  Mainline Linux puts the bit in the bulk
+ * mask and clears it once, which keeps the two drivers apart, so that is what
+ * is done here.
+ */
+#define HCI_CLKSTOP_CTRL		0xb0
+#define REFCLKOUT_STOP			BIT(4)
+#define MPHY_APBCLK_STOP		BIT(3)
+#define REFCLK_STOP			BIT(2)
+#define UNIPRO_MCLK_STOP		BIT(1)
+#define UNIPRO_PCLK_STOP		BIT(0)
+#define CLK_STOP_MASK			(REFCLKOUT_STOP | MPHY_APBCLK_STOP | \
+					 REFCLK_STOP | UNIPRO_MCLK_STOP | \
+					 UNIPRO_PCLK_STOP)
+
+#define HCI_FORCE_HCS			0xb4
+#define HCI_CORECLK_STOP_EN		BIT(4)
+
+/* Automatic clock gating, switched off for the whole of bring-up. */
+#define HCI_UFS_ACG_DISABLE		0xfc
+#define HCI_UFS_ACG_DISABLE_EN		BIT(0)
+#define HCI_IOP_ACG_DISABLE		0x100
+#define HCI_IOP_ACG_DISABLE_EN		BIT(0)
+
+/*
+ * Lane selectors of the PCS attributes.  The transmit lanes are numbered from
+ * zero and the receive lanes from four.
+ */
+#define TX_LANE_0			0
+#define RX_LANE_0			4
+
+#endif /* __UFS_EXYNOS_H__ */
