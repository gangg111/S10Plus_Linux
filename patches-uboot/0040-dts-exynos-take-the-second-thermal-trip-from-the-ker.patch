From 23b183baeaff8aa6ef475b81f4de86b3935d3caf Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Thu, 24 Sep 2026 21:00:17 +0200
Subject: [PATCH 40/40] dts: exynos: take the second thermal trip from the
 kernel tree

Kernel patch 0115 gives the Exynos9820 CPU clusters and GPU a second
passive trip at 92 C.  This tree carries a copy of that SoC file, and the
copy has to stay a copy, so take the file.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 dts/upstream/src/arm64/exynos/exynos9820.dtsi | 61 +++++++++++++++++--
 1 file changed, 57 insertions(+), 4 deletions(-)

diff --git a/dts/upstream/src/arm64/exynos/exynos9820.dtsi b/dts/upstream/src/arm64/exynos/exynos9820.dtsi
index c6724eb0..6d816b49 100644
--- a/dts/upstream/src/arm64/exynos/exynos9820.dtsi
+++ b/dts/upstream/src/arm64/exynos/exynos9820.dtsi
@@ -1518,10 +1518,14 @@
 	};
 
 	/*
-	 * Each CPU cluster is throttled through cpufreq and the GPU through
-	 * devfreq from 85 C on.  The critical trip stays 15 C below the hardware
-	 * trip of the TMU, so the kernel powers the phone off in order before the
-	 * TMU removes the power; the ISP zone has nothing to throttle yet.
+	 * Each CPU cluster and the GPU are throttled through cpufreq or devfreq
+	 * from 85 C on, and from 92 C on at least to about half of their top
+	 * clock: step_wise raises the cooling state only while the temperature
+	 * keeps rising, so with the 1 C steps of the TMU a steady load can sit
+	 * above the first trip without the state moving.  The critical trip stays
+	 * 15 C below the hardware trip of the TMU, so the kernel powers the phone
+	 * off in order before the TMU removes the power; the ISP zone has nothing
+	 * to throttle yet.
 	 */
 	thermal-zones {
 		big-thermal {
@@ -1536,6 +1540,12 @@
 					type = "passive";
 				};
 
+				big_hot: big-hot {
+					temperature = <92000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				big-critical {
 					temperature = <100000>;
 					hysteresis = <0>;
@@ -1549,6 +1559,12 @@
 					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
 							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
 				};
+
+				map1 {
+					trip = <&big_hot>;
+					cooling-device = <&cpu6 8 THERMAL_NO_LIMIT>,
+							 <&cpu7 8 THERMAL_NO_LIMIT>;
+				};
 			};
 		};
 
@@ -1564,6 +1580,12 @@
 					type = "passive";
 				};
 
+				gpu_hot: gpu-hot {
+					temperature = <92000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				gpu-critical {
 					temperature = <100000>;
 					hysteresis = <0>;
@@ -1576,6 +1598,11 @@
 					trip = <&gpu_alert>;
 					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
 				};
+
+				map1 {
+					trip = <&gpu_hot>;
+					cooling-device = <&gpu 4 THERMAL_NO_LIMIT>;
+				};
 			};
 		};
 
@@ -1604,6 +1631,12 @@
 					type = "passive";
 				};
 
+				little_hot: little-hot {
+					temperature = <92000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				little-critical {
 					temperature = <100000>;
 					hysteresis = <0>;
@@ -1619,6 +1652,14 @@
 							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
 							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
 				};
+
+				map1 {
+					trip = <&little_hot>;
+					cooling-device = <&cpu0 8 THERMAL_NO_LIMIT>,
+							 <&cpu1 8 THERMAL_NO_LIMIT>,
+							 <&cpu2 8 THERMAL_NO_LIMIT>,
+							 <&cpu3 8 THERMAL_NO_LIMIT>;
+				};
 			};
 		};
 
@@ -1634,6 +1675,12 @@
 					type = "passive";
 				};
 
+				mid_hot: mid-hot {
+					temperature = <92000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				mid-critical {
 					temperature = <100000>;
 					hysteresis = <0>;
@@ -1647,6 +1694,12 @@
 					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
 							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
 				};
+
+				map1 {
+					trip = <&mid_hot>;
+					cooling-device = <&cpu4 8 THERMAL_NO_LIMIT>,
+							 <&cpu5 8 THERMAL_NO_LIMIT>;
+				};
 			};
 		};
 	};
-- 
2.47.3

