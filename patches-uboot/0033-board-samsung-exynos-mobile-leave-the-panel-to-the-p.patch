From 4c69364898086f75f56b0efbab7917926c24fa64 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Tue, 22 Sep 2026 23:54:14 +0200
Subject: [PATCH 33/40] board: samsung: exynos-mobile: leave the panel to the
 picture on it

A phone hands its screen from one stage to the next: the first stage
draws a picture, and the system that comes up draws its own.  This
loader sat in the middle of that and wrote over it - the banner, the
storage scan, the network, every line of it on top of the picture, and
the framebuffer cleared to black before even that.

None of it is anything the person holding the phone can use, and all of
it is on the one screen they are looking at.  So the console goes to the
port, where it is all still there for anyone who attaches one, the
framebuffer is left as the first stage filled it, and the panel is
handed over only where something on it is meant to be read: the menu,
the fastboot mode, and the message when booting falls through.  Each of
those runs one variable which puts the console back on the panel, in
front of the port so that the EFI console learns its real size, and
clears the screen first.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 board/samsung/exynos-mobile/exynos-mobile.c   | 25 --------------
 board/samsung/exynos-mobile/exynos-mobile.env | 34 ++++++++++++++++---
 configs/exynos-mobile_defconfig               |  1 +
 3 files changed, 30 insertions(+), 30 deletions(-)

diff --git a/board/samsung/exynos-mobile/exynos-mobile.c b/board/samsung/exynos-mobile/exynos-mobile.c
index 710b4495..72236165 100644
--- a/board/samsung/exynos-mobile/exynos-mobile.c
+++ b/board/samsung/exynos-mobile/exynos-mobile.c
@@ -1025,31 +1025,6 @@ int board_late_init(void)
 {
 	exynos_mark(EXYNOS_MARK_CONSOLE);
 
-	/*
-	 * Put the panel first in the list of output devices.
-	 *
-	 * The EFI layer learns how wide and how tall the console is by asking
-	 * the video console for it, and it only asks when the name of the
-	 * output device begins with that console (lib/efi_loader/efi_console.c,
-	 * query_vidconsole).  With the console multiplexer the list begins with
-	 * the serial port instead, so the question is never asked; what follows
-	 * is a question put to a terminal on a port with nothing attached to
-	 * it, no answer, and a console left at the assumed eighty by
-	 * twenty five.
-	 *
-	 * A loader drawing eighty columns on a panel that holds forty five
-	 * then writes the right hand third of every line, its error messages
-	 * among them, past the edge of the screen, where it cannot be read.
-	 * On a board whose only output is the panel that is the difference
-	 * between a message and silence.
-	 */
-	env_set("stdout", "vidconsole,serial");
-
-	/*
-	 * After the line above, so that whatever it has to say about the last
-	 * reset is drawn on the panel rather than sent to a port with nothing
-	 * on the other end.
-	 */
 	exynos_reboot_mode();
 	exynos_boot_control_block();
 
diff --git a/board/samsung/exynos-mobile/exynos-mobile.env b/board/samsung/exynos-mobile/exynos-mobile.env
index b11eddd1..746716bd 100644
--- a/board/samsung/exynos-mobile/exynos-mobile.env
+++ b/board/samsung/exynos-mobile/exynos-mobile.env
@@ -1,6 +1,30 @@
 stdin=serial,button-kbd
-stdout=serial,vidconsole
-stderr=serial,vidconsole
+stdout=serial
+stderr=serial
+
+/*
+ * The panel, for the one moment something on it is meant to be read.
+ *
+ * What this loader has to say goes to the port, and the picture the first
+ * stage drew is left where it is.  On a phone the screen is not a log: the
+ * ten seconds it takes to read a system off the flash read better as the
+ * picture the phone came up with, with a ring turning on it, than as forty
+ * lines of driver output over the top of it.  Everything which does want to
+ * be read, the menu, the fastboot mode and the message when booting falls
+ * through, runs this first.
+ *
+ * The panel goes in FRONT of the port, not behind it.  The EFI layer learns
+ * how wide and how tall the console is by asking the video console, and it
+ * only asks when the name of the first output device is that console
+ * (lib/efi_loader/efi_console.c, query_vidconsole).  Behind the serial port
+ * the question is never asked; the answer is sought from a terminal on a
+ * port with nothing attached to it, and the console is left at the assumed
+ * eighty by twenty five.  A loader drawing eighty columns on a panel that
+ * holds forty five writes the right hand third of every line, its error
+ * messages among them, past the edge of the screen.
+ */
+panel=spinner off; setenv stdout vidconsole,serial;
+	setenv stderr vidconsole,serial; cls
 
 blkmapcmd=blkmap create root;
 	  blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}
@@ -10,10 +34,10 @@ preboot=run blkmapcmd
 bootdelay=0
 bootmenu_delay=-1
 efiboot=bootefi bootmgr
-bootcmd=bootefi bootmgr; spinner off;
+bootcmd=bootefi bootmgr; run panel;
 		echo "<-- EFI boot returned, menu in 5 s"; sleep 5; bootmenu
 
-fastbootcmd=spinner off; echo "Fastboot Mode";
+fastbootcmd=run panel; echo "Fastboot Mode";
 	fastboot -l $fastboot_addr_r usb 0;
 	echo "fastboot returned, menu in 5 s";
 	sleep 5
@@ -36,4 +60,4 @@ diag_storage=echo "--- ufs init ---"; ufs init;
 diag_dm=dm tree; echo "--- done, press a key ---"; pause; bootmenu
 
 button_cmd_0_name=Volume Down Key
-button_cmd_0=spinner off; bootmenu
+button_cmd_0=run panel; bootmenu
diff --git a/configs/exynos-mobile_defconfig b/configs/exynos-mobile_defconfig
index a27edec6..fc3835da 100644
--- a/configs/exynos-mobile_defconfig
+++ b/configs/exynos-mobile_defconfig
@@ -72,6 +72,7 @@ CONFIG_USB_GADGET_MANUFACTURER="Samsung"
 CONFIG_USB_GADGET_VENDOR_NUM=0x04e8
 CONFIG_USB_GADGET_PRODUCT_NUM=0x6602
 CONFIG_VIDEO=y
+CONFIG_NO_FB_CLEAR=y
 CONFIG_VIDEO_SIMPLE=y
 CONFIG_FS_EXT4=y
 CONFIG_FS_FAT=y
-- 
