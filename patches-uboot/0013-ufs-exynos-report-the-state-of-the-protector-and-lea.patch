+			/*
+			 * The panel is a command mode one, so something has
+			 * to tell this controller to send each new frame or
+			 * nothing written above is ever seen.
+			 */
+			samsung,decon = <&decon0>;
 		};
 	};
 };
 
 &soc {
-	/*
