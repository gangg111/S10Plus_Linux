+	},
 	{ /* sentinel */ }
 };
 
diff --git a/include/samsung-ufs-phy.h b/include/samsung-ufs-phy.h
new file mode 100644
index 00000000..53b72138
--- /dev/null
+++ b/include/samsung-ufs-phy.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Calibration interface of the Samsung UFS PHY.
+ *
+ * Copyright (c) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ *
+ * The PHY of this family is not configured once and left alone.  It is
+ * calibrated at four points of the link bring-up, and the host controller
+ * driver is the only party that knows when those points are reached, so it
+ * hands the point over to the PHY through generic_phy_configure().
+ */
+
+#ifndef __SAMSUNG_UFS_PHY_H__
+#define __SAMSUNG_UFS_PHY_H__
+
+/**
+ * enum samsung_ufs_phy_step - the point of the bring-up being calibrated for
+ *
+ * @UFS_PHY_PRE_LINK:	before the link is started, while the lanes are idle
+ * @UFS_PHY_POST_LINK:	after the link has come up in the slowest mode
+ * @UFS_PHY_PRE_PWR_HS:	before the link is asked to move to a high speed gear
+ * @UFS_PHY_POST_PWR_HS: after that move, once the receiver has data to lock on
+ * @UFS_PHY_STEP_COUNT:	number of steps, not a step itself
+ */
+enum samsung_ufs_phy_step {
+	UFS_PHY_PRE_LINK,
+	UFS_PHY_POST_LINK,
+	UFS_PHY_PRE_PWR_HS,
+	UFS_PHY_POST_PWR_HS,
+	UFS_PHY_STEP_COUNT,
+};
+
+/**
+ * struct samsung_ufs_phy_params - what generic_phy_configure() is handed
+ *
+ * @step:	which of the four points above this call is for
+ * @lane_cnt:	how many lanes to calibrate, 1 or 2
+ * @gear:	the high speed gear being prepared for, 1 to 4; ignored for
+ *		the two steps that run before a gear has been chosen
+ *
+ * The lane count has to be passed in rather than discovered here, because the
+ * PHY has no way of its own to learn it: the attribute that carries it,
+ * PA_AVAILRXDATALANES, is read over the link, which at UFS_PHY_PRE_LINK does
+ * not exist yet.
+ */
+struct samsung_ufs_phy_params {
+	enum samsung_ufs_phy_step step;
+	unsigned int lane_cnt;
+	unsigned int gear;
+};
+
+#endif /* __SAMSUNG_UFS_PHY_H__ */
-- 
