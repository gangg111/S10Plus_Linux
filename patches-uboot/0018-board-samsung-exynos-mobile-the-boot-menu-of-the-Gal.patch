 #define EXYNOS_DECON_HW_SW_TRIG_CONTROL		0x70
 #define EXYNOS_DECON_SW_TRIG_ON			0x1281
-#define EXYNOS_SIGN_OF_LIFE_ROWS		128
-#define EXYNOS_SIGN_OF_LIFE_COLOUR		0xffff00ff	/* opaque magenta */
+#define EXYNOS_MARK_ROWS			64
+
+enum exynos_mark_stage {
+	EXYNOS_MARK_ENTERED,	/* before the memory, before relocation  */
+	EXYNOS_MARK_DRIVERS,	/* memory, relocation, the driver model  */
+	EXYNOS_MARK_STDIO,	/* the tables the console is built on    */
+	EXYNOS_MARK_CONSOLE,	/* the console, and the command line     */
+	EXYNOS_MARK_COUNT,
+};
+
+static const u32 exynos_mark_colour[EXYNOS_MARK_COUNT] = {
+	0xffff00ff,	/* magenta */
+	0xff00ffff,	/* cyan    */
+	0xffffff00,	/* yellow  */
+	0xff00ff00,	/* green   */
+};
+
+static void exynos_decon_trigger(const void *fdt)
+{
+	fdt_addr_t base;
+	int node, parent;
+
+	node = fdt_node_offset_by_compatible(fdt, -1,
+					     "samsung,exynos9820-decon");
+	if (node < 0)
+		return;
+
+	parent = fdt_parent_offset(fdt, node);
+	base = fdtdec_get_addr_size_auto_parent(fdt, parent, node, "reg", 0,
+						NULL, false);
+	if (base == FDT_ADDR_T_NONE)
+		return;
+
+	writel(EXYNOS_DECON_SW_TRIG_ON,
+	       (void __iomem *)(uintptr_t)base +
+	       EXYNOS_DECON_HW_SW_TRIG_CONTROL);
+}
 
-static void exynos_show_sign_of_life(const void *fdt)
