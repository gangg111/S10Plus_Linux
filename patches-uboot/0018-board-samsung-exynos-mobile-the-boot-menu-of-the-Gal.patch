+/*
+ * The menu this board draws: its own name, what it found, and where it can go,
+ * in whichever of four languages is picked.
+ *
+ * The generic boot menu takes every line it draws from the environment, so all
+ * of this is a matter of setting variables: bootmenu_hdr_<n> above the entries,
+ * bootmenu_<n> for the entries themselves, bootmenu_ftr_<n> below them.
+ * Changing language is then setting them again and asking for the menu once
+ * more, which is what the bmenu command below does.
+ *
+ * Nothing here mixes languages: a line is either wholly in the chosen one or
+ * it is a name, a number or a unit, which are the same everywhere.
+ */
+
+enum exynos_lang {
+	EXYNOS_LANG_DE,
+	EXYNOS_LANG_EN,
+	EXYNOS_LANG_ES,
+	EXYNOS_LANG_PL,
+	EXYNOS_LANG_COUNT,
+};
+
+struct exynos_menu_text {
+	const char *code;	/* what to write in the environment	*/
+	const char *own_name;	/* what the language calls itself	*/
+	const char *entry[8];
+	const char *language;
+	const char *back;
+	const char *keys;
+	const char *banks;	/* "%u MB ..." with the count of banks	*/
+	const char *no_link;
+	const char *unknown;
+};
+
+/*
+ * In the order each language names itself, which is the order they are offered
+ * in: Deutsch, English, Espanol, Polski.
+ */
+static const struct exynos_menu_text exynos_menu_lang[EXYNOS_LANG_COUNT] = {
+	{
+		.code = "de", .own_name = "Deutsch",
+		.entry = { "System starten", "Fastboot-Modus", "UEFI-Wartung",
+			   "Neustart", "Ausschalten", "Speicher-Diagnose",
+			   "Treiberbaum", "Download-Modus" },
+		.language = "Sprache", .back = "Zurück",
+		.keys = "VOL+/-  bewegen   POWER  wählen",
+		.banks = "%u MB in %u Bänken",
+		.no_link = "Verbindung fehlt", .unknown = "unbekannt",
+	}, {
+		.code = "en", .own_name = "English",
+		.entry = { "Continue boot", "Fastboot mode", "UEFI maintenance",
+			   "Reboot", "Power off", "Storage diagnostics",
+			   "Driver tree", "Download mode" },
+		.language = "Language", .back = "Back",
+		.keys = "VOL+/-  move      POWER  select",
+		.banks = "%u MB in %u banks",
+		.no_link = "link did not come up", .unknown = "unknown",
+	}, {
+		.code = "es", .own_name = "Español",
+		.entry = { "Iniciar el sistema", "Modo Fastboot",
+			   "Mantenimiento UEFI", "Reiniciar", "Apagar",
+			   "Diagnóstico de disco", "Árbol de controladores",
+			   "Modo Download" },
+		.language = "Idioma", .back = "Volver",
+		.keys = "VOL+/-  mover     POWER  elegir",
+		.banks = "%u MB en %u bancos",
+		.no_link = "sin enlace", .unknown = "desconocido",
+	}, {
+		.code = "pl", .own_name = "Polski",
+		.entry = { "Uruchom system", "Tryb Fastboot", "Obsługa UEFI",
+			   "Restart", "Wyłącz", "Diagnostyka pamięci",
+			   "Drzewo sterowników", "Tryb Download" },
+		.language = "Język", .back = "Wstecz",
+		.keys = "VOL+/-  ruch      POWER  wybierz",
+		.banks = "%u MB w %u bankach",
+		.no_link = "łącze nie wstało", .unknown = "nieznany",
+	},
+};
+
+/* What each entry does, in the same order, and the same in every language. */
+static const char * const exynos_menu_cmd[8] = {
+	/*
+	 * Each of these ends by asking for the menu again, because selecting
+	 * an entry leaves it: without that, a command which returns drops to
+	 * a command line that two volume keys cannot type into, and the next
+	 * keypress is read there as a command. The three that never return,
+	 * reset, poweroff and the one that reboots into Download mode, have
+	 * nothing to add.
+	 */
+	"boot; bootmenu",
+	"run fastbootcmd; bootmenu",
+	"eficonfig; bootmenu",
+	"reset",
+	"poweroff",
+	"run diag_storage",
+	"run diag_dm",
+	"run dlmode",
+};
+
+#define EXYNOS_MENU_NAME	"B E Y O N D   B O O T"
+#define EXYNOS_MENU_MAX_COLS	96
+
+static const struct exynos_menu_text *exynos_menu_chosen(void)
+{
+	const char *code = env_get("menu_lang");
+	int i;
+
+	if (code) {
+		for (i = 0; i < EXYNOS_LANG_COUNT; i++) {
+			if (!strcmp(code, exynos_menu_lang[i].code))
+				return &exynos_menu_lang[i];
+		}
+	}
+
+	return &exynos_menu_lang[EXYNOS_LANG_EN];
+}
+
+/*
+ * How wide the console is, in characters. Everything framed below is drawn to
+ * that width, so a different panel or font needs no changes here.
+ */
+static int exynos_menu_cols(void)
+{
+	struct vidconsole_priv *priv;
+	struct udevice *con;
+
+	if (uclass_first_device_err(UCLASS_VIDEO_CONSOLE, &con))
+		return 0;
+
+	priv = dev_get_uclass_priv(con);
+	if (priv->cols < 24)
+		return 0;
+
+	return min_t(int, priv->cols, EXYNOS_MENU_MAX_COLS);
+}
+
+/*
+ * Length in characters rather than in bytes: the accented letters of three of
+ * these languages take more than one byte each, and counting bytes would pull
+ * every frame around them out of true. A byte that is not a continuation byte
+ * starts a character.
+ */
+static int exynos_menu_len(const char *s)
+{
+	int n = 0;
+
+	for (; *s; s++) {
+		if ((*s & 0xc0) != 0x80)
+			n++;
+	}
+
+	return n;
+}
+
+static void exynos_menu_var(const char *prefix, int n, const char *value)
+{
+	char name[24];
+
+	snprintf(name, sizeof(name), "%s_%d", prefix, n);
+	env_set(name, value);
+}
+
+/* A line of the frame, in the colour the rest of the frame is drawn in. */
+static void exynos_menu_rule(const char *prefix, int n, int cols)
+{
+	char buf[EXYNOS_MENU_MAX_COLS + 16];
+	int i, at = 0;
+
+	at += snprintf(buf + at, sizeof(buf) - at, "\033[33m+");
+	for (i = 0; i < cols - 2; i++)
+		buf[at++] = '-';
+	snprintf(buf + at, sizeof(buf) - at, "+\033[0m");
+	exynos_menu_var(prefix, n, buf);
+}
+
+static void exynos_menu_middle(const char *prefix, int n, int cols,
+			       const char *text, const char *colour)
+{
+	char buf[EXYNOS_MENU_MAX_COLS * 2];
+	int len = exynos_menu_len(text);
+	int pad = (cols - 2 - len) / 2;
+
+
+	if (pad < 0)
+		pad = 0;
+
+	snprintf(buf, sizeof(buf), "\033[33m|%*s\033[%sm%s\033[0;33m%*s|\033[0m",
+		 pad, "", colour, text, cols - 2 - pad - len, "");
+	exynos_menu_var(prefix, n, buf);
+}
+
+static void exynos_menu_field(const char *prefix, int n, int cols,
+			      const char *label, const char *value,
+			      const char *colour)
+{
+	char buf[EXYNOS_MENU_MAX_COLS * 2];
+	int len = exynos_menu_len(value);
+	int room = cols - 10;
+
+	if (len > room)
+		len = room;
+
+	snprintf(buf, sizeof(buf), "\033[33m| %-6s \033[%sm%.*s%*s\033[0;33m|\033[0m",
+		 label, colour, (int)strlen(value), value, room - len, "");
+	exynos_menu_var(prefix, n, buf);
+}
+
+/*
+ * What the storage probe found, kept from the first time it ran.
+ *
+ * It is the one expensive thing on this screen: looking for a block device
+ * scans the SCSI bus, and on a phone whose link does not come up that is four
+ * timeouts. Doing it again every time the menu is rebuilt, which is what
+ * changing language does, is felt as a menu that takes seconds to answer.
+ */
+static struct {
+	bool probed;
+	bool found;
+	char text[40];
+} exynos_storage;
+
+static void exynos_storage_probe(void)
+{
+	const struct blk_desc *blk;
+	const char *ifname;
+
+	if (exynos_storage.probed)
+		return;
+
+	exynos_storage.probed = true;
+
+	blk = exynos_get_boot_blk(&ifname, 0);
+	if (!blk)
+		return;
+
+	exynos_storage.found = true;
+	snprintf(exynos_storage.text, sizeof(exynos_storage.text),
+		 "%s  %llu MB", ifname, ((u64)blk->lba * blk->blksz) >> 20);
+}
+
+static void exynos_menu_hardware(const struct exynos_menu_text *txt, int cols)
+{
+	struct udevice *con;
+	char buf[64];
+	u64 total = 0;
+	u32 banks = 0;
+	int i;
+
+	/*
+	 * Summed rather than taken from gd->ram_size, which is the one region
+	 * U-Boot picked to live in, not what the phone has.
+	 */
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS; i++) {
+		if (gd->dram[i].size) {
+			total += gd->dram[i].size;
+			banks++;
+		}
+	}
+
+	exynos_menu_field("bootmenu_hdr", 4, cols, "SoC",
+			  env_get("platform") ? : txt->unknown, "1;33");
+
+	snprintf(buf, sizeof(buf), txt->banks, (u32)(total >> 20), banks);
+	exynos_menu_field("bootmenu_hdr", 5, cols, "DRAM", buf, "1;33");
+
+	if (!uclass_first_device_err(UCLASS_VIDEO_CONSOLE, &con)) {
+		struct vidconsole_priv *vc = dev_get_uclass_priv(con);
+		struct video_priv *vid = dev_get_uclass_priv(con->parent);
+
+		snprintf(buf, sizeof(buf), "%dx%d  %dx%d", vid->xsize,
+			 vid->ysize, vc->cols, vc->rows);
+		exynos_menu_field("bootmenu_hdr", 6, cols, "Panel", buf, "1;33");
+	}
+
+	exynos_storage_probe();
+	if (exynos_storage.found)
+		exynos_menu_field("bootmenu_hdr", 7, cols, "UFS",
+				  exynos_storage.text, "1;32");
+	else
+		exynos_menu_field("bootmenu_hdr", 7, cols, "UFS", txt->no_link,
+				  "1;31");
+}
+
+/**
+ * exynos_menu_build() - put the whole menu into the environment
+ *
+ * @lang_list:	true to offer the languages instead of the usual entries
+ */
+static void exynos_menu_build(bool lang_list)
+{
+	const struct exynos_menu_text *txt = exynos_menu_chosen();
+	char buf[EXYNOS_MENU_MAX_COLS * 2];
+	int cols = exynos_menu_cols();
+	int i, n = 0;
+
+	if (!cols)
+		return;
+
+	exynos_menu_rule("bootmenu_hdr", 0, cols);
+	exynos_menu_middle("bootmenu_hdr", 1, cols, EXYNOS_MENU_NAME, "1;33");
+	snprintf(buf, sizeof(buf), "%s  .  %s",
+		 env_get("platform") ? : "", env_get("board") ? : "");
+	exynos_menu_middle("bootmenu_hdr", 2, cols, buf, "33");
+	exynos_menu_rule("bootmenu_hdr", 3, cols);
+	exynos_menu_hardware(txt, cols);
+	exynos_menu_rule("bootmenu_hdr", 8, cols);
+
+	if (lang_list) {
+		for (i = 0; i < EXYNOS_LANG_COUNT; i++) {
+			snprintf(buf, sizeof(buf), "%s=setenv menu_lang %s; bmenu; bootmenu",
+				 exynos_menu_lang[i].own_name,
+				 exynos_menu_lang[i].code);
+			exynos_menu_var("bootmenu", n++, buf);
+		}
+		snprintf(buf, sizeof(buf), "%s=bmenu; bootmenu", txt->back);
+		exynos_menu_var("bootmenu", n++, buf);
+	} else {
+		for (i = 0; i < 8; i++) {
+			snprintf(buf, sizeof(buf), "%s=%s", txt->entry[i],
+				 exynos_menu_cmd[i]);
+			exynos_menu_var("bootmenu", n++, buf);
+		}
+		snprintf(buf, sizeof(buf), "%s=bmenu lang; bootmenu",
+			 txt->language);
+		exynos_menu_var("bootmenu", n++, buf);
+	}
+
+	/* Whatever the longer list left behind has to go, or it stays on. */
+	for (i = n; i < EXYNOS_LANG_COUNT + 9; i++)
+		exynos_menu_var("bootmenu", i, NULL);
+
+	exynos_menu_rule("bootmenu_ftr", 0, cols);
+	exynos_menu_middle("bootmenu_ftr", 1, cols, txt->keys, "33");
+	exynos_menu_rule("bootmenu_ftr", 2, cols);
+}
+
+static int do_bmenu(struct cmd_tbl *cmdtp, int flag, int argc,
+		    char *const argv[])
+{
+	exynos_menu_build(argc > 1 && !strcmp(argv[1], "lang"));
+
 	return 0;
 }
 
+U_BOOT_CMD(bmenu, 2, 1, do_bmenu,
+	   "rebuild the board's boot menu",
+	   "       - the usual entries\n"
+	   "bmenu lang  - the list of languages"
+);
+
 int misc_init_r(void)
 {
 	int ret;
 
 	exynos_env_setup();
 
+	/*
+	 * A boot loader that cannot find storage should still bring up its
+	 * command line: that is the one tool there is for working out why it
+	 * could not.  Returning the error here would instead hang the board,
+	 * because that is what a failed initcall does.
+	 */
 	ret = exynos_blk_env_setup();
 	if (ret)
-		return ret;
+		log_warning("%s: carrying on without storage (%d)\n",
+				    __func__, ret);
+
+	exynos_menu_build(false);
 
 	return exynos_fastboot_setup();
 }
