index 00000000..ea48614a
--- /dev/null
+++ b/dts/upstream/src/arm64/exynos/exynos9820-beyond2lte.dts
@@ -0,0 +1,365 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Galaxy S10+ (SM-G975F, beyond2lte) device tree source
+ *
+ * Copyright (C) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ *
+ * What the board adds on top of the SoC: the crystal rate, the four keys, the
+ * touchscreen and its two rails, and the display, which is a S6E3HA9 panel fed
+ * over MIPI DSI and powered by a S2DOS05 PMIC on the always-on I2C bus.
+ */
+
+/dts-v1/;
+#include "exynos9820.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/soc/samsung,exynos-usi.h>
+
+/ {
+	model = "Samsung Galaxy S10+ (SM-G975F)";
+	compatible = "samsung,beyond2lte", "samsung,exynos9820";
+	chassis-type = "handset";
+
+	/*
+	 * 8 GiB of DRAM in six banks, read from the device tree the boot
+	 * loader hands the vendor kernel on this phone (/sys/firmware/fdt).
+	 * The two gaps below 4 GiB, 0xbab00000..0xbfffffff and
+	 * 0xe0000000..0xe18fffff, are memory the secure firmware keeps, so
+	 * they are absent here on purpose; merging the banks across them
+	 * would hand the kernel pages it must not touch.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3ab00000>;
+	};
+
+	memory@c0000000 {
+		device_type = "memory";
+		reg = <0x0 0xc0000000 0x20000000>;
+	};
+
+	memory@e1900000 {
+		device_type = "memory";
+		reg = <0x0 0xe1900000 0x1e700000>;
+	};
+
+	memory@880000000 {
+		device_type = "memory";
+		reg = <0x8 0x80000000 0x80000000>;
+	};
+
+	memory@900000000 {
+		device_type = "memory";
+		reg = <0x9 0x00000000 0x80000000>;
+	};
+
+	memory@980000000 {
+		device_type = "memory";
+		reg = <0x9 0x80000000 0x80000000>;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+		stdout-path = &serial0;
+
+		/*
+		 * The framebuffer S-Boot leaves behind, so there is a picture
+		 * before the display driver takes over.  The address is the one
+		 * the boot loader itself passes on this phone: the vendor kernel
+		 * receives "s3cfb.bootloaderfb=0xca000000" on its command line.
+		 */
+		framebuffer0: framebuffer@ca000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
+			width = <1440>;
+			height = <3040>;
+			stride = <(1440 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	/*
+	 * Four keys, all wired to always-on banks so they can wake the phone.
+	 * Two of them are wakeup sources, the two the vendor marks that way:
+	 * the wink key and the power key.
+	 */
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&key_volup &key_voldown &key_wink &key_power>;
+		pinctrl-names = "default";
+
+		key-volup {
+			label = "Volume Up Key";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;
+		};
+
+		key-voldown {
+			label = "Volume Down Key";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa0 4 GPIO_ACTIVE_LOW>;
+		};
+
+		key-wink {
+			label = "Wink Key";
+			linux,code = <KEY_COFFEE>;
+			gpios = <&gpa0 6 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+
+		key-power {
+			label = "Power Key";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa2 4 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * The touchscreen rails really come from two LDOs of the main PMIC
+	 * (LDO19M and LDO27M of the S2MPS19), which mainline cannot reach yet:
+	 * that PMIC is behind the ACPM mailbox.  They are on when the bootloader
+	 * hands over, so they are described as fixed supplies until the real
+	 * regulators can be named.
+	 */
+	reg_tsp_io: regulator-tsp-io {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_io";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	reg_tsp_avdd: regulator-tsp-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_avdd";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		regulator-always-on;
+	};
+
+	/*
+	 * Memory the kernel must not hand out.  Every region below is taken
+	 * from a tree that describes this board, not from a calculation: the
+	 * vendor kernel's own device tree, or the independent port that boots
+	 * the same phone.  Leaving one out is not a missing feature, it is a
+	 * kernel that eventually writes into the hypervisor, the modem or the
+	 * secure firmware and dies without a line on the console.
+	 *
+	 * The three the vendor's SoC tree carries are sec_debug_magic,
+	 * mm_debug and seclog_mem (ds/exynos9820.dts:2885-2892 and :2980-2983);
+	 * the modem's three and the secure camera come from its board tree
+	 * (ds/exynos9820-beyond2lte_eur_open_26.dts:4490-4503 and :6727-6734).
+	 * The remaining three, the KASLR seed page and the two EL2 regions,
+	 * exist only in the independent port (ub/exynos9820-common.dtsi:60-112),
+	 * which is why they carry their own note.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		sec_debug_magic@80000000 {
+			reg = <0x0 0x80000000 0x1000>;
+			no-map;
+		};
+
+		/*
+		 * The seed page and the two EL2 regions are not in the vendor
+		 * source tree, but they are in the device tree the boot loader
+		 * hands the vendor kernel on this phone, at exactly these
+		 * addresses and sizes, under the compatibles "kernel-kaslr"
+		 * and "el2,uh".
+		 */
+		kaslr_seed@80001000 {
+			reg = <0x0 0x80001000 0x1000>;
+			no-map;
+		};
+
+		el2_code@87000000 {
+			reg = <0x0 0x87000000 0x200000>;
+			no-map;
+		};
+
+		mm_debug@91200000 {
+			reg = <0x0 0x91200000 0x1000>;
+			no-map;
+		};
+
+		secure_camera@96000000 {
+			reg = <0x0 0x96000000 0x2200000>;
+			no-map;
+		};
+
+		seclog_mem@c0000000 {
+			reg = <0x0 0xc0000000 0x80000>;
+			no-map;
+		};
+
+		framebuffer@ca000000 {
+			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
+			no-map;
+		};
+
+		modem_spare@d0000000 {
+			reg = <0x0 0xd0000000 0x1600000>;
+			no-map;
+		};
+
+		modem_if@f0000000 {
+			reg = <0x0 0xf0000000 0xb900000>;
+			no-map;
+		};
+
+		cp_ram_logging@fb900000 {
+			reg = <0x0 0xfb900000 0x2000000>;
+			no-map;
+		};
+
+		el2_earlymem@9fd800000 {
+			reg = <0x9 0xfd800000 0x2800000>;
+			no-map;
+		};
+	};
+};
+
+&decon0 {
+	status = "okay";
+};
+
+&dsim0 {
+	status = "okay";
+
+	panel@0 {
+		compatible = "samsung,s6e3ha9";
+		reg = <0>;
+
+		vdd3-supply = <&panel_vdd3>;
+		vci-supply = <&panel_vci>;
+		vddr-supply = <&panel_vddr>;
+
+		reset-gpios = <&gpa3 4 GPIO_ACTIVE_LOW>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&dsim0_out>;
+			};
+		};
+	};
+};
+
+&hsi2c10 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchscreen@48 {
+		compatible = "samsung,s6sy761";
+		reg = <0x48>;
+
+		avdd-supply = <&reg_tsp_avdd>;
+		vdd-supply = <&reg_tsp_io>;
+
+		interrupts-extended = <&gpa1 0 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&ts_int>;
+		pinctrl-names = "default";
+	};
+};
+
+/*
+ * The display PMIC.  Its three rails are the panel's, and the names below are
+ * the roles the vendor gives them: ddi-3p0 is vci, ddi-1p8 is vdd3 and
+ * ddr-1p6 is vddr.  The buck can also run at 1.5 V in the vendor's low power
+ * mode, which is not modelled here.
+ *
+ * The bus is not a guess.  The vendor keeps this chip in a device tree
+ * overlay whose target is a label rather than a path, and the fixup table
+ * resolves it: hsi2c_44 owns the fragment that holds s2dos05_pmic@60
+ * (ds/exynos9820-beyond2lte_eur_open_26.dts:8271), and hsi2c_44 is the node
+ * at 0x15d50000 (ds/exynos9820.dts:11537), which is this one.
+ */
+&hsi2c2 {
+	status = "okay";
+
+	pmic@60 {
+		compatible = "samsung,s2dos05";
+		reg = <0x60>;
+
+		regulators {
+			panel_vddr: buck {
+				regulator-name = "panel_vddr";
+				regulator-min-microvolt = <1600000>;
+				regulator-max-microvolt = <1600000>;
+				regulator-boot-on;
+			};
+
+			panel_vdd3: ldo1 {
+				regulator-name = "panel_vdd3";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-boot-on;
+			};
+
+			panel_vci: ldo4 {
+				regulator-name = "panel_vci";
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
+				regulator-boot-on;
+			};
+		};
+	};
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+&pinctrl_alive {
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa0-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_wink: key-wink-pins {
+		samsung,pins = "gpa0-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_power: key-power-pins {
+		samsung,pins = "gpa2-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	ts_int: ts-int-pins {
+		samsung,pins = "gpa1-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
+
+&serial0 {
+	status = "okay";
+};
+
+/* This USI instance is wired as the touchscreen I2C master on this board. */
+&usi3 {
+	samsung,mode = <USI_V2_I2C>;
+	status = "okay";
+};
diff --git a/dts/upstream/src/arm64/exynos/exynos9820-pinctrl.dtsi b/dts/upstream/src/arm64/exynos/exynos9820-pinctrl.dtsi
new file mode 100644
index 00000000..e3767714
--- /dev/null
+++ b/dts/upstream/src/arm64/exynos/exynos9820-pinctrl.dtsi
@@ -0,0 +1,665 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Exynos9820 SoC pin-mux and pin-config device tree source
+ *
+ * Copyright (C) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ *
+ * The bank names and their order are the ones the pin controller driver
+ * expects, and the wakeup interrupt numbers are the ones the SoC wires to the
+ * GIC; both are transcribed from the vendor sources rather than from another
+ * port.  Only the banks that can wake the system carry an interrupt list: the
+ * rest reach the CPU through their own controller.
+ *
+ * The three pin groups at the end are the ones this SoC needs before anything
+ * can talk: the two I2C buses and the panel tearing effect line.
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include "exynos-pinctrl.h"
+
+&pinctrl_alive {
+	gpa0: gpa0-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	gpa1: gpa1-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	gpa2: gpa2-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	gpa3: gpa3-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	gpa4: gpa4-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	gpq0: gpq0-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+
+	etc0: etc0-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+};
+
+&pinctrl_aud {
+	gpb0: gpb0-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+
+	gpb1: gpb1-gpio-bank {
