@@ -0,0 +1,689 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Exynos9820 SoC device tree source
+ *
+ * Copyright (C) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ *
+ * This describes the part of the SoC that the drivers in this series can
+ * actually reach: the eight CPUs, the clock controllers, the pin controllers,
+ * the system timer, the interrupt controller, the debug UART and the buses the
+ * board needs.  Everything else the SoC has is left out rather than described
+ * and disabled, because a node nobody drives is a claim nobody checks.
+ *
+ * Addresses, interrupt numbers and clock indices come from the vendor sources
+ * listed in SOURCES.md.  Nodes under soc@0 are ordered by their unit address.
+ *
+ * UNVERIFIED: every interrupt here is described as level high, the way every
+ * other Exynos SoC in this tree describes its own, but that is not the shape
+ * the phone runs with: the vendor tree sets no type at all and its kernel ends
+ * up with the lines as edge.  The numbers are confirmed against the running
+ * system, only the type is open, and getting it wrong gives either a storm or
+ * an interrupt that never arrives.  Each block has to be made to raise its
+ * line.  Copying the vendor's unset type is not the fix.
+ */
+
+#include <dt-bindings/clock/samsung,exynos9820.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+	compatible = "samsung,exynos9820";
+	#address-cells = <2>;
+	#size-cells = <1>;
+
+	interrupt-parent = <&gic>;
+
+	/*
+	 * The pin controller driver picks its bank tables by this alias, so the
+	 * numbering is not cosmetic: pinctrlN has to name the Nth entry of
+	 * exynos9820_pin_ctrl[].
+	 */
+	aliases {
+		pinctrl0 = &pinctrl_alive;
+		pinctrl1 = &pinctrl_aud;
+		pinctrl2 = &pinctrl_cmgp;
+		pinctrl3 = &pinctrl_fsys0;
+		pinctrl4 = &pinctrl_fsys1;
+		pinctrl5 = &pinctrl_peric0;
+		pinctrl6 = &pinctrl_peric1;
+		pinctrl7 = &pinctrl_vts;
+	};
+
+	/*
+	 * Three clusters: four Cortex-A55, two Cortex-A75 and two Mongoose M4.
+	 * The M4 pair sits behind its own affinity level, hence the 0x100 in its
+	 * MPIDR rather than a flat numbering.
+	 */
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					cpu = <&cpu0>;
+				};
+				core1 {
+					cpu = <&cpu1>;
+				};
+				core2 {
+					cpu = <&cpu2>;
+				};
+				core3 {
+					cpu = <&cpu3>;
+				};
+			};
+
+			cluster1 {
+				core0 {
+					cpu = <&cpu4>;
+				};
+				core1 {
+					cpu = <&cpu5>;
+				};
+			};
+
+			cluster2 {
+				core0 {
+					cpu = <&cpu6>;
+				};
+				core1 {
+					cpu = <&cpu7>;
+				};
+			};
+		};
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <272>;
+			dynamic-power-coefficient = <160>;
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x1>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <272>;
+			dynamic-power-coefficient = <160>;
+		};
+
+		cpu2: cpu@2 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x2>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <272>;
+			dynamic-power-coefficient = <160>;
+		};
+
+		cpu3: cpu@3 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x3>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <272>;
+			dynamic-power-coefficient = <160>;
+		};
+
+		cpu4: cpu@4 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a75";
+			reg = <0x4>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <531>;
+			dynamic-power-coefficient = <320>;
+		};
+
+		cpu5: cpu@5 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a75";
+			reg = <0x5>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <531>;
+			dynamic-power-coefficient = <320>;
+		};
+
+		cpu6: cpu@100 {
+			device_type = "cpu";
+			compatible = "samsung,mongoose-m4";
+			reg = <0x100>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <785>;
+			dynamic-power-coefficient = <760>;
+		};
+
+		cpu7: cpu@101 {
+			device_type = "cpu";
+			compatible = "samsung,mongoose-m4";
+			reg = <0x101>;
+			enable-method = "psci";
+			capacity-dmips-mhz = <785>;
+			dynamic-power-coefficient = <760>;
+		};
+	};
+
+	/*
+	 * The 26 MHz crystal every clock controller takes as its reference.  The
+	 * rate is a property of the board, so the board file fills it in.
+	 */
+	oscclk: osc-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-output-names = "oscclk";
+	};
+
+	/* One performance monitor node per core type, as the PMUs differ. */
+	pmu-a55 {
+		compatible = "arm,cortex-a55-pmu";
+		interrupts = <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
+	};
+
+	pmu-a75 {
+		compatible = "arm,cortex-a75-pmu";
+		interrupts = <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-affinity = <&cpu4>, <&cpu5>;
+	};
+
+	pmu-mongoose {
+		compatible = "samsung,mongoose-pmu";
+		interrupts = <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 175 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-affinity = <&cpu6>, <&cpu7>;
+	};
+
+	psci {
+		compatible = "arm,psci";
+		method = "smc";
+		cpu_suspend = <0xc4000001>;
+		cpu_off = <0x84000002>;
+		cpu_on = <0xc4000003>;
+	};
+
+	soc: soc@0 {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x0 0x0 0x20000000>;
+
+		chipid@10000000 {
+			compatible = "samsung,exynos9820-chipid",
+				     "samsung,exynos850-chipid";
+			reg = <0x10000000 0x100>;
+		};
+
+		cmu_peris: clock-controller@10020000 {
+			compatible = "samsung,exynos9820-cmu-peris";
+			reg = <0x10020000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>,
+				 <&cmu_top CLK_DOUT_CMU_PERIS_BUS>;
+			clock-names = "oscclk", "bus";
+		};
+
+		/*
+		 * Twelve comparators, one per core plus four global ones; the
+		 * driver takes them in that order.
+		 */
+		timer@10040000 {
+			compatible = "samsung,exynos9820-mct",
+				     "samsung,exynos4210-mct";
+			reg = <0x10040000 0x800>;
+			clocks = <&oscclk>,
+				 <&cmu_peris CLK_GOUT_PERIS_MCT_PCLK>;
+			clock-names = "fin_pll", "mct";
+			interrupts = <GIC_SPI 466 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 467 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 468 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 469 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 470 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 471 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 472 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 473 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 474 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 475 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 476 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 477 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		gic: interrupt-controller@10101000 {
+			compatible = "arm,gic-400";
+			#interrupt-cells = <3>;
+			#address-cells = <0>;
+			interrupt-controller;
+			reg = <0x10101000 0x1000>,
+			      <0x10102000 0x1000>,
+			      <0x10104000 0x2000>,
+			      <0x10106000 0x2000>;
+			interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(8) |
+						 IRQ_TYPE_LEVEL_HIGH)>;
+		};
+
+		cmu_peric0: clock-controller@10400000 {
+			compatible = "samsung,exynos9820-cmu-peric0";
+			reg = <0x10400000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>,
+				 <&cmu_top CLK_DOUT_CMU_PERIC0_BUS>,
+				 <&cmu_top CLK_DOUT_CMU_PERIC0_IP>;
+			clock-names = "oscclk", "bus", "ip";
+		};
+
+		/* Holds the mode register the USI blocks of this domain use. */
+		sysreg_peric0: syscon@10420000 {
+			compatible = "samsung,exynos9820-peric0-sysreg",
+				     "syscon";
+			reg = <0x10420000 0x2000>;
+			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_SYSREG_PERIC0_PCLK>;
+		};
+
+		pinctrl_peric0: pinctrl@10430000 {
+			compatible = "samsung,exynos9820-pinctrl";
+			reg = <0x10430000 0x1000>;
+			interrupts = <GIC_SPI 380 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		serial0: serial@10440000 {
+			compatible = "samsung,exynos9820-uart",
+				     "samsung,exynos8895-uart";
+			reg = <0x10440000 0x100>;
+			interrupts = <GIC_SPI 381 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_UART_DBG_PCLK>,
+				 <&cmu_peric0 CLK_GOUT_PERIC0_UART_DBG_IPCLK>;
+			clock-names = "uart", "clk_uart_baud0";
+			samsung,uart-fifosize = <256>;
+			status = "disabled";
+		};
+
+		/*
+		 * A USI block is one piece of hardware that can be a UART, an SPI
+		 * master or an I2C master; the mode lives in the PERIC0 system
+		 * register, and the child node below is the mode this board picks.
+		 * The USI configuration window sits above the peripheral window,
+		 * which is why the parent address is the higher of the two.
+		 */
+		usi3: usi@104b00c0 {
+			compatible = "samsung,exynos9820-usi",
+				     "samsung,exynos850-usi";
+			reg = <0x104b00c0 0x20>;
+			ranges;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI03_USI_PCLK>,
+				 <&cmu_peric0 CLK_GOUT_PERIC0_USI03_USI_IPCLK>;
+			clock-names = "pclk", "ipclk";
+			samsung,sysreg = <&sysreg_peric0 0x101c>;
+			status = "disabled";
+
+			hsi2c10: i2c@104b0000 {
+				compatible = "samsung,exynos9820-hsi2c",
+					     "samsung,exynosautov9-hsi2c";
+				reg = <0x104b0000 0xc0>;
+				interrupts = <GIC_SPI 388 IRQ_TYPE_LEVEL_HIGH>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI03_USI_IPCLK>,
+					 <&cmu_peric0 CLK_GOUT_PERIC0_USI03_USI_PCLK>;
+				clock-names = "hsi2c", "hsi2c_pclk";
+				pinctrl-0 = <&hsi2c10_bus>;
+				pinctrl-names = "default";
+				status = "disabled";
+			};
+		};
+
+		pinctrl_peric1: pinctrl@10830000 {
+			compatible = "samsung,exynos9820-pinctrl";
+			reg = <0x10830000 0x1000>;
+			interrupts = <GIC_SPI 407 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		pinctrl_fsys0: pinctrl@13030000 {
+			compatible = "samsung,exynos9820-pinctrl";
+			reg = <0x13030000 0x1000>;
+			interrupts = <GIC_SPI 240 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		pinctrl_fsys1: pinctrl@13c40000 {
+			compatible = "samsung,exynos9820-pinctrl";
+			reg = <0x13c40000 0x1000>;
+			interrupts = <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		/*
+		 * The VTS and AUD pin controllers sit inside power domains that can
+		 * be off, so they carry no interrupt and the driver leaves their
+		 * registers alone until something claims a pin.
+		 */
+		pinctrl_vts: pinctrl@15580000 {
+			compatible = "samsung,exynos9820-pinctrl";
+			reg = <0x15580000 0x1000>;
+		};
+
+		cmu_apm: clock-controller@15800000 {
+			compatible = "samsung,exynos9820-cmu-apm";
+			reg = <0x15800000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>,
+				 <&cmu_top CLK_DOUT_CMU_APM_BUS>;
+			clock-names = "oscclk", "bus";
+		};
+
+		/*
+		 * The banks of this controller and of CMGP keep their pads alive
+		 * across suspend, so they are the two that can wake the system.  The
+		 * interrupt lists live with the banks, in the pin controller file.
+		 */
+		pinctrl_alive: pinctrl@15850000 {
+			compatible = "samsung,exynos9820-pinctrl";
+			reg = <0x15850000 0x1000>;
+
+			wakeup-interrupt-controller {
+				compatible = "samsung,exynos9820-wakeup-eint",
+					     "samsung,exynos850-wakeup-eint",
+					     "samsung,exynos7-wakeup-eint";
+			};
+		};
+
+		pmu_system_controller: system-controller@15860000 {
+			compatible = "samsung,exynos9820-pmu",
+				     "samsung,exynos7-pmu",
+				     "syscon";
+			reg = <0x15860000 0x10000>;
+
+			poweroff: syscon-poweroff {
+				compatible = "syscon-poweroff";
+				regmap = <&pmu_system_controller>;
+				offset = <0x030c>; /* PS_HOLD_CONTROL */
+				mask = <0x100>;
+				value = <0x0>;
+			};
+
+			reboot: syscon-reboot {
+				compatible = "syscon-reboot";
+				regmap = <&pmu_system_controller>;
+				offset = <0x3a00>; /* SWRESET */
+				mask = <0x2>; /* SWRESET_TRIGGER */
+				value = <0x2>;
+			};
+		};
+
+		/*
+		 * UNVERIFIED: The mask is the vendor's own
+		 * (flexpmu_cal_local_exynos9820.h:287-288 writes 0x15860000 +
+		 * 0x1e00 with (0x1 << 0) and waits on + 0x1e04 with the same
+		 * mask), but exynos_pd_power writes the whole word, so the other
+		 * 31 bits are zeroed and no source says what they hold.  The
+		 * vendor node also carries need_smc = <0x191b0204>, which this
+		 * binding has no way to express.
+		 */
+		pd_dpu: power-domain@15861e00 {
+			compatible = "samsung,exynos9820-pd";
+			reg = <0x15861e00 0x20>;
+			#power-domain-cells = <0>;
+			label = "DPU";
+		};
+
+		cmu_cmgp: clock-controller@15c00000 {
+			compatible = "samsung,exynos9820-cmu-cmgp";
+			reg = <0x15c00000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>,
+				 <&cmu_apm CLK_DOUT_CMU_CMGP_BUS>;
+			clock-names = "oscclk", "bus";
+		};
+
+		pinctrl_cmgp: pinctrl@15c30000 {
+			compatible = "samsung,exynos9820-pinctrl";
+			reg = <0x15c30000 0x1000>;
+
+			wakeup-interrupt-controller {
+				compatible = "samsung,exynos9820-wakeup-eint",
+					     "samsung,exynos850-wakeup-eint",
+					     "samsung,exynos7-wakeup-eint";
+			};
+		};
+
+		/*
+		 * This bus stays awake with the CMGP domain, which is why the
+		 * display PMIC hangs off it rather than off a PERIC bus: the panel
+		 * rails have to be reachable while the rest sleeps.
+		 */
+		hsi2c2: i2c@15d50000 {
+			compatible = "samsung,exynos9820-hsi2c",
+				     "samsung,exynosautov9-hsi2c";
+			reg = <0x15d50000 0x1000>;
+			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			clocks = <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP2_IPCLK>,
+				 <&cmu_cmgp CLK_GOUT_CMGP_I2C_CMGP2_PCLK>;
+			clock-names = "hsi2c", "hsi2c_pclk";
+			pinctrl-0 = <&hsi2c2_bus>;
+			pinctrl-names = "default";
+			status = "disabled";
+		};
+
+		pinctrl_aud: pinctrl@18c60000 {
+			compatible = "samsung,exynos9820-pinctrl";
+			reg = <0x18c60000 0x1000>;
+		};
+
+		cmu_dpu: clock-controller@19000000 {
+			compatible = "samsung,exynos9820-cmu-dpu";
+			reg = <0x19000000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>,
+				 <&cmu_top CLK_DOUT_CMU_DPU_BUS>;
+			clock-names = "oscclk", "bus";
+			power-domains = <&pd_dpu>;
+		};
+
+		/*
+		 * The window of the display unit system registers that carries the
+		 * reset of the D-PHY and the choice of what drives it.  This is the
+		 * window the vendor maps, sixteen bytes at this address rather than
+		 * the whole block, so the offsets are the ones its sources use.
+		 */
+		sysreg_dpu: syscon@19011000 {
+			compatible = "samsung,exynos9820-dpu-sysreg",
+				     "syscon";
+			reg = <0x19011000 0x10>;
+		};
+
+		/*
+		 * The display controller and one of its window pipelines.  This
+		 * panel runs in command mode, so nothing scans out on its own: the
+		 * panel raises the tearing effect line and the controller sends one
+		 * frame in answer.
+		 */
+		decon0: display-controller@19030000 {
+			compatible = "samsung,exynos9820-decon";
+			reg = <0x19030000 0x10000>, <0x19070000 0x10000>;
+			reg-names = "decon", "dma";
+
+			interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 189 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "frame-start", "frame-done", "extra";
+
+			/* the panel drives the frame trigger over this line */
+			pinctrl-names = "default";
+			pinctrl-0 = <&decon_te_pins>;
+
+			clocks = <&cmu_dpu CLK_GOUT_DPU_DPU_ACLK_DECON>,
+				 <&cmu_dpu CLK_GOUT_DPU_DPU_ACLK_DMA>,
+				 <&cmu_dpu CLK_GOUT_DPU_DPU_ACLK_DPP>;
+			clock-names = "aclk", "aclk-dma", "aclk-dpp";
+
+			power-domains = <&pd_dpu>;
+			iommus = <&sysmmu_dpud0>, <&sysmmu_dpud1>,
+				 <&sysmmu_dpud2>;
+			status = "disabled";
+
+			port {
+				decon0_out: endpoint {
+					remote-endpoint = <&dsim0_in>;
+				};
+			};
+		};
+
+		dsim0: dsi@19080000 {
+			compatible = "samsung,exynos9820-mipi-dsi";
+			reg = <0x19080000 0x300>;
+
+			phys = <&dsim0_dphy>;
+			phy-names = "dsim";
+
+			interrupts = <GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&cmu_dpu CLK_GOUT_DPU_AD_APB_MIPI_DSIM0_PCLKS>;
+			clock-names = "bus";
+
+			/*
+			 * The link runs at a rate the panel and the D-PHY timing table
+			 * agree on.  Without this the host would derive it from the
+			 * pixel clock and the uncompressed 24 bpp, which ignores DSC
+			 * and asks the PHY for a rate it has no timings for.
+			 */
+			samsung,burst-clock-frequency = <898000000>;
+
+			/*
+			 * UNVERIFIED: the sources give both 18 and 20 MHz for
+			 * this link.  The prescaler rounds whatever is asked for down
+			 * to a divider of the word clock, so the number that actually
