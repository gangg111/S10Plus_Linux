+		 * point at it instead of each mapping it themselves.
+		 */
+		dphy_top: syscon@19160000 {
+			compatible = "samsung,exynos9820-dphy-top", "syscon";
+			reg = <0x19160000 0x100>;
+		};
+
+		dsim0_dphy: phy@19161000 {
+			compatible = "samsung,exynos9820-mipi-dphy";
+			reg = <0x19161000 0x800>;
+			samsung,dphy-top-syscon = <&dphy_top>;
+			samsung,dpu-sysreg = <&sysreg_dpu>;
+
+			clocks = <&cmu_dpu CLK_GOUT_DPU_AD_APB_MIPI_DSIM0_PCLKS>;
+			clock-names = "apb";
+
+			power-domains = <&pd_dpu>;
+			#phy-cells = <0>;
+		};
+
+		/*
+		 * Every other clock controller takes its input from this one, so it
+		 * is registered before them.
+		 */
+		cmu_top: clock-controller@1a240000 {
+			compatible = "samsung,exynos9820-cmu-top";
+			reg = <0x1a240000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>;
+			clock-names = "oscclk";
+		};
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+
+		/*
+		 * Hypervisor Virtual Timer interrupt is not wired to the GIC
+		 * and S-Boot leaves CNTFRQ_EL0 unconfigured.
+		 */
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
