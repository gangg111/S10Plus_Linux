+		int part = dim;
 
-	node = fdt_node_offset_by_compatible(fdt, -1, "simple-framebuffer");
-	if (node < 0)
-		return;
+		if (behind < EXYNOS_SPIN_ARC)
+			part += (lit - dim) * (int)(EXYNOS_SPIN_ARC - behind) /
+				EXYNOS_SPIN_ARC;
 
-	parent = fdt_parent_offset(fdt, node);
-	base = fdtdec_get_addr_size_auto_parent(fdt, parent, node, "reg", 0,
-						&size, false);
-	if (base == FDT_ADDR_T_NONE)
+		colour |= (u32)part << (16 - 8 * i);
