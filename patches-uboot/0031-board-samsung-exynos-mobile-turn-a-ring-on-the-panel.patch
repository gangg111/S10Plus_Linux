+	{   946,  -392 }, {   964,  -345 }, {   980,  -297 }, {   993,  -249 },
+	{  1004,  -200 }, {  1013,  -150 }, {  1019,  -100 }, {  1023,   -50 },
+	{  1024,     0 }, {  1023,    50 }, {  1019,   100 }, {  1013,   150 },
+	{  1004,   200 }, {   993,   249 }, {   980,   297 }, {   964,   345 },
+	{   946,   392 }, {   926,   438 }, {   903,   483 }, {   878,   526 },
+	{   851,   569 }, {   822,   610 }, {   792,   650 }, {   759,   688 },
+	{   724,   724 }, {   688,   759 }, {   650,   792 }, {   610,   822 },
+	{   569,   851 }, {   526,   878 }, {   483,   903 }, {   438,   926 },
+	{   392,   946 }, {   345,   964 }, {   297,   980 }, {   249,   993 },
+	{   200,  1004 }, {   150,  1013 }, {   100,  1019 }, {    50,  1023 },
+	{     0,  1024 }, {   -50,  1023 }, {  -100,  1019 }, {  -150,  1013 },
+	{  -200,  1004 }, {  -249,   993 }, {  -297,   980 }, {  -345,   964 },
+	{  -392,   946 }, {  -438,   926 }, {  -483,   903 }, {  -526,   878 },
+	{  -569,   851 }, {  -610,   822 }, {  -650,   792 }, {  -688,   759 },
+	{  -724,   724 }, {  -759,   688 }, {  -792,   650 }, {  -822,   610 },
+	{  -851,   569 }, {  -878,   526 }, {  -903,   483 }, {  -926,   438 },
+	{  -946,   392 }, {  -964,   345 }, {  -980,   297 }, {  -993,   249 },
+	{ -1004,   200 }, { -1013,   150 }, { -1019,   100 }, { -1023,    50 },
+	{ -1024,     0 }, { -1023,   -50 }, { -1019,  -100 }, { -1013,  -150 },
+	{ -1004,  -200 }, {  -993,  -249 }, {  -980,  -297 }, {  -964,  -345 },
+	{  -946,  -392 }, {  -926,  -438 }, {  -903,  -483 }, {  -878,  -526 },
+	{  -851,  -569 }, {  -822,  -610 }, {  -792,  -650 }, {  -759,  -688 },
+	{  -724,  -724 }, {  -688,  -759 }, {  -650,  -792 }, {  -610,  -822 },
+	{  -569,  -851 }, {  -526,  -878 }, {  -483,  -903 }, {  -438,  -926 },
+	{  -392,  -946 }, {  -345,  -964 }, {  -297,  -980 }, {  -249,  -993 },
+	{  -200, -1004 }, {  -150, -1013 }, {  -100, -1019 }, {   -50, -1023 },
+};
+
+/* The green of the system this loader is there to start, and the ring. */
+static const u8 exynos_spin_lit[3] = { 0x12, 0xdc, 0x1e };
+static const u8 exynos_spin_dim[3] = { 0x12, 0x3a, 0x16 };
+
+static struct cyclic_info exynos_spin_cyclic;
+static struct exynos_fb exynos_spin_fb;
+static bool exynos_spin_on;
+static u32 exynos_spin_head;
+
+static u32 exynos_spin_colour(u32 behind)
 {
-	const void *fdt = gd->fdt_blob;
-	u32 height, stride, rows, *pixel;
-	fdt_addr_t base;
-	fdt_size_t size;
-	int node, parent;
-	u64 offset;
-	u32 i, words;
+	u32 colour = 0xff000000;
+	int i;
 
-	if (stage >= EXYNOS_MARK_COUNT)
-		return;
+	for (i = 0; i < 3; i++) {
