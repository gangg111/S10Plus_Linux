+
+	return colour;
+}
+
+static void exynos_spin_disc(u32 cx, u32 cy, u32 colour)
+{
+	const struct exynos_fb *fb = &exynos_spin_fb;
+	int dx, dy;
+
+	for (dy = -EXYNOS_SPIN_DISC; dy <= EXYNOS_SPIN_DISC; dy++) {
+		u32 *row = (u32 *)(fb->base + (u64)fb->stride * (cy + dy));
+
+		for (dx = -EXYNOS_SPIN_DISC; dx <= EXYNOS_SPIN_DISC; dx++)
+			if (dx * dx + dy * dy <=
+			    EXYNOS_SPIN_DISC * EXYNOS_SPIN_DISC)
+				row[cx + dx] = colour;
+	}
+}
+
+static void exynos_spin_step(struct cyclic_info *c)
+{
+	const struct exynos_fb *fb = &exynos_spin_fb;
+	u32 cx = fb->width / 2;
+	u32 cy = fb->height / 2;
+	u32 i, top, bottom;
+
+	for (i = 0; i < EXYNOS_SPIN_STEPS; i++) {
+		u32 behind = (exynos_spin_head + EXYNOS_SPIN_STEPS - i) %
+			     EXYNOS_SPIN_STEPS;
+		int dx = EXYNOS_SPIN_RADIUS * exynos_spin_at[i][0] /
+			 EXYNOS_SPIN_SCALE;
+		int dy = EXYNOS_SPIN_RADIUS * exynos_spin_at[i][1] /
+			 EXYNOS_SPIN_SCALE;
+
+		exynos_spin_disc(cx + dx, cy + dy, exynos_spin_colour(behind));
+	}
+
+	top = cy - EXYNOS_SPIN_RADIUS - EXYNOS_SPIN_DISC;
+	bottom = cy + EXYNOS_SPIN_RADIUS + EXYNOS_SPIN_DISC + 1;
+	flush_dcache_range((ulong)(fb->base + (u64)fb->stride * top),
+			   (ulong)(fb->base + (u64)fb->stride * bottom));
+
+	exynos_decon_trigger();
+
+	exynos_spin_head = (exynos_spin_head + EXYNOS_SPIN_ADVANCE) %
+			   EXYNOS_SPIN_STEPS;
+}
+
+static void exynos_spin_start(void)
+{
+	u32 reach = EXYNOS_SPIN_RADIUS + EXYNOS_SPIN_DISC;
+
+	if (exynos_spin_on)
 		return;
 
-	height = fdtdec_get_int(fdt, node, "height", 0);
-	stride = fdtdec_get_int(fdt, node, "stride", 0);
-	if (!height || !stride || stride % sizeof(*pixel))
+	if (exynos_fb_get(&exynos_spin_fb))
 		return;
 
-	/* Do not write past what the tree says is there. */
-	if ((u64)stride * height > size)
+	/* Half of the ring has to fit above the centre, and half below. */
+	if (exynos_spin_fb.width < 2 * reach ||
+	    exynos_spin_fb.height < 2 * reach)
 		return;
 
-	rows = EXYNOS_MARK_ROWS;
-	if (height < rows * (stage + 1))
+	exynos_spin_head = 0;
+	cyclic_register(&exynos_spin_cyclic, exynos_spin_step,
+			EXYNOS_SPIN_PERIOD_US, "exynos-spin");
+	exynos_spin_on = true;
+}
+
+static void exynos_spin_stop(void)
+{
+	if (!exynos_spin_on)
 		return;
 
-	offset = (u64)stride * (height - rows * (stage + 1));
-	words = rows * (stride / sizeof(*pixel));
+	cyclic_unregister(&exynos_spin_cyclic);
+	exynos_spin_on = false;
+}
 
-	pixel = (u32 *)(uintptr_t)(base + offset);
-	for (i = 0; i < words; i++)
-		pixel[i] = exynos_mark_colour[stage];
+static int do_spinner(struct cmd_tbl *cmdtp, int flag, int argc,
+		      char *const argv[])
+{
+	if (argc != 2)
+		return CMD_RET_USAGE;
 
-	/*
-	 * Past the point where the caches come on this is mapped as ordinary
-	 * memory, so without this the pixels would sit in the cache, where
-	 * the display controller, which reads the memory itself, would never
-	 * see them.  Every band but the first is painted after that point.
-	 */
-	flush_dcache_range((ulong)pixel, (ulong)(pixel + words));
+	if (!strcmp(argv[1], "on"))
+		exynos_spin_start();
+	else if (!strcmp(argv[1], "off"))
+		exynos_spin_stop();
+	else
+		return CMD_RET_USAGE;
 
-	exynos_decon_trigger(fdt);
+	return 0;
 }
 
+U_BOOT_CMD(spinner, 2, 1, do_spinner,
+	   "turn the ring on the panel",
+	   "on   - draw it, and keep it turning\n"
+	   "spinner off  - stop it, and leave the panel to what draws next"
+);
+
 int board_early_init_f(void)
 {
 	exynos_mark(EXYNOS_MARK_ENTERED);
@@ -667,6 +894,15 @@ int board_early_init_r(void)
 {
 	exynos_mark(EXYNOS_MARK_STDIO);
 
+	/*
+	 * Here, and not later, because what takes the time is below this
+	 * point: the storage controller coming up, the partitions being
+	 * scanned and the system being read.  All the ring needs is the
+	 * framebuffer the tree describes and a timer, and the initcall
+	 * before this one is where the timer starts.
+	 */
+	exynos_spin_start();
+
 	return 0;
 }
 
