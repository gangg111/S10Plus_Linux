From 1623cedb3d0cb470f749789ea5b6affbab73eb28 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Tue, 22 Sep 2026 23:53:59 +0200
Subject: [PATCH 31/40] board: samsung: exynos-mobile: turn a ring on the panel
 while it reads

Between the first stage handing over and the kernel painting its own
picture this phone spends over ten seconds on storage, and for all of it
the screen holds one unchanging picture: the panel is a command mode one
and only takes a frame when it is handed one.  A phone that looks dead
that long is a phone whose owner reaches for the power key.

So draw a dim ring with a brighter arc travelling around it, in the
green of the system being loaded, over the picture the first stage left.
The ring is laid out as overlapping discs along a circle, which keeps
the whole of it to one table and integer multiplication, and leaves
every pixel around it as it was.

It is driven from the cyclic framework, which U-Boot runs out of
schedule(), and the EFI layer calls that on every block it reads.  The
ring therefore turns exactly while the reading it reports on is going
on, and stands still when nothing is happening, which is the truth and
not an animation.  It starts as early as it can be of use, right after
the timer, because what takes the time - the storage controller, the
partition scan and the read itself - all comes after that.

The lookup of the framebuffer and the trigger handed to the display
controller were already here, inside the bands the start up paints;
they are now their own two pieces, because the ring needs both.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 board/samsung/exynos-mobile/exynos-mobile.c   | 362 +++++++++++++++---
 board/samsung/exynos-mobile/exynos-mobile.env |   7 +-
 2 files changed, 303 insertions(+), 66 deletions(-)

diff --git a/board/samsung/exynos-mobile/exynos-mobile.c b/board/samsung/exynos-mobile/exynos-mobile.c
index bacff2eb..eb4a2411 100644
--- a/board/samsung/exynos-mobile/exynos-mobile.c
+++ b/board/samsung/exynos-mobile/exynos-mobile.c
@@ -15,6 +15,7 @@
 #include <clk.h>
 #include <cpu_func.h>
 #include <ctype.h>
+#include <cyclic.h>
 #include <dm.h>
 #include <dm/ofnode.h>
 #include <efi.h>
@@ -468,6 +469,89 @@ int timer_init(void)
 	return 0;
 }
 
+/*
+ * The framebuffer the first stage left behind.
+ *
+ * Two things on this board draw into it without going through the video
+ * uclass: the bands below, which have to work before the driver model
+ * exists, and the ring further down, which has to be small enough to run
+ * from schedule().  Both write into the buffer the device tree describes as
+ * a simple framebuffer, the one the first stage filled with the vendor
+ * picture and the one the display controller reads, so both find it here.
+ */
+struct exynos_fb {
+	u8 *base;
+	u32 width;
+	u32 height;
+	u32 stride;
+};
+
+static int exynos_fb_get(struct exynos_fb *fb)
+{
+	fdt_addr_t base;
+	fdt_size_t size;
+	ofnode node;
+
+	node = ofnode_by_compatible(ofnode_null(), "simple-framebuffer");
+	if (!ofnode_valid(node))
+		return -ENODEV;
+
+	base = ofnode_get_addr_size_index_notrans(node, 0, &size);
+	if (base == FDT_ADDR_T_NONE)
+		return -ENODEV;
+
+	fb->width = ofnode_read_u32_default(node, "width", 0);
+	fb->height = ofnode_read_u32_default(node, "height", 0);
+	fb->stride = ofnode_read_u32_default(node, "stride", 0);
+	if (!fb->width || !fb->height || !fb->stride ||
+	    fb->stride % sizeof(u32))
+		return -EINVAL;
+
+	/* Do not write past what the tree says is there. */
+	if ((u64)fb->stride * fb->height > size)
+		return -EINVAL;
+
+	fb->base = (u8 *)(uintptr_t)base;
+
+	return 0;
+}
+
+/*
+ * Hand the panel what is in the framebuffer.
+ *
+ * The panel of these phones is a command mode one: it shows a picture when
+ * it is triggered, and by the time a boot loader runs nothing is triggering
+ * it any more, so whatever is written to the framebuffer stays invisible and
+ * the screen keeps the picture it came up with.  That is why everything
+ * which draws outside the video uclass has to come here afterwards.  The
+ * controller's address comes out of the device tree, so nothing at all
+ * happens on a board whose tree has no such controller; the register offset
+ * and the value are constants, and the value is the one uniLoader hands the
+ * sibling phone of this family.
+ */
+#define EXYNOS_DECON_HW_SW_TRIG_CONTROL		0x70
+#define EXYNOS_DECON_SW_TRIG_ON			0x1281
+
+static void exynos_decon_trigger(void)
+{
+	fdt_addr_t base;
+	fdt_size_t size;
+	ofnode node;
+
+	node = ofnode_by_compatible(ofnode_null(),
+				    "samsung,exynos9820-decon");
+	if (!ofnode_valid(node))
+		return;
+
+	base = ofnode_get_addr_size_index_notrans(node, 0, &size);
+	if (base == FDT_ADDR_T_NONE)
+		return;
+
+	writel(EXYNOS_DECON_SW_TRIG_ON,
+	       (void __iomem *)(uintptr_t)base +
+	       EXYNOS_DECON_HW_SW_TRIG_CONTROL);
+}
+
 /*
  * Marks of life, painted on the screen as the start up gets on.
  *
@@ -486,20 +570,7 @@ int timer_init(void)
  *
  * The bands go at the bottom because the console starts writing at the top,
  * so the two can be read together rather than over each other.
- *
- * Before any of it the display controller has to be told to push what is in
- * the framebuffer out to the panel.  The panel of these phones is a command
- * mode one: it shows a picture when it is triggered, and by the time a boot
- * loader runs nothing is triggering it any more, so whatever is written to
- * the framebuffer stays invisible and the screen keeps the picture it came up
- * with.  That is why the trigger is handed over again after every band and
- * not just once.  The controller's address comes out of the device tree, so
- * nothing at all happens on a board whose tree has no such controller; the
- * register offset and the value are constants, and the value is the one
- * uniLoader hands the sibling phone of this family.
  */
-#define EXYNOS_DECON_HW_SW_TRIG_CONTROL		0x70
-#define EXYNOS_DECON_SW_TRIG_ON			0x1281
 #define EXYNOS_MARK_ROWS			64
 
 enum exynos_mark_stage {
@@ -517,81 +588,237 @@ static const u32 exynos_mark_colour[EXYNOS_MARK_COUNT] = {
 	0xff00ff00,	/* green   */
 };
 
-static void exynos_decon_trigger(const void *fdt)
+static void exynos_mark(enum exynos_mark_stage stage)
 {
-	fdt_addr_t base;
-	int node, parent;
+	struct exynos_fb fb;
+	u32 rows = EXYNOS_MARK_ROWS;
+	u32 *pixel, i, words;
 
-	node = fdt_node_offset_by_compatible(fdt, -1,
-					     "samsung,exynos9820-decon");
-	if (node < 0)
+	if (stage >= EXYNOS_MARK_COUNT)
 		return;
 
-	parent = fdt_parent_offset(fdt, node);
-	base = fdtdec_get_addr_size_auto_parent(fdt, parent, node, "reg", 0,
-						NULL, false);
-	if (base == FDT_ADDR_T_NONE)
+	if (exynos_fb_get(&fb))
 		return;
 
-	writel(EXYNOS_DECON_SW_TRIG_ON,
-	       (void __iomem *)(uintptr_t)base +
-	       EXYNOS_DECON_HW_SW_TRIG_CONTROL);
+	if (fb.height < rows * (stage + 1))
+		return;
+
+	pixel = (u32 *)(fb.base + (u64)fb.stride *
+			(fb.height - rows * (stage + 1)));
+	words = rows * (fb.stride / sizeof(*pixel));
+
+	for (i = 0; i < words; i++)
+		pixel[i] = exynos_mark_colour[stage];
+
+	/*
+	 * Past the point where the caches come on this is mapped as ordinary
+	 * memory, so without this the pixels would sit in the cache, where
+	 * the display controller, which reads the memory itself, would never
+	 * see them.  Every band but the first is painted after that point.
+	 */
+	flush_dcache_range((ulong)pixel, (ulong)(pixel + words));
+
+	exynos_decon_trigger();
 }
 
-static void exynos_mark(enum exynos_mark_stage stage)
+/*
+ * A ring turning on the panel while the loader reads a system off the flash.
+ *
+ * Between the first stage handing over and the kernel painting its own
+ * picture this phone spends over ten seconds reading, and for all of it the
+ * screen holds one unchanging picture, because the panel only takes a frame
+ * when it is handed one.  A phone that looks dead for ten seconds is a phone
+ * whose owner reaches for the power key, so it says instead that something
+ * is going on: a dim ring with a brighter arc travelling around it, in the
+ * green of the system being loaded.
+ *
+ * The ring is laid out as overlapping discs along a circle, which keeps the
+ * whole of it to a table and integer multiplication: no angle has to be
+ * taken an arctangent of, and no pixel outside a disc is ever touched.  What
+ * is around the ring is left as it was, so the picture underneath stays.
+ *
+ * It is driven from the cyclic framework, which U-Boot runs out of
+ * schedule(), and the EFI layer calls that on every block it reads
+ * (lib/efi_loader/efi_disk.c, efi_disk_rw_blocks).  The ring therefore turns
+ * exactly while the reading it reports on is going on, and stands still when
+ * nothing is happening, which is the truth rather than an animation.  A
+ * cyclic function running longer than CONFIG_CYCLIC_MAX_CPU_TIME_US is
+ * dropped with a warning, so a step writes only the discs, flushes only the
+ * rows they sit in, and hands the panel a single trigger.
+ *
+ * Whatever puts text on the panel has to stop it first, or the ring is drawn
+ * over the text; that is what "spinner off" is for, and the environment runs
+ * it wherever the panel is taken over.
+ */
+#define EXYNOS_SPIN_STEPS	128	/* discs around the ring          */
+#define EXYNOS_SPIN_ARC		36	/* discs in the travelling arc    */
+#define EXYNOS_SPIN_RADIUS	144	/* pixels, centre to disc centre  */
+#define EXYNOS_SPIN_DISC	8	/* pixels, radius of one disc     */
+#define EXYNOS_SPIN_ADVANCE	4	/* discs the arc moves in a step  */
+#define EXYNOS_SPIN_PERIOD_US	60000
+#define EXYNOS_SPIN_SCALE	1024
+
+/* Where each disc sits on the unit circle, from twelve o'clock clockwise. */
+static const s16 exynos_spin_at[EXYNOS_SPIN_STEPS][2] = {
+	{     0, -1024 }, {    50, -1023 }, {   100, -1019 }, {   150, -1013 },
+	{   200, -1004 }, {   249,  -993 }, {   297,  -980 }, {   345,  -964 },
+	{   392,  -946 }, {   438,  -926 }, {   483,  -903 }, {   526,  -878 },
+	{   569,  -851 }, {   610,  -822 }, {   650,  -792 }, {   688,  -759 },
+	{   724,  -724 }, {   759,  -688 }, {   792,  -650 }, {   822,  -610 },
