From bac40b5fc9b9d026bec57dc1ed73572f07957263 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Mon, 21 Sep 2026 13:11:50 +0200
Subject: [PATCH 09/40] dts: exynos: sync the Exynos9820 device trees with the
 kernel series

The three device tree files this board uses are copies of the ones the
kernel series carries, and they had fallen behind it by 547 lines.  What
comes over: the UFS host and its PHY with all four windows, the pin
configuration of the storage lines and of the Bluetooth controller, the bus
the main PMIC sits on, the mailbox the power firmware answers from, the CMU
blocks added since, the PCIe controller, and the reboot modes the first
stage reads.

The clock identifiers header comes over with them.  It had fallen behind by
105 lines, which is not a cosmetic difference: without it the tree does not
build at all, because the nodes that arrive here name clocks the old header
has never heard of.

One thing does not come over, and the board tree now says so explicitly.
The kernel describes this panel's framebuffer 32 pixels narrower on each
side, so that its text console keeps clear of the curved edges, and that
moved the node to a different address.  The node the board carries stayed
where it was, so after this sync the two no longer merge and both end up in
the built tree. The first one wins, and with the narrower one first the
diagnostic bands stop being drawn: their own guard against writing past the
buffer sees a size 128 bytes smaller than stride times height and refuses
every band.  That would take away the only thing that says how far the boot
loader got, without a word anywhere, because at that point there is no log
yet.  So the board tree deletes the narrower node and keeps its own.

A copy that drifts is worse than no copy, because both sides look right on
their own.  scripts/check-uboot-dts.py in the port repository compares the
two byte for byte, and it is what found this: it had been reading the copy
out of a single patch, which stopped being the whole story once the series
carried the sync in a second one.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../arm/dts/exynos9820-beyond2lte-u-boot.dtsi |  28 ++
 .../arm64/exynos/exynos9820-beyond2lte.dts    | 209 +++++++-
 .../src/arm64/exynos/exynos9820-pinctrl.dtsi  |  82 ++++
 dts/upstream/src/arm64/exynos/exynos9820.dtsi | 464 +++++++++++++++++-
 .../dt-bindings/clock/samsung,exynos9820.h    | 105 ++++
 5 files changed, 873 insertions(+), 15 deletions(-)

diff --git a/arch/arm/dts/exynos9820-beyond2lte-u-boot.dtsi b/arch/arm/dts/exynos9820-beyond2lte-u-boot.dtsi
index bd2d5247..3a0a8c43 100644
--- a/arch/arm/dts/exynos9820-beyond2lte-u-boot.dtsi
+++ b/arch/arm/dts/exynos9820-beyond2lte-u-boot.dtsi
@@ -37,6 +37,34 @@
 		#size-cells = <1>;
 		ranges;
 
+		/*
+		 * Zwezony ekran ze wspolnego drzewa nie moze tu zostac.
+		 *
+		 * Seria jadra opisuje ten bufor o 32 piksele wezszy z kazdej
+		 * strony i zaczyna go o tyle dalej, bo panel zakrzywia sie
+		 * wzdluz obu dlugich krawedzi, a konsola tekstowa Linuksa nie
+		 * umie odsunac swojego obszaru sama.  Wezel dostal przez to
+		 * inny adres w nazwie niz nasz, wiec przestal sie z nim scalac
+		 * i w zbudowanym drzewie stoja DWA wezly simple-framebuffer.
+		 *
+		 * Zmierzone skutki, gdyby zostawic oba: exynos_mark() bierze
+		 * PIERWSZY wezel z tym compatible, a pierwszy jest wlasnie
+		 * zwezony.  Jego rozmiar jest o 128 bajtow mniejszy niz
+		 * stride * height, wiec bramka "nie pisz poza bufor" zamyka sie
+		 * na kazdym stopniu i nie powstaje ani jeden pasek
+		 * diagnostyczny.  Narzedzie, ktore jako jedyne mowi, gdzie
+		 * stanal rozruch, przestaloby dzialac bez sladu w logu, bo loga
+		 * na tym etapie jeszcze nie ma.  Do tego menu jest liczone
+		 * w znakach czcionki 32x64, czyli 1440 / 32 = 45 kolumn; przy
+		 * 1376 pikselach wychodzi 43 i caly uklad ekranu wymaga
+		 * przeliczenia.
+		 *
+		 * Czy bootloader tez ma odsuwac sie od zakrzywionych krawedzi,
+		 * rozstrzygnie spojrzenie na panel.  Do tego czasu obowiazuje
+		 * geometria, ktora zostala na nim sprawdzona.
+		 */
+		/delete-node/ framebuffer@ca000080;
+
 		/*
 		 * The screen this phone comes up with, left running by whatever
 		 * ran before.  Its address is not guessed: the primary boot
diff --git a/dts/upstream/src/arm64/exynos/exynos9820-beyond2lte.dts b/dts/upstream/src/arm64/exynos/exynos9820-beyond2lte.dts
index ea48614a..a4d11f3c 100644
--- a/dts/upstream/src/arm64/exynos/exynos9820-beyond2lte.dts
+++ b/dts/upstream/src/arm64/exynos/exynos9820-beyond2lte.dts
@@ -70,10 +70,18 @@
 		 * the boot loader itself passes on this phone: the vendor kernel
 		 * receives "s3cfb.bootloaderfb=0xca000000" on its command line.
 		 */
-		framebuffer0: framebuffer@ca000000 {
+		framebuffer0: framebuffer@ca000080 {
 			compatible = "simple-framebuffer";
-			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
-			width = <1440>;
+			/*
+			 * The panel curves along both long edges, so the outermost
+			 * columns are distorted and hard to hit with a finger.  The
+			 * text console cannot offset its own area, so the buffer is
+			 * described 32 pixels narrower on each side instead: the
+			 * start moves by that many pixels and the line length stays
+			 * as the hardware has it.
+			 */
+			reg = <0x0 0xca000080 ((1440 * 3040 - 32) * 4)>;
+			width = <1376>;
 			height = <3040>;
 			stride = <(1440 * 4)>;
 			format = "a8r8g8b8";
@@ -226,6 +234,37 @@
 	};
 };
 
+/*
+ * The cell, described because the charger has to be told what it is
+ * charging.  Every number here is read from the vendor tree of this exact
+ * phone rather than from a datasheet of a similar one: the end of charge
+ * voltage is battery,chg_float_voltage, the capacity is
+ * battery,battery_full_capacity, the charge current is
+ * battery,max_charging_current and the current at which the charge counts
+ * as finished is full_check_current_1st.
+ *
+ * The cell itself agrees: an EB-BG975ABU is labelled 4000 mAh rated,
+ * 3.85 V nominal, and a charging limit of 4.40 V.  The limit is what the
+ * cell survives, not what it is charged to, and the vendor stops at 4.35 V;
+ * that margin is where the life of the cell comes from, so the lower number
+ * is the one described here and it is not a rounding to fix later.
+ *
+ * voltage-min-design-microvolt is left out.  The vendor tree never states a
+ * cutoff as a voltage, and a number invented here would be the one thing in
+ * this node that nothing measured.
+ */
+/ {
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		charge-full-design-microamp-hours = <4000000>;
+		voltage-max-design-microvolt = <4350000>;
+		constant-charge-voltage-max-microvolt = <4350000>;
+		constant-charge-current-max-microamp = <2850000>;
+		charge-term-current-microamp = <400000>;
+	};
+};
+
 &decon0 {
 	status = "okay";
 };
@@ -256,7 +295,7 @@
 	status = "okay";
 
 	touchscreen@48 {
-		compatible = "samsung,s6sy761";
+		compatible = "samsung,s6sy771";
 		reg = <0x48>;
 
 		avdd-supply = <&reg_tsp_avdd>;
@@ -313,6 +352,59 @@
 	};
 };
 
+/*
+ * The companion chip of the main PMIC: the fuel gauge, which answers how
+ * much charge is left, and the charger, which puts it back.  The charger
+ * needs a cell to charge against, so it points at the battery node above,
+ * whose numbers come from the vendor tree of this phone.
+ *
+ * The address of the fuel gauge started out as an analogy with the only
+ * other board in mainline carrying this chip, a Galaxy S9, because the
+ * vendor sources for this phone never put the fuel gauge on a bus at all:
+ * they hang it in the root of the tree with no address and bind it to the
+ * battery by name.  It has since been measured on the phone, by driving
+ * this bus by hand over its own pins: 0x36 answers, and so do 0x66 for the
+ * companion chip and 0x69 beside them.  The analogy held.
+ *
+ * maxim,rsns-microohm is not guessed either, it is derived from what the
+ * gauge itself reports.  The vendor gives the resistor as a plain index
+ * rather than as a resistance, so the value comes from the measurement:
+ * with the driver default of 10 mohm the gauge reported a design capacity
+ * of 1979 mAh for a cell labelled 4000 mAh, and that ratio is the resistor.
+ * Half the assumed resistance gives twice the reported capacity, so 5 mohm
+ * it is, and the reported capacity then lands on the printed one.
+ */
+&hsi2c45 {
+	status = "okay";
+
+	max77705: pmic@66 {
+		compatible = "maxim,max77705";
+		reg = <0x66>;
+		interrupt-parent = <&gpa1>;
+		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		pinctrl-0 = <&pmic_irq>;
+		pinctrl-names = "default";
+	};
+
+	fuel-gauge@36 {
+		compatible = "maxim,max77705-battery";
+		reg = <0x36>;
+		maxim,rsns-microohm = <5000>;
+		interrupt-parent = <&max77705>;
+		interrupts = <2>;
+	};
+
+	charger@69 {
+		compatible = "maxim,max77705-charger";
+		reg = <0x69>;
+		monitored-battery = <&battery>;
+		interrupt-parent = <&max77705>;
+		interrupts = <0>;
+	};
+};
+
 &oscclk {
 	clock-frequency = <26000000>;
 };
@@ -354,12 +446,121 @@
 	};
 };
 
+&pinctrl_alive {
+	pmic_irq: pmic-irq-pins {
+		samsung,pins = "gpa1-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
+
+/ {
+	reg_usb_dummy: regulator-usb-dummy {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_dummy";
+	};
+};
+
 &serial0 {
 	status = "okay";
 };
 
+/*
+ * The Bluetooth controller answers on the serial port of the PERIC1 USI
+ * block.  Three lines go with the port: the one the chip powers up from, the
+ * one the host pokes to wake the controller, and the one the controller pokes
+ * to wake the host.  The last one is an interrupt, so it is described as one
+ * rather than as the deprecated gpio property.
+ */
+&serial1 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm4375-bt";
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_en_pins>, <&bt_btwake_pins>,
+			    <&bt_hostwake_pins>;
+		shutdown-gpios = <&gpm8 0 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&gpg2 0 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&gpa2 3 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "host-wakeup";
+	};
+};
+
+&ufs_0 {
+	status = "okay";
+};
+
+/*
+ * The port is described as peripheral only.  It is wired as dual role and
+ * the phone changes roles with a USB-C controller sitting on the max77705,
+ * which nothing in this series can reach; a dual role port without that
+ * controller waits for a role that never arrives.  Peripheral is the half
+ * that works with a plain cable to a PC, and it is the half this series
+ * needs to be able to report anything about itself.
+ *
+ * The supplies are named against a stand-in.  They really come from rails
+ * of the main PMIC, which sits behind the ACPM mailbox and which nothing
+ * here can reach, and the driver would be happy with the dummy the
+ * regulator core hands out for a supply nobody names.  The binding is not:
+ * it lists both as required, so they are named, and named honestly as what
+ * they are rather than as rails this series pretends to drive.
+ */
+&usbdrd {
+	status = "okay";
+	vdd10-supply = <&reg_usb_dummy>;
+	vdd33-supply = <&reg_usb_dummy>;
+};
+
+/*
+ * The port is wired to the only connector this phone has, so it has to work
+ * both ways: as a device, which is how the machine is reached from a computer,
+ * and as a host, so that a keyboard can be plugged into the phone.
+ *
+ * There is no Type-C driver here to sense which way the cable goes, so the
+ * role is switched by hand through the role switch dwc3 registers, and the
+ * default is spelled out: a board that came up as a host would drop the
+ * connection to the computer and leave no way back in.
+ */
+&usbdrd_dwc3 {
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+};
+
+&usbdrd_phy {
+	status = "okay";
+};
+
 /* This USI instance is wired as the touchscreen I2C master on this board. */
 &usi3 {
 	samsung,mode = <USI_V2_I2C>;
 	status = "okay";
 };
+
+/*
+ * This one is wired as the I2C master the display PMIC answers on.  Picking
+ * the mode here is also what releases the block from reset, so the bus below
+ * cannot work without it.
+ */
+&usi_cmgp2 {
+	samsung,mode = <USI_V2_I2C>;
+	status = "okay";
+};
+
+/*
+ * This USI instance is wired as the I2C master the main PMIC's companion
+ * answers on.  Picking the mode here is also what releases the block from
+ * reset, so the bus below cannot work without it.
+ */
+&usi_cmgp3 {
+	samsung,mode = <USI_V2_I2C>;
+	status = "okay";
+};
+
+/* This USI instance is wired as the serial port the Bluetooth chip uses. */
+&usi_uart_bt {
+	samsung,mode = <USI_V2_UART>;
+	status = "okay";
+};
diff --git a/dts/upstream/src/arm64/exynos/exynos9820-pinctrl.dtsi b/dts/upstream/src/arm64/exynos/exynos9820-pinctrl.dtsi
index e3767714..477ba04a 100644
--- a/dts/upstream/src/arm64/exynos/exynos9820-pinctrl.dtsi
+++ b/dts/upstream/src/arm64/exynos/exynos9820-pinctrl.dtsi
@@ -106,6 +106,21 @@
 		gpio-controller;
 		#gpio-cells = <2>;
 	};
+
+	/* the line the Bluetooth controller pokes to wake the host */
+	bt_hostwake_pins: bt-hostwake-pins {
+		samsung,pins = "gpa2-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	/* to the Bluetooth controller */
+	uart1_bus: uart1-bus-pins {
+		samsung,pins = "gpq0-3", "gpq0-2", "gpq0-1", "gpq0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
 };
 
 &pinctrl_aud {
@@ -455,6 +470,15 @@
 		interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_HIGH>;
 	};
 
+	/* the line the Bluetooth controller powers up from */
+	bt_en_pins: bt-en-pins {
+		samsung,pins = "gpm8-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+
 	/* to the S2DOS05 display PMIC */
 	hsi2c2_bus: hsi2c2-bus-pins {
 		samsung,pins = "gpm10-0", "gpm11-0";
@@ -462,6 +486,18 @@
 		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
 		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
 	};
+
+	/*
+	 * To the MAX77705, which carries the charger and the fuel gauge.
+	 * This one is a USI in I2C mode, not a dedicated I2C like the bus
+	 * above, which is why its pins take a different function.
+	 */
+	hsi2c45_bus: hsi2c45-bus-pins {
+		samsung,pins = "gpm12-0", "gpm13-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
 };
 
 &pinctrl_fsys0 {
@@ -498,6 +534,43 @@
 		interrupt-controller;
 		#interrupt-cells = <2>;
 	};
+
+	/* the clock request line of the PCIe endpoint */
+	pcie0_clkreq_pins: pcie0-clkreq-pins {
+		samsung,pins = "gpf2-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_UP>;
+	};
+
+	/* the reset line of the PCIe endpoint */
+	pcie0_perst_pins: pcie0-perst-pins {
+		samsung,pins = "gpf2-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+	};
+
+	/*
+	 * The two pins of the embedded storage: the reset line of the device
+	 * and the reference clock going out to it.  Both take their second
+	 * function and keep their level while the domain is down.
+	 */
+	ufs_refclk_out: ufs-refclk-out-pins {
+		samsung,pins = "gpf3-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+	};
+
+	ufs_rst_n: ufs-rst-n-pins {
+		samsung,pins = "gpf3-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+	};
 };
 
 &pinctrl_peric0 {
@@ -565,6 +638,15 @@
 		#interrupt-cells = <2>;
 	};
 
+	/* the line the host pokes to wake the Bluetooth controller */
+	bt_btwake_pins: bt-btwake-pins {
+		samsung,pins = "gpg2-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+
 	/* to the touchscreen */
 	hsi2c10_bus: hsi2c10-bus-pins {
 		samsung,pins = "gpp1-4", "gpp1-5";
diff --git a/dts/upstream/src/arm64/exynos/exynos9820.dtsi b/dts/upstream/src/arm64/exynos/exynos9820.dtsi
index 155be359..87d95413 100644
--- a/dts/upstream/src/arm64/exynos/exynos9820.dtsi
+++ b/dts/upstream/src/arm64/exynos/exynos9820.dtsi
@@ -23,6 +23,7 @@
  */
 
 #include <dt-bindings/clock/samsung,exynos9820.h>
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 
 / {
@@ -46,6 +47,8 @@
 		pinctrl5 = &pinctrl_peric0;
 		pinctrl6 = &pinctrl_peric1;
 		pinctrl7 = &pinctrl_vts;
+		serial0 = &serial0;
+		serial1 = &serial1;
 	};
 
 	/*
@@ -213,6 +216,20 @@
 		#size-cells = <1>;
 		ranges = <0x0 0x0 0x0 0x20000000>;
 
+		/*
+		 * The memory the firmware and the processor pass messages through.
+		 * Its size is the one the vendor states for this SoC; the channel
+		 * configuration sits at an offset inside it that the protocol driver
+		 * knows from the compatible.
+		 */
+		apm_sram: sram@2039000 {
+			compatible = "mmio-sram";
+			reg = <0x2039000 0x30000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0x0 0x2039000 0x30000>;
+		};
+
 		chipid@10000000 {
 			compatible = "samsung,exynos9820-chipid",
 				     "samsung,exynos850-chipid";
@@ -323,6 +340,14 @@
 				 <&cmu_peric0 CLK_GOUT_PERIC0_USI03_USI_IPCLK>;
 			clock-names = "pclk", "ipclk";
 			samsung,sysreg = <&sysreg_peric0 0x101c>;
+			/*
+			 * Without this the block keeps its automatic clock stop, and
+			 * a master that has no clock cannot drive the line it is
+			 * supposed to clock.  Measured on the phone: with the property
+			 * the bus raises interrupts and the controller reports the
+			 * result of a transfer; without it the block is silent.
+			 */
+			samsung,clkreq-on;
 			status = "disabled";
 
 			hsi2c10: i2c@104b0000 {
@@ -342,24 +367,293 @@
 			};
 		};
 
+		cmu_peric1: clock-controller@10800000 {
+			compatible = "samsung,exynos9820-cmu-peric1";
+			reg = <0x10800000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>,
+				 <&cmu_top CLK_DOUT_CMU_PERIC1_BUS>,
+				 <&cmu_top CLK_DOUT_CMU_PERIC1_IP>;
+			clock-names = "oscclk", "bus", "ip";
+		};
+
+		/* Holds the mode register the USI blocks of this domain use. */
+		sysreg_peric1: syscon@10820000 {
+			compatible = "samsung,exynos9820-peric1-sysreg",
+				     "syscon";
+			reg = <0x10820000 0x2000>;
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_SYSREG_PERIC1_PCLK>;
+		};
+
 		pinctrl_peric1: pinctrl@10830000 {
 			compatible = "samsung,exynos9820-pinctrl";
 			reg = <0x10830000 0x1000>;
 			interrupts = <GIC_SPI 407 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		/*
+		 * The Bluetooth controller hangs off a serial port, and that port is
+		 * one mode of a USI block, the same kind of block the I2C buses above
+		 * use.  The mode register sits in the PERIC1 system register at
