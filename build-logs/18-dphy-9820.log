## wyprowadzenie zegarów (dsim_reg.c:1826-1846), arytmetyka u32:
  word_clk = hs_clk/16 = 898/16 = 56 MHz
  esc_div  = 56/20 -> korekta -> 3
  esc_clk  = 56/3 = 18 MHz  (ZADANE 20, FAKTYCZNE 18)
  b_dphyctl index = esc_clk-7 = 11 -> 0x1c2 (450)
  hsmode = (hs_clk < 1500) = 1  -> HSTX_CLK_SEL=1, SKEWCAL=0
  pll_lock_cnt = PLL_LOCK_CNT_MULT * p = 500 * 2 = 1000
