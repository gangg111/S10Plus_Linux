+	regulator_desc_s2mps19_buck(4, S2MPS19_BUCK_MIN1, S2MPS19_BUCK_STEP1,
+				    B4M_CTRL, B4M_OUT1),
+	regulator_desc_s2mps19_buck(5, S2MPS19_BUCK_MIN1, S2MPS19_BUCK_STEP1,
+				    B5M_CTRL, B5M_OUT1),
+	regulator_desc_s2mps19_buck(6, S2MPS19_BUCK_MIN1, S2MPS19_BUCK_STEP1,
+				    B6M_CTRL, B6M_OUT),
+	regulator_desc_s2mps19_buck(7, S2MPS19_BUCK_MIN1, S2MPS19_BUCK_STEP1,
+				    B7M_CTRL, B7M_OUT),
+	regulator_desc_s2mps19_buck(8, S2MPS19_BUCK_MIN1, S2MPS19_BUCK_STEP1,
+				    B8M_CTRL, B8M_OUT),
+	regulator_desc_s2mps19_buck(9, S2MPS19_BUCK_MIN1, S2MPS19_BUCK_STEP1,
+				    B9M_CTRL, B9M_OUT),
+	regulator_desc_s2mps19_buck(10, S2MPS19_BUCK_MIN1, S2MPS19_BUCK_STEP1,
+				    B10M_CTRL, B10M_OUT1),
+	regulator_desc_s2mps19_buck(11, S2MPS19_BUCK_MIN1, S2MPS19_BUCK_STEP1,
+				    B11M_CTRL, B11M_OUT),
+	regulator_desc_s2mps19_buck(12, S2MPS19_BUCK_MIN2, S2MPS19_BUCK_STEP2,
+				    B12M_CTRL, B12M_OUT),
+	{
+		.name		= "BBM",
+		.id		= S2MPS19_BB,
+		.of_match	= of_match_ptr("BBM"),
+		.regulators_node = of_match_ptr("regulators"),
+		.ops		= &s2mps14_reg_ops,
+		.type		= REGULATOR_VOLTAGE,
+		.owner		= THIS_MODULE,
+		.min_uV		= S2MPS19_BB_MIN,
+		.uV_step	= S2MPS19_BB_STEP,
+		.n_voltages	= S2MPS19_BB_N_VOLTAGES,
+		.vsel_reg	= S2MPS19_PMIC_BBM_OUT,
+		.vsel_mask	= S2MPS19_BB_VSEL_MASK,
+		.enable_reg	= S2MPS19_PMIC_BBM_CTRL,
+		.enable_mask	= S2MPS19_ENABLE_MASK,
+		.enable_time	= S2MPS19_ENABLE_TIME_BB,
+	},
+};
+
 static const struct regulator_desc s2mpu02_regulators[] = {
 	regulator_desc_s2mpu02_ldo1(1),
 	regulator_desc_s2mpu02_ldo2(2),
@@ -2207,6 +2360,11 @@ static int s2mps11_pmic_probe(struct platform_device *pdev)
 		regulators = s2mps15_regulators;
 		BUILD_BUG_ON(ARRAY_SIZE(s2mps15_regulators) > S2MPS_REGULATOR_MAX);
 		break;
+	case S2MPS19X:
+		rdev_num = ARRAY_SIZE(s2mps19_regulators);
+		regulators = s2mps19_regulators;
+		BUILD_BUG_ON(ARRAY_SIZE(s2mps19_regulators) > S2MPS_REGULATOR_MAX);
+		break;
 	case S2MPU02:
 		rdev_num = ARRAY_SIZE(s2mpu02_regulators);
 		regulators = s2mpu02_regulators;
@@ -2272,6 +2430,7 @@ static const struct platform_device_id s2mps11_pmic_id[] = {
 	{ .name = "s2mps13-regulator", .driver_data = S2MPS13X },
 	{ .name = "s2mps14-regulator", .driver_data = S2MPS14X },
 	{ .name = "s2mps15-regulator", .driver_data = S2MPS15X },
+	{ .name = "s2mps19-regulator", .driver_data = S2MPS19X },
 	{ .name = "s2mpu02-regulator", .driver_data = S2MPU02 },
 	{ .name = "s2mpu05-regulator", .driver_data = S2MPU05 },
 	{ }
