From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Mon, 21 Sep 2026 07:30:00 +0200
Subject: [PATCH] dt-bindings: clock: samsung,exynos9820: Add CMU_PERIC1

CMU_PERIC1 is the clock controller of the second peripheral block.  The
serial port the Bluetooth controller answers on sits behind it, and so do
the camera I2C buses and eight more USI blocks.

The identifiers are the ones the vendor clock tables name, transcribed the
same way as the blocks already described here.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../clock/samsung,exynos9820-clock.yaml       |  21 ++++
 .../dt-bindings/clock/samsung,exynos9820.h    | 105 ++++++++++++++++++
 2 files changed, 126 insertions(+)

diff --git a/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml b/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
index dabb24e301f..0fae5bdac24 100644
--- a/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
+++ b/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
@@ -35,6 +35,7 @@ properties:
       - samsung,exynos9820-cmu-fsys0a
       - samsung,exynos9820-cmu-fsys1
       - samsung,exynos9820-cmu-peric0
+      - samsung,exynos9820-cmu-peric1
       - samsung,exynos9820-cmu-peris
       - samsung,exynos9820-cmu-top
 
@@ -170,6 +171,26 @@ allOf:
             - const: bus
             - const: ip
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos9820-cmu-peric1
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+            - description: CMU_PERIC1 BUS clock (from CMU_TOP)
+            - description: CMU_PERIC1 IP clock (from CMU_TOP)
+
+        clock-names:
+          items:
+            - const: oscclk
+            - const: bus
+            - const: ip
+
   - if:
       properties:
         compatible:
