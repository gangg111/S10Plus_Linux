From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Fri, 25 Sep 2026 07:54:02 +0200
Subject: [PATCH] dt-bindings: clock: exynos9820: Add CMU_AUD

CMU_AUD clocks the audio block: the ABOX, its UAIF serial ports, the
codec master clock and the digital microphone interface. Its only input
from outside the block is the CPU clock CMU_TOP divides down for it; the
two audio PLLs sit inside the block and run from the board oscillator.

Add the compatible, its two input clocks and the identifiers of the
block's clocks. The identifiers are appended after the existing blocks,
so none of the numbers already in use moves.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../clock/samsung,exynos9820-clock.yaml       | 19 +++++
 .../dt-bindings/clock/samsung,exynos9820.h    | 83 +++++++++++++++++++
 2 files changed, 102 insertions(+)

diff --git a/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml b/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
index 0fae5bdac24..3bf39580e07 100644
--- a/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
+++ b/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
@@ -30,6 +30,7 @@ properties:
   compatible:
     enum:
       - samsung,exynos9820-cmu-apm
+      - samsung,exynos9820-cmu-aud
       - samsung,exynos9820-cmu-cmgp
       - samsung,exynos9820-cmu-dpu
       - samsung,exynos9820-cmu-fsys0a
@@ -85,6 +86,24 @@ allOf:
             - const: oscclk
             - const: bus
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos9820-cmu-aud
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+            - description: CMU_AUD CPU clock (from CMU_TOP)
+
+        clock-names:
+          items:
+            - const: oscclk
+            - const: cpu
+
   - if:
       properties:
         compatible:
