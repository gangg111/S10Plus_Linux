From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Sun, 20 Sep 2026 07:19:19 +0200
Subject: [PATCH] phy: samsung: exynos5-usbdrd: Add Exynos9820 support

The USB 2.0 half of this SoC's PHY is driven the way the next SoC of the
family drives its own: the same configuration, the same operations and the
same power management offset, which the vendor tree gives as 0x72c.

What this variant deliberately does not carry is a tuning table.  The
vendor describes one for this SoC but leaves it disabled on the board
this series
targets, so the phone runs on the PHY's own defaults and so does this.

The other two register windows of the block, the ones carrying the
SuperSpeed lanes and the DisplayPort side, are left alone.  Driving them
needs calibration tables that are in none of the sources this was written
from, and a port that enumerates at high speed is worth more than a window
nobody writes.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 drivers/phy/samsung/phy-exynos5-usbdrd.c    | 26 +++++++++++++++++++++
 include/linux/soc/samsung/exynos-regs-pmu.h |  3 +++
 2 files changed, 29 insertions(+)

diff --git a/drivers/phy/samsung/phy-exynos5-usbdrd.c b/drivers/phy/samsung/phy-exynos5-usbdrd.c
index 8711a3b62c8..ff81e9e895a 100644
--- a/drivers/phy/samsung/phy-exynos5-usbdrd.c
+++ b/drivers/phy/samsung/phy-exynos5-usbdrd.c
@@ -2095,6 +2095,29 @@ static const struct exynos5_usbdrd_phy_tuning *exynos990_tunes[PTS_MAX] = {
 	[PTS_UTMI_POSTINIT] = exynos990_tunes_utmi_postinit,
 };
 
+/*
+ * The USB 2.0 half of this SoC's combined USB and DisplayPort PHY, which is
+ * the half a peripheral-only port needs.  It is driven exactly the way the
+ * next SoC of this family is: the same register layout, the same operations
+ * and the same power management offset, which the vendor tree confirms as
+ * 0x72c.
+ *
+ * What is deliberately not here is a tuning table.  The vendor describes one
+ * for this SoC but leaves it disabled on this board, so the phone runs on the
+ * PHY's own defaults and so does this.
+ */
+static const struct exynos5_usbdrd_phy_drvdata exynos9820_usbdrd_phy = {
+	.phy_cfg		= phy_cfg_exynos850,
+	.phy_ops		= &exynos850_usbdrd_phy_ops,
+	.pmu_offset_usbdrd0_phy	= EXYNOS9820_PHY_CTRL_USB20,
+	.clk_names		= exynos5_clk_names,
+	.n_clks			= ARRAY_SIZE(exynos5_clk_names),
+	.core_clk_names		= exynos5_core_clk_names,
+	.n_core_clks		= ARRAY_SIZE(exynos5_core_clk_names),
+	.regulator_names	= exynos5_regulator_names,
+	.n_regulators		= ARRAY_SIZE(exynos5_regulator_names),
+};
+
 static const struct exynos5_usbdrd_phy_drvdata exynos990_usbdrd_phy = {
 	.phy_cfg		= phy_cfg_exynos850,
 	.phy_ops		= &exynos850_usbdrd_phy_ops,
@@ -2900,6 +2923,9 @@ static const struct of_device_id exynos5_usbdrd_phy_of_match[] = {
 	}, {
 		.compatible = "samsung,exynos850-usbdrd-phy",
 		.data = &exynos850_usbdrd_phy
+	}, {
+		.compatible = "samsung,exynos9820-usbdrd-phy",
+		.data = &exynos9820_usbdrd_phy
 	}, {
 		.compatible = "samsung,exynos990-usbdrd-phy",
 		.data = &exynos990_usbdrd_phy
diff --git a/include/linux/soc/samsung/exynos-regs-pmu.h b/include/linux/soc/samsung/exynos-regs-pmu.h
index db8a7ca8108..43de3438849 100644
--- a/include/linux/soc/samsung/exynos-regs-pmu.h
+++ b/include/linux/soc/samsung/exynos-regs-pmu.h
@@ -662,6 +662,9 @@
 #define EXYNOS5433_PAD_RETENTION_UFS_OPTION			(0x3268)
 #define EXYNOS5433_PAD_RETENTION_FSYSGENIO_OPTION		(0x32A8)
 
+/* For Exynos9820 */
+#define EXYNOS9820_PHY_CTRL_USB20				(0x72C)
+
 /* For Exynos990 */
 #define EXYNOS990_PHY_CTRL_USB20				(0x72C)
 
