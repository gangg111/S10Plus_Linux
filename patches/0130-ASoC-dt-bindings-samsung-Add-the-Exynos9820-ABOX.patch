From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Fri, 25 Sep 2026 08:23:43 +0200
Subject: [PATCH] ASoC: dt-bindings: samsung: Add the Exynos9820 ABOX

ABOX is the audio block of the Exynos9820: DMA engines that move samples
between memory and a set of mixers, the UAIF serial ports those mixers
feed, and a DSP core the vendor firmware runs on.

Describe the block as it is driven from the application processor alone,
with the DSP core left off: its register window, the bus clock, the bit
clock gates and dividers of UAIF1 and UAIF0, and the pins of those ports.
Each UAIF port is a DAI, addressed by its number.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../sound/samsung,exynos9820-abox.yaml        | 82 +++++++++++++++++++
 MAINTAINERS                                   |  1 +
 2 files changed, 83 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/samsung,exynos9820-abox.yaml

diff --git a/Documentation/devicetree/bindings/sound/samsung,exynos9820-abox.yaml b/Documentation/devicetree/bindings/sound/samsung,exynos9820-abox.yaml
new file mode 100644
index 00000000000..1f8f3cc1667
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/samsung,exynos9820-abox.yaml
@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/samsung,exynos9820-abox.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9820 ABOX audio subsystem
+
+maintainers:
+  - Artur Szafraniec <ganggg111@gmail.com>
+
+description: |
+  ABOX is the audio block of the Exynos9820. It holds DMA engines that move
+  samples between memory and a set of mixers and serial interfaces (UAIF),
+  and a DSP core that the vendor firmware runs on. This binding describes
+  the block as driven from the application processor alone: the DMA engines
+  and the UAIF ports are programmed directly and the DSP core is left off.
+
+  Each UAIF port is a DAI. The DAI index in the sound-dai specifier is the
+  number of the port.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,exynos9820-abox
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: bus clock of the block
+      - description: bit clock gate of UAIF1
+      - description: bit clock divider of UAIF1
+      - description: bit clock gate of UAIF0
+      - description: bit clock divider of UAIF0
+
+  clock-names:
+    items:
+      - const: aclk
+      - const: bclk_uaif1
+      - const: div_uaif1
+      - const: bclk_uaif0
+      - const: div_uaif0
+
+  pinctrl-0: true
+
+  pinctrl-names:
+    const: default
+
+  "#sound-dai-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#sound-dai-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/samsung,exynos9820.h>
+
+    audio-controller@18c50000 {
+        compatible = "samsung,exynos9820-abox";
+        reg = <0x18c50000 0x10000>;
+        clocks = <&cmu_aud CLK_GOUT_AUD_ABOX_ACLK>,
+                 <&cmu_aud CLK_GOUT_AUD_ABOX_BCLK_UAIF1>,
+                 <&cmu_aud CLK_DOUT_AUD_UAIF1>,
+                 <&cmu_aud CLK_GOUT_AUD_ABOX_BCLK_UAIF0>,
+                 <&cmu_aud CLK_DOUT_AUD_UAIF0>;
+        clock-names = "aclk", "bclk_uaif1", "div_uaif1",
+                      "bclk_uaif0", "div_uaif0";
+        pinctrl-0 = <&aud_i2s1_bus>, <&aud_i2s0_bus>;
+        pinctrl-names = "default";
+        #sound-dai-cells = <1>;
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index b580c8c5efe..8990028febc 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -24003,6 +24003,7 @@ L:	linux-samsung-soc@vger.kernel.org
 S:	Maintained
 F:	Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
 F:	Documentation/devicetree/bindings/pci/samsung,exynos9820-pcie.yaml
+F:	Documentation/devicetree/bindings/sound/samsung,exynos9820-abox.yaml
 F:	Documentation/devicetree/bindings/thermal/samsung,exynos9820-tmu.yaml
 F:	arch/arm64/boot/dts/exynos/exynos9820*
 F:	drivers/clk/samsung/clk-exynos9820.c
