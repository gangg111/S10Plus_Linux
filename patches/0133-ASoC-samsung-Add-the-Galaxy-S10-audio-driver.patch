index 23fe045c62b..8a5be10c03f 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -24014,6 +24014,7 @@ F:	drivers/thermal/samsung/exynos9820-tmu.c
 F:	drivers/video/backlight/exynos9820-dsim-lcd.c
 F:	include/dt-bindings/clock/samsung,exynos9820-acpm.h
 F:	include/dt-bindings/clock/samsung,exynos9820.h
+F:	sound/soc/samsung/beyond-audio.c
 F:	sound/soc/samsung/exynos9820-abox.c
 
 SAMSUNG EXYNOS ACPM MAILBOX PROTOCOL
diff --git a/sound/soc/samsung/Kconfig b/sound/soc/samsung/Kconfig
index e22f53fe193..7bba19c530c 100644
--- a/sound/soc/samsung/Kconfig
+++ b/sound/soc/samsung/Kconfig
@@ -158,4 +158,18 @@ config SND_SOC_SAMSUNG_MIDAS_WM1811
 	help
 	  Say Y if you want to add support for SoC audio on the Midas boards.
 
+config SND_SOC_SAMSUNG_BEYOND
+	tristate "Audio support for the Galaxy S10 family"
+	depends on SND_SOC_SAMSUNG && I2C
+	select SND_SOC_SAMSUNG_EXYNOS9820_ABOX
+	select SND_SOC_CS35L41_I2C
+	select SND_SOC_CS47L92 if MFD_CS47L92
+	help
+	  Say Y if you want the speaker amplifiers of the Samsung Galaxy S10,
+	  S10e and S10+ (Exynos9820): two CS35L40 on one I2S port of the
+	  ABOX, the earpiece on the left channel and the bottom speaker on
+	  the right, with their voltage and current monitors available for
+	  capture on the same port, and the CS47L93 codec with the
+	  microphones and the headset jack on a second port.
+
 endif #SND_SOC_SAMSUNG
