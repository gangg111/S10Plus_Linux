diff --git a/sound/soc/samsung/beyond-audio.c b/sound/soc/samsung/beyond-audio.c
new file mode 100644
index 00000000000..857e34185ae
--- /dev/null
+++ b/sound/soc/samsung/beyond-audio.c
@@ -0,0 +1,339 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Galaxy S10 family audio on the Exynos9820 ABOX
+ *
+ * Copyright (C) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ *
+ * Two CS35L40 amplifiers hang off one I2S port, UAIF1.  Each takes the
+ * channel given by its position in the codec list of the device tree node,
+ * and hands its monitor data back in the slot of the same channel.
+ *
+ * The CS47L93 codec, with the microphones and the headset jack, sits on
+ * UAIF0.  Its system clock runs from FLL1, which locks to the bit clock of
+ * the port: the 26 MHz MCLK1 the vendor uses comes from the PMU clock
+ * output, which has no driver here.  ABOX starts the bit clock when a
+ * stream is prepared, before DAPM powers the codec, so the FLL is started
+ * on the way into the prepare bias level and stopped on the way out.
+ */
+
+#include <linux/interrupt.h>	/* for sound/cs35l41.h */
+#include <linux/mfd/madera/core.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/cs35l41.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "../codecs/madera.h"
+
+#define BEYOND_MAX_AMPS		2
+#define BEYOND_SYSCLK_RATE	98304000
+
+enum {
+	BEYOND_LINK_SPEAKERS,
+	BEYOND_LINK_CODEC,
+	BEYOND_NUM_LINKS,
+};
+
+struct beyond_priv {
+	struct snd_soc_card card;
+	struct snd_soc_dai_link link[BEYOND_NUM_LINKS];
+	struct snd_soc_dai_link_component platform[BEYOND_NUM_LINKS];
+	struct snd_soc_component *codec;
+	unsigned int codec_bclk;
+};
+
+/* receive slots per amplifier position: RX1 takes its own channel */
+static const unsigned int beyond_rx_slots[BEYOND_MAX_AMPS][2] = {
+	{ 0, 1 },
+	{ 1, 0 },
+};
+
+/* transmit slot of ASPTX1 per amplifier position */
+static const unsigned int beyond_tx_slot[BEYOND_MAX_AMPS] = { 0, 1 };
+
+static unsigned int beyond_bclk(struct snd_pcm_hw_params *params)
+{
+	return params_rate(params) * params_channels(params) *
+	       params_physical_width(params);
+}
+
+static int beyond_amp_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	unsigned int bclk = beyond_bclk(params);
+	struct snd_soc_dai *dai;
+	int i, ret;
+
+	for_each_rtd_codec_dais(rtd, i, dai) {
+		/* the amplifier PLL takes its reference from the bit clock */
+		ret = snd_soc_dai_set_sysclk(dai, CS35L41_CLKID_SCLK, bclk,
+					     SND_SOC_CLOCK_IN);
+		if (ret < 0)
+			return ret;
+		ret = snd_soc_component_set_sysclk(dai->component,
+						   CS35L41_CLKID_SCLK, 0, bclk,
+						   SND_SOC_CLOCK_IN);
+		if (ret < 0)
+			return ret;
+		ret = snd_soc_dai_set_channel_map(dai, 1, &beyond_tx_slot[i],
+						  2, beyond_rx_slots[i]);
+		if (ret < 0)
+			return ret;
+	}
+	return 0;
+}
+
+static const struct snd_soc_ops beyond_amp_ops = {
+	.hw_params = beyond_amp_hw_params,
+};
+
+static int beyond_codec_hw_params(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+
+	priv->codec_bclk = beyond_bclk(params);
+	return 0;
+}
+
+static const struct snd_soc_ops beyond_codec_ops = {
+	.hw_params = beyond_codec_hw_params,
+};
+
+static int beyond_codec_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *dai = snd_soc_rtd_to_codec(rtd, 0);
+	int ret;
+
+	priv->codec = dai->component;
+	ret = snd_soc_component_set_sysclk(priv->codec, MADERA_CLK_SYSCLK_1,
+					   MADERA_CLK_SRC_FLL1,
+					   BEYOND_SYSCLK_RATE,
+					   SND_SOC_CLOCK_IN);
+	if (ret)
+		return ret;
+	return snd_soc_dai_set_sysclk(dai, MADERA_CLK_SYSCLK_1, 0, 0);
+}
+
+static int beyond_set_bias_level(struct snd_soc_card *card,
+				 struct snd_soc_dapm_context *dapm,
+				 enum snd_soc_bias_level level)
+{
+	struct beyond_priv *priv = snd_soc_card_get_drvdata(card);
+	enum snd_soc_bias_level cur = snd_soc_dapm_get_bias_level(dapm);
+
+	if (!priv->codec || dapm != snd_soc_component_to_dapm(priv->codec))
+		return 0;
+
+	if (level == SND_SOC_BIAS_PREPARE && cur == SND_SOC_BIAS_STANDBY) {
+		if (!priv->codec_bclk) {
+			dev_err(card->dev, "no bit clock rate for the codec FLL\n");
+			return -EINVAL;
+		}
+		return snd_soc_component_set_pll(priv->codec, MADERA_FLL1_REFCLK,
+						 MADERA_FLL_SRC_AIF1BCLK,
+						 priv->codec_bclk,
+						 BEYOND_SYSCLK_RATE);
+	}
+	if (level == SND_SOC_BIAS_STANDBY && cur == SND_SOC_BIAS_PREPARE)
+		return snd_soc_component_set_pll(priv->codec, MADERA_FLL1_REFCLK,
+						 0, 0, 0);
+	return 0;
+}
+
+/*
+ * With two slots on the port, each amplifier may transmit in one of them
+ * only.  ASPTX2 comes out of reset fed by IMON and placed in slot 1 on both
+ * parts, which puts three transmitters on the shared SDOUT line as soon as
+ * the port records.  Take it off the line through its source mux, so that
+ * DAPM leaves the channel unpowered.  Writing the register underneath would
+ * not do, as DAPM keeps the path it read when the routes went in, and the
+ * mux controls exist only once the card is bound, so this runs after the
+ * card is registered rather than from late_probe.
+ */
+static int beyond_quiet_asptx2(struct beyond_priv *priv)
+{
+	struct snd_soc_card *card = &priv->card;
+	struct snd_soc_pcm_runtime *rtd;
+	struct snd_ctl_elem_value *value;
+	const char *prefix;
+	struct snd_kcontrol *kctl;
+	struct snd_soc_dai *dai;
+	char name[SNDRV_CTL_ELEM_ID_NAME_MAXLEN];
+	int i, ret = 0;
+
+	value = kzalloc_obj(*value);
+	if (!value)
+		return -ENOMEM;
+
+	for_each_card_rtds(card, rtd) {
+		if (rtd->dai_link != &priv->link[BEYOND_LINK_SPEAKERS])
+			continue;
+		for_each_rtd_codec_dais(rtd, i, dai) {
+			prefix = dai->component->name_prefix;
+			snprintf(name, sizeof(name), "%s%sASP TX2 Source",
+				 prefix ?: "", prefix ? " " : "");
+			kctl = snd_soc_card_get_kcontrol(card, name);
+			if (!kctl) {
+				dev_err(card->dev, "no control '%s'\n", name);
+				ret = -ENOENT;
+				goto out;
+			}
+			memset(value, 0, sizeof(*value));
+			value->value.enumerated.item[0] = 0;	/* "Zero" */
+			ret = kctl->put(kctl, value);
+			if (ret < 0)
+				goto out;
+			ret = 0;
+		}
+	}
+out:
+	kfree(value);
+	return ret;
+}
+
+static void beyond_put_link(void *data)
+{
+	struct snd_soc_dai_link *link = data;
+
+	snd_soc_of_put_dai_link_codecs(link);
+	snd_soc_of_put_dai_link_cpus(link);
+}
+
+/* cpu and codec subnodes of np into link, with ABOX as the PCM */
+static int beyond_parse_link(struct device *dev, struct device_node *np,
+			     struct snd_soc_dai_link *link,
+			     struct snd_soc_dai_link_component *platform)
+{
+	struct device_node *cpu, *codec;
+	int ret;
+
+	cpu = of_get_child_by_name(np, "cpu");
+	if (!cpu)
+		return dev_err_probe(dev, -EINVAL, "%pOF: no cpu node\n", np);
+	ret = snd_soc_of_get_dai_link_cpus(dev, cpu, link);
+	of_node_put(cpu);
+	if (ret)
+		return dev_err_probe(dev, ret, "%pOF: cannot get the cpu DAI\n", np);
+
+	codec = of_get_child_by_name(np, "codec");
+	if (!codec) {
+		snd_soc_of_put_dai_link_cpus(link);
+		return dev_err_probe(dev, -EINVAL, "%pOF: no codec node\n", np);
+	}
+	ret = snd_soc_of_get_dai_link_codecs(dev, codec, link);
+	of_node_put(codec);
+	if (ret) {
+		snd_soc_of_put_dai_link_cpus(link);
+		return dev_err_probe(dev, ret, "%pOF: cannot get the codec DAIs\n", np);
+	}
+
+	/* the ABOX component is both the port and the PCM */
+	platform->of_node = link->cpus[0].of_node;
+	link->platforms = platform;
+	link->num_platforms = 1;
+
+	/* added before the card, so it runs after the card is gone */
+	return devm_add_action_or_reset(dev, beyond_put_link, link);
+}
+
+static const struct snd_soc_dapm_widget beyond_widgets[] = {
+	SND_SOC_DAPM_SPK("Receiver", NULL),
+	SND_SOC_DAPM_SPK("Speaker", NULL),
+	SND_SOC_DAPM_HP("Headphone", NULL),
+	SND_SOC_DAPM_MIC("Headset Mic", NULL),
+	SND_SOC_DAPM_MIC("DMIC1", NULL),
+	SND_SOC_DAPM_MIC("DMIC2", NULL),
+};
+
+static int beyond_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct snd_soc_dai_link *link;
+	struct device_node *np;
+	struct beyond_priv *priv;
+	struct snd_soc_card *card;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	card = &priv->card;
+
+	card->dev = dev;
+	card->owner = THIS_MODULE;
+	card->driver_name = "beyond-audio";
+	card->dapm_widgets = beyond_widgets;
+	card->num_dapm_widgets = ARRAY_SIZE(beyond_widgets);
+	card->set_bias_level = beyond_set_bias_level;
+	card->dai_link = priv->link;
+	card->num_links = 1;
+	snd_soc_card_set_drvdata(card, priv);
+
+	ret = snd_soc_of_parse_card_name(card, "model");
+	if (ret)
+		return ret;
+	ret = snd_soc_of_parse_audio_routing(card, "audio-routing");
+	if (ret)
+		return ret;
+
+	link = &priv->link[BEYOND_LINK_SPEAKERS];
+	link->name = "Speakers";
+	link->stream_name = "Speakers";
+	link->dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			SND_SOC_DAIFMT_CBC_CFC;
+	link->ops = &beyond_amp_ops;
+	ret = beyond_parse_link(dev, dev->of_node, link,
+				&priv->platform[BEYOND_LINK_SPEAKERS]);
+	if (ret)
+		return ret;
+	if (link->num_codecs > BEYOND_MAX_AMPS)
+		return dev_err_probe(dev, -EINVAL, "at most %d amplifiers\n",
+				     BEYOND_MAX_AMPS);
+
+	np = of_get_child_by_name(dev->of_node, "codec-link");
+	if (np) {
+		link = &priv->link[BEYOND_LINK_CODEC];
+		link->name = "Codec";
+		link->stream_name = "Codec";
+		link->dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+				SND_SOC_DAIFMT_CBC_CFC;
+		link->ops = &beyond_codec_ops;
+		link->init = beyond_codec_init;
+		ret = beyond_parse_link(dev, np, link,
+					&priv->platform[BEYOND_LINK_CODEC]);
+		of_node_put(np);
+		if (ret)
+			return ret;
+		card->num_links++;
+	}
+
+	ret = devm_snd_soc_register_card(dev, card);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot register the card\n");
+	return beyond_quiet_asptx2(priv);
+}
+
+static const struct of_device_id beyond_of_match[] = {
+	{ .compatible = "samsung,beyond-audio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, beyond_of_match);
+
+static struct platform_driver beyond_driver = {
+	.probe = beyond_probe,
+	.driver = {
+		.name = "beyond-audio",
+		.of_match_table = beyond_of_match,
+	},
+};
+module_platform_driver(beyond_driver);
+
+MODULE_AUTHOR("Artur Szafraniec <ganggg111@gmail.com>");
+MODULE_DESCRIPTION("Galaxy S10 family audio on the Exynos9820 ABOX");
+MODULE_LICENSE("GPL");
