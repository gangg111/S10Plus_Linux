From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Mon, 7 Sep 2026 04:44:45 +0200
Subject: [PATCH] dt-bindings: display: Add the Exynos9820 DECON

DECON blends the DPP windows and drives DSIM, optionally through the DSC
encoders. The DSIM is a different generation from the ones that
samsung,mipi-dsim.yaml describes - register map, PLL programming
and command transfer all differ - but it is the same block,
so it is added to that binding rather than given one of its
own.

The windows are fed by DPU_DMA, and that block is described as the second
register range of the DECON node.  The whole block is named, not the one
channel this driver programs, so adding the remaining windows later is a
driver change and not a device tree change.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../samsung/samsung,exynos9820-decon.yaml     | 113 ++++++++++++++++++
 1 file changed, 113 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/samsung/samsung,exynos9820-decon.yaml

diff --git a/Documentation/devicetree/bindings/display/samsung/samsung,exynos9820-decon.yaml b/Documentation/devicetree/bindings/display/samsung/samsung,exynos9820-decon.yaml
new file mode 100644
index 00000000000..b95afa0bba0
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/samsung/samsung,exynos9820-decon.yaml
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/samsung/samsung,exynos9820-decon.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9820 SoC Display and Enhancement Controller (DECON)
+
+maintainers:
+  - Artur Szafraniec <ganggg111@gmail.com>
+
+description:
+  DECON blends the window inputs and drives the result into DSIM, on the
+  Exynos9820 optionally through the DSC encoders.  The windows are fed by
+  DPU_DMA, a block of six input channels and one writeback channel that has
+  no function of its own, and it feeds the display controllers of this SoC.
+  This device tree describes one of them, so the block is described as part
+  of that controller rather than as a device on its own.
+
+properties:
+  compatible:
+    const: samsung,exynos9820-decon
+
+  reg:
+    items:
+      - description: DECON_F registers
+      - description: DPU_DMA registers, the input channels feeding the windows
+
+  reg-names:
+    items:
+      - const: decon
+      - const: dma
+
+  interrupts:
+    items:
+      - description: frame start
+      - description: frame done
+      - description:
+          Resource conflict, timeout and error.  The vendor register map calls
+          this group extra, hence the name.
+
+  interrupt-names:
+    items:
+      - const: frame-start
+      - const: frame-done
+      - const: extra
+
+  clocks:
+    items:
+      - description: DECON bus clock
+      - description: DPU DMA bus clock
+      - description: DPP bus clock
+
+  clock-names:
+    items:
+      - const: aclk
+      - const: aclk-dma
+      - const: aclk-dpp
+
+  power-domains:
+    maxItems: 1
+
+  iommus:
+    maxItems: 3
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description: Output to the DSI host
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - power-domains
+  - iommus
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/clock/samsung,exynos9820.h>
+
+    display-controller@19030000 {
+        compatible = "samsung,exynos9820-decon";
+        reg = <0x19030000 0x10000>, <0x19070000 0x10000>;
+        reg-names = "decon", "dma";
+
+        interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 189 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "frame-start", "frame-done", "extra";
+
+        clocks = <&cmu_dpu CLK_GOUT_DPU_DPU_ACLK_DECON>,
+                 <&cmu_dpu CLK_GOUT_DPU_DPU_ACLK_DMA>,
+                 <&cmu_dpu CLK_GOUT_DPU_DPU_ACLK_DPP>;
+        clock-names = "aclk", "aclk-dma", "aclk-dpp";
+
+        power-domains = <&pd_dpu>;
+        iommus = <&sysmmu_dpud0>, <&sysmmu_dpud1>, <&sysmmu_dpud2>;
+
+        port {
+            decon_to_dsim: endpoint {
+                remote-endpoint = <&dsim_to_decon>;
+            };
+        };
+    };
+...
