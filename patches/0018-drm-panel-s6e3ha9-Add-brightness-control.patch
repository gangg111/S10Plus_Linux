+#include <linux/backlight.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
@@ -27,9 +28,17 @@
 struct s6e3ha9 {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi;
+	struct backlight_device *backlight;
 	struct drm_dsc_config dsc;
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+
+	/*
+	 * The backlight device is registered in probe, so a write to sysfs can
+	 * ask for a brightness change while the panel is off, the DSI host is
+	 * runtime suspended and its clocks are gated.
+	 */
+	bool prepared;
 };
 
 /*
@@ -61,6 +70,149 @@ static inline struct s6e3ha9 *to_s6e3ha9(struct drm_panel *panel)
 #define s6e3ha9_key_on_lvl3(ctx)  mipi_dsi_dcs_write_seq_multi(ctx, 0xfc, 0x5a, 0x5a)
 #define s6e3ha9_key_off_lvl3(ctx) mipi_dsi_dcs_write_seq_multi(ctx, 0xfc, 0xa5, 0xa5)
 
+/*
+ * Samsung AID dimming: brightness is set by the AOR (analog on-time ratio)
+ * duty together with the ELVSS and VINT levels, not by a single DCS command.
+ * The tables below are the vendor's, transcribed from
+ * s6e3ha9_beyond2_a3_s0_panel.h (AOR, ELVSS, VINT) and
+ * s6e3ha9_beyond2_a3_s0_panel_dimming.h (brightness and luminance steps),
+ * for the room temperature (OVER_ZERO) slice.
+ *
+ * The per level gamma curve that the vendor computes from the panel's MTP
+ * data is not implemented; the panel keeps the gamma programmed at power on,
+ * so the luminance of a given step will not match the nits column exactly.
+ */
+static const struct s6e3ha9_brightness {
+	u16 brightness;	/* platform brightness this row starts at */
+	u16 nits;	/* luminance the vendor tables aim for */
+	u8 aor[2];	/* 0xb1 */
+	u8 elvss;	/* 0xb5, third byte */
+	u8 vint;	/* 0xf4, second byte */
+} s6e3ha9_brightness_table[] = {
+	{   0,   2, { 0x0b, 0xc1 }, 0x12, 0x23 },
+	{   7,   3, { 0x0b, 0xad }, 0x12, 0x23 },
+	{  14,   4, { 0x0b, 0x8c }, 0x13, 0x23 },
+	{  21,   5, { 0x0b, 0x72 }, 0x13, 0x23 },
+	{  28,   6, { 0x0b, 0x55 }, 0x14, 0x23 },
+	{  35,   7, { 0x0b, 0x35 }, 0x15, 0x23 },
+	{  36,   8, { 0x0b, 0x19 }, 0x16, 0x23 },
+	{  38,   9, { 0x0a, 0xfa }, 0x17, 0x23 },
+	{  40,  10, { 0x0a, 0xda }, 0x18, 0x23 },
+	{  42,  11, { 0x0a, 0xbc }, 0x1a, 0x23 },
+	{  44,  12, { 0x0a, 0x95 }, 0x1c, 0x23 },
+	{  46,  13, { 0x0a, 0x6e }, 0x1e, 0x23 },
+	{  48,  14, { 0x0a, 0x41 }, 0x20, 0x23 },
+	{  50,  15, { 0x0a, 0x1b }, 0x22, 0x23 },
+	{  52,  16, { 0x09, 0xff }, 0x22, 0x23 },
+	{  54,  17, { 0x09, 0xda }, 0x22, 0x23 },
+	{  56,  19, { 0x09, 0x9b }, 0x22, 0x23 },
+	{  57,  20, { 0x09, 0x7e }, 0x22, 0x23 },
+	{  59,  21, { 0x09, 0x55 }, 0x22, 0x23 },
+	{  61,  22, { 0x09, 0x24 }, 0x22, 0x23 },
+	{  63,  24, { 0x08, 0xff }, 0x22, 0x23 },
+	{  65,  25, { 0x08, 0xd9 }, 0x22, 0x23 },
+	{  67,  27, { 0x08, 0x9a }, 0x22, 0x23 },
+	{  69,  29, { 0x08, 0x54 }, 0x22, 0x23 },
+	{  70,  30, { 0x08, 0x32 }, 0x22, 0x23 },
+	{  72,  32, { 0x07, 0xf1 }, 0x22, 0x23 },
+	{  74,  34, { 0x07, 0xad }, 0x22, 0x23 },
+	{  76,  37, { 0x07, 0x41 }, 0x22, 0x23 },
+	{  78,  39, { 0x07, 0x01 }, 0x22, 0x23 },
+	{  80,  41, { 0x06, 0xba }, 0x22, 0x23 },
+	{  82,  44, { 0x06, 0x5e }, 0x22, 0x23 },
+	{  84,  47, { 0x05, 0xf0 }, 0x22, 0x23 },
+	{  86,  50, { 0x05, 0x92 }, 0x22, 0x23 },
+	{  88,  53, { 0x05, 0x21 }, 0x22, 0x23 },
+	{  90,  56, { 0x04, 0xbb }, 0x22, 0x23 },
+	{  92,  60, { 0x04, 0x5d }, 0x22, 0x23 },
+	{  94,  64, { 0x04, 0x5d }, 0x22, 0x23 },
+	{  96,  68, { 0x04, 0x5d }, 0x22, 0x23 },
+	{  98,  72, { 0x04, 0x5d }, 0x22, 0x23 },
+	{ 100,  77, { 0x04, 0x5d }, 0x22, 0x23 },
+	{ 102,  82, { 0x04, 0x5d }, 0x22, 0x23 },
+	{ 104,  87, { 0x04, 0x5d }, 0x21, 0x23 },
+	{ 106,  93, { 0x04, 0x5d }, 0x21, 0x23 },
+	{ 108,  98, { 0x04, 0x5d }, 0x21, 0x23 },
+	{ 110, 105, { 0x04, 0x5d }, 0x21, 0x23 },
+	{ 112, 111, { 0x04, 0x5d }, 0x21, 0x23 },
+	{ 114, 119, { 0x04, 0x5d }, 0x20, 0x23 },
+	{ 116, 126, { 0x04, 0x5d }, 0x20, 0x23 },
+	{ 118, 134, { 0x04, 0x5d }, 0x20, 0x23 },
+	{ 120, 143, { 0x04, 0x5d }, 0x20, 0x23 },
+	{ 122, 152, { 0x04, 0x5d }, 0x1f, 0x23 },
+	{ 124, 162, { 0x04, 0x5d }, 0x1f, 0x23 },
+	{ 126, 172, { 0x04, 0x5d }, 0x1f, 0x23 },
+	{ 128, 183, { 0x04, 0x42 }, 0x1f, 0x23 },
+	{ 135, 195, { 0x03, 0xbf }, 0x1e, 0x23 },
+	{ 142, 207, { 0x03, 0x21 }, 0x1e, 0x23 },
+	{ 149, 220, { 0x02, 0x6a }, 0x1e, 0x23 },
+	{ 157, 234, { 0x01, 0xb3 }, 0x1e, 0x23 },
+	{ 165, 249, { 0x01, 0x58 }, 0x1d, 0x23 },
+	{ 174, 265, { 0x01, 0x58 }, 0x1c, 0x23 },
+	{ 183, 282, { 0x01, 0x58 }, 0x1b, 0x23 },
+	{ 193, 300, { 0x01, 0x58 }, 0x1a, 0x23 },
+	{ 201, 316, { 0x01, 0x58 }, 0x1a, 0x23 },
+	{ 210, 333, { 0x01, 0x58 }, 0x19, 0x23 },
+	{ 219, 350, { 0x01, 0x58 }, 0x18, 0x23 },
+	{ 223, 357, { 0x01, 0x58 }, 0x18, 0x23 },
+	{ 227, 365, { 0x01, 0x45 }, 0x18, 0x23 },
+	{ 230, 372, { 0x00, 0xf1 }, 0x18, 0x23 },
+	{ 234, 380, { 0x00, 0xba }, 0x17, 0x23 },
+	{ 238, 387, { 0x00, 0x8a }, 0x17, 0x23 },
+	{ 242, 395, { 0x00, 0x29 }, 0x17, 0x23 },
+	{ 246, 403, { 0x00, 0x14 }, 0x17, 0x23 },
+	{ 250, 412, { 0x00, 0x14 }, 0x16, 0x23 },
+	{ 255, 420, { 0x00, 0x14 }, 0x16, 0x23 },
+};
+
+#define S6E3HA9_MAX_BRIGHTNESS	255
+
+static int s6e3ha9_set_brightness(struct s6e3ha9 *priv, unsigned int brightness)
+{
+	struct mipi_dsi_multi_context ctx = { .dsi = priv->dsi };
+	const struct s6e3ha9_brightness *row = &s6e3ha9_brightness_table[0];
+	/* the payloads depend on the level, so they cannot be static */
+	u8 aor[3] = { 0xb1, };
+	u8 elvss[4] = { 0xb5, 0x19, 0xdc, };
+	u8 vint[3] = { 0xf4, 0xeb, };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(s6e3ha9_brightness_table); i++) {
+		if (s6e3ha9_brightness_table[i].brightness > brightness)
+			break;
+		row = &s6e3ha9_brightness_table[i];
+	}
+
+	aor[1] = row->aor[0];
+	aor[2] = row->aor[1];
+	elvss[3] = row->elvss;
+	vint[2] = row->vint;
+
+	s6e3ha9_key_on_lvl2(&ctx);
+	mipi_dsi_dcs_write_buffer_multi(&ctx, aor, sizeof(aor));
+	mipi_dsi_dcs_write_buffer_multi(&ctx, elvss, sizeof(elvss));
+	mipi_dsi_dcs_write_buffer_multi(&ctx, vint, sizeof(vint));
+	/* latch gamma, AOR and ELVSS together */
+	mipi_dsi_dcs_write_seq_multi(&ctx, 0xf7, 0x03);
+	s6e3ha9_key_off_lvl2(&ctx);
+
+	return ctx.accum_err;
+}
+
+static int s6e3ha9_bl_update_status(struct backlight_device *bl)
+{
+	struct s6e3ha9 *priv = bl_get_data(bl);
+
+	if (!priv->prepared)
+		return 0;
+
+	return s6e3ha9_set_brightness(priv, backlight_get_brightness(bl));
+}
+
+static const struct backlight_ops s6e3ha9_bl_ops = {
+	.update_status = s6e3ha9_bl_update_status,
+};
+
 /*
  * The panel RESETB pin is active low: the vendor device tree describes it as
  * "disp-reset" with the active-low flag set (gpa3-4, flag 1).  gpiod values are
@@ -157,28 +309,16 @@ static int s6e3ha9_on(struct s6e3ha9 *priv)
 	mipi_dsi_dcs_write_seq_multi(&ctx, 0xb0, 0x95); /* global para offset 0x95 */
 	mipi_dsi_dcs_write_seq_multi(&ctx, 0xb1, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00);
 
-	/*
-	 * Static brightness condition, copied from the vendor's base packets.
-	 * TODO: proper AID dimming needs the per-level gamma/AOR/ELVSS tables
-	 * derived from the panel's MTP data, which this driver does not read yet.
-	 */
-	mipi_dsi_dcs_write_seq_multi(&ctx, 0xca,
-				     0x2a, 0x00, 0x00, 0x00,
-				     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
-				     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
-				     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
-				     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
-				     0x80, 0x80, 0x80,
-				     0x00, 0x00, 0x00);
-	mipi_dsi_dcs_write_seq_multi(&ctx, 0xb1, 0x00, 0x14);       /* AOR */
-	mipi_dsi_dcs_write_seq_multi(&ctx, 0xb5, 0x19, 0xdc, 0x0a); /* TSET/MPS/ELVSS */
-	mipi_dsi_dcs_write_seq_multi(&ctx, 0xf4, 0xeb, 0x23);       /* VGH/VINT */
 	mipi_dsi_dcs_write_seq_multi(&ctx, 0xb4, 0x00, 0x44, 0x80, 0x65, 0x26, 0x00);
 	mipi_dsi_dcs_write_seq_multi(&ctx, 0x55, 0x00);             /* ACL off */
-	mipi_dsi_dcs_write_seq_multi(&ctx, 0xf7, 0x03);             /* gamma update */
 	s6e3ha9_key_off_lvl2(&ctx);
 
-	return ctx.accum_err;
+	if (ctx.accum_err)
+		return ctx.accum_err;
+
+	/* brightness condition: AOR, ELVSS and VINT for the current level */
+	return s6e3ha9_set_brightness(priv,
+				      backlight_get_brightness(priv->backlight));
 }
 
 static int s6e3ha9_prepare(struct drm_panel *panel)
@@ -197,6 +337,8 @@ static int s6e3ha9_prepare(struct drm_panel *panel)
 		return ret;
 	}
 
+	priv->prepared = true;
+
 	return 0;
 }
 
@@ -204,6 +346,8 @@ static int s6e3ha9_unprepare(struct drm_panel *panel)
 {
 	struct s6e3ha9 *priv = to_s6e3ha9(panel);
 
+	priv->prepared = false;
+
 	/* hold the DDIC in reset while the rails go down */
 	gpiod_set_value_cansleep(priv->reset_gpio, 1);
 
@@ -314,6 +458,11 @@ static int s6e3ha9_init_dsc(struct device *dev, struct drm_dsc_config *dsc)
 
 static int s6e3ha9_probe(struct mipi_dsi_device *dsi)
 {
+	static const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = S6E3HA9_MAX_BRIGHTNESS,
+		.max_brightness = S6E3HA9_MAX_BRIGHTNESS,
+	};
 	struct device *dev = &dsi->dev;
 	struct s6e3ha9 *priv;
 	int ret;
@@ -341,6 +490,15 @@ static int s6e3ha9_probe(struct mipi_dsi_device *dsi)
 	priv->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, priv);
 
+	priv->backlight = devm_backlight_device_register(dev, dev_name(dev), dev,
+							 priv, &s6e3ha9_bl_ops,
+							 &props);
+	if (IS_ERR(priv->backlight))
+		return dev_err_probe(dev, PTR_ERR(priv->backlight),
+				     "Failed to register backlight\n");
+
+	priv->panel.backlight = priv->backlight;
+
 	dsi->lanes = 4;
 	dsi->format = MIPI_DSI_FMT_RGB888;
 	/*
