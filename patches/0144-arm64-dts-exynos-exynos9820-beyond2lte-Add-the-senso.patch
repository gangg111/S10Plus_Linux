From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Sun, 27 Sep 2026 02:46:07 +0200
Subject: [PATCH] arm64: dts: exynos: exynos9820-beyond2lte: Add the sensor hub

Every motion and environment sensor of the Galaxy S10+ sits behind the
Cortex-M4 hub of its BCM47752 GNSS receiver.  Describe the hub on SPI17
with its handshake lines and interrupts, the pin settings of the vendor
tree, and the board data its firmware needs.

The hub core runs from LDO21M of the main PMIC, which the vendor tree
keeps always on.  Left off, the hub never answers; switched on, the hub
takes its firmware, reports the accelerometer at 4096 counts per g and
drives screen rotation through iio-sensor-proxy.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../boot/dts/exynos/exynos9820-beyond2lte.dts | 126 ++++++++++++++++++
 1 file changed, 126 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9820-beyond2lte.dts b/arch/arm64/boot/dts/exynos/exynos9820-beyond2lte.dts
index 326825353bc..1d20f8fb03a 100644
--- a/arch/arm64/boot/dts/exynos/exynos9820-beyond2lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9820-beyond2lte.dts
@@ -313,6 +313,17 @@ ldo19m: LDO19M {
 				regulator-max-microvolt = <1800000>;
 			};
 
+			/*
+			 * The sensor hub core, vdd_mcu_1p8 in the vendor tree, which keeps
+			 * it always on.  Without it the hub never answers on its bus.
+			 */
+			ldo21m: LDO21M {
+				regulator-name = "vdd_mcu_1p8";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+			};
+
 			ldo27m: LDO27M {
 				regulator-name = "tsp_avdd";
 				regulator-min-microvolt = <3000000>;
@@ -600,6 +611,36 @@ ts_int: ts-int-pins {
 	};
 };
 
+/*
+ * The sensor hub and GNSS receiver, a Broadcom BCM47752 the vendor tree
+ * still calls BCM4773, answers on the vendor spi_17.  The groups below carry
+ * the pull, drive and sleep settings of the vendor tree.  The output lines
+ * get no pin function from their groups: requesting a line as an output sets
+ * its level first, where switching the pin to output from a group would not.
+ * The ALIVE banks have no sleep fields, so the vendor sleep setting of the
+ * batch wake line is left out.
+ */
+&pinctrl_alive {
+	ssp_batch_wake_pins: ssp-batch-wake-pins {
+		samsung,pins = "gpa0-5";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	ssp_host_req_pins: ssp-host-req-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+
+	ssp_shub_int_pins: ssp-shub-int-pins {
+		samsung,pins = "gpa4-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+	};
+};
+
 &pinctrl_alive {
 	codec_irq: codec-irq-pins {
 		samsung,pins = "gpa2-2";
@@ -635,6 +676,33 @@ amp_int_pins: amp-int-pins {
 	};
 };
 
+&pinctrl_peric0 {
+	ssp_gps_pwr_en_pins: ssp-gps-pwr-en-pins {
+		samsung,pins = "gpg0-2";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	ssp_mcu_req_pins: ssp-mcu-req-pins {
+		samsung,pins = "gpg4-1";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	ssp_mcu_resp_pins: ssp-mcu-resp-pins {
+		samsung,pins = "gpg4-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV4>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
 &pinctrl_peric0 {
 	wlan_en_pins: wlan-en-pins {
 		samsung,pins = "gpg0-5";
@@ -712,6 +780,58 @@ bluetooth {
 	};
 };
 
+/*
+ * The chip select is a GPIO, as in the vendor tree and on the codec bus.
+ * The select this controller drives by itself is automatic, and an SSI
+ * frame is one transfer longer than the 64 byte FIFO.
+ */
+&spi_17 {
+	cs-gpios = <&gph0 3 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	sensorhub@0 {
+		compatible = "brcm,bcm47752";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		spi-cpol;
+		spi-cpha;
+
+		/* raw levels, the way the vendor driver reads and drives them */
+		host-req-gpios = <&gpa1 7 GPIO_ACTIVE_HIGH>;
+		mcu-req-gpios = <&gpg4 1 GPIO_ACTIVE_HIGH>;
+		mcu-resp-gpios = <&gpg4 2 GPIO_ACTIVE_HIGH>;
+		batch-wake-gpios = <&gpa0 5 GPIO_ACTIVE_HIGH>;
+		shub-int-gpios = <&gpa4 0 GPIO_ACTIVE_HIGH>;
+		gps-pwr-en-gpios = <&gpg0 2 GPIO_ACTIVE_HIGH>;
+
+		interrupts-extended = <&gpa1 7 IRQ_TYPE_LEVEL_HIGH>,
+				      <&gpa4 0 IRQ_TYPE_EDGE_FALLING>;
+		interrupt-names = "host-req", "shub-int";
+
+		pinctrl-0 = <&ssp_host_req_pins>, <&ssp_mcu_req_pins>,
+			    <&ssp_mcu_resp_pins>, <&ssp_batch_wake_pins>,
+			    <&ssp_shub_int_pins>, <&ssp_gps_pwr_en_pins>;
+		pinctrl-names = "default";
+
+		brcm,ap-type = <2>;
+		brcm,acc-position = <4>;
+		brcm,mag-position = <7>;
+		brcm,mag-type = <1>;
+		brcm,glass-type = <0>;
+		brcm,mag-array = /bits/ 8 <0xc1 0x52 0xa9 0xed 0x9e 0x42 0x00 0x35 0xd4
+					  0x38 0xcd 0x98 0xa7 0x8d 0x01 0xcb 0xff 0xb4
+					  0xbe 0x9c 0xc1 0xfc 0x7f 0x64 0x0c 0xee 0xd4>;
+		brcm,thermi-up = /bits/ 16 <0x0bce 0x0bb0 0x0b8a 0x0b5b 0x0b21 0x0ad8
+					   0x0a86 0x0a20 0x09a7 0x0927 0x0894 0x0806
+					   0x0765 0x06c2 0x061d 0x0577 0x04e1 0x0453
+					   0x03f0 0x0372 0x0303 0x02a1 0x0254>;
+		brcm,thermi-sub = /bits/ 16 <0x0bc7 0x0ba9 0x0b85 0x0b59 0x0b1b 0x0ad4
+					    0x0a7d 0x0a15 0x099d 0x091e 0x088b 0x07fb
+					    0x0761 0x06ba 0x0618 0x056e 0x04da 0x044c
+					    0x03e7 0x0369 0x02fb 0x02a0 0x024d>;
+	};
+};
+
 /*
  * The audio hub, a CS47L93, is the only device on this bus.  AVDD, DBVDD1
  * and CPVDD1 come from LDO17M (1.8 V), DCVDD and CPVDD2 from LDO18M
@@ -831,6 +951,12 @@ &usi1 {
 	status = "okay";
 };
 
+/* This USI instance is wired as the SPI master of the sensor hub. */
+&usi16 {
+	samsung,mode = <USI_V2_SPI>;
+	status = "okay";
+};
+
 /*
  * This I2C-only USI instance carries the bus of the speaker amplifiers.
  * Picking the mode here is also what releases the block from reset.
