From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Mon, 7 Sep 2026 04:48:03 +0200
Subject: [PATCH] dt-bindings: arm: samsung: Add the Galaxy S10+ board

beyond2lte is the SM-G975F variant of the Galaxy S10 family, built
around Exynos9820.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../devicetree/bindings/arm/samsung/samsung-boards.yaml     | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml b/Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml
index 753b3ba1b60..c639d5a413f 100644
--- a/Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml
+++ b/Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml
@@ -247,6 +247,12 @@ properties:
               - samsung,starlte                 # Samsung Galaxy S9 (SM-G960F)
           - const: samsung,exynos9810
 
+      - description: Exynos9820 based boards
+        items:
+          - enum:
+              - samsung,beyond2lte                # Samsung Galaxy S10+ (SM-G975F)
+          - const: samsung,exynos9820
+
       - description: Exynos990 based boards
         items:
           - enum:
