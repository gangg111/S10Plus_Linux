+#include "panel-samsung-s6e3ha9-dimming.h"
+
+/* MTP read register, S6E3HA9_MTP_REG/OFS/LEN in the vendor s6e3ha9.h:39-41 */
+#define S6E3HA9_DCS_READ_MTP	0xc8
+#define S6E3HA9_DCS_GAMMA	0xca
+
 struct s6e3ha9 {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi;
@@ -39,6 +45,10 @@ struct s6e3ha9 {
 	 * runtime suspended and its clocks are gated.
 	 */
