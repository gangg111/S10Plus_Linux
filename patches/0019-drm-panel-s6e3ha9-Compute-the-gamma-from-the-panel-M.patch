+	{ 395, 403, s6e3ha9_gamma_curve_2p15,
+	  s6e3ha9_rtbl395nit, s6e3ha9_ctbl395nit },
+	{ 403, 409, s6e3ha9_gamma_curve_2p15,
+	  s6e3ha9_rtbl403nit, s6e3ha9_ctbl403nit },
+	{ 412, 417, s6e3ha9_gamma_curve_2p15,
+	  s6e3ha9_rtbl412nit, s6e3ha9_ctbl412nit },
+	{ 420, 420, s6e3ha9_gamma_curve_2p20,
+	  s6e3ha9_rtbl420nit, s6e3ha9_ctbl420nit },
+};
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha9-dimming.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha9-dimming.c
new file mode 100644
index 00000000000..9b1b2533d09
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha9-dimming.c
@@ -0,0 +1,395 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AID dimming for the Samsung S6E3HA9 DDIC.
+ *
+ * The panel is calibrated in the factory and carries the deviation of its own
+ * gamma taps in MTP memory.  The gamma register values for every brightness
+ * level are computed from that: the tap voltages are reconstructed from the
+ * MTP offsets, a 256 entry gray scale is interpolated between them, and for
+ * each level the target voltages are looked up on the gamma curve and turned
+ * back into register values.
+ *
+ * The maths follows the vendor implementation: LineageOS/
+ * android_kernel_samsung_exynos9820, commit 7d08ec364a06, drivers/video/
+ * fbdev/exynos/panel/dimming.c, with the per panel tables from
+ * s6e3ha9_dimming.h and s6e3ha9_beyond2_a3_s0_panel_dimming.h.
+ *
+ * Copyright (C) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ */
+
+#include <linux/bits.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include "panel-samsung-s6e3ha9-dimming.h"
+
+#define S6E3HA9_BIT_SHIFT	24
+#define S6E3HA9_GRAY_MAX	256
+#define S6E3HA9_VREGOUT		114085069LL	/* 6.8 V << 24 */
+#define S6E3HA9_VREF		16777216LL	/* 1.0 V << 24 */
+#define S6E3HA9_TARGET_LUM	420
+
+/* voltage source of a tap */
+#define S6E3HA9_VREG_OUT	0
+#define S6E3HA9_V0_OUT		1
+#define S6E3HA9_VT_OUT		2
+
+/* fixed tap indices */
+#define TP_VT			0
+#define TP_V0			1
+#define TP_V255			(S6E3HA9_NR_TP - 1)
+
+struct s6e3ha9_tp {
+	u8 level;
+	u8 volt_src;
+	u16 numerator;
+	u16 denominator;
+	u8 bits;
+	s16 center[3];
+};
+
+struct s6e3ha9_dim_lut {
+	u16 luminance;
+	u16 base_luminance;
+	const u32 *curve;
+	const s16 *rtbl;
+	const s16 (*ctbl)[3];
+};
+
+static const u32 s6e3ha9_vt_voltage[16] = {
+	0, 24, 48, 72, 96, 120, 144, 168, 192, 216, 276, 296, 316, 336, 356, 372,
+};
+
+static const u32 s6e3ha9_v0_voltage[16] = {
+	0, 12, 24, 36, 48, 60, 72, 84, 96, 108, 120, 132, 144, 156, 168, 180,
+};
+
+#include "panel-samsung-s6e3ha9-dimming-data.h"
+
+/* rounded down division that keeps the sign, like the vendor's disp_div64() */
+static s64 s6e3ha9_div(s64 num, s64 den)
+{
+	int sign = ((num < 0) != (den < 0)) ? -1 : 1;
+	u64 tnum = (num < 0) ? -num : num;
+	u64 tden = (den < 0) ? -den : den;
+
+	if (!tden)
+		return 0;
+
+	do_div(tnum, tden);
+
+	return sign * (s64)tnum;
+}
+
+/*
+ * The reverse conversion rounds half up rather than truncating; the vendor
+ * does it with disp_div64_round(num, den, 2) because the voltages it works
+ * with are themselves approximations (dimming.c:235-274).
+ */
+static s64 s6e3ha9_div_round(s64 num, s64 den)
+{
+	int sign = ((num < 0) != (den < 0)) ? -1 : 1;
+	u64 tnum = (num < 0) ? -num : num;
+	u64 tden = (den < 0) ? -den : den;
+	u64 rem;
+
+	if (!tden)
+		return 0;
+
+	rem = do_div(tnum, tden);
+	rem *= 10000;
+	do_div(rem, tden);
+	rem += 5;
+	do_div(rem, 10000);
+
+	return sign * (s64)(tnum + rem);
+}
+
+static s64 s6e3ha9_interpolate(s64 from, s64 to, int cur_step, int total_step)
+{
+	if (cur_step == total_step || from == to)
+		return to;
+
+	return from + s6e3ha9_div((to - from) * cur_step, total_step);
+}
+
+/* voltage of tap @v, colour @c, reconstructed from its MTP offset */
+static s64 s6e3ha9_tp_vout(struct s6e3ha9_dimming *dim, int v, int c)
+{
+	const struct s6e3ha9_tp *tp = &s6e3ha9_tp[v];
+	s64 den = tp->denominator;
+	s64 vsrc, vreg, num;
+	s32 offset;
+
+	vsrc = S6E3HA9_VREGOUT;
+	if (tp->volt_src == S6E3HA9_VT_OUT)
+		vsrc = dim->vout[TP_VT][c];
+
+	if (v == TP_VT || v == TP_V0) {
+		offset = clamp(tp->center[c] + dim->mtp[v][c], 0, 0xf);
+		vreg = vsrc - S6E3HA9_VREF;
+		num = vreg * (v == TP_VT ? s6e3ha9_vt_voltage[offset]
+					 : s6e3ha9_v0_voltage[offset]);
+	} else if (v == TP_V255) {
+		vreg = vsrc - S6E3HA9_VREF;
+		num = vreg * (tp->numerator + tp->center[c] + dim->mtp[v][c]);
+	} else {
+		vreg = vsrc - dim->vout[v + 1][c];
+		num = vreg * (tp->numerator + tp->center[c] + dim->mtp[v][c]);
+	}
+
+	return vsrc - s6e3ha9_div(num, den);
+}
+
+/* the reverse: register value that puts tap @v at the wanted voltage */
+static s32 s6e3ha9_tp_center(struct s6e3ha9_dimming *dim, int ilum, int v, int c)
+{
+	const struct s6e3ha9_tp *tp = &s6e3ha9_tp[v];
+	const s64 *vout = dim->lum_vout[v];
+	s64 num, den, res, vsrc;
+	u32 upper = (1 << tp->bits) - 1;
+
+	vsrc = S6E3HA9_VREGOUT;
+	if (tp->volt_src == S6E3HA9_VT_OUT)
+		vsrc = dim->lum_vout[TP_VT][c];
+
+	num = (vsrc - vout[c]) * tp->denominator;
+	den = (v == TP_V255) ? vsrc - S6E3HA9_VREF
+			     : vsrc - dim->lum_vout[v + 1][c];
+
+	num -= den * (tp->numerator + dim->mtp[v][c]);
+	res = s6e3ha9_div_round(num, den) + s6e3ha9_dim_lut[ilum].ctbl[v][c];
+
+	return clamp_t(s64, res, 0, upper);
+}
+
+/*
+ * Index of the gray level whose luminance is closest to @value.
+ *
+ * A value outside the table is clamped to an end rather than reported.  This
+ * is a deliberate difference from the vendor, which returns -EINVAL and then
+ * uses it as an array index one caller up (dimming.c:752-757 feeding :1137),
+ * so its error path reads before the start of the array.  For this panel
+ * neither behaviour is reachable: the table starts at zero and its top is the
+ * highest luminance any entry asks for, so the two agree on every input the
+ * data can produce.  They would diverge once entries brighter than the table
+ * appear, which is what a high brightness mode would bring.
+ */
+static int s6e3ha9_find_gray(struct s6e3ha9_dimming *dim, u64 value)
+{
+	int l = 0, r = S6E3HA9_GRAY_MAX - 1, m;
+
+	if (value <= dim->gray_gamma[0])
+		return 0;
+	if (value >= dim->gray_gamma[r])
+		return r;
+
+	while (l <= r) {
+		m = l + (r - l) / 2;
+		if (dim->gray_gamma[m] == value)
+			return m;
+		if (dim->gray_gamma[m] < value)
+			l = m + 1;
+		else
+			r = m - 1;
+	}
+
+	return (value - dim->gray_gamma[r] <= dim->gray_gamma[l] - value) ? r : l;
+}
+
+static void s6e3ha9_build_gray_scale(struct s6e3ha9_dimming *dim)
+{
+	int i, c, iv, iv_lower = 0, iv_upper = 0, total_step = 0;
+
+	for (i = 0, iv = TP_V0; iv < S6E3HA9_NR_TP && i < S6E3HA9_GRAY_MAX; i++) {
+		if (i == s6e3ha9_tp[iv].level) {
+			iv_upper = s6e3ha9_tp[iv == S6E3HA9_NR_TP - 1 ? iv : iv + 1].level;
+			iv_lower = s6e3ha9_tp[iv].level;
+			total_step = iv_upper - iv_lower;
+			iv++;
+			continue;
+		}
+
+		for (c = 0; c < 3; c++)
+			dim->gray_vout[i][c] =
+				s6e3ha9_interpolate(dim->gray_vout[iv_lower][c],
+						    dim->gray_vout[iv_upper][c],
+						    i - iv_lower, total_step);
+	}
+
+	for (i = 0; i < S6E3HA9_GRAY_MAX; i++)
+		dim->gray_gamma[i] = (u64)S6E3HA9_TARGET_LUM *
+				     s6e3ha9_gamma_curve_2p20[i];
+}
+
+/* pack one tap value into the 0xca payload, mirroring the panel's layout */
+static void s6e3ha9_pack(u8 *out, u32 value, int v, int c)
+{
+	int index = S6E3HA9_NR_TP - v - 1;
+
+	if (v == TP_V255) {
+		out[0] &= ~(0x3 << ((2 - c) * 2));
+		out[0] |= ((value >> 8) & 0x3) << ((2 - c) * 2);
+		out[c + 1] = value & 0xff;
+	} else if (v == TP_V0) {
+		if (c == 0) {
+			out[index * 3 + 1] &= ~(0xf << 4);
+			out[index * 3 + 1] |= (value & 0xf) << 4;
+		} else if (c == 1) {
+			out[index * 3 + 1] &= ~0xf;
+			out[index * 3 + 1] |= value & 0xf;
+		} else {
+			out[index * 3 + 2] &= ~(0xf << 4);
+			out[index * 3 + 2] |= (value & 0xf) << 4;
+		}
+	} else if (v == TP_VT) {
+		if (c == 0) {
+			out[(index - 1) * 3 + 2] &= ~0xf;
+			out[(index - 1) * 3 + 2] |= value & 0xf;
+		} else if (c == 1) {
+			out[(index - 1) * 3 + 3] &= ~(0xf << 4);
+			out[(index - 1) * 3 + 3] |= (value & 0xf) << 4;
+		} else {
+			out[(index - 1) * 3 + 3] &= ~0xf;
+			out[(index - 1) * 3 + 3] |= value & 0xf;
+		}
+	} else {
+		out[index * 3 + c + 1] = value & 0xff;
+	}
+}
+
+/**
+ * s6e3ha9_dimming_unpack_mtp - decode the MTP offsets read from the panel
+ * @dim: dimming state to fill in
+ * @mtp: payload of the 0xc8 read, %S6E3HA9_MTP_LEN bytes
+ *
+ * The offsets come packed like a gamma payload, but as sign and magnitude:
+ * V255 has 9 magnitude bits, the middle taps 7, and VT and V0 are unsigned
+ * nibbles.
+ */
+void s6e3ha9_dimming_unpack_mtp(struct s6e3ha9_dimming *dim, const u8 *mtp)
+{
+	static const s8 sign_bit[S6E3HA9_NR_TP] = {
+		-1, -1, 7, 7, 7, 7, 7, 7, 7, 7, 7, 9,
+	};
+	static const u16 value_mask[S6E3HA9_NR_TP] = {
+		0xf, 0xf, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x1ff,
+	};
+	unsigned int v, c, pos = 1;
+	s32 raw;
+
+	for (v = S6E3HA9_NR_TP - 1; v > 1; v--) {
+		for (c = 0; c < 3; c++) {
+			if (v == S6E3HA9_NR_TP - 1)
+				dim->mtp[v][c] = ((mtp[0] >> ((2 - c) * 2)) & 0x3) << 8 |
+						 mtp[pos++];
+			else
+				dim->mtp[v][c] = mtp[pos++];
+		}
+	}
+
+	dim->mtp[1][0] = (mtp[pos] >> 4) & 0xf;
+	dim->mtp[1][1] = mtp[pos] & 0xf;
+	dim->mtp[1][2] = (mtp[pos + 1] >> 4) & 0xf;
+	dim->mtp[0][0] = mtp[pos + 1] & 0xf;
+	dim->mtp[0][1] = (mtp[pos + 2] >> 4) & 0xf;
+	dim->mtp[0][2] = mtp[pos + 2] & 0xf;
+
+	/* sign and magnitude to two's complement */
+	for (v = 0; v < S6E3HA9_NR_TP; v++) {
+		for (c = 0; c < 3; c++) {
+			raw = dim->mtp[v][c];
+
+			if (sign_bit[v] < 0)
+				continue;
+
+			dim->mtp[v][c] = (raw & BIT(sign_bit[v])) ?
+				-(raw & value_mask[v]) : (raw & value_mask[v]);
+		}
+	}
+}
+
+/**
+ * s6e3ha9_dimming_process - build the gamma payloads for every level
+ * @dim: dimming state, with the MTP offsets already filled in
+ *
+ * The tap voltages are reconstructed first, in the order the later taps
+ * depend on: VT, then V255 down to V0.
+ */
+void s6e3ha9_dimming_process(struct s6e3ha9_dimming *dim)
+{
+	static const int vout_order[S6E3HA9_NR_TP] = {
+		TP_VT, 11, 10, 9, 8, 7, 6, 5, 4, 3, 2, TP_V0,
+	};
+	int i, v, c, ilum;
+
+	for (i = 0; i < S6E3HA9_NR_TP; i++) {
+		v = vout_order[i];
+
+		for (c = 0; c < 3; c++) {
+			dim->vout[v][c] = s6e3ha9_tp_vout(dim, v, c);
+			dim->gray_vout[s6e3ha9_tp[v].level][c] =
+				(v == TP_VT) ? S6E3HA9_VREGOUT : dim->vout[v][c];
+		}
+	}
+
+	s6e3ha9_build_gray_scale(dim);
+
+	for (ilum = 0; ilum < S6E3HA9_NR_LUMINANCE; ilum++) {
+		const struct s6e3ha9_dim_lut *lut = &s6e3ha9_dim_lut[ilum];
+		u64 lum255 = (u64)lut->base_luminance << S6E3HA9_BIT_SHIFT;
+		u8 *out = dim->gamma[ilum];
+		int gray;
+		u64 l;
+
+		/* target voltage of every tap at this level */
+		for (i = 0; i < S6E3HA9_NR_TP; i++) {
+			/* V255 first, it sets the scale for the rest */
+			v = (i == 0) ? TP_V255 : i - 1;
+
+			if (v == TP_V255)
+				l = lum255;
+			else if (v == TP_VT && lut->luminance < 251)
+				l = 0;
+			else
+				l = (lum255 * lut->curve[s6e3ha9_tp[v].level]) >>
+				    S6E3HA9_BIT_SHIFT;
+
+			/*
+			 * Only an upper bound, as in the vendor
+			 * (dimming.c:1137-1142).  The offsets can be
+			 * negative, so in principle the sum could go below
+			 * zero; in this panel's tables the negative ones sit
+			 * only at a tap whose target luminance keeps the
+			 * index near 200, so the case does not arise.
+			 * Bounding it here would diverge from the engine this
+			 * is compared against.
+			 */
+			if (s6e3ha9_tp[v].level <= 1)
+				gray = s6e3ha9_tp[v].level;
+			else
+				gray = min(s6e3ha9_find_gray(dim, l) + lut->rtbl[v],
+					   255);
+
+			for (c = 0; c < 3; c++)
+				dim->lum_vout[v][c] = (v == TP_VT) ?
+					dim->vout[TP_VT][c] : dim->gray_vout[gray][c];
+		}
+
+		/* and back to register values, again in dependency order */
+		memset(out, 0, S6E3HA9_GAMMA_LEN);
+		for (i = 0; i < S6E3HA9_NR_TP; i++) {
+			v = vout_order[i];
+
+			for (c = 0; c < 3; c++) {
+				s32 center = (v == TP_VT || v == TP_V0) ?
+					s6e3ha9_tp[v].center[c] :
+					s6e3ha9_tp_center(dim, ilum, v, c);
+
+				s6e3ha9_pack(out, center, v, c);
+			}
+		}
+	}
+}
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha9-dimming.h b/drivers/gpu/drm/panel/panel-samsung-s6e3ha9-dimming.h
