+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * AID dimming for the Samsung S6E3HA9 DDIC.
+ *
+ * Copyright (C) 2026 Artur Szafraniec <ganggg111@gmail.com>
+ */
+
+#ifndef __PANEL_SAMSUNG_S6E3HA9_DIMMING_H__
+#define __PANEL_SAMSUNG_S6E3HA9_DIMMING_H__
+
+#include <linux/types.h>
+
+#define S6E3HA9_NR_TP		12
+#define S6E3HA9_NR_LUMINANCE	74
+/* payload of the gamma command (0xca), without the command byte */
+#define S6E3HA9_GAMMA_LEN	34
+/* the panel returns its MTP offsets in the same packing */
+#define S6E3HA9_MTP_LEN		S6E3HA9_GAMMA_LEN
+
+struct s6e3ha9_dimming {
+	s32 mtp[S6E3HA9_NR_TP][3];
+	s64 vout[S6E3HA9_NR_TP][3];
+	s64 lum_vout[S6E3HA9_NR_TP][3];
+	s64 gray_vout[256][3];
+	u64 gray_gamma[256];
+	u8 gamma[S6E3HA9_NR_LUMINANCE][S6E3HA9_GAMMA_LEN];
+};
+
+void s6e3ha9_dimming_unpack_mtp(struct s6e3ha9_dimming *dim, const u8 *mtp);
+void s6e3ha9_dimming_process(struct s6e3ha9_dimming *dim);
+
+#endif /* __PANEL_SAMSUNG_S6E3HA9_DIMMING_H__ */
