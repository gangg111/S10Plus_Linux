+	struct s6e3ha9_dimming dim;
+	bool gamma_valid;
 };
 
 /*
@@ -78,9 +88,9 @@ static inline struct s6e3ha9 *to_s6e3ha9(struct drm_panel *panel)
  * s6e3ha9_beyond2_a3_s0_panel_dimming.h (brightness and luminance steps),
  * for the room temperature (OVER_ZERO) slice.
  *
- * The per level gamma curve that the vendor computes from the panel's MTP
- * data is not implemented; the panel keeps the gamma programmed at power on,
- * so the luminance of a given step will not match the nits column exactly.
+ * The per level gamma curve that goes with these rows is computed from the
+ * panel's own MTP data by s6e3ha9_dimming_process() and sent alongside them,
+ * see s6e3ha9_read_mtp().
  */
 static const struct s6e3ha9_brightness {
 	u16 brightness;	/* platform brightness this row starts at */
@@ -165,22 +175,66 @@ static const struct s6e3ha9_brightness {
 	{ 255, 420, { 0x00, 0x14 }, 0x16, 0x23 },
 };
 
+/*
+ * The row index of this table is also the luminance step index of the dimming
+ * engine, so the two have to stay the same length: gamma[] is the last member
+ * of struct s6e3ha9_dimming, and one extra row here would read past it and send
+ * whatever follows to the panel as the 0xca payload.
+ */
+static_assert(ARRAY_SIZE(s6e3ha9_brightness_table) == S6E3HA9_NR_LUMINANCE);
+
 #define S6E3HA9_MAX_BRIGHTNESS	255
 
+/*
+ * The vendor computes the gamma curve of every luminance step from the MTP
+ * offsets burnt into the panel and reads them back with DCS 0xc8, 34 bytes
+ * (S6E3HA9_MTP_REG / S6E3HA9_MTP_OFS / S6E3HA9_MTP_LEN, vendor s6e3ha9.h:39-41).
+ * The data is one time programmed, so a single read per power on is enough.
+ *
+ * A panel that does not answer the read keeps the gamma it powers up with:
+ * brightness stays monotonic through AOR, ELVSS and VINT, only the photometric
+ * calibration of each step is lost.  That is a degradation, not a failure, so
+ * the read error is not propagated.
+ */
+static void s6e3ha9_read_mtp(struct s6e3ha9 *priv)
+{
+	u8 mtp[S6E3HA9_MTP_LEN];
