From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Thu, 24 Sep 2026 17:50:35 +0200
Subject: [PATCH] arm64: dts: exynos: exynos9820: Add GPU DVFS through ACPM

Give the GPU an OPP table, so panfrost can scale it through devfreq, and
let the GPU thermal zone throttle it.

The levels are the nine the vendor gives its GPU, 156 to 702 MHz, at the
frequencies the DVFS firmware keeps for them; the firmware also has 100,
598 and 676 MHz, which the vendor does not use.  The firmware sets the
voltage of each level.  A request goes through the same ACPM clock as
before: moving the GPU from 156 to 325 MHz by hand made glmark2 texture
at 1440x3040 go from 404 to 767 frames per second, and back to 403 at
156 MHz.

The GPU zone gets the passive trip the CPU clusters have, 85 C, below
the 88 C at which the vendor starts to control the GPU.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 arch/arm64/boot/dts/exynos/exynos9820.dtsi | 73 ++++++++++++++++++++--
 1 file changed, 67 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos9820.dtsi b/arch/arm64/boot/dts/exynos/exynos9820.dtsi
index 2d7d2007c0b..c6724eb08a0 100644
--- a/arch/arm64/boot/dts/exynos/exynos9820.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9820.dtsi
@@ -956,8 +956,8 @@ hsi2c45: i2c@15d60000 {
 		/*
 		 * A Mali-G76 MP12: GPU_ID reads 0x72110000 and SHADER_PRESENT
 		 * 0x00770077 on this phone.  The firmware on the APM owns its clock
-		 * and voltage, and with no operating points the GPU stays at the
-		 * level the firmware starts it at.  The power domain is left out:
+		 * and voltage; panfrost picks the level through devfreq and the GPU
+		 * thermal zone throttles it.  The power domain is left out:
 		 * the bootloader leaves it on, and the vendor saves and restores
 		 * the TrustZone setup of the block with an SMC around every power
 		 * cycle, which the power domain driver does not do.
@@ -970,6 +970,8 @@ gpu: gpu@18500000 {
 				     <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "job", "mmu", "gpu";
 			clocks = <&acpm_ipc EXYNOS9820_CLK_ACPM_DVFS_G3D>;
+			operating-points-v2 = <&gpu_opp_table>;
+			#cooling-cells = <2>;
 		};
 
 		pinctrl_aud: pinctrl@18c60000 {
@@ -1471,10 +1473,55 @@ opp-2080000000 {
 	};
 
 	/*
-	 * Each CPU cluster is throttled through cpufreq from 85 C on.  The
-	 * critical trip stays 15 C below the hardware trip of the TMU, so the
-	 * kernel powers the phone off in order before the TMU removes the power;
-	 * the GPU and ISP zones have nothing to throttle yet.
+	 * The levels the vendor gives the GPU, at the frequencies the DVFS
+	 * firmware keeps for them.  The firmware sets the voltage of a level
+	 * itself.
+	 */
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		opp-156000000 {
+			opp-hz = /bits/ 64 <156000000>;
+		};
+
+		opp-200000000 {
+			opp-hz = /bits/ 64 <200000000>;
+		};
+
+		opp-260000000 {
+			opp-hz = /bits/ 64 <260000000>;
+		};
+
+		opp-325000000 {
+			opp-hz = /bits/ 64 <325000000>;
+		};
+
+		opp-377000000 {
+			opp-hz = /bits/ 64 <377000000>;
+		};
+
+		opp-433000000 {
+			opp-hz = /bits/ 64 <433000000>;
+		};
+
+		opp-572000000 {
+			opp-hz = /bits/ 64 <572000000>;
+		};
+
+		opp-650000000 {
+			opp-hz = /bits/ 64 <650000000>;
+		};
+
+		opp-702000000 {
+			opp-hz = /bits/ 64 <702000000>;
+		};
+	};
+
+	/*
+	 * Each CPU cluster is throttled through cpufreq and the GPU through
+	 * devfreq from 85 C on.  The critical trip stays 15 C below the hardware
+	 * trip of the TMU, so the kernel powers the phone off in order before the
+	 * TMU removes the power; the ISP zone has nothing to throttle yet.
 	 */
 	thermal-zones {
 		big-thermal {
@@ -1506,16 +1553,30 @@ map0 {
 		};
 
 		gpu-thermal {
+			polling-delay-passive = <100>;
 			polling-delay = <1000>;
 			thermal-sensors = <&tmu_sub 3>;
 
 			trips {
+				gpu_alert: gpu-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				gpu-critical {
 					temperature = <100000>;
 					hysteresis = <0>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&gpu_alert>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		isp-thermal {
