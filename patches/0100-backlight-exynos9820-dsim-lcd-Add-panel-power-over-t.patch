 drivers/video/backlight/Kconfig               |  15 +
 drivers/video/backlight/Makefile              |   1 +
 drivers/video/backlight/exynos9820-dsim-lcd.c | 295 ++++++++++++++++++
 5 files changed, 320 insertions(+)
