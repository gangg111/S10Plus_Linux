@@ -128,6 +128,21 @@ config LCD_OTM3225A
 	  If you have a panel based on the OTM3225A controller
 	  chip then say y to include a driver for it.
 
+config LCD_EXYNOS9820_DSIM
+	bool "Exynos9820 panel power over the boot-loader DSI link"
+	depends on LCD_CLASS_DEVICE=y
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	depends on OF && HAS_IOMEM && COMMON_CLK
+	depends on !DRM_EXYNOS_DSI
+	help
+	  Say Y to turn the panel picture off and on with fb blanking while
+	  an Exynos9820 board shows the simple-framebuffer the boot loader
+	  left, with DSIM0 still running as the boot loader set it up.
+	  Without it, blanking only paints that framebuffer black.
+
+	  The DSI driver of the SoC takes the link over for good, so this
+	  is only offered without it.
+
 endif # LCD_CLASS_DEVICE
 
