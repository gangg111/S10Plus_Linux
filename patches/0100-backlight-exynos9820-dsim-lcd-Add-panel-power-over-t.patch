diff --git a/drivers/gpu/drm/exynos/exynos9820_regs.h b/drivers/gpu/drm/exynos/exynos9820_regs.h
index fe393d7d582..88576a2d512 100644
--- a/drivers/gpu/drm/exynos/exynos9820_regs.h
+++ b/drivers/gpu/drm/exynos/exynos9820_regs.h
@@ -337,7 +337,10 @@
 #define DSIM_INTSRC_PLL_STABLE			BIT(31)
 #define DSIM_INTSRC_SFR_PL_FIFO_EMPTY		BIT(29)
 #define DSIM_INTSRC_SFR_PH_FIFO_EMPTY		BIT(28)
+#define DSIM_INTSRC_SFR_PH_FIFO_OVERFLOW	BIT(27)
 #define DSIM_INTSRC_FRAME_DONE			BIT(24)
+#define DSIM_INTSRC_INVALID_SFR_VALUE		BIT(23)
+#define DSIM_INTSRC_ABNRMAL_CMD_ST		BIT(22)
 #define DSIM_INTSRC_RX_DATA_DONE		BIT(18)
 
 #define DSIM_INTMSK				0x0054
@@ -346,11 +349,14 @@
 #define DSIM_PKTHDR_DATA1(x)			((x) << 16)
 #define DSIM_PKTHDR_DATA0(x)			((x) << 8)
 #define DSIM_PKTHDR_ID(x)			((x) << 0)
+#define DSIM_PKTHDR_DATA			(0x1ffffff << 0)
 #define DSIM_PAYLOAD				0x005c
 #define DSIM_RXFIFO				0x0060
 
 #define DSIM_FIFOCTRL				0x0068
+#define DSIM_FIFOCTRL_NUMBER_OF_PH_SFR_GET(x)	(((x) >> 16) & 0x3f)
 #define DSIM_FIFOCTRL_EMPTY_RX			BIT(12)
+#define DSIM_FIFOCTRL_EMPTY_PH_SFR		BIT(10)
 
 #define DSIM_CMD_CONFIG				0x0080
 #define DSIM_CMD_CONFIG_PKT_GO_EN		BIT(16)
@@ -362,6 +368,8 @@
 #define DSIM_CMD_TE_CTRL1_TIME_TE_PROTECT_ON(x)	((x) << 16)
 #define DSIM_CMD_TE_CTRL1_TIME_TE_TOUT(x)	((x) << 0)
 
+#define DSIM_CMD_STATUS				0x008c
+
 /* DSIM D-PHY (M4S0 block, second reg range of the dsim node) */
 
 #define DSIM_PHY_BIAS_CON(i)			(0x0000 + 4 * (i))
