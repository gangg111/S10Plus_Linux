From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Mon, 21 Sep 2026 21:54:49 +0200
Subject: [PATCH] dt-bindings: mfd: Add the Samsung S2MPS19 PMIC

The main PMIC of the Exynos9820 line.  Twelve bucks, a buck boost and
twenty seven LDOs, of which LDO13M and LDO14M are left out: no board
wires them, so the vendor driver carries no voltage range for them and
neither can this.

The node belongs under the ACPM firmware rather than under a bus, because
the chip answers on a SPEEDY link of that firmware and not on any bus the
CPU can reach.  This is also what the vendor device tree of the Galaxy S10
describes, where the node sits on its own and carries acpm-ipc-channel
and acpm-speedy-channel instead of a reg property.  The pmic-1 child of
the ACPM schema therefore takes a second compatible.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../firmware/google,gs101-acpm-ipc.yaml       |  4 +-
 .../bindings/mfd/samsung,s2mps19-pmic.yaml    | 65 +++++++++++++++++++
 .../regulator/samsung,s2mps19-regulator.yaml  | 55 ++++++++++++++++
 3 files changed, 123 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/mfd/samsung,s2mps19-pmic.yaml
 create mode 100644 Documentation/devicetree/bindings/regulator/samsung,s2mps19-regulator.yaml

diff --git a/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml b/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
index c0854b3cd69..ede13aed0d4 100644
--- a/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
+++ b/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
@@ -55,7 +55,9 @@ properties:
 
     properties:
       compatible:
-        const: samsung,s2mpg10-pmic
+        enum:
+          - samsung,s2mpg10-pmic
+          - samsung,s2mps19-pmic
 
   pmic-2:
     description: Child node describing the sub PMIC.
diff --git a/Documentation/devicetree/bindings/mfd/samsung,s2mps19-pmic.yaml b/Documentation/devicetree/bindings/mfd/samsung,s2mps19-pmic.yaml
new file mode 100644
index 00000000000..0d7031d1718
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/samsung,s2mps19-pmic.yaml
@@ -0,0 +1,65 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/samsung,s2mps19-pmic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPS19 Power Management IC
+
+maintainers:
+  - Krzysztof Kozlowski <krzk@kernel.org>
+
+description: |
+  This is part of the device tree bindings for the S2MPS19 Power Management IC
+  (PMIC).
+
+  The Samsung S2MPS19 is the main Power Management IC of the Exynos 9820 line
+  of mobile SoCs. It carries twelve buck converters, a buck boost converter and
+  twenty seven LDOs.
+
+  Unlike the older members of this family, the chip does not answer on a bus of
+  the CPU. It hangs off a SPEEDY link of the Active Power Management firmware,
+  and the kernel reaches its registers by asking that firmware over the ACPM
+  mailbox, which is why the node belongs under the ACPM firmware node.
+
+properties:
+  compatible:
+    const: samsung,s2mps19-pmic
+
+  interrupts:
+    maxItems: 1
+
+  regulators:
+    type: object
+    $ref: /schemas/regulator/samsung,s2mps19-regulator.yaml
+    description:
+      List of child nodes that specify the regulators.
+
+  wakeup-source: true
+
+required:
+  - compatible
+  - interrupts
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    pmic-1 {
+        compatible = "samsung,s2mps19-pmic";
+        interrupts-extended = <&gpa0 1 IRQ_TYPE_LEVEL_LOW>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&pmic_int>;
+        wakeup-source;
+
+        regulators {
+            LDO19M {
+                regulator-name = "tsp_io";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/regulator/samsung,s2mps19-regulator.yaml b/Documentation/devicetree/bindings/regulator/samsung,s2mps19-regulator.yaml
new file mode 100644
index 00000000000..874562cfd45
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/samsung,s2mps19-regulator.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/samsung,s2mps19-regulator.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPS19 Power Management IC regulators
+
+maintainers:
+  - Krzysztof Kozlowski <krzk@kernel.org>
+
+description: |
+  This is a part of device tree bindings for S2M and S5M family of Power
+  Management IC (PMIC).
+
+  The S2MPS19 provides buck, buck boost and LDO regulators.
+
+  See also Documentation/devicetree/bindings/mfd/samsung,s2mps19-pmic.yaml for
+  additional information and example.
+
+properties:
+  BBM:
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description:
+      Properties for the buck boost regulator.
+
+    required:
+      - regulator-name
+
+patternProperties:
+  # 27 LDOs, without LDO13 and LDO14
+  "^LDO([1-9]|1[0-2]|1[5-9]|2[0-9])M$":
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description:
+      Properties for single LDO regulator.
+
+    required:
+      - regulator-name
+
+  # 12 bucks
+  "^BUCK([1-9]|1[0-2])M$":
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description:
+      Properties for single BUCK regulator.
+
+    required:
+      - regulator-name
+
+additionalProperties: false
