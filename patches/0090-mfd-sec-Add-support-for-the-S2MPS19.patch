 };
 
+static const struct mfd_cell s2mps19_devs[] = {
+	MFD_CELL_NAME("s2mps19-regulator"),
+};
+
 static const struct resource s2mpu05_rtc_resources[] = {
 	DEFINE_RES_IRQ_NAMED(S2MPU05_IRQ_RTCA0, "alarm"),
 };
@@ -125,7 +129,8 @@ static void sec_pmic_dump_rev(struct sec_pmic_dev *sec_pmic)
 	switch (sec_pmic->device_type) {
 	case S2MPG10:
 	case S2MPG11:
-		/* For s2mpg1x, the revision is in a different regmap */
+	case S2MPS19X:
+		/* For s2mpg1x and s2mps19, the revision is in a different regmap */
 		return;
 	case S2MU005:
 		reg = S2MU005_REG_ID;
@@ -263,6 +268,10 @@ int sec_pmic_probe(struct device *dev, int device_type, unsigned int irq,
 		sec_devs = s2mps15_devs;
 		num_sec_devs = ARRAY_SIZE(s2mps15_devs);
 		break;
+	case S2MPS19X:
+		sec_devs = s2mps19_devs;
+		num_sec_devs = ARRAY_SIZE(s2mps19_devs);
+		break;
 	case S2MPU02:
 		sec_devs = s2mpu02_devs;
 		num_sec_devs = ARRAY_SIZE(s2mpu02_devs);
