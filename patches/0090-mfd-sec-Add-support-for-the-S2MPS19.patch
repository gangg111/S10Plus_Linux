From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Mon, 21 Sep 2026 21:54:50 +0200
Subject: [PATCH] mfd: sec: Add support for the S2MPS19

The main PMIC of the Exynos9820 line, and the reason the touchscreen of a
Galaxy S10 has no power under mainline: both of its rails come from LDOs
of this chip.

Nothing has to be added below this driver.  The chip is reached with the
very same ACPM command this driver already sends to the PMICs of Tensor:
the vendor packs channel into bits 15:12, bank into 11:8 and register into
7:0 of the first word and the function code into the second, which is
field for field what exynos-acpm-pmic.c builds, and its function codes are
in the same order (acpm_mfd.h:19-60, acpm_mfd.c:19-61).  So this is a
register map, an interrupt layout and two platform numbers.

Both numbers come from the vendor device tree of the phone, whose node for
this chip carries acpm-ipc-channel = <2> and acpm-speedy-channel = <0>.
They happen to be the ones the main PMIC of Tensor uses.

Three things differ from the S2MPG1x and shape the code:

 - There are seven interrupt registers, not six, and their bits are taken
   from the vendor table rather than from the order of the names, because
   INT3 skips bit 4 (s2mps19_irq.c:59-118).

 - There is no meter bank.  The power meter of this chip lives in the PMIC
   bank behind the ADC registers at 0xbf, so the meter regmap becomes
   optional, as the RTC one already was.

 - Neither bank is cached.  The APM firmware drives the buck rails on its
   own while the kernel runs, so a cached voltage would go stale with
   nothing writing to it.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 drivers/mfd/Kconfig                 |   2 +-
 drivers/mfd/sec-acpm.c              | 119 +++++++++-
 drivers/mfd/sec-common.c            |  11 +-
 drivers/mfd/sec-irq.c               |  90 +++++++
 include/linux/mfd/samsung/core.h    |   1 +
 include/linux/mfd/samsung/s2mps19.h | 349 ++++++++++++++++++++++++++++
 6 files changed, 566 insertions(+), 6 deletions(-)
 create mode 100644 include/linux/mfd/samsung/s2mps19.h

diff --git a/drivers/mfd/Kconfig b/drivers/mfd/Kconfig
index 763ce6a3478..65941c3774e 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -1423,7 +1423,7 @@ config MFD_SEC_CORE
 	select REGMAP_IRQ
 
 config MFD_SEC_ACPM
-	tristate "Samsung Electronics S2MPG1x PMICs"
+	tristate "Samsung Electronics S2MPG1x and S2MPS19 PMICs"
 	depends on EXYNOS_ACPM_PROTOCOL
 	depends on OF
 	select MFD_SEC_CORE
diff --git a/drivers/mfd/sec-acpm.c b/drivers/mfd/sec-acpm.c
index d11fbf5b94b..3c3e74471aa 100644
--- a/drivers/mfd/sec-acpm.c
+++ b/drivers/mfd/sec-acpm.c
@@ -14,6 +14,7 @@
 #include <linux/mfd/samsung/rtc.h>
 #include <linux/mfd/samsung/s2mpg10.h>
 #include <linux/mfd/samsung/s2mpg11.h>
+#include <linux/mfd/samsung/s2mps19.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -365,6 +366,99 @@ static const struct regmap_config s2mpg11_regmap_config_meter = {
 	.cache_type = REGCACHE_FLAT,
 };
 
+static const struct regmap_range s2mps19_common_registers[] = {
+	regmap_reg_range(0x00, 0x02), /* CHIPID, INT, INT_MASK */
+};
+
+static const struct regmap_range s2mps19_common_ro_registers[] = {
+	regmap_reg_range(0x00, 0x01), /* CHIPID, INT */
+};
+
+static const struct regmap_range s2mps19_common_precious_registers[] = {
+	regmap_reg_range(0x01, 0x01), /* INT */
+};
+
+static const struct regmap_access_table s2mps19_common_wr_table = {
+	.yes_ranges = s2mps19_common_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps19_common_registers),
+	.no_ranges = s2mps19_common_ro_registers,
+	.n_no_ranges = ARRAY_SIZE(s2mps19_common_ro_registers),
+};
+
+static const struct regmap_access_table s2mps19_common_rd_table = {
+	.yes_ranges = s2mps19_common_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps19_common_registers),
+};
+
+static const struct regmap_access_table s2mps19_common_precious_table = {
+	.yes_ranges = s2mps19_common_precious_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps19_common_precious_registers),
+};
+
+/*
+ * Neither bank is cached.  The APM firmware drives the buck rails of this
+ * chip on its own while the kernel runs, so a cached voltage would go stale
+ * without anything writing to it, and the interrupt registers clear on read.
+ */
+static const struct regmap_config s2mps19_regmap_config_common = {
+	.name = "common",
+	.reg_bits = ACPM_ADDR_BITS,
+	.val_bits = 8,
+	.max_register = S2MPS19_COMMON_INT_MASK,
+	.wr_table = &s2mps19_common_wr_table,
+	.rd_table = &s2mps19_common_rd_table,
+	.precious_table = &s2mps19_common_precious_table,
+	.cache_type = REGCACHE_NONE,
+};
+
+static const struct regmap_range s2mps19_pmic_registers[] = {
+	regmap_reg_range(0x00, 0x16), /* INTx, INTxM, STATUSx, PWRONSRC, CTRLx */
+	regmap_reg_range(0x1d, 0x3e), /* Bucks, buck boost, ramp rates */
+	regmap_reg_range(0x46, 0x62), /* LDO1M .. LDO29M */
+	regmap_reg_range(0xa4, 0xa5), /* PWREN_SEL */
+	regmap_reg_range(0xa9, 0xad), /* Over current warning */
+	regmap_reg_range(0xb1, 0xbb), /* Over current protection */
+	regmap_reg_range(0xbf, 0xc2), /* ADC */
+};
+
+static const struct regmap_range s2mps19_pmic_ro_registers[] = {
+	regmap_reg_range(0x00, 0x06), /* INTx */
+	regmap_reg_range(0x0e, 0x11), /* STATUSx PWRONSRC OFFSRC */
+	regmap_reg_range(0xc2, 0xc2), /* ADC data */
+};
+
+static const struct regmap_range s2mps19_pmic_precious_registers[] = {
+	regmap_reg_range(0x00, 0x06), /* INTx */
+};
+
+static const struct regmap_access_table s2mps19_pmic_wr_table = {
+	.yes_ranges = s2mps19_pmic_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps19_pmic_registers),
+	.no_ranges = s2mps19_pmic_ro_registers,
+	.n_no_ranges = ARRAY_SIZE(s2mps19_pmic_ro_registers),
+};
+
+static const struct regmap_access_table s2mps19_pmic_rd_table = {
+	.yes_ranges = s2mps19_pmic_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps19_pmic_registers),
+};
+
+static const struct regmap_access_table s2mps19_pmic_precious_table = {
+	.yes_ranges = s2mps19_pmic_precious_registers,
+	.n_yes_ranges = ARRAY_SIZE(s2mps19_pmic_precious_registers),
+};
+
+static const struct regmap_config s2mps19_regmap_config_pmic = {
+	.name = "pmic",
+	.reg_bits = ACPM_ADDR_BITS,
+	.val_bits = 8,
+	.max_register = S2MPS19_PMIC_ADC_DATA,
+	.wr_table = &s2mps19_pmic_wr_table,
+	.rd_table = &s2mps19_pmic_rd_table,
+	.precious_table = &s2mps19_pmic_precious_table,
+	.cache_type = REGCACHE_NONE,
+};
+
 struct sec_pmic_acpm_shared_bus_context {
 	struct acpm_handle *acpm;
 	unsigned int acpm_chan_id;
@@ -520,10 +614,13 @@ static int sec_pmic_acpm_probe(struct platform_device *pdev)
 			return PTR_ERR(regmap);
 	}
 
-	regmap = sec_pmic_acpm_regmap_init(dev, shared_ctx, SEC_PMIC_ACPM_ACCESSTYPE_METER,
-					   pdata->regmap_cfg_meter, true);
-	if (IS_ERR(regmap))
-		return PTR_ERR(regmap);
+	if (pdata->regmap_cfg_meter) {
+		regmap = sec_pmic_acpm_regmap_init(dev, shared_ctx,
+						   SEC_PMIC_ACPM_ACCESSTYPE_METER,
+						   pdata->regmap_cfg_meter, true);
+		if (IS_ERR(regmap))
+			return PTR_ERR(regmap);
+	}
 
 	ret = sec_pmic_probe(dev, pdata->device_type, irq, regmap_pmic, NULL);
 	if (ret)
@@ -559,9 +656,23 @@ static const struct sec_pmic_acpm_platform_data s2mpg11_data = {
 	.regmap_cfg_meter = &s2mpg11_regmap_config_meter,
 };
 
+/*
+ * Both numbers come from the vendor device tree of the Galaxy S10, where the
+ * node of this chip carries acpm-ipc-channel = <2> and acpm-speedy-channel
+ * = <0>.  They happen to match the main PMIC of Tensor.
+ */
+static const struct sec_pmic_acpm_platform_data s2mps19_data = {
+	.device_type = S2MPS19X,
+	.acpm_chan_id = 2,
+	.speedy_channel = 0,
+	.regmap_cfg_common = &s2mps19_regmap_config_common,
+	.regmap_cfg_pmic = &s2mps19_regmap_config_pmic,
+};
+
 static const struct of_device_id sec_pmic_acpm_of_match[] = {
 	{ .compatible = "samsung,s2mpg10-pmic", .data = &s2mpg10_data, },
 	{ .compatible = "samsung,s2mpg11-pmic", .data = &s2mpg11_data, },
+	{ .compatible = "samsung,s2mps19-pmic", .data = &s2mps19_data, },
 	{ },
 };
 MODULE_DEVICE_TABLE(of, sec_pmic_acpm_of_match);
diff --git a/drivers/mfd/sec-common.c b/drivers/mfd/sec-common.c
index fe92bc4a3dd..995b96e3367 100644
--- a/drivers/mfd/sec-common.c
+++ b/drivers/mfd/sec-common.c
@@ -97,6 +97,10 @@ static const struct mfd_cell s2mpu02_devs[] = {
