--- /dev/null
+++ b/include/linux/mfd/samsung/s2mps19.h
@@ -0,0 +1,349 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2018 Samsung Electronics Co., Ltd.
+ */
+
+#ifndef __LINUX_MFD_S2MPS19_H
+#define __LINUX_MFD_S2MPS19_H
+
+/* Common registers (type 0x000) */
+enum s2mps19_common_reg {
+	S2MPS19_COMMON_CHIPID,
+	S2MPS19_COMMON_INT,
+	S2MPS19_COMMON_INT_MASK,
+};
+
+/* For S2MPS19_COMMON_INT and S2MPS19_COMMON_INT_MASK */
+#define S2MPS19_COMMON_INT_SRC		GENMASK(7, 0)
+#define S2MPS19_COMMON_INT_SRC_PMIC	BIT(0)
+
+/* PMIC registers (type 0x100) */
+enum s2mps19_pmic_reg {
+	S2MPS19_PMIC_INT1,
