 sound/soc/samsung/Kconfig           |  10 +
 sound/soc/samsung/Makefile          |   2 +
 sound/soc/samsung/exynos9820-abox.c | 711 ++++++++++++++++++++++++++++
 4 files changed, 724 insertions(+)
 create mode 100644 sound/soc/samsung/exynos9820-abox.c

