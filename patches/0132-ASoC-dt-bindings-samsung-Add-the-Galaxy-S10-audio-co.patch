From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Fri, 25 Sep 2026 08:23:59 +0200
Subject: [PATCH] ASoC: dt-bindings: samsung: Add the Galaxy S10 audio complex

The speakers of the Galaxy S10 phones are two CS35L40 amplifiers on one
I2S port of the Exynos9820 ABOX, one driving the earpiece and one the
bottom loudspeaker. Each takes the channel given by its position in the
codec list, and hands its monitor data back in the slot of the same
channel when the port records.

The CS47L93 codec, which carries the two digital microphones, the
headset microphone and the headphone outputs, sits on a second port and
is described by an optional codec-link node.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../bindings/sound/samsung,beyond-audio.yaml  | 122 ++++++++++++++++++
 MAINTAINERS                                   |   1 +
 2 files changed, 123 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/samsung,beyond-audio.yaml

diff --git a/Documentation/devicetree/bindings/sound/samsung,beyond-audio.yaml b/Documentation/devicetree/bindings/sound/samsung,beyond-audio.yaml
new file mode 100644
index 00000000000..7d1e3cc09ef
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/samsung,beyond-audio.yaml
@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/samsung,beyond-audio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Galaxy S10 family audio complex
+
+maintainers:
+  - Artur Szafraniec <ganggg111@gmail.com>
+
+description: |
+  The speakers of the Galaxy S10 phones: two CS35L40 amplifiers on one I2S
+  port of the Exynos9820 ABOX, one driving the earpiece and one the bottom
+  loudspeaker. Each amplifier takes its own channel of the stereo stream,
+  and when the port records, each hands back its monitor data in the slot
+  of its own channel.
+
+  The CS47L93 audio codec, with the microphones and the headset jack, sits
+  on a second ABOX port and is described by the optional codec-link node.
+
+  The card provides the widgets "Receiver" and "Speaker" (speakers),
+  "Headphone" (headphones), "Headset Mic" and "DMIC1", "DMIC2"
+  (microphones), which audio-routing connects to the amplifiers and the
+  codec.
+
+allOf:
+  - $ref: sound-card-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,beyond-audio
+
+  cpu:
+    type: object
+    additionalProperties: false
+    properties:
+      sound-dai:
+        maxItems: 1
+        description: phandle to the ABOX UAIF port the amplifiers sit on
+    required:
+      - sound-dai
+
+  codec:
+    type: object
+    additionalProperties: false
+    properties:
+      sound-dai:
+        minItems: 1
+        maxItems: 2
+        description:
+          phandles to the amplifiers, in channel order; the first takes
+          the left channel and slot 0, the second the right channel and
+          slot 1
+    required:
+      - sound-dai
+
+  codec-link:
+    type: object
+    additionalProperties: false
+    description: the audio codec on its own ABOX port
+    properties:
+      cpu:
+        type: object
+        additionalProperties: false
+        properties:
+          sound-dai:
+            maxItems: 1
+            description: phandle to the ABOX UAIF port the codec sits on
+        required:
+          - sound-dai
+
+      codec:
+        type: object
+        additionalProperties: false
+        properties:
+          sound-dai:
+            maxItems: 1
+            description: phandle to the audio interface of the codec
+        required:
+          - sound-dai
+
+    required:
+      - cpu
+      - codec
+
+required:
+  - compatible
+  - cpu
+  - codec
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    sound {
+        compatible = "samsung,beyond-audio";
+        model = "Samsung Galaxy S10+";
+
+        audio-routing = "Receiver", "Top SPK",
+                        "Speaker", "Bottom SPK",
+                        "DMIC1", "MICBIAS1A", "IN1ARN", "DMIC1",
+                        "Headphone", "HPOUT2L", "Headphone", "HPOUT2R";
+
+        cpu {
+            sound-dai = <&abox 1>;
+        };
+
+        codec {
+            sound-dai = <&speaker_top 0>, <&speaker_bottom 0>;
+        };
+
+        codec-link {
+            cpu {
+                sound-dai = <&abox 0>;
+            };
+
+            codec {
+                sound-dai = <&audio_codec 0>;
+            };
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index 1a1a84d6b84..23fe045c62b 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -24003,6 +24003,7 @@ L:	linux-samsung-soc@vger.kernel.org
 S:	Maintained
 F:	Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
 F:	Documentation/devicetree/bindings/pci/samsung,exynos9820-pcie.yaml
+F:	Documentation/devicetree/bindings/sound/samsung,beyond-audio.yaml
