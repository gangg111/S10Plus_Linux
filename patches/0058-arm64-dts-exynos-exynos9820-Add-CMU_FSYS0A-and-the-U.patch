From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Sun, 20 Sep 2026 07:19:19 +0200
Subject: [PATCH] arm64: dts: exynos: exynos9820: Add CMU_FSYS0A and the USB
 controller

The clock controller of this domain has been in the driver since the clocks
went in, with its identifiers and its binding, and only the node was
missing.  It feeds both halves of what this commit adds: the USB controller
and the PHY in front of it.

The PHY is described with one of its three register windows.  The other two
belong to the SuperSpeed lanes and to the DisplayPort side of the same
block, which nothing here drives.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 arch/arm64/boot/dts/exynos/exynos9820.dtsi | 68 ++++++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9820.dtsi b/arch/arm64/boot/dts/exynos/exynos9820.dtsi
index 8010c66b352..792c936cde3 100644
--- a/arch/arm64/boot/dts/exynos/exynos9820.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9820.dtsi
@@ -358,6 +358,74 @@ pinctrl_peric1: pinctrl@10830000 {
 			interrupts = <GIC_SPI 407 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		cmu_fsys0a: clock-controller@10a00000 {
+			compatible = "samsung,exynos9820-cmu-fsys0a";
+			reg = <0x10a00000 0x8000>;
+			#clock-cells = <1>;
+
+			clocks = <&oscclk>,
+				 <&cmu_top CLK_DOUT_CMU_FSYS0A_BUS>,
+				 <&cmu_top CLK_DOUT_CMU_FSYS0A_USB31DRD>,
+				 <&cmu_top CLK_DOUT_CMU_FSYS0A_USBDP_DEBUG>;
+			clock-names = "oscclk", "bus", "usb31drd", "usbdp_debug";
+		};
+
+		/*
+		 * Only the USB 2.0 window of this PHY is described.  The vendor
+		 * gives the block three windows and calls it a combined PHY: the
+		 * other two carry the SuperSpeed lanes and the DisplayPort side,
+		 * and driving them needs calibration tables that are in none of
+		 * the sources this series is built from.  A port that enumerates
+		 * at high speed is worth more than a window nobody writes.
+		 */
+		usbdrd_phy: phy@10b00000 {
+			compatible = "samsung,exynos9820-usbdrd-phy";
+			reg = <0x10b00000 0x200>;
+			#phy-cells = <1>;
+
+			clocks = <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_ACLK_PHYCTRL>,
+				 <&oscclk>;
+			clock-names = "phy", "ref";
+
+			samsung,pmu-syscon = <&pmu_system_controller>;
+			status = "disabled";
+		};
+
+		usbdrd: usb@10c00000 {
+			compatible = "samsung,exynos9820-dwusb3",
+				     "samsung,exynos850-dwusb3";
+			ranges = <0x0 0x10c00000 0x10000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			clocks = <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_BUS_CLK_EARLY>,
+				 <&cmu_fsys0a CLK_GOUT_FSYS0A_USB31DRD_I_USB31DRD_REF_CLK_40>;
+			clock-names = "bus_early", "ref";
+			status = "disabled";
+
+			usbdrd_dwc3: usb@0 {
+				compatible = "snps,dwc3";
+				reg = <0x0 0x10000>;
+				interrupts = <GIC_SPI 241 IRQ_TYPE_LEVEL_HIGH>;
+				phys = <&usbdrd_phy 0>;
+				phy-names = "usb2-phy";
+				/*
+				 * A suspended PHY stops driving the line, and this
+				 * board has nothing to wake it up: the port runs as
+				 * a peripheral with no Type-C driver, so nothing
+				 * tells the controller that a cable is attached.
+				 * Measured on a Galaxy S10+: after a reboot, with
+				 * the cable never touched, the controller sits in
+				 * "not attached" and the host sees no device at all,
+				 * while unplugging and replugging brings it back.
+				 * The Exynos-derived port in tree, Google gs101,
+				 * disables the suspend for the same reason.
+				 */
+				snps,has-lpm-erratum;
+				snps,dis_u2_susphy_quirk;
+			};
+		};
+
 		pinctrl_fsys0: pinctrl@13030000 {
 			compatible = "samsung,exynos9820-pinctrl";
 			reg = <0x13030000 0x1000>;
