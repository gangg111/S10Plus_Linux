From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Sun, 27 Sep 2026 02:46:06 +0200
Subject: [PATCH 142/144] dt-bindings: iio: imu: Add the Broadcom BCM47752

The BCM47752 is a GNSS receiver with a Cortex-M4 sensor hub.  On the
Samsung Galaxy S10 family every motion and environment sensor sits
behind that hub, which the host reaches over SPI with a set of GPIO
lines around each transfer.

Describe the device with the lines, the two interrupts and the board
data the hub firmware needs: the mounting of the accelerometer and the
magnetometer, the magnetometer compensation matrix and the thermistor
tables.  The vendor tree names these with an "ssp-" prefix and no
vendor; here the handshake lines are plain GPIO properties and the
board data carries the brcm prefix.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../bindings/iio/imu/brcm,bcm47752.yaml       | 146 ++++++++++++++++++
 MAINTAINERS                                   |   1 +
 2 files changed, 147 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/iio/imu/brcm,bcm47752.yaml

diff --git a/Documentation/devicetree/bindings/iio/imu/brcm,bcm47752.yaml b/Documentation/devicetree/bindings/iio/imu/brcm,bcm47752.yaml
new file mode 100644
index 00000000000..be5d693eecf
--- /dev/null
+++ b/Documentation/devicetree/bindings/iio/imu/brcm,bcm47752.yaml
@@ -0,0 +1,146 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/imu/brcm,bcm47752.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Broadcom BCM47752 GNSS receiver and sensor hub
+
+maintainers:
+  - Artur Szafraniec <ganggg111@gmail.com>
+
+description: |
+  The BCM47752 is a GNSS receiver with a Cortex-M4 sensor hub.  On phones such
+  as the Samsung Galaxy S10 family every motion and environment sensor (the
+  accelerometer and gyroscope, the magnetometer, the barometer and the light
+  and proximity sensors) sits behind the hub, which the host reaches over SPI.
+  The host loads the hub firmware at start and exchanges framed messages with
+  it; a set of GPIO lines carries the handshake around each transfer.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: brcm,bcm47752
+
+  reg:
+    maxItems: 1
+
+  spi-cpha: true
+  spi-cpol: true
+
+  interrupts:
+    items:
+      - description: host request, the hub has data for the host
+      - description: sensor hub interrupt
+
+  interrupt-names:
+    items:
+      - const: host-req
+      - const: shub-int
+
+  host-req-gpios:
+    maxItems: 1
+    description: Input the hub raises when it has data for the host.
+
+  mcu-req-gpios:
+    maxItems: 1
+    description: Output the host raises to ask the hub for a transfer.
+
+  mcu-resp-gpios:
+    maxItems: 1
+    description: Input the hub answers a transfer request on.
+
+  batch-wake-gpios:
+    maxItems: 1
+    description: Output telling the hub that the host is asleep.
+
+  shub-int-gpios:
+    maxItems: 1
+    description: Interrupt input from the sensor hub.
+
+  gps-pwr-en-gpios:
+    maxItems: 1
+    description: Output holding the chip out of standby.
+
+  brcm,ap-type:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Host platform code the hub firmware expects.
+
+  brcm,acc-position:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 7
+    description: Mounting of the accelerometer, as one of eight axis layouts.
+
+  brcm,mag-position:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 7
+    description: Mounting of the magnetometer, as one of eight axis layouts.
+
+  brcm,mag-type:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Magnetometer calibration format, 1 for a byte matrix.
+
+  brcm,glass-type:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Cover glass variant, which sets the light sensor coefficients.
+
+  brcm,mag-array:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 27
+    maxItems: 27
+    description: Soft iron compensation matrix of the magnetometer.
+
+  brcm,thermi-up:
+    $ref: /schemas/types.yaml#/definitions/uint16-array
+    minItems: 23
+    maxItems: 23
+    description: ADC table of the upper board thermistor.
+
+  brcm,thermi-sub:
+    $ref: /schemas/types.yaml#/definitions/uint16-array
+    minItems: 23
+    maxItems: 23
+    description: ADC table of the lower board thermistor.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - host-req-gpios
+  - mcu-req-gpios
+  - mcu-resp-gpios
+  - gps-pwr-en-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensorhub@0 {
+            compatible = "brcm,bcm47752";
+            reg = <0>;
+            spi-max-frequency = <25000000>;
+            spi-cpol;
+            spi-cpha;
+
+            host-req-gpios = <&gpa1 7 GPIO_ACTIVE_HIGH>;
+            mcu-req-gpios = <&gpg4 1 GPIO_ACTIVE_HIGH>;
+            mcu-resp-gpios = <&gpg4 2 GPIO_ACTIVE_HIGH>;
+            gps-pwr-en-gpios = <&gpg0 2 GPIO_ACTIVE_HIGH>;
+
+            interrupts-extended = <&gpa1 7 IRQ_TYPE_LEVEL_HIGH>,
+                                  <&gpa4 0 IRQ_TYPE_EDGE_FALLING>;
+            interrupt-names = "host-req", "shub-int";
+
+            brcm,acc-position = <4>;
+        };
+    };
+...
