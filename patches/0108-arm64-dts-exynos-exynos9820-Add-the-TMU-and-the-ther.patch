From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Thu, 24 Sep 2026 00:40:03 +0200
Subject: [PATCH] arm64: dts: exynos: exynos9820: Add the TMU and the thermal
 zones

Describe the two blocks of the thermal management unit and the five
zones the firmware on the APM reports for them: the big, middle and
little CPU clusters on the TOP block, the GPU and the ISP on the SUB
block.

Nothing can be throttled yet, since there is neither cpufreq nor cpuidle
to act on, so each zone gets one critical trip.  It sits at 100 C, 15 C
below the hardware trip the bootloader arms in both blocks, which takes
the power away with no shutdown at all.  Twenty seconds of load on all
eight cores already raises the big cluster by 12 C at the clocks the
bootloader leaves, so the margin is what gives the kernel time to power
the phone off in order.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 arch/arm64/boot/dts/exynos/exynos9820.dtsi | 98 ++++++++++++++++++++++
 1 file changed, 98 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9820.dtsi b/arch/arm64/boot/dts/exynos/exynos9820.dtsi
index 87d954131b4..2f2a0145811 100644
--- a/arch/arm64/boot/dts/exynos/exynos9820.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9820.dtsi
@@ -271,6 +271,31 @@ timer@10040000 {
 				     <GIC_SPI 477 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		/*
+		 * The first of the two blocks of the thermal management unit, with
+		 * the probes of the three CPU clusters.  The firmware on the APM
+		 * owns them and answers for the zones over ACPM; the bootloader has
+		 * armed the hardware trip of the block at 115 C.
+		 */
+		tmu_top: thermal-sensor@10090000 {
+			compatible = "samsung,exynos9820-tmu-top";
+			reg = <0x10090000 0x800>;
+			interrupts = <GIC_SPI 478 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_peris CLK_GOUT_PERIS_TMU_TOP_PCLK>;
+			#thermal-sensor-cells = <1>;
+			samsung,acpm-ipc = <&acpm_ipc>;
+		};
+
+		/* The second block, with the probes of the GPU and the ISP. */
+		tmu_sub: thermal-sensor@100a0000 {
+			compatible = "samsung,exynos9820-tmu-sub";
+			reg = <0x100a0000 0x800>;
+			interrupts = <GIC_SPI 479 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_peris CLK_GOUT_PERIS_TMU_SUB_PCLK>;
+			#thermal-sensor-cells = <1>;
+			samsung,acpm-ipc = <&acpm_ipc>;
+		};
+
 		gic: interrupt-controller@10101000 {
 			compatible = "arm,gic-400";
 			#interrupt-cells = <3>;
@@ -1113,6 +1138,79 @@ acpm_ipc: power-management {
 		};
 	};
 
+	/*
+	 * Nothing can be throttled yet: without cpufreq or cpuidle there is no
+	 * cooling device.  What is left is a critical trip 15 C below the
+	 * hardware trip of the TMU, so the kernel powers the phone off in order
+	 * before the TMU removes the power.
+	 */
+	thermal-zones {
+		big-thermal {
+			polling-delay = <1000>;
+			thermal-sensors = <&tmu_top 0>;
+
+			trips {
+				big-critical {
+					temperature = <100000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		gpu-thermal {
+			polling-delay = <1000>;
+			thermal-sensors = <&tmu_sub 3>;
+
+			trips {
+				gpu-critical {
+					temperature = <100000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		isp-thermal {
+			polling-delay = <1000>;
+			thermal-sensors = <&tmu_sub 4>;
+
+			trips {
+				isp-critical {
+					temperature = <100000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		little-thermal {
+			polling-delay = <1000>;
+			thermal-sensors = <&tmu_top 2>;
+
+			trips {
+				little-critical {
+					temperature = <100000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		mid-thermal {
+			polling-delay = <1000>;
+			thermal-sensors = <&tmu_top 1>;
+
+			trips {
+				mid-critical {
+					temperature = <100000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+	};
+
 	timer {
 		compatible = "arm,armv8-timer";
 
