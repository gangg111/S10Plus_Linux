From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Sun, 20 Sep 2026 00:29:58 +0200
Subject: [PATCH] phy: samsung-ufs: Apply the power mode a calibration entry
 names

An entry of a calibration table carries a descriptor beside its value,
and the header spells out what goes in it: the power mode, the rate
series and the gear, each of which may be left as "any".  Nothing ever
read it.  Every table written so far leaves the descriptor at zero, so
nothing was lost, but a table that needs a register to take one value in
one gear and another value in another gear has no way to say so: both
entries are written in turn and the last one wins.

Read the descriptor and skip the entries it excludes.  The mode and the
series come from what the host asks for through set_mode, and the gear
from the value passed beside it, which was being discarded.

Tables that name nothing, which is all of them today, keep applying
always, so no existing SoC changes behaviour.

A fourth gear is added to the descriptor values while they are being put
to use, because the calibration a gear can select reaches that far.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 drivers/phy/samsung/phy-samsung-ufs.c | 47 +++++++++++++++++++++++++++
 drivers/phy/samsung/phy-samsung-ufs.h |  5 +++
 2 files changed, 52 insertions(+)

diff --git a/drivers/phy/samsung/phy-samsung-ufs.c b/drivers/phy/samsung/phy-samsung-ufs.c
index ee665f26c23..47a7f2916fd 100644
--- a/drivers/phy/samsung/phy-samsung-ufs.c
+++ b/drivers/phy/samsung/phy-samsung-ufs.c
@@ -73,6 +73,45 @@ int samsung_ufs_phy_wait_for_lock_acq(struct phy *phy, u8 lane)
 	return err;
 }
 
+/*
+ * An entry of a calibration table can name the power mode it belongs to: the
+ * mode itself, the rate series and the gear, each of which may be left as
+ * "any".  An entry that names none of them applies always, which is what
+ * every entry written before this was taught to look at them does.
+ *
+ * The mode and the series come from what the host asked for through
+ * set_mode, the gear from the value it passed beside it.
+ */
+static bool samsung_ufs_phy_cfg_applies(const struct samsung_ufs_phy *phy,
+					const struct samsung_ufs_phy_cfg *cfg)
+{
+	u8 mode = cfg->desc & MD_MASK;
+	u8 series = (cfg->desc >> 2) & SR_MASK;
+	u8 gear = (cfg->desc >> 4) & GR_MASK;
+	bool high_speed = phy->mode == PHY_MODE_UFS_HS_A ||
+			  phy->mode == PHY_MODE_UFS_HS_B;
+
+	if (mode != PWR_DESC_ANY) {
+		bool entry_is_hs = mode == PWR_DESC_HS;
+
+		if (entry_is_hs != high_speed)
+			return false;
+	}
+
+	if (series != PWR_DESC_ANY) {
+		enum phy_mode wanted = series == PWR_DESC_SER_A ?
+				       PHY_MODE_UFS_HS_A : PHY_MODE_UFS_HS_B;
+
+		if (phy->mode != wanted)
+			return false;
+	}
+
+	if (gear != PWR_DESC_ANY && gear != phy->gear)
+		return false;
+
+	return true;
+}
+
 static int samsung_ufs_phy_calibrate(struct phy *phy)
 {
 	struct samsung_ufs_phy *ufs_phy = get_samsung_ufs_phy(phy);
@@ -92,6 +131,9 @@ static int samsung_ufs_phy_calibrate(struct phy *phy)
 		goto out;
 
 	for_each_phy_cfg(cfg) {
+		if (!samsung_ufs_phy_cfg_applies(ufs_phy, cfg))
+			continue;
+
 		for_each_phy_lane(ufs_phy, i) {
 			samsung_ufs_phy_config(ufs_phy, cfg, i);
 		}
@@ -214,6 +256,8 @@ static int samsung_ufs_phy_set_mode(struct phy *generic_phy,
 	if (mode > 0)
 		ss_phy->mode = mode;
 
+	ss_phy->gear = submode;
+
 	return 0;
 }
 
@@ -235,6 +279,9 @@ static int samsung_ufs_phy_notify_state(struct phy *phy,
 		goto err_out;
 
 	for_each_phy_cfg(cfg) {
+		if (!samsung_ufs_phy_cfg_applies(ufs_phy, cfg))
+			continue;
+
 		for_each_phy_lane(ufs_phy, i) {
 			samsung_ufs_phy_config(ufs_phy, cfg, i);
 		}
diff --git a/drivers/phy/samsung/phy-samsung-ufs.h b/drivers/phy/samsung/phy-samsung-ufs.h
index f2c2e744e5b..3904a63f933 100644
--- a/drivers/phy/samsung/phy-samsung-ufs.h
+++ b/drivers/phy/samsung/phy-samsung-ufs.h
@@ -58,6 +58,7 @@ enum {
 	PWR_DESC_G1	= 1,
 	PWR_DESC_G2	= 2,
 	PWR_DESC_G3	= 3,
+	PWR_DESC_G4	= 4,
 	/* field mask */
 	MD_MASK		= 0x3,
 	SR_MASK		= 0x3,
@@ -73,6 +74,9 @@ enum {
 #define PWR_MODE_HS_G3_ANY	PWR_MODE_HS(PWR_DESC_G3, PWR_DESC_ANY)
 #define PWR_MODE_HS_G3_SER_A	PWR_MODE_HS(PWR_DESC_G3, PWR_DESC_SER_A)
 #define PWR_MODE_HS_G3_SER_B	PWR_MODE_HS(PWR_DESC_G3, PWR_DESC_SER_B)
+#define PWR_MODE_HS_G4_ANY	PWR_MODE_HS(PWR_DESC_G4, PWR_DESC_ANY)
+#define PWR_MODE_HS_G4_SER_A	PWR_MODE_HS(PWR_DESC_G4, PWR_DESC_SER_A)
+#define PWR_MODE_HS_G4_SER_B	PWR_MODE_HS(PWR_DESC_G4, PWR_DESC_SER_B)
 #define PWR_MODE(g, s, m)	((((g) & GR_MASK) << 4) |\
 				 (((s) & SR_MASK) << 2) | ((m) & MD_MASK))
 #define PWR_MODE_PWM_ANY	PWR_MODE(PWR_DESC_ANY,\
@@ -135,6 +139,7 @@ struct samsung_ufs_phy {
 	u8 lane_cnt;
 	int ufs_phy_state;
 	enum phy_mode mode;
+	int gear;
 };
 
 static inline struct samsung_ufs_phy *get_samsung_ufs_phy(struct phy *phy)
