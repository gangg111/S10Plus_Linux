 };
 
-static const unsigned int exynos7870_reg_values[] = {
+static const unsigned int exynos7870_reg_values[NUM_REG_VALUES] = {
 	[RESET_TYPE] = DSIM_SWRST,
 	[PLL_TIMER] = 80000,
 	[STOP_STATE_CNT] = 0xa,
@@ -443,7 +444,7 @@ static const unsigned int exynos7870_reg_values[] = {
 	[PHYTIMING_HS_TRAIL] = DSIM_PHYTIMING2_HS_TRAIL(0x0c),
 };
 
-static const unsigned int imx8mm_dsim_reg_values[] = {
+static const unsigned int imx8mm_dsim_reg_values[NUM_REG_VALUES] = {
 	[RESET_TYPE] = DSIM_SWRST,
 	[PLL_TIMER] = 500,
 	[STOP_STATE_CNT] = 0xf,
