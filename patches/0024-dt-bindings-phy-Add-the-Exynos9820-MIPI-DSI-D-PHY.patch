From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Mon, 7 Sep 2026 04:43:56 +0200
Subject: [PATCH] dt-bindings: phy: Add the Exynos9820 MIPI DSI D-PHY

The D-PHY of the Exynos9820 display block is a device of its own rather
than a set of registers inside the DSI host: it holds the link PLL, the
clock lane and the data lanes in the per link M4S0 range, and the bias
generator it shares in the M4S4 top range.

Describing it separately keeps the two ranges out of the DSI host node,
where they would become ABI, and lets the host reach it through the
generic PHY interface the way samsung-dsim already expects.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../phy/samsung,exynos9820-mipi-dphy.yaml     | 81 +++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/samsung,exynos9820-mipi-dphy.yaml

diff --git a/Documentation/devicetree/bindings/phy/samsung,exynos9820-mipi-dphy.yaml b/Documentation/devicetree/bindings/phy/samsung,exynos9820-mipi-dphy.yaml
new file mode 100644
index 00000000000..99c791e80c7
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/samsung,exynos9820-mipi-dphy.yaml
@@ -0,0 +1,81 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/samsung,exynos9820-mipi-dphy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9820 MIPI DSI D-PHY
+
+maintainers:
+  - Artur Szafraniec <ganggg111@gmail.com>
+
+description:
+  The D-PHY of the Exynos9820 display block is split in two. The per-link M4S0
+  range carries the PLL, the clock lane and the data lanes and is the reg of
+  this node; the M4S4 top block, which carries the bias generator, is a block of
+  its own and is reached through a phandle rather than being a second range of
+  every link node. The PHY is driven by the DSI host over the generic PHY
+  interface.
+
+properties:
+  compatible:
+    const: samsung,exynos9820-mipi-dphy
+
+  reg:
+    maxItems: 1
+
+  samsung,dpu-sysreg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the system register block of the display unit, which holds
+      the reset of this PHY. The PHY answers only once that reset is
+      released.
+
+  samsung,dphy-top-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the M4S4 top block, which carries the bias generator this
+      PHY needs. The block has no clock or power domain of its own, and
+      its registers answer only while the display block is powered and
+      the clock of this PHY is running.
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: apb
+
+  power-domains:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - samsung,dphy-top-syscon
+  - samsung,dpu-sysreg
+  - power-domains
+  - clocks
+  - clock-names
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/samsung,exynos9820.h>
+
+    phy@19161000 {
+        compatible = "samsung,exynos9820-mipi-dphy";
+        reg = <0x19161000 0x800>;
+        samsung,dphy-top-syscon = <&dphy_top>;
+        samsung,dpu-sysreg = <&sysreg_dpu>;
+        clocks = <&cmu_dpu CLK_GOUT_DPU_AD_APB_MIPI_DSIM0_PCLKS>;
+        clock-names = "apb";
+        power-domains = <&pd_dpu>;
+        #phy-cells = <0>;
+    };
+...
