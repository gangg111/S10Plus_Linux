+	/*
+	 * Each CPU cluster is throttled through cpufreq from 85 C on.  The
+	 * critical trip stays 15 C below the hardware trip of the TMU, so the
+	 * kernel powers the phone off in order before the TMU removes the power;
+	 * the GPU and ISP zones have nothing to throttle yet.
 	 */
 	thermal-zones {
 		big-thermal {
+			polling-delay-passive = <100>;
 			polling-delay = <1000>;
 			thermal-sensors = <&tmu_top 0>;
 
 			trips {
+				big_alert: big-alert {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
 				big-critical {
 					temperature = <100000>;
 					hysteresis = <0>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&big_alert>;
+					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
