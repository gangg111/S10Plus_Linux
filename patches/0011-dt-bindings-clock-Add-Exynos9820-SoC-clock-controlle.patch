From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artur Szafraniec <ganggg111@gmail.com>
Date: Wed, 19 Aug 2026 00:14:53 +0200
Subject: [PATCH] dt-bindings: clock: Add Exynos9820 SoC clock controller

Add binding documentation and clock IDs for the CMU_TOP, CMU_APM,
CMU_PERIS, CMU_PERIC0, CMU_FSYS0A, CMU_FSYS1, CMU_CMGP and CMU_DPU
blocks of the Exynos9820 SoC.

The identifiers are generated from the clock tables that ship with the
vendor kernel, cmucal-sfr.c and cmucal-node.c, together with the driver
that consumes them. Within each CMU they run from 1 in the order PLL,
fixed rate, mux, divider, fixed factor, gate, and inside each of those
by register offset, so adding a clock to a block does not renumber the
blocks after it. The names follow the register to clock name mangling
that clk-gs101.c documents, which is derived from the same vendor
tables.

Signed-off-by: Artur Szafraniec <ganggg111@gmail.com>
---
 .../clock/samsung,exynos9820-clock.yaml       | 204 +++++++
 .../dt-bindings/clock/samsung,exynos9820.h    | 564 ++++++++++++++++++
 2 files changed, 768 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
 create mode 100644 include/dt-bindings/clock/samsung,exynos9820.h

diff --git a/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml b/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
new file mode 100644
index 00000000000..dabb24e301f
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/samsung,exynos9820-clock.yaml
@@ -0,0 +1,204 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/samsung,exynos9820-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9820 SoC clock controller
+
+maintainers:
+  - Artur Szafraniec <ganggg111@gmail.com>
+  - Krzysztof Kozlowski <krzk@kernel.org>
+
+description: |
+  Exynos9820 clock controller is comprised of several CMU units, generating
+  clocks for different domains. Those CMU units are modeled as separate device
+  tree nodes, and might depend on each other. The root clock in that root tree
+  is an external clock: OSCCLK (26 MHz). This external clock must be defined
+  as a fixed-rate clock in dts.
+
+  CMU_TOP is a top-level CMU, where all base clocks are prepared using PLLs and
+  dividers; all other clocks of function blocks (other CMUs) are usually
+  derived from CMU_TOP.
+
+  Each clock is assigned an identifier and client nodes can use this identifier
+  to specify the clock which they consume. All clocks available for usage
+  in clock consumer nodes are defined as preprocessor macros in
+  'include/dt-bindings/clock/samsung,exynos9820.h' header.
+
+properties:
+  compatible:
+    enum:
+      - samsung,exynos9820-cmu-apm
+      - samsung,exynos9820-cmu-cmgp
+      - samsung,exynos9820-cmu-dpu
+      - samsung,exynos9820-cmu-fsys0a
+      - samsung,exynos9820-cmu-fsys1
+      - samsung,exynos9820-cmu-peric0
+      - samsung,exynos9820-cmu-peris
+      - samsung,exynos9820-cmu-top
+
+  clocks:
+    minItems: 1
+    maxItems: 6
+
+  clock-names:
+    minItems: 1
+    maxItems: 6
+
+  "#clock-cells":
+    const: 1
+
+  power-domains:
+    maxItems: 1
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - clocks
+  - clock-names
+  - reg
+  - "#clock-cells"
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - samsung,exynos9820-cmu-apm
+              - samsung,exynos9820-cmu-dpu
+              - samsung,exynos9820-cmu-peris
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+            - description: CMU BUS clock (from CMU_TOP)
+
+        clock-names:
+          items:
+            - const: oscclk
+            - const: bus
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos9820-cmu-cmgp
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+            - description: CMU BUS clock (from CMU_APM)
+
+        clock-names:
+          items:
+            - const: oscclk
+            - const: bus
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos9820-cmu-fsys0a
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+            - description: CMU_FSYS0A BUS clock (from CMU_TOP)
+            - description: CMU_FSYS0A USB31DRD clock (from CMU_TOP)
+            - description: CMU_FSYS0A USBDP debug clock (from CMU_TOP)
+
+        clock-names:
+          items:
+            - const: oscclk
+            - const: bus
+            - const: usb31drd
+            - const: usbdp_debug
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos9820-cmu-fsys1
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+            - description: CMU_FSYS1 BUS clock (from CMU_TOP)
+            - description: CMU_FSYS1 MMC card clock (from CMU_TOP)
+            - description: CMU_FSYS1 PCIe clock (from CMU_TOP)
+            - description: CMU_FSYS1 UFS card clock (from CMU_TOP)
+            - description: CMU_FSYS1 UFS embedded clock (from CMU_TOP)
+
+        clock-names:
+          items:
+            - const: oscclk
+            - const: bus
+            - const: mmc_card
+            - const: pcie
+            - const: ufs_card
+            - const: ufs_embd
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos9820-cmu-peric0
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+            - description: CMU_PERIC0 BUS clock (from CMU_TOP)
+            - description: CMU_PERIC0 IP clock (from CMU_TOP)
+
+        clock-names:
+          items:
+            - const: oscclk
+            - const: bus
+            - const: ip
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos9820-cmu-top
+
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+
+        clock-names:
+          items:
+            - const: oscclk
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/samsung,exynos9820.h>
+
+    cmu_peris: clock-controller@10020000 {
+        compatible = "samsung,exynos9820-cmu-peris";
+        reg = <0x10020000 0x8000>;
+        #clock-cells = <1>;
+
+        clocks = <&oscclk>,
+                 <&cmu_top CLK_DOUT_CMU_PERIS_BUS>;
+        clock-names = "oscclk", "bus";
+    };
+...
