# Fragment konfiguracji jadra dla Galaxy S10+ (beyond2lte, Exynos9820).
#
# Po co osobny plik. Seria nie dodaje wpisu w arch/arm64/configs, bo jeden
# telefon nie jest powodem do dokladania plyty do defconfiga arm64. Skutek jest
# jednak taki, ze KAZDY nowy symbol tej serii ma domyslnie wartosc n, a polowa
# rzeczy, ktore seria zaklada po stronie platformy, tez nie jest w defconfigu.
# Zbudowane z samego defconfiga jadro nie ma wiec ani DECON-a, ani panelu, ani
# D-PHY, ani regulatorow panelu, i nie zapali ekranu mimo poprawnego kodu.
#
# Uzycie na drzewie jadra:
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m .config <ten plik>
#   make ARCH=arm64 olddefconfig
#
# Bramka scripts/check-kconfig.sh sprawdza, ze po tej operacji KAZDY symbol
# ponizej ma zadana wartosc. Symbol, ktorego zaleznosc jest niespelniona,
# zostaje przez olddefconfig wylaczony po cichu i wtedy bramka pada.
#
# Symbole, ktorych tu NIE MA, bo wchodza same: DRM_SAMSUNG_DSIM,
# DRM_DISPLAY_DSC_HELPER i GENERIC_PHY_MIPI_DPHY (select z symboli nizej),
# I2C_EXYNOS5 (default y if ARCH_EXYNOS), PINCTRL_EXYNOS_ARM64
# (select z PINCTRL_EXYNOS).

# --- platforma ---------------------------------------------------------------
CONFIG_ARCH_EXYNOS=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_EXYNOS_PM_DOMAINS=y

# --- zasilanie panelu --------------------------------------------------------
# Bez tych dwoch trzy szyny panelu nie powstaja, panel wisi na EPROBE_DEFER
# i ekran nie zapala sie przy poprawnym kodzie.
CONFIG_MFD_SEC_I2C=y
CONFIG_REGULATOR_S2DOS05=y

# --- lancuch wyswietlania ----------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS_DSI=y
CONFIG_DRM_EXYNOS9820_DECON=y
CONFIG_PHY_EXYNOS9820_DSIM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA9=y

# --- dotyk -------------------------------------------------------------------
CONFIG_TOUCHSCREEN_S6SY761=y

# --- pamiec masowa -----------------------------------------------------------
# Bez tych czterech jadro nie ma jak siegnac do wbudowanej pamieci, wiec nie ma
# skad wziac rootfs. SCSI i BLK_DEV_SD sa w defconfigu arm64, ale zamawiamy je
# tutaj jawnie, bo bez nich sterownik hosta rejestruje kontroler, do ktorego
# nikt sie nie zglasza, i objaw wyglada jak martwy kontroler, a nie jak
# brakujaca warstwa wyzej.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y

# --- dwie decyzje, ktore nie sa oczywiste ------------------------------------
#
# 1. SYSMMU wylaczony. Wezly sysmmu_dpud0..2 sa w DT, ale sterownik wlacza sie
#    tu na n. Powod: EXYNOS_IOMMU robi "select ARM_DMA_USE_IOMMU"
#    (drivers/iommu/Kconfig:259-264), czyli symbol swiata ARM32, a na arm64
#    exynos_drm_dma.c idzie druga galezia, przez IOMMU_DMA. Tej kombinacji dla
#    tego SoC nikt nie uruchomil i nie da sie jej sprawdzic bez sprzetu.
#    Wlaczenie jej zmienia caly model adresowania bufora obrazu, wiec pierwszy
#    bring-up ma isc bez niej, a wlaczenie jest osobnym krokiem z osobnym
#    pomiarem. Patrz HW-35 w docs/HW-BLOCKED.md.
# CONFIG_EXYNOS_IOMMU is not set
#
# 2. SIMPLEDRM wylaczony. Wezel /chosen/framebuffer0 w DT plyty jest po to,
#    zeby bootloader zostawil obraz, ale sterowniki drm/exynos nie usuwaja
#    konkurencyjnego framebuffera (w calym drivers/gpu/drm/exynos nie ma ani
#    jednego wywolania aperture_remove_conflicting_devices). Wlaczony
#    SIMPLEDRM daje wiec dwa urzadzenia DRM na ten sam ekran i userland moze
#    trafic na to zamrozone. Do wlaczenia dopiero razem z przekazaniem ekranu.
#    Patrz HW-36 w docs/HW-BLOCKED.md.
# CONFIG_DRM_SIMPLEDRM is not set

# --- USB, tryb urzadzenia -----------------------------------------------
#
# Port opisany jest jako peripheral, bo zmiana roli wymaga ukladu USB-C na
# max77705, ktorego ta seria nie siega. Peripheral to ta polowa, ktora dziala
# ze zwyklym kablem do komputera, i ta, ktorej brak najbardziej boli: dzis
# telefon nie ma jak o sobie nic powiedziec, bo initramfs postmarketOS probuje
# wystawic dysk z logami przez USB i konczy na braku /sys/kernel/config/usb_gadget.
#
# Cztery pierwsze symbole domyslny defconfig arm64 daje jako MODULY, a ta seria
# buduje wylacznie "Image dtbs", nigdy "modules", wiec kazde =m jest tu martwe.
# Katalog modulow w initramfs nalezy zreszta do innego jadra (7.2.0-rc2), wiec
# modprobe i tak by spudlowal.
#
# TYPEC musi byc wbudowany, chociaz ta seria nie ma ukladu USB-C.
# PHY_EXYNOS5_USBDRD ma "depends on TYPEC || !TYPEC", czyli klasyczna
# pulapke trojstanowa: przy TYPEC=m, ktore daje domyslny defconfig arm64,
# symbol NIE MOZE byc =y i kconfig po cichu przycina go z powrotem do =m,
# a modulow ta seria nie buduje. Zmierzone: merge_config melduje podmiane
# na =y, a po olddefconfig w .config i tak stoi =m.
CONFIG_TYPEC=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_F_MASS_STORAGE=y
#
# Ponizsze defconfig daje dzis jako wbudowane, ale nic tego nie pilnuje, a bez
# nich nie ma ani kontrolera, ani sciezki gadgetu.
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_CONFIGFS_FS=y

# --- bateria, sam odczyt poziomu naladowania -----------------------------
#
# Licznika ladunku nie trzeba pisac: obsluguje go max17042_battery.c, ktory
# zna compatible maxim,max77705-battery. MFD musi byc wbudowany, bo to on
# wystawia kontroler przerwan, z ktorego licznik bierze swoje przerwanie.
# Ladowarka jest, bo ogniwo jest juz opisane: wszystkie jej liczby (napiecie
# konca ladowania, pojemnosc, prad ladowania, prad uznania za naladowane)
# pochodza z drzewa producenta tego telefonu, nie z analogii. Czujniki tego
# samego ukladu daja odczyt napiec i pradow, czyli sposob sprawdzenia, czy
# ladowanie naprawde idzie, zamiast wierzenia na slowo.
CONFIG_MFD_MAX77705=y
CONFIG_BATTERY_MAX17042=y
CONFIG_CHARGER_MAX77705=y
CONFIG_SENSORS_MAX77705=y

# --- tablica znakow dla rozruchowego /boot ---------------------------------
#
# Bez tego symbolu telefon wstaje, montuje rootfs i uruchamia systemd, po czym
# wpada w tryb awaryjny z zablokowanym kontem root, czyli bez zadnej konsoli.
# Zmierzone po obu stronach:
#
#   telefon:  FAT-fs (loop0p1): IO charset ascii not found
#             [FAILED] Failed to mount /boot
#   obraz:    /etc/fstab -> UUID=A2B9-9F37 /boot vfat ...,iocharset=ascii
#   jadro:    # CONFIG_NLS_ASCII is not set
#
# Domyslny defconfig arm64 daje CONFIG_NLS_ISO8859_1 i CONFIG_NLS_CODEPAGE_437,
# ale nie ASCII, a postmarketOS zada wlasnie ASCII i nie ma tu pola do wyboru:
# fstab generuje instalator dystrybucji, nie my. Wpis nalezy do serii, a nie do
# fragmentu uruchomieniowego, bo dotyczy kazdego rozruchu tego urzadzenia.
CONFIG_NLS_ASCII=y

# --- czcionka konsoli dla ekranu o bardzo duzej gestosci ------------------
#
# Panel ma 1440x3040 na 6,4 cala, czyli okolo 522 pikseli na cal. Domyslna
# czcionka konsoli 8x16 daje na nim 180 kolumn i znak wysoki na 16 pikseli,
# co w praktyce jest nieczytelne golym okiem; pierwszy rozruch trzeba bylo
# odczytywac powiekszajac zdjecie aparatem.
#
# TER16x32 to NAJWIEKSZA czcionka wbudowana w jadro (fbcon nie skaluje
# i nie przyjmuje wiekszych), wiec to jest sufit, a nie wybor estetyczny:
# daje 90 kolumn na 95 wierszy, czyli dwukrotnosc w obu osiach.
# Samo wbudowanie nie wystarcza, trzeba ja jeszcze wybrac parametrem
# rozruchowym fbcon=font:TER16x32, bo inaczej fbcon bierze czcionke
# o najwyzszym priorytecie wbudowanym, czyli nadal 8x16.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# --- Bluetooth ---------------------------------------------------------------
#
# Uklad BCM4375 wisi na porcie szeregowym, nie na USB ani na PCIe, wiec droga
# jest taka: sterownik portu (mamy go juz dla konsoli) wystawia port, magistrala
# serdev podpina pod ten port urzadzenie opisane w drzewie, a hci_bcm gada
# z ukladem protokolem H4 z rozszerzeniami Broadcoma.
#
# SERIAL_DEV_BUS bez SERIAL_DEV_CTRL_TTYPORT nie ma sterownika samej magistrali
# i wezel-dziecko portu nigdy nie dostaje swojego urzadzenia; BT_HCIUART_SERDEV
# wchodzi samo przez select, gdy obie strony sa wbudowane.
#
# BT_HIDP jest tu dlatego, ze pierwszym sensownym uzyciem Bluetootha na tym
# telefonie jest klawiatura, a bez tego profilu jadro zestawi polaczenie
# i nie zrobi z niego urzadzenia wejscia.
CONFIG_NET=y
CONFIG_RFKILL=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
# Profil sam zestawia polaczenie, ale urzadzenia wejscia z niego nie
# robi: to jest zadanie demona w userlandzie, a on potrzebuje wezla
# /dev/uhid, ktorego bez tego symbolu nie ma.
CONFIG_UHID=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
# Sluchawki Bluetooth do rozmow (HFP/HSP): PipeWire prowadzi sterowanie
# profilem po RFCOMM, a bez tego gniazda BlueZ oglasza tylko A2DP
# (sprawdzone 25.09.2026: bluetoothctl show mial Audio Source/Sink, bez
# Handsfree). Dzwiek rozmowy idzie po UART dzieki latce 0117.
CONFIG_BT_RFCOMM=m

# --- Wi-Fi ------------------------------------------------------------------
#
# Uklad lacznosci tego telefonu ma dwie polowy: Bluetooth na porcie szeregowym
# (wyzej) i Wi-Fi na magistrali PCIe. Droga do tej drugiej jest dluzsza, bo
# mainline nie ma sterownika kontrolera PCIe dla tego ukladu: wnosi go ta
# seria razem z warstwa fizyczna.
#
# BRCMFMAC_PCIE bez BRCMFMAC nic nie daje, a sam BRCMFMAC domyslnie wybiera
# tylko droge przez SDIO; uklad na PCIe potrzebuje jawnego wpisu.
CONFIG_PCI=y
CONFIG_PCIE_DW_HOST=y
CONFIG_PCIE_EXYNOS9820=y
CONFIG_CFG80211=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y

# --- tryby restartu -----------------------------------------------------------
#
# Bootloader tego telefonu czyta po resecie jedno slowo w jednostce zasilania
# i po nim poznaje, dokad ma pojsc. Bez tego sterownika wejscie w tryb
# pobierania wymaga trzymania przyciskow, czyli czlowieka przy telefonie;
# z nim wystarczy `reboot download` przez kabel.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_SYSCON_REBOOT_MODE=y

# --- firmware zarzadzania energia (ACPM) --------------------------------------
#
# Jedyna droga do glownego PMIC tego telefonu. Nie siedzi on na zadnej
# magistrali procesora: producent trzyma go na kanale SPEEDY nalezacym do
# firmware APM i zostawia kontrolery SPEEDY wylaczone. Za tym samym mostem sa
# szyny, ktorych nasze drzewo opisuje dzis atrapami "regulator-fixed", w tym
# tsp_io i tsp_avdd zasilajace uklad dotyku i rezystory podciagajace jego
# magistrale. Zmierzone: bez tych szyn obie linie magistrali stoja nisko,
# kontroler zacina sie na pierwszym bicie adresu, a uklad wyglada na nieobecny.
#
# Wezel juz jest w drzewie (firmware/power-management), skrzynka i pamiec
# dzielona tez; brakowalo wylacznie tego symbolu, wiec sterownik nigdy sie
# nie zbudowal.
# Skrzynka pocztowa do firmware APM. Domyslnie buduje sie jako MODUL, a to
# jadro modulow nie laduje: katalog /lib/modules na telefonie nalezy do innej
# wersji. Bez niej urzadzenie 15900000.mailbox nie dostaje sterownika, a ACPM
# czeka na nie w odroczonej sondzie bez konca ("deferred probe pending").
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y
CONFIG_EXYNOS_ACPM_CLK=y

# Glowny uklad zasilania plyty (S2MPS19) rozmawia przez ACPM, nie po
# magistrali; stad jego sterownik MFD i wspolny sterownik regulatorow.
CONFIG_MFD_SEC_ACPM=y
CONFIG_REGULATOR_S2MPS11=y

# --- temperatura SoC -----------------------------------------------------------
#
# Czujnik TMU, ktory czyta firmware APM, a jadro pyta go przez ACPM (latki
# 0106-0108). Bez niego jedyna ochrona jest sprzetowy trip S-Boota przy 115 C,
# ktory odcina zasilanie bez zadnego zamykania systemu.
CONFIG_EXYNOS9820_TMU=y
# Wylaczanie potrafi zawisnac na synchronizacji pamieci podrecznej UFS. Po
# 5 s od progu krytycznego jadro wylacza telefon samo, zanim dojdzie do 115 C.
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=5000

# --- urzadzenie wpisujace dla klawiatury ekranowej ----------------------------
#
# Klawiatura z tools/klawiatura wysyla znaki przez /dev/uinput i bez tego
# symbolu nie ma czym pisac: wstrzyk_otworz() pada na open("/dev/uinput"),
# a jedyny sposob obslugi telefonu bez komputera przestaje istniec.
#
# Zmierzone 22 wrzesnia 2026: w sources/linux/.config stoi
# "# CONFIG_INPUT_UINPUT is not set", a w arm64 defconfig tego symbolu NIE MA
# (jest tylko CONFIG_INPUT_EVDEV). Dzialajace jadro #39 uinput ma, bo
# klawiatura na telefonie realnie pisze, wiec ktos wlaczyl go poza fragmentem.
# Pierwsze jadro zbudowane czysto z tego pliku byloby wiec bez klawiatury,
# a objaw ("klawiatura nie dziala") niczego by o przyczynie nie mowil.
CONFIG_INPUT_UINPUT=y

# --- log jadra przezywajacy reset (pstore, ramoops) ---------------------------
#
# Po co: wlaczenie drugiego rdzenia (echo 1 > cpu1/online) zawiesza ten telefon
# tak, ze zabiera ze soba lacze USB. Zmierzone 22 wrzesnia 2026: ssh zerwane
# w tej samej sekundzie, a potem ZERO urzadzen USB na komputerze, wiec z tej
# proby nie zostal ani jeden wiersz dziennika i nie ma czego diagnozowac.
#
# pstore z kopia KONSOLI w pamieci daje na to odpowiedz: obszar ramoops lezy
# w DRAM, ktorego firmware nie czysci przy cieplym restarcie, wiec po wymuszonym
# restarcie ostatnie wiersze przed zawieszeniem czekaja w /sys/fs/pstore.
# Ze ten sprzet tak potrafi, wiadomo z pomiaru: stockowe jadro zostawilo tam
# slad awarii debugfs (measurements/2026-09-11-etap0a). Obszar dokłada drzewu
# etap 9 generatora plyty, pod adresem producenta 0xfd910000.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- logo rozruchu: znak postmarketOS zamiast pingwina ------------------------
#
# Po co: pierwsza rzecz, ktora na tym telefonie rysuje SAM system, to logo
# konsoli ramki. Wszystko przed nim nalezy do wczesniejszych stopni (obrazek
# S-Boota z partycji up_param, potem obrecz bootloadera). Pingwin mowilby tylko
# tyle, ze jadro weszlo, a nie ktory system wstaje.
#
# Plik wnosi latka 0097; jest to znak projektu postmarketOS dopasowany do 160
# na 160 i zredukowany do 224 kolorow palety konsoli. Jadro rysuje jedna kopie
# na KAZDY rdzen online, wiec przy osmiu rdzeniach widac osiem znakow obok
# siebie (8 x 160 = 1280 pikseli na panelu szerokim na 1440).
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_LOGO_LINUX_CLUT224_FILE="drivers/video/logo/logo_pmos_clut224.ppm"

# --- GPU: Mali-G76 przez panfrost ----------------------------------------------
#
# Po co: bez GPU KWin sklada kazda klatke w llvmpipe, ok. 110 ms na klatke
# przy 1440x3040 niezaleznie od zegarow procesora
# (measurements/2026-09-24-cpufreq). Wezel GPU wnosi etap 16 generatora SoC.
#
# Modul, a nie wbudowany: na telefonie nie ma katalogu modulow tego jadra,
# wiec nic nie laduje panfrosta samo i pierwsze uruchomienie GPU robi sie
# recznie (insmod gpu-sched.ko, potem panfrost.ko). Zawieszenie magistrali
# przy pierwszym dostepie nie zablokuje wtedy rozruchu.
CONFIG_DRM_PANFROST=m

# --- diagnostyka: sledzenie, profilowanie, presja zasobow -----------------------
#
# Po co: przyczyny zacinania i opoznien maja wskazywac narzedzia uruchomione na
# telefonie (perf sched/record, bpftrace, bcc: offcputime/runqlat, trace-cmd,
# rtla timerlat), a nie reczne skrypty. Jadro #60 mialo tylko perf z licznikami
# PMU i BPF_SYSCALL; bez ftrace, kprobes i BTF zadne z tych narzedzi nie dziala.
#
# Koszt: wszystko ponizej spi, dopoki nikt nie sledzi (ftrace dynamiczny to NOP
# w prologu funkcji, kprobes i uprobes nic nie wstawiaja bez sondy, schedstats
# i opoznienia zadan sa za statycznym kluczem). Celowo pominiete sa tracery
# irqsoff i preempt: te kosztuja przy kazdym wlaczeniu przerwan takze wtedy,
# gdy nikt nie sledzi.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_SCHED_TRACER=y
CONFIG_HIST_TRIGGERS=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
#
# BTF opisuje typy jadra dla bpftrace i narzedzi libbpf (CO-RE); wymaga pahole
# w srodowisku budowania (Debian: pakiet dwarves). Naglowki w jadrze
# (/sys/kernel/kheaders.tar.xz) sa dla bcc, ktore kompiluje sondy na telefonie.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# defconfig arm64 wlacza wersje okrojona, a z nia BTF sie nie da (Kconfig.debug:
# depends on !DEBUG_INFO_REDUCED).
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_IKHEADERS=y
#
# Presja zasobow (/proc/pressure/{cpu,io,memory}), statystyki planisty
# (/proc/schedstat, perf sched) i opoznienia zadan (getdelays, iotop).
CONFIG_PSI=y
CONFIG_SCHEDSTATS=y
CONFIG_TASK_DELAY_ACCT=y
#
# Granice wykorzystania dla planisty (uclamp), jak top-app w Androidzie: bez
# ustawionych granic (0..1024) nic nie zmieniaja; sa po to, zeby podbic watki
# interfejsu, jesli narzedzia wskaza planiste.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# --- dzwiek -----------------------------------------------------------------
#
# Wbudowane jak reszta portu: na telefonie nie ma modulow z drzewa, tylko
# extra/. Wzmacniacze CS35L40 (hsi2c38, latka 0121) obsluguje sterownik
# cs35l41. Karte glosnikow skladaja sterownik ABOX sterowany z AP i sterownik
# karty telefonu (latki 0130-0135); zegary bloku daje CMU_AUD (0126-0128).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_CS35L41_I2C=y
CONFIG_SND_SOC_SAMSUNG=y
CONFIG_SND_SOC_SAMSUNG_EXYNOS9820_ABOX=y
CONFIG_SND_SOC_SAMSUNG_BEYOND=y
# MICVDD kodeka CS47L93: bez tego regulatora kodek dostaje atrape, a DMIC
# i mikrofon zestawu slepna (zmierzone 26.09.2026, jadro #75).
CONFIG_REGULATOR_ARIZONA_MICSUPP=y

# Kodek CS47L93 na SPI2 (latki 0122-0125). Wbudowany jak reszta portu.
# Pierwsze wlaczenie LDO18M przez ACPM i odczyt ID przeszly 25.09.2026 jako
# osobne kroki z modulow (measurements/2026-09-25-kodek): CS47L93 rev 1.
CONFIG_SPI=y
CONFIG_SPI_S3C64XX=y
CONFIG_MFD_MADERA=y
CONFIG_MFD_MADERA_SPI=y
CONFIG_MFD_CS47L92=y

# --- zapora i swap w pamieci (uslugi pmOS) -----------------------------------
# nftables.service pmOS laduje /etc/nftables.nft: tablica inet, ct state,
# reject with icmpx. Bez nf_tables usluga pada na "Unable to initialize Netlink
# socket: Protocol not supported" i telefon zostaje BEZ zapory. Wszystko =y,
# bo obraz nie ma katalogu /lib/modules/<wersja>/kernel, wiec =m nic nie daje.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
# postmarketos-zram-swap (zramstart) tworzy zram z algorytmem zstd.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
# Wykrywanie zablokowan: trzy zawieszenia z 27.09.2026 nie zostawily sladu, bo
# reset przyciskami kasuje ramoops.  Panike przy blokadzie miekkiej i twardej
# (log do ramoops, cieply restart przez kernel.panic=120) wlacza sysctl w
# tools/phone/blokady; zawieszone zadanie tylko ostrzega, zeby wolne wylaczanie
# UFS nie restartowalo telefonu.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
# Sprzetowe zarzadzanie bitami dostepu i zabrudzenia stron WYLACZONE, jak w jadrze
# Samsunga (defconfig beyond2lte: "# CONFIG_ARM64_HW_AFDBM is not set").  Z nim
# 27.09.2026 padaly losowo rozne programy w alokatorze (firefox 8 razy w pol
# godziny, sudo, pipewire-pulse, plasmashell, tok) i zapis jadra na /boot wyszedl
# uszkodzony bez bledu w dmesg.  Jadro #90 bez tej opcji: zero awarii.
# CONFIG_ARM64_HW_AFDBM is not set

# --- wibracja i czujnik Halla -----------------------------------------------
#
# Silnik wibracyjny (LRA) steruje blok haptyki max77705, a sygnal daje mu
# kanal 1 bloku PWM w PERIC0. Sterownik jest w mainline (max77693-haptic,
# compatible maxim,max77705-haptic). PWM i PWM_SAMSUNG sa juz w defconfigu
# arm64, ale stoja tu jawnie: haptyka ma "depends on PWM", wiec bez nich
# olddefconfig wylaczylby ja po cichu, a bramka check-kconfig.sh ma to zlapac.
# INPUT_FF_MEMLESS wchodzi sam (select z haptyki). Czujnik Halla to gpio-keys
# z SW_LID, KEYBOARD_GPIO jest w defconfigu, nowego symbolu nie potrzebuje.
CONFIG_PWM=y
CONFIG_PWM_SAMSUNG=y
CONFIG_INPUT_MAX77693_HAPTIC=y
