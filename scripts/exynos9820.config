# Fragment konfiguracji jadra dla Galaxy S10+ (beyond2lte, Exynos9820).
#
# Po co osobny plik. Seria nie dodaje wpisu w arch/arm64/configs, bo jeden
# telefon nie jest powodem do dokladania plyty do defconfiga arm64. Skutek jest
# jednak taki, ze KAZDY nowy symbol tej serii ma domyslnie wartosc n, a polowa
# rzeczy, ktore seria zaklada po stronie platformy, tez nie jest w defconfigu.
# Zbudowane z samego defconfiga jadro nie ma wiec ani DECON-a, ani panelu, ani
# D-PHY, ani regulatorow panelu, i nie zapali ekranu mimo poprawnego kodu.
#
# Uzycie na drzewie jadra:
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m .config <ten plik>
#   make ARCH=arm64 olddefconfig
#
# Bramka scripts/check-kconfig.sh sprawdza, ze po tej operacji KAZDY symbol
# ponizej ma zadana wartosc. Symbol, ktorego zaleznosc jest niespelniona,
# zostaje przez olddefconfig wylaczony po cichu i wtedy bramka pada.
#
# Symbole, ktorych tu NIE MA, bo wchodza same: DRM_SAMSUNG_DSIM,
# DRM_DISPLAY_DSC_HELPER i GENERIC_PHY_MIPI_DPHY (select z symboli nizej),
# I2C_EXYNOS5 (default y if ARCH_EXYNOS), PINCTRL_EXYNOS_ARM64
# (select z PINCTRL_EXYNOS).

# --- platforma ---------------------------------------------------------------
CONFIG_ARCH_EXYNOS=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_EXYNOS_PM_DOMAINS=y

# --- zasilanie panelu --------------------------------------------------------
# Bez tych dwoch trzy szyny panelu nie powstaja, panel wisi na EPROBE_DEFER
# i ekran nie zapala sie przy poprawnym kodzie.
CONFIG_MFD_SEC_I2C=y
CONFIG_REGULATOR_S2DOS05=y

# --- lancuch wyswietlania ----------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS_DSI=y
CONFIG_DRM_EXYNOS9820_DECON=y
CONFIG_PHY_EXYNOS9820_DSIM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA9=y

# --- dotyk -------------------------------------------------------------------
CONFIG_TOUCHSCREEN_S6SY761=y

# --- dwie decyzje, ktore nie sa oczywiste ------------------------------------
#
# 1. SYSMMU wylaczony. Wezly sysmmu_dpud0..2 sa w DT, ale sterownik wlacza sie
#    tu na n. Powod: EXYNOS_IOMMU robi "select ARM_DMA_USE_IOMMU"
#    (drivers/iommu/Kconfig:259-264), czyli symbol swiata ARM32, a na arm64
#    exynos_drm_dma.c idzie druga galezia, przez IOMMU_DMA. Tej kombinacji dla
#    tego SoC nikt nie uruchomil i nie da sie jej sprawdzic bez sprzetu.
#    Wlaczenie jej zmienia caly model adresowania bufora obrazu, wiec pierwszy
#    bring-up ma isc bez niej, a wlaczenie jest osobnym krokiem z osobnym
#    pomiarem. Patrz HW-35 w docs/HW-BLOCKED.md.
# CONFIG_EXYNOS_IOMMU is not set
#
# 2. SIMPLEDRM wylaczony. Wezel /chosen/framebuffer0 w DT plyty jest po to,
#    zeby bootloader zostawil obraz, ale sterowniki drm/exynos nie usuwaja
#    konkurencyjnego framebuffera (w calym drivers/gpu/drm/exynos nie ma ani
#    jednego wywolania aperture_remove_conflicting_devices). Wlaczony
#    SIMPLEDRM daje wiec dwa urzadzenia DRM na ten sam ekran i userland moze
#    trafic na to zamrozone. Do wlaczenia dopiero razem z przekazaniem ekranu.
#    Patrz HW-36 w docs/HW-BLOCKED.md.
# CONFIG_DRM_SIMPLEDRM is not set
